---
import { homeContent, type HomeContent } from '../data/home';
import type { Locale } from '../data/locales';
import RqContactForm from './RqContactForm.astro';
import RqFooter from './RqFooter.astro';
import RqHeader from './RqHeader.astro';
import RqJourney from './RqJourney.astro';
import RqMotion from './RqMotion.astro';
import RqProblemDiagnostic from './RqProblemDiagnostic.astro';

interface Props {
  content?: HomeContent;
  lang?: Locale;
}

const { content: providedContent, lang = 'cs' } = Astro.props;
const content: HomeContent = providedContent ?? homeContent.cs;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (href: string) => {
  if (!href || !href.startsWith('/')) return href;
  if (base && (href === base || href.startsWith(`${base}/`))) return href;
  return `${base}${href}`;
};
const heroSecondaryHref = resolve(content.hero.actions.secondary.href);
const pricingAuditContactHref = '?project_type=Audit#kontakt';
const pricingAuditMeasureHref = resolve(content.pricing.audit.measureHref);
const contactNotePhone = content.contact.notePhone ?? '+420 730 634 439';
const contactNotePhoneLabel = lang === 'en' ? 'Prefer a call?' : 'Radši telefon?';
const typewriterWords = content.hero.typewriter.words.join('|');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'RadeQ.cz',
  description: content.schema.description,
  url: content.schema.url,
  image: 'https://radeq.cz/og-default.jpg',
  priceRange: '$$',
  telephone: contactNotePhone,
  email: 'siroky@radeq.cz',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: contactNotePhone,
    email: 'siroky@radeq.cz',
    contactType: 'customer support',
    areaServed: content.schema.areaServed,
    availableLanguage: ['cs', 'en'],
  },
  areaServed: content.schema.areaServed,
  founder: { '@type': 'Person', name: content.schema.founderName },
  address: {
    '@type': 'PostalAddress',
    addressLocality: content.schema.addressLocality,
    addressCountry: content.schema.addressCountry,
  },
  knowsAbout: content.schema.knowsAbout,
  sameAs: ['https://github.com/SirRadek', 'https://cz.linkedin.com/in/sirradek'],
};
---

<RqHeader content={content.nav} alternateLabel={content.seo.alternateLabel} alternatePath={content.seo.alternatePath} />

<main>
  <section class="rq-section rq-hero" id="top" style="--rq-reveal-index: 0">
    <div class="rq-hero__ambient" data-rq-hero-three aria-hidden="true"></div>
    <div class="rq-hero__content">
      <div class="rq-hero__copy">
        <p class="rq-eyebrow" data-rq-reveal style="--rq-i:0">{content.hero.eyebrow}</p>
        <h1 class="rq-display" data-rq-reveal style="--rq-i:1">{content.hero.title}</h1>
        <p class="rq-hero__typewriter" data-rq-reveal style="--rq-i:2">
          <span class="rq-hero__tw-prefix">{content.hero.typewriter.prefix}</span><span
            class="rq-hero__tw-rotator"
            data-rq-typewriter
            data-rq-words={typewriterWords}
          ><span class="rq-hero__tw-sizer" aria-hidden="true">{content.hero.typewriter.sizerWord}</span><span class="rq-hero__tw-text" aria-hidden="true">{content.hero.typewriter.initialWord}</span></span>
          <span class="rq-sr-only" data-rq-typewriter-live aria-live="polite">{content.hero.typewriter.liveText}</span>
        </p>
        <p class="rq-lead" data-rq-reveal style="--rq-i:3">{content.hero.lead}</p>
        <p class="rq-hero__journey-note" data-rq-reveal style="--rq-i:4">{content.hero.journeyNote}</p>
      </div>

      <div class="rq-proof-rail" data-rq-reveal style="--rq-i:5" aria-label={content.hero.proofAriaLabel}>
        {content.hero.proofItems.map((item) => (
          <div class="rq-proof-rail__item">
            <p class="rq-proof-rail__label">{item.label}</p>
            <p class="rq-proof-rail__text">{item.text}</p>
          </div>
        ))}
      </div>

      <div class="rq-hero__actions" data-rq-reveal style="--rq-i:6">
        <a class="rq-btn rq-btn--primary" href={content.hero.actions.primary.href}>{content.hero.actions.primary.label}</a>
        <div class="rq-hero__secondary-action">
          <a class="rq-btn rq-btn--ghost" href={heroSecondaryHref}>{content.hero.actions.secondary.label}</a>
          <p class="rq-hero__secondary-micro">{content.hero.actions.secondaryMicro}</p>
        </div>
        <p class="rq-hero__micro">{content.hero.actions.micro}</p>
      </div>
    </div>
  </section>

  <script>
    import { inViewGate } from '../lib/inViewGate';

    (() => {
      const MASCOT_STORAGE_KEY = 'rq-mascot';

      function mascotOptedIn() {
        try {
          return window.localStorage?.getItem(MASCOT_STORAGE_KEY) === 'on';
        } catch {
          return false;
        }
      }

      const mount = document.querySelector('[data-rq-hero-three]');
      if (!mount || mount.getAttribute('data-rq-hero-three-ready') === 'true' || !mascotOptedIn()) return;
      mount.setAttribute('data-rq-hero-three-ready', 'true');

      const MOBILE_POINT_WIDTH = 768;
      const reducedMotionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');
      const mobilePointQuery = window.matchMedia?.(`(max-width: ${MOBILE_POINT_WIDTH - 0.02}px)`);
      const coarsePointerQuery = window.matchMedia?.('(pointer: coarse)');
      let gate = null;
      let ambient = null;
      let loading = false;
      let shouldRun = false;
      let resizeTimer = 0;
      let pageHidden = document.hidden;
      let webglAvailable = null;

      function canUseWebGL() {
        if (webglAvailable !== null) return webglAvailable;
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('webgl2', { alpha: true }) || canvas.getContext('webgl', { alpha: true });
        context?.getExtension('WEBGL_lose_context')?.loseContext();
        webglAvailable = Boolean(context);
        return webglAvailable;
      }

      function canEnhance() {
        return mascotOptedIn() && !isStaticMode() && !isMobilePointMode() && canUseWebGL();
      }

      function isStaticMode() {
        return Boolean(reducedMotionQuery?.matches);
      }

      function isMobilePointMode() {
        const mobileViewport = mobilePointQuery ? mobilePointQuery.matches : window.innerWidth < MOBILE_POINT_WIDTH;
        return mobileViewport || Boolean(coarsePointerQuery?.matches);
      }

      function getCatQualityMode() {
        const forcedQuality = new URLSearchParams(window.location.search).get('catQuality');
        if (forcedQuality === 'max' || forcedQuality === 'desktop' || forcedQuality === 'low' || forcedQuality === 'ultra') {
          return forcedQuality;
        }

        const mobileViewport = mobilePointQuery ? mobilePointQuery.matches : window.innerWidth < MOBILE_POINT_WIDTH;
        const coarsePointer = Boolean(coarsePointerQuery?.matches);
        const cores = navigator.hardwareConcurrency || 8;
        if (!mobileViewport && !coarsePointer && cores > 4) return 'desktop';
        return window.innerWidth < 520 || cores <= 2 ? 'ultra' : 'low';
      }

      function requestIdle(callback) {
        if (typeof window.requestIdleCallback === 'function') {
          return window.requestIdleCallback(callback, { timeout: 1200 });
        }
        return window.setTimeout(callback, 180);
      }

      function handleVisibilityChange() {
        pageHidden = document.hidden;
        if (pageHidden) {
          ambient?.stop();
          return;
        }

        if (shouldRun) {
          ensureAmbient();
        }
      }

      function scheduleResize() {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resizeTimer = 0;

          if (!canEnhance()) {
            ambient?.dispose();
            ambient = null;
            return;
          }

          if (
              ambient &&
              (
                ambient.staticMode !== isStaticMode() ||
                ambient.qualityMode !== getCatQualityMode()
              )
            ) {
            ambient.dispose();
            ambient = null;
          }

          if (!ambient && shouldRun && !pageHidden) {
            ensureAmbient();
            return;
          }

          ambient?.resize();
        }, 160);
      }

      async function ensureAmbient() {
        if (!shouldRun || pageHidden || !canEnhance()) return;
        const staticMode = isStaticMode();
        const qualityMode = getCatQualityMode();
        if (ambient) {
          if (ambient.staticMode !== staticMode || ambient.qualityMode !== qualityMode) {
            ambient.dispose();
            ambient = null;
          } else {
            ambient.start();
            return;
          }
        }
        if (loading || !canUseWebGL()) return;

        loading = true;
        try {
          const [three, catData] = await Promise.all([
            import('three'),
            import('../data/heroCatPoints'),
          ]);

          if (!shouldRun || pageHidden) return;

          ambient = createHeroAmbient(mount, three, catData, {
            staticMode: isStaticMode(),
            qualityMode: getCatQualityMode(),
          });
          ambient.start();
        } catch {
          ambient?.dispose();
          ambient = null;
        } finally {
          loading = false;
        }
      }

      function createHeroAmbient(root, three, catData, { staticMode = false, qualityMode = 'desktop' } = {}) {
        const {
          NormalBlending,
          BufferAttribute,
          BufferGeometry,
          Color,
          DynamicDrawUsage,
          Group,
          PerspectiveCamera,
          Points,
          Scene,
          ShaderMaterial,
          Vector3,
          WebGLRenderer,
        } = three;
        const {
          HERO_CAT_COLORS_BASE64,
          HERO_CAT_DETAIL_BASE64,
          HERO_CAT_MAX_COLORS_BASE64,
          HERO_CAT_MAX_DETAIL_BASE64,
          HERO_CAT_MAX_POINT_COUNT,
          HERO_CAT_MAX_POINTS_BASE64,
          HERO_CAT_MAX_SIZES_BASE64,
          HERO_CAT_SIZES_BASE64,
          HERO_CAT_SIZE_RANGE,
          HERO_CAT_LOW_POWER_COLORS_BASE64,
          HERO_CAT_LOW_POWER_DETAIL_BASE64,
          HERO_CAT_LOW_POWER_POINT_COUNT,
          HERO_CAT_LOW_POWER_POINTS_BASE64,
          HERO_CAT_LOW_POWER_SIZES_BASE64,
          HERO_CAT_POINT_COUNT,
          HERO_CAT_POINTS_BASE64,
          HERO_CAT_ULTRA_LOW_POWER_COLORS_BASE64,
          HERO_CAT_ULTRA_LOW_POWER_DETAIL_BASE64,
          HERO_CAT_ULTRA_LOW_POWER_POINT_COUNT,
          HERO_CAT_ULTRA_LOW_POWER_POINTS_BASE64,
          HERO_CAT_ULTRA_LOW_POWER_SIZES_BASE64,
        } = catData;

        const bgColor = new Color('#F7F4EE');
        const scene = new Scene();
        const cloud = new Group();
        const camera = new PerspectiveCamera(42, 1, 0.1, 180);
        const renderer = new WebGLRenderer({
          alpha: true,
          antialias: false,
          powerPreference: 'low-power',
        });
        const refDepth = 86;
        const dpr = () => Math.min(window.devicePixelRatio || 1, 1.5);
        const pointSources = {
          max: {
            positions: HERO_CAT_MAX_POINTS_BASE64,
            colors: HERO_CAT_MAX_COLORS_BASE64,
            sizes: HERO_CAT_MAX_SIZES_BASE64,
            details: HERO_CAT_MAX_DETAIL_BASE64,
            targetCount: HERO_CAT_MAX_POINT_COUNT,
          },
          desktop: {
            positions: HERO_CAT_POINTS_BASE64,
            colors: HERO_CAT_COLORS_BASE64,
            sizes: HERO_CAT_SIZES_BASE64,
            details: HERO_CAT_DETAIL_BASE64,
            targetCount: HERO_CAT_POINT_COUNT,
          },
          low: {
            positions: HERO_CAT_LOW_POWER_POINTS_BASE64,
            colors: HERO_CAT_LOW_POWER_COLORS_BASE64,
            sizes: HERO_CAT_LOW_POWER_SIZES_BASE64,
            details: HERO_CAT_LOW_POWER_DETAIL_BASE64,
            targetCount: HERO_CAT_LOW_POWER_POINT_COUNT,
          },
          ultra: {
            positions: HERO_CAT_ULTRA_LOW_POWER_POINTS_BASE64,
            colors: HERO_CAT_ULTRA_LOW_POWER_COLORS_BASE64,
            sizes: HERO_CAT_ULTRA_LOW_POWER_SIZES_BASE64,
            details: HERO_CAT_ULTRA_LOW_POWER_DETAIL_BASE64,
            targetCount: HERO_CAT_ULTRA_LOW_POWER_POINT_COUNT,
          },
        };
        const pointSource = pointSources[qualityMode] || pointSources.desktop;
        const lowPower = qualityMode === 'low' || qualityMode === 'ultra';
        const pointPixelSize = qualityMode === 'max'
          ? 3.05
          : qualityMode === 'desktop'
            ? 3.15
            : qualityMode === 'low'
              ? 5.05
              : 5.85;
        const decodedPositions = decodeFloat32Base64(pointSource.positions);
        const decodedColors = decodeUint8Base64(pointSource.colors);
        const decodedPointSizes = decodeUint8Base64(pointSource.sizes);
        const decodedPointDetail = decodeUint8Base64(pointSource.details);
        const targetPointCount = Math.min(
          pointSource.targetCount,
          Math.floor(decodedPositions.length / 3),
          Math.floor(decodedColors.length / 3),
          decodedPointSizes.length,
          decodedPointDetail.length,
        );
        const decodedPointCount = Math.min(
          Math.floor(decodedPositions.length / 3),
          Math.floor(decodedColors.length / 3),
          decodedPointSizes.length,
          decodedPointDetail.length,
        );
        const pointData = selectPointData(
          decodedPositions,
          decodedColors,
          decodedPointSizes,
          decodedPointDetail,
          decodedPointCount,
          targetPointCount,
          qualityMode,
        );
        const basePositions = pointData.positions;
        const pointColors = pointData.colors;
        const pointSizes = pointData.sizes;
        const pointDetail = pointData.details;
        const pointCount = pointData.count;
        const homePositions = new Float32Array(pointCount * 3);
        const positions = new Float32Array(pointCount * 3);
        const pointAlpha = new Float32Array(pointCount);
        const pointGeometry = new BufferGeometry();
        const hoverQuery = window.matchMedia?.('(hover: hover) and (pointer: fine)');
        const coarseQuery = window.matchMedia?.('(pointer: coarse)');
        const touchCapable = (navigator.maxTouchPoints || 0) > 0 || 'ontouchstart' in window;
        const scatterEnabled = !staticMode && (
          Boolean(hoverQuery?.matches) ||
          Boolean(coarseQuery?.matches) ||
          touchCapable
        );
        const pointer = { x: 0, y: 0, active: false, coarse: false, id: null };
        const projection = new Vector3();
        let scatterSettled = true;
        const scatterPointLimit = lowPower ? pointCount : Math.min(pointCount, 36000);
        const scatterIndices = buildScatterIndices(scatterPointLimit);
        const scatterCount = scatterIndices ? scatterIndices.length : pointCount;

        camera.position.z = refDepth;
        renderer.setClearColor(bgColor, 0);
        renderer.setPixelRatio(dpr());
        root.appendChild(renderer.domElement);
        scene.add(cloud);

        let width = 1;
        let height = 1;
        let worldWidth = 100;
        let worldHeight = 70;
        let frameId = 0;
        let running = false;
        let disposed = false;
        let parallax = 0;
        let cloudBaseX = 0;
        let cloudBaseY = 0;
        let staticRendered = false;

        seedPointAttributes();
        const positionAttribute = new BufferAttribute(positions, 3);
        positionAttribute.setUsage(DynamicDrawUsage);
        pointGeometry.setAttribute('position', positionAttribute);
        pointGeometry.setAttribute('acolor', new BufferAttribute(pointColors, 3, true));
        pointGeometry.setAttribute('aSize', new BufferAttribute(pointSizes, 1, true));
        pointGeometry.setAttribute('aAlpha', new BufferAttribute(pointAlpha, 1));
        pointGeometry.setAttribute('aDetail', new BufferAttribute(pointDetail, 1, true));

        const pointMaterial = new ShaderMaterial({
          transparent: true,
          depthWrite: false,
          depthTest: false,
          blending: NormalBlending,
          uniforms: {
            uOpacity: { value: lowPower ? 1 : 0.98 },
            uDpr: { value: dpr() },
            uRef: { value: refDepth },
            uSize: { value: pointPixelSize },
            uSizeMin: { value: HERO_CAT_SIZE_RANGE?.min ?? 0.5 },
            uSizeRange: { value: (HERO_CAT_SIZE_RANGE?.max ?? 1.2) - (HERO_CAT_SIZE_RANGE?.min ?? 0.5) },
            uSaturation: { value: 1 },
            uContrast: { value: 1 },
          },
          vertexShader: `
            attribute vec3 acolor;
            attribute float aSize;
            attribute float aAlpha;
            attribute float aDetail;
            uniform float uDpr;
            uniform float uRef;
            uniform float uSize;
            uniform float uSizeMin;
            uniform float uSizeRange;
            varying vec3 vColor;
            varying float vAlpha;
            varying float vDetail;
            varying float vDepth;

            void main() {
              vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
              float depth = max(34.0, -mvPosition.z);
              vColor = acolor;
              vAlpha = aAlpha;
              vDetail = aDetail;
              vDepth = clamp(position.z * 0.035 + 0.5, 0.0, 1.0);
              gl_Position = projectionMatrix * mvPosition;
              gl_PointSize = uSize * (uSizeMin + aSize * uSizeRange) * uDpr * (uRef / depth);
            }
          `,
          fragmentShader: `
            precision mediump float;
            uniform float uOpacity;
            uniform float uSaturation;
            uniform float uContrast;
            varying vec3 vColor;
            varying float vAlpha;
            varying float vDetail;
            varying float vDepth;

            void main() {
              vec2 c = gl_PointCoord - vec2(0.5);
              float d = dot(c, c);
              if (d > 0.25) discard;
              float softCircle = smoothstep(0.25, 0.14, d);
              float core = smoothstep(0.105, 0.0, d);
              float alpha = softCircle * uOpacity * vAlpha * (0.94 + core * 0.08 + vDetail * 0.04);
              if (alpha < 0.006) discard;
              float lum = dot(vColor, vec3(0.2126, 0.7152, 0.0722));
              vec3 adjusted = mix(vec3(lum), vColor, uSaturation);
              adjusted = clamp((adjusted - 0.5) * uContrast + 0.5, 0.0, 1.0);
              float depthShade = mix(0.88, 1.08, vDepth);
              vec3 color = adjusted * depthShade;
              color = mix(color, adjusted * 1.035, core * 0.08);
              gl_FragColor = vec4(color, alpha);
            }
          `,
        });

        const points = new Points(pointGeometry, pointMaterial);
        points.frustumCulled = false;
        cloud.add(points);

        if (scatterEnabled) {
          window.addEventListener('pointerdown', handlePointerDown, { passive: true });
          window.addEventListener('pointermove', handlePointerMove, { passive: true });
          window.addEventListener('pointerup', handlePointerEnd, { passive: true });
          window.addEventListener('pointercancel', handlePointerEnd, { passive: true });
          window.addEventListener('pointerout', handlePointerOut, { passive: true });
          window.addEventListener('touchmove', handleTouchMove, { passive: true });
          window.addEventListener('touchend', handleTouchEnd, { passive: true });
          window.addEventListener('touchcancel', handleTouchEnd, { passive: true });
          window.addEventListener('blur', deactivatePointer);
        }

        function decodeFloat32Base64(base64) {
          const binary = window.atob(base64);
          const bytes = new Uint8Array(binary.length);
          for (let index = 0; index < binary.length; index += 1) {
            bytes[index] = binary.charCodeAt(index);
          }

          const view = new DataView(bytes.buffer);
          const floats = new Float32Array(bytes.byteLength / 4);
          for (let index = 0; index < floats.length; index += 1) {
            floats[index] = view.getFloat32(index * 4, true);
          }
          return floats;
        }

        function decodeUint8Base64(base64) {
          const binary = window.atob(base64);
          const bytes = new Uint8Array(binary.length);
          for (let index = 0; index < binary.length; index += 1) {
            bytes[index] = binary.charCodeAt(index);
          }
          return bytes;
        }

        function selectPointData(sourcePositions, sourceColors, sourceSizes, sourceDetails, sourceCount, targetCount, salt) {
          const count = Math.min(sourceCount, Math.max(0, targetCount));
          if (count >= sourceCount) {
            return {
              positions: sourcePositions.subarray(0, sourceCount * 3),
              colors: sourceColors.subarray(0, sourceCount * 3),
              sizes: sourceSizes.subarray(0, sourceCount),
              details: sourceDetails.subarray(0, sourceCount),
              count: sourceCount,
            };
          }

          const positions = new Float32Array(count * 3);
          const colors = new Uint8Array(count * 3);
          const sizes = new Uint8Array(count);
          const details = new Uint8Array(count);
          const bucketSize = sourceCount / Math.max(1, count);
          const saltValue = salt === 'ultra' ? 193 : salt === 'low' ? 97 : 31;

          for (let index = 0; index < count; index += 1) {
            const start = Math.floor(index * bucketSize);
            const end = Math.min(sourceCount - 1, Math.floor((index + 1) * bucketSize) - 1);
            const span = Math.max(1, end - start + 1);
            const sourceBaseOffset = start * 3;
            const pick = start + Math.min(
              span - 1,
              Math.floor(noise(start + saltValue, sourcePositions[sourceBaseOffset], sourcePositions[sourceBaseOffset + 1]) * span),
            );
            const sourceOffset = pick * 3;
            const targetOffset = index * 3;

            positions[targetOffset] = sourcePositions[sourceOffset];
            positions[targetOffset + 1] = sourcePositions[sourceOffset + 1];
            positions[targetOffset + 2] = sourcePositions[sourceOffset + 2];
            colors[targetOffset] = sourceColors[sourceOffset];
            colors[targetOffset + 1] = sourceColors[sourceOffset + 1];
            colors[targetOffset + 2] = sourceColors[sourceOffset + 2];
            sizes[index] = sourceSizes[pick];
            details[index] = sourceDetails[pick];
          }

          return { positions, colors, sizes, details, count };
        }

        function clamp01(value) {
          return Math.max(0, Math.min(1, value));
        }

        function noise(index, x, y) {
          const value = Math.sin((index + 1) * 12.9898 + x * 78.233 + y * 37.719) * 43758.5453;
          return value - Math.floor(value);
        }

        function buildScatterIndices(limit) {
          const targetCount = Math.max(1, Math.floor(limit));
          if (targetCount >= pointCount) return null;

          const indices = new Uint32Array(targetCount);
          const bucketSize = pointCount / targetCount;
          for (let index = 0; index < targetCount; index += 1) {
            const start = Math.floor(index * bucketSize);
            const end = Math.min(pointCount - 1, Math.floor((index + 1) * bucketSize) - 1);
            const span = Math.max(1, end - start + 1);
            const offset = start * 3;
            const jitter = Math.floor(noise(start, basePositions[offset], basePositions[offset + 1]) * span);
            indices[index] = start + Math.min(span - 1, jitter);
          }
          return indices;
        }

        function seedPointAttributes() {
          for (let index = 0; index < pointCount; index += 1) {
            const offset = index * 3;
            const x = basePositions[offset];
            const y = basePositions[offset + 1];
            const n = noise(index, x, y);
            const detail = pointDetail[index] / 255;
            pointAlpha[index] = Math.min(1, 0.82 + n * 0.14 + detail * 0.12);
          }
        }

        function measure() {
          const rect = root.getBoundingClientRect();
          width = Math.max(1, Math.floor(rect.width || window.innerWidth));
          height = Math.max(1, Math.floor(rect.height || window.innerHeight * 0.78));
          worldHeight = 2 * camera.position.z * Math.tan((camera.fov * Math.PI / 180) * 0.5);
          worldWidth = worldHeight * (width / height);
        }

        function layoutCloud() {
          const mobileViewport = width < 768;
          const compactDesktop = width < 1040;
          const scale = Math.min(
            mobileViewport ? worldHeight * 0.68 : compactDesktop ? worldHeight * 0.86 : worldHeight * 1.04,
            mobileViewport ? worldWidth * 0.76 : compactDesktop ? worldWidth * 0.66 : worldWidth * 0.52,
            mobileViewport ? 48 : compactDesktop ? 66 : 82,
          );

          cloudBaseX = worldWidth * (mobileViewport ? 0.42 : compactDesktop ? 0.34 : 0.3);
          cloudBaseY = -worldHeight * (mobileViewport ? 0.13 : compactDesktop ? 0.01 : 0.04);

          for (let index = 0; index < pointCount; index += 1) {
            const offset = index * 3;
            homePositions[offset] = basePositions[offset] * scale;
            homePositions[offset + 1] = basePositions[offset + 1] * scale;
            homePositions[offset + 2] = basePositions[offset + 2] * scale * 0.92;
            positions[offset] = homePositions[offset];
            positions[offset + 1] = homePositions[offset + 1];
            positions[offset + 2] = homePositions[offset + 2];
          }

          scatterSettled = true;
          pointGeometry.attributes.position.needsUpdate = true;
          updateTransform(0);
        }

        function updateTransform(now) {
          const time = now * 0.001;
          if (staticMode) {
            parallax = 0;
          } else {
            const rect = root.getBoundingClientRect();
            const unitPerPx = worldHeight / Math.max(height, 1);
            const parallaxTarget = -rect.top * 0.12 * unitPerPx;
            parallax += (parallaxTarget - parallax) * 0.04;
          }

          const driftY = staticMode ? 0 : Math.sin(time * 0.18) * 0.55;
          cloud.position.set(cloudBaseX, cloudBaseY + parallax + driftY, 0);
          cloud.rotation.x = -0.035 + Math.sin(time * 0.1) * 0.032;
          cloud.rotation.y = -0.16 + Math.sin(time * 0.12) * 0.105;
          cloud.rotation.z = Math.sin(time * 0.07) * 0.012;
        }

        function updatePointer(clientX, clientY, coarse, pointerId = null) {
          const rect = root.getBoundingClientRect();
          pointer.x = clientX;
          pointer.y = clientY;
          pointer.coarse = Boolean(coarse);
          pointer.id = pointerId;
          pointer.active = (
            clientX >= rect.left &&
            clientX <= rect.right &&
            clientY >= rect.top &&
            clientY <= rect.bottom
          );
          scatterSettled = false;
        }

        function updatePointerFromEvent(event) {
          const coarse = event.pointerType !== 'mouse' || Boolean(coarseQuery?.matches);
          const pointerId = event.pointerType === 'mouse' ? null : event.pointerId;
          updatePointer(event.clientX, event.clientY, coarse, pointerId);
        }

        function handlePointerDown(event) {
          if (!scatterEnabled) return;
          updatePointerFromEvent(event);
        }

        function handlePointerMove(event) {
          if (!scatterEnabled) return;
          if (pointer.id !== null && event.pointerType !== 'mouse' && event.pointerId !== pointer.id) return;
          updatePointerFromEvent(event);
        }

        function handlePointerEnd(event) {
          if (!scatterEnabled) return;
          if (pointer.id !== null && event.pointerId !== pointer.id) return;
          deactivatePointer();
        }

        function handlePointerOut(event) {
          if (event.relatedTarget) return;
          deactivatePointer();
        }

        function handleTouchMove(event) {
          if (!scatterEnabled || !event.touches.length) return;
          const touch = event.touches[0];
          updatePointer(touch.clientX, touch.clientY, true, pointer.id);
        }

        function handleTouchEnd(event) {
          if (!scatterEnabled) return;
          if (event.touches.length) {
            const touch = event.touches[0];
            updatePointer(touch.clientX, touch.clientY, true, pointer.id);
            return;
          }
          deactivatePointer();
        }

        function deactivatePointer() {
          if (!scatterEnabled) return;
          pointer.active = false;
          pointer.id = null;
          scatterSettled = false;
        }

        function copyHomePositions() {
          positions.set(homePositions);
          pointGeometry.attributes.position.needsUpdate = true;
        }

        function applyScatter() {
          if (!scatterEnabled || scatterSettled) return;

          const rect = root.getBoundingClientRect();
          const touchScatter = pointer.coarse;
          const radius = touchScatter ? (width < 768 ? 196 : 180) : (width < 1040 ? 124 : 148);
          const activeMargin = touchScatter ? Math.min(72, radius * 0.35) : 4;
          const active = pointer.active &&
            pointer.x >= rect.left - activeMargin &&
            pointer.x <= rect.right + activeMargin &&
            pointer.y >= rect.top - activeMargin &&
            pointer.y <= rect.bottom + activeMargin;
          if (!active) pointer.active = false;

          const radiusSq = radius * radius;
          const maxPushPx = touchScatter ? (lowPower ? 58 : 70) : (lowPower ? 44 : 58);
          const unitPerPx = worldHeight / Math.max(height, 1);
          const lerp = active ? (touchScatter ? 0.18 : 0.16) : 0.085;
          let maxDelta = 0;

          if (active) {
            camera.updateMatrixWorld();
            cloud.updateMatrixWorld(true);
            points.updateMatrixWorld(true);
          }

          for (let scatterIndex = 0; scatterIndex < scatterCount; scatterIndex += 1) {
            const index = scatterIndices ? scatterIndices[scatterIndex] : scatterIndex;
            const offset = index * 3;
            const homeX = homePositions[offset];
            const homeY = homePositions[offset + 1];
            const homeZ = homePositions[offset + 2];
            let targetX = homeX;
            let targetY = homeY;
            let targetZ = homeZ;

            if (active) {
              projection.set(homeX, homeY, homeZ).applyMatrix4(points.matrixWorld).project(camera);
              if (projection.z >= -1 && projection.z <= 1) {
                const screenX = rect.left + (projection.x * 0.5 + 0.5) * width;
                const screenY = rect.top + (-projection.y * 0.5 + 0.5) * height;
                const dx = screenX - pointer.x;
                const dy = screenY - pointer.y;
                const distSq = dx * dx + dy * dy;

                if (distSq < radiusSq) {
                  const dist = Math.max(1, Math.sqrt(distSq));
                  const falloff = 1 - dist / radius;
                  const push = maxPushPx * falloff * falloff;
                  targetX = homeX + (dx / dist) * push * unitPerPx;
                  targetY = homeY - (dy / dist) * push * unitPerPx;
                  targetZ = homeZ + falloff * 2.2;
                }
              }
            }

            const nextX = positions[offset] + (targetX - positions[offset]) * lerp;
            const nextY = positions[offset + 1] + (targetY - positions[offset + 1]) * lerp;
            const nextZ = positions[offset + 2] + (targetZ - positions[offset + 2]) * lerp;
            maxDelta = Math.max(
              maxDelta,
              Math.abs(targetX - positions[offset]),
              Math.abs(targetY - positions[offset + 1]),
              Math.abs(targetZ - positions[offset + 2]),
            );
            positions[offset] = nextX;
            positions[offset + 1] = nextY;
            positions[offset + 2] = nextZ;
          }

          if (!active && maxDelta < 0.002) {
            copyHomePositions();
            scatterSettled = true;
            return;
          }

          pointGeometry.attributes.position.needsUpdate = true;
        }

        function resize() {
          if (disposed) return;
          measure();
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          renderer.setPixelRatio(dpr());
          pointMaterial.uniforms.uDpr.value = dpr();
          renderer.setSize(width, height, false);
          layoutCloud();
          if (staticMode && staticRendered) renderStatic();
        }

        function renderStatic() {
          if (disposed || document.hidden) return;
          parallax = 0;
          updateTransform(0);
          renderer.render(scene, camera);
          staticRendered = true;
        }

        function render(now) {
          if (!running || disposed) return;
          if (document.hidden) {
            stop();
            return;
          }

          updateTransform(now);
          applyScatter();
          renderer.render(scene, camera);
          frameId = window.requestAnimationFrame(render);
        }

        function start() {
          if (disposed) return;
          if (staticMode) {
            stop();
            renderStatic();
            return;
          }
          if (running) return;
          running = true;
          frameId = window.requestAnimationFrame(render);
        }

        function stop() {
          running = false;
          if (!frameId) return;
          window.cancelAnimationFrame(frameId);
          frameId = 0;
        }

        function dispose() {
          if (disposed) return;
          stop();
          disposed = true;
          pointGeometry.dispose();
          pointMaterial.dispose();
          renderer.dispose();
          renderer.domElement.remove();
          if (scatterEnabled) {
            window.removeEventListener('pointerdown', handlePointerDown);
            window.removeEventListener('pointermove', handlePointerMove);
            window.removeEventListener('pointerup', handlePointerEnd);
            window.removeEventListener('pointercancel', handlePointerEnd);
            window.removeEventListener('pointerout', handlePointerOut);
            window.removeEventListener('touchmove', handleTouchMove);
            window.removeEventListener('touchend', handleTouchEnd);
            window.removeEventListener('touchcancel', handleTouchEnd);
            window.removeEventListener('blur', deactivatePointer);
          }
        }

        resize();

        return { start, stop, resize, dispose, staticMode, qualityMode, lowPowerMode: lowPower };
      }

      function startGate() {
        if (!canEnhance()) return;
        gate = inViewGate(mount, {
          rootMargin: '160px 0px',
          threshold: 0.01,
          onEnter: () => {
            shouldRun = true;
            ensureAmbient();
          },
          onExit: () => {
            shouldRun = false;
            ambient?.stop();
          },
        });
        window.addEventListener('resize', scheduleResize, { passive: true });
        reducedMotionQuery?.addEventListener?.('change', scheduleResize);
        mobilePointQuery?.addEventListener?.('change', scheduleResize);
        coarsePointerQuery?.addEventListener?.('change', scheduleResize);
      }

      function cleanup() {
        window.clearTimeout(resizeTimer);
        gate?.destroy();
        gate = null;
        ambient?.dispose();
        ambient = null;
        window.removeEventListener('resize', scheduleResize);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        reducedMotionQuery?.removeEventListener?.('change', scheduleResize);
        mobilePointQuery?.removeEventListener?.('change', scheduleResize);
        coarsePointerQuery?.removeEventListener?.('change', scheduleResize);
      }

      document.addEventListener('visibilitychange', handleVisibilityChange);

      window.addEventListener('pagehide', cleanup, { once: true });

      const boot = () => requestIdle(() => startGate());
      if (document.readyState === 'complete') {
        boot();
      } else {
        window.addEventListener('load', boot, { once: true });
      }
    })();
  </script>

  <script is:inline>
    (() => {
      const el = document.querySelector('[data-rq-typewriter]');
      if (!el) return;
      const textEl = el.querySelector('.rq-hero__tw-text');
      const liveEl = el.parentElement && el.parentElement.querySelector('[data-rq-typewriter-live]');
      const words = (el.getAttribute('data-rq-words') || '').split('|').map((w) => w.trim()).filter(Boolean);
      if (!textEl || words.length === 0) return;

      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { textEl.textContent = words[0]; return; }

      function createInViewGate(target, { rootMargin = '120px 0px', threshold = 0, onEnter = () => {}, onExit = () => {} } = {}) {
        let observer = null;
        let isIntersecting = false;
        let isActive = false;
        let destroyed = false;

        function enter() {
          if (destroyed || isActive) return;
          isActive = true;
          onEnter();
        }

        function exit() {
          if (destroyed || !isActive) return;
          isActive = false;
          onExit();
        }

        function sync() {
          if (document.hidden || !isIntersecting) {
            exit();
            return;
          }

          enter();
        }

        function handleVisibilityChange() {
          if (document.hidden) {
            exit();
            return;
          }

          if (isIntersecting) enter();
        }

        function cleanup() {
          observer?.disconnect();
          observer = null;
          document.removeEventListener('visibilitychange', handleVisibilityChange);
          window.removeEventListener('pagehide', handlePageHide);
        }

        function handlePageHide() {
          onExit();
          isActive = false;
          destroyed = true;
          cleanup();
        }

        document.addEventListener('visibilitychange', handleVisibilityChange);
        window.addEventListener('pagehide', handlePageHide, { once: true });

        if (!('IntersectionObserver' in window)) {
          isIntersecting = true;
          if (!document.hidden) enter();

          return {
            destroy() {
              destroyed = true;
              cleanup();
            },
          };
        }

        observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          isIntersecting = Boolean(entry && entry.isIntersecting);
          sync();
        }, { rootMargin, threshold });

        observer.observe(target);

        return {
          destroy() {
            destroyed = true;
            cleanup();
          },
        };
      }

      const TYPE = 70, DEL = 38, HOLD = 1600, GAP = 320;
      const MAX_CYCLES = 3;
      const finalWord = words[words.length - 1];
      const observeTarget = el.closest('.rq-hero__typewriter') || el;
      const prefixEl = el.parentElement && el.parentElement.querySelector('.rq-hero__tw-prefix');
      const livePrefix = prefixEl ? prefixEl.textContent.replace(/\s+/g, ' ') : '';
      let wi = 0, ci = words[0].length, deleting = true;
      let cycles = 0;
      let inView = false;
      let stopped = false;
      let timerId = 0;
      let nextDelay = HOLD;
      let gate = null;

      function clearTimer() {
        if (!timerId) return;
        window.clearTimeout(timerId);
        timerId = 0;
      }

      function destroyGate() {
        if (!gate) return;
        gate.destroy();
        gate = null;
      }

      function cleanup() {
        clearTimer();
        destroyGate();
      }

      function schedule(delay) {
        nextDelay = delay;
        clearTimer();
        if (!inView || stopped || document.hidden) return;
        timerId = window.setTimeout(() => {
          timerId = 0;
          tick();
        }, delay);
      }

      function resume() {
        if (timerId || stopped || document.hidden) return;
        schedule(nextDelay);
      }

      function stopOnFinalWord() {
        stopped = true;
        deleting = false;
        wi = words.length - 1;
        ci = finalWord.length;
        textEl.textContent = finalWord;
        textEl.classList.add('is-rq-typewriter-done');
        textEl.classList.remove('is-rq-typewriter-paused');
        if (liveEl) liveEl.textContent = `${livePrefix}${finalWord}.`;
        cleanup();
      }

      function maybeStopAfterCycle(word) {
        if (word !== finalWord) return false;
        cycles += 1;
        if (cycles < MAX_CYCLES) return false;
        stopOnFinalWord();
        return true;
      }

      function tick() {
        if (!inView || stopped || document.hidden) return;
        const word = words[wi];
        if (!deleting) {
          ci += 1;
          textEl.textContent = word.slice(0, ci);
          if (ci >= word.length) {
            if (liveEl) liveEl.textContent = word;
            if (maybeStopAfterCycle(word)) return;
            deleting = true;
            schedule(HOLD);
            return;
          }
          schedule(TYPE);
          return;
        }
        ci -= 1;
        textEl.textContent = word.slice(0, Math.max(ci, 0));
        if (ci <= 0) {
          deleting = false;
          wi = (wi + 1) % words.length;
          schedule(GAP);
          return;
        }
        schedule(DEL);
      }

      function setInView(nextInView) {
        if (stopped) return;
        inView = nextInView;
        textEl.classList.toggle('is-rq-typewriter-paused', !inView);
        if (!inView) {
          clearTimer();
          return;
        }
        resume();
      }

      // Start showing the SSR word, hold, then delete and cycle.
      textEl.classList.add('is-rq-typewriter-paused');
      gate = createInViewGate(observeTarget, {
        rootMargin: '120px 0px',
        onEnter: () => setInView(true),
        onExit: () => setInView(false),
      });
    })();
  </script>

