---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['handoff'];
}

const { content } = Astro.props;
---

<section class="handoff-section ds-section ds-bleed" id="handoff" aria-labelledby="handoff-title">
  <div class="handoff-section__inner">
    <div class="handoff-section__heading">
      <p class="ds-eyebrow">{content.sectionCode}</p>
      <h2 class="handoff-section__title" id="handoff-title">{content.title}</h2>
      <p class="handoff-section__lead">{content.lead}</p>
    </div>

    <ul class="handoff-list" aria-label={content.title}>
      {content.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>
