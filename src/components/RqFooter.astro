---
interface NavLink {
  href: string;
  label: string;
}

interface FooterContent {
  tagline?: string;
  navTitle?: string;
  navAriaLabel?: string;
  connectionTitle?: string;
  connectionLinks?: readonly NavLink[];
  legal?: string;
  contactEmail?: string;
  contactPhone?: string;
}

interface Props {
  navItems?: readonly NavLink[];
  content?: FooterContent;
  homeHref?: string;
}

const { navItems = [], content = {}, homeHref = Astro.url.pathname.includes("/en/") ? "/en/" : "/" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (h: string) => {
  if (!h || !h.startsWith("/")) return h;
  if (base && (h === base || h.startsWith(base + "/"))) return h;
  return base + h;
};
const logoMask = `${base}/brand/radeq-logo-b-mask.png`;
const navAriaLabel = content.navAriaLabel ?? "Navigace v patičce";
const legal = content.legal ?? "© 2026 Radek Široký — RadeQ.cz · IČO 08748811 · Praha · celá ČR";
const isEnglishFooter = homeHref.startsWith("/en") || navItems.some((item) => item.href.includes("/en/"));
const auditLink = isEnglishFooter
  ? { href: "/en/audit/", label: "Automated website check" }
  : { href: "/audit/", label: "Automatická kontrola webu" };
---

<footer class="rq-minimal-footer"><a class="rq-minimal-preview__logo" href={resolve(homeHref)} aria-label={isEnglishFooter ? 'RadeQ — home' : 'RadeQ — domů'} style={`--logo-mask:url("${logoMask}")`}><span aria-hidden="true"></span></a><p>{legal}</p><nav aria-label={navAriaLabel}><a href={resolve(isEnglishFooter?'/en/ukazky/':'/ukazky/')}>{isEnglishFooter?'Examples':'Ukázky'}</a><a href={resolve(isEnglishFooter?'/en/soukromi/':'/soukromi/')}>{isEnglishFooter?'Privacy':'Soukromí'}</a><a href={resolve(auditLink.href)}>{auditLink.label}</a><a href={resolve('/zapisky/')} lang="cs">{isEnglishFooter?'Notes (in Czech)':'Zápisky'}</a></nav></footer>
