---
import type { SiteContent } from '../data/siteContent';
import type { Locale } from '../data/locales';
import type { ShowcaseExample } from '../data/showcaseExamples';

interface Props {
  content: SiteContent['demos'];
  locale: Locale;
  examples?: ShowcaseExample[];
}

const { content, locale, examples = [] } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const showcaseHref = `${basePath}/ukazky/`;
const showcaseLabel = locale === 'cs' ? 'Otevřít všechny ukázky' : 'Open all examples';
const demoItems =
  examples.length > 0
    ? examples.map((example) => ({
        name: example.h1,
        metric: example.eyebrow,
        summary: example.summary,
        events: example.proofTags.slice(0, 4),
        href: `${basePath}/ukazky/${example.slug}/`,
      }))
    : content.items.map((item) => ({ ...item, href: undefined }));
const hasCards = demoItems.length > 0;
---

<section class="demo-section" id="demos" aria-labelledby="demo-title">
  <div class="section-heading">
    {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
    <h2 id="demo-title">{content.title}</h2>
    <p>{content.lead}</p>
  </div>
  {
    hasCards && (
      <>
        <div class="demo-grid">
          {
            demoItems.map((demo, index) => (
              <article class="demo-card" data-cat-platform={`demo-card-${index + 1}`} tabindex="0">
                {demo.metric && <div class="card-kicker">{demo.metric}</div>}
                <h3>{demo.name}</h3>
                <p>{demo.summary}</p>
                <ol>
                  {demo.events.map((event) => (
                    <li>{event}</li>
                  ))}
                </ol>
                {demo.href && (
                  <a class="demo-card__link" href={demo.href}>
                    {locale === 'cs' ? 'Zobrazit ukázku' : 'View example'}
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <a class="demo-section__link" href={showcaseHref}>{showcaseLabel}</a>
      </>
    )
  }
</section>
