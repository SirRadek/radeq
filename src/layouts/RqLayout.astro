---
import { isPreviewChannel } from '../lib/preview-channel.mjs';
import ConsentPanel from '../components/ConsentPanel.astro';
import RqMetadata from '../components/RqMetadata.astro';
import type { Locale } from '../data/locales';
import MeasurementTracker from '../components/MeasurementTracker';
import { identity } from '../data/legal';
import '../styles/minimal-home-preview.css';
import '../styles/minimal-site.css';
import '../styles/studio.css';
interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  alternatePath?: string;
  alternateLang?: Locale;
  allowStoredStyle?: boolean;
  preview?: boolean;
  trackEvents?: boolean;
}

const { title, description, lang = 'cs', canonicalPath, alternatePath, alternateLang, trackEvents = true } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ? `${basePath}${canonicalPath}` : Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternatePath ? new URL(`${basePath}${alternatePath}`, siteUrl).toString() : undefined;
const ogImageUrl = new URL(`${basePath}/og-default.jpg`, siteUrl).toString();
const personId = 'https://radeq.cz/#person';
const businessId = 'https://radeq.cz/#business';
const identitySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService', '@id': businessId,
      name: identity.brand, legalName: identity.name, url: 'https://radeq.cz/',
      email: identity.email, telephone: identity.phone,
      identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: identity.ico },
      address: { '@type': 'PostalAddress', streetAddress: identity.street, addressLocality: identity.city, postalCode: identity.postcode, addressCountry: 'CZ' },
      areaServed: 'CZ', founder: { '@id': personId },
      sameAs: ['https://www.firmy.cz/detail/14036384-radeq-praha-nusle.html', 'https://www.zivefirmy.cz/radeq_f1952239'],
    },
    {
      '@type': 'Person', '@id': personId, name: identity.name,
      url: 'https://radeq.cz/#autor', worksFor: { '@id': businessId },
      sameAs: ['https://www.linkedin.com/in/sirradek', 'https://github.com/SirRadek'],
    },
  ],
};
const defaultUrl = lang === 'cs' ? canonicalUrl : alternateUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <RqMetadata
      title={title}
      description={description}
      lang={lang}
      canonicalUrl={canonicalUrl}
      ogUrl={canonicalUrl}
      imageUrl={ogImageUrl}
      alternates={alternatePath && alternateLang && alternateUrl ? [
        { lang, url: canonicalUrl },
        { lang: alternateLang, url: alternateUrl },
        { lang: 'x-default', url: defaultUrl! },
      ] : []}
      icons={[
        { rel: 'icon', type: 'image/png', url: basePath + '/favicon.png' },
        { rel: 'icon', type: 'image/png', media: '(prefers-color-scheme: dark)', url: basePath + '/favicon-dark.png' },
        { rel: 'apple-touch-icon', url: basePath + '/apple-touch-icon.png' },
      ]}
    />
    {!isPreviewChannel && !Astro.props.preview && <script is:inline type="application/ld+json" set:html={JSON.stringify(identitySchema).replaceAll('<','\\u003c')} />}
    <style is:global set:html={`@font-face{font-family:Chillax;src:url('${basePath}/fonts/radeq/chillax.woff2') format('woff2');font-weight:200 700;font-display:swap}@font-face{font-family:'Cabinet Grotesk';src:url('${basePath}/fonts/radeq/cabinet-grotesk.woff2') format('woff2');font-weight:100 900;font-display:swap}`} />
    {(isPreviewChannel || Astro.props.preview) && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body class="rq-minimal-preview rq-minimal-site">
    {trackEvents && <MeasurementTracker client:idle />}
    <div class="rq-minimal-preview__wrap"><slot /></div>
    {!isPreviewChannel && !Astro.props.preview && <ConsentPanel lang={lang} />}
  </body>
</html>
<script>
 import {startFaviconMotion} from '../lib/favicon-motion.mjs';
 startFaviconMotion();
</script>
