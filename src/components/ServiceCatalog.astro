---
import type { Locale, SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['systems'];
  locale: Locale;
}

const { content, locale } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const demoRoot = locale === 'en' ? '/en/demo' : '/demo';
const getDemoHref = (moduleId: string) => `${basePath}${demoRoot}/${moduleId}/`;

const routeCopy = {
  cs: {
    label: 'Doporučený start',
    title: 'Nejdřív vyberte jednu ztrátu na webu.',
    text: 'Mapa neprodává všechno najednou. Vede od rozpoznaného problému k jasnému dalšímu kroku.',
    action: 'Poslat krátký brief',
  },
  en: {
    label: 'Recommended start',
    title: 'Pick one place where the site leaks trust.',
    text: 'The map does not sell everything at once. It moves from a recognized problem to a clear next step.',
    action: 'Send a short brief',
  },
}[locale];
---

<section class="service-catalog" id="services-guided" aria-labelledby="services-title" data-direction="guided-offer-map">
  <div class="section-heading section-heading--services">
    {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
    <h2 id="services-title">{content.title}</h2>
    <p>{content.lead}</p>
  </div>
  <div class="offer-map" aria-label={content.mapAria} data-cat-platform="service-grid">
    <aside class="offer-map-guide">
      <p class="section-code">{content.guide.eyebrow}</p>
      <h3>{content.guide.title}</h3>
      <p>{content.guide.text}</p>
      <div class="offer-map-guide__recommendation">
        <span>{routeCopy.label}</span>
        <strong>{routeCopy.title}</strong>
        <p>{routeCopy.text}</p>
        <a href="#terminal">{routeCopy.action}</a>
      </div>
      <ol>
        {
          content.guide.steps.map((step) => (
            <li>
              <span>{step.label}</span>
              <strong>{step.value}</strong>
            </li>
          ))
        }
      </ol>
    </aside>
    <div class="service-path">
      {
        content.items.map((item, index) => (
          <article class="service-card" data-cat-platform={`service-card-${index + 1}`}>
            <div class="service-card__marker">
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p>{item.problem}</p>
            <h3>{item.system}</h3>
            <p>{item.output}</p>
            {
              item.demoModule ? (
                <a href={getDemoHref(item.demoModule)}>{content.demoLabel}</a>
              ) : (
                <a href="#terminal">{content.requestLabel}</a>
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>
