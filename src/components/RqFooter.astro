---
const { navItems } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (h) => {
  if (!h || !h.startsWith("/")) return h;
  if (base && (h === base || h.startsWith(base + "/"))) return h;
  return base + h;
};
const logoMask = `${base}/brand/radeq-logo-b-mask.png`;
---

<footer class="rq-site-footer rq-bleed">
  <div class="rq-site-footer__inner">
    <div class="rq-site-footer__grid">
      <div>
        <a
          class="rq-site-footer__logo rq-logo"
          href={base || "/"}
          style={`--rq-logo-mask:url("${logoMask}")`}
          aria-label="RadeQ.cz"
        >
          <span role="img" aria-label="RadeQ.cz"></span>
        </a>
        <p class="rq-site-footer__tagline">Racionální digitalizace pro živnostníky, malé firmy a spolky. Postavím, změřím, předám.</p>
      </div>

      <div>
        <h2 class="rq-site-footer__title">Navigace</h2>
        <nav class="rq-site-footer__links" aria-label="Navigace v patičce">
          {navItems.map((item) => (
            <a class="rq-site-footer__link" href={resolve(item.href)}>{item.label}</a>
          ))}
        </nav>
      </div>

      <div>
        <h2 class="rq-site-footer__title">Spojení</h2>
        <div class="rq-site-footer__links">
          <a class="rq-site-footer__link" href={resolve("/#kontakt")}>Napsat poptávku</a>
          <a class="rq-site-footer__link" href={resolve("/#ceny")}>Ceník</a>
        </div>
      </div>
    </div>

    <div class="rq-site-footer__bottom">
      <span>© 2026 Radek [PŘÍJMENÍ] — RadeQ.cz · IČO [DOPLNIT] · [MĚSTO/REGION]</span>
      <span class="rq-site-footer__contact"><a href="tel:+420000000000">+420 [TELEFON]</a> · <a href="mailto:info@radeq.cz">info@radeq.cz</a></span>
    </div>
  </div>
</footer>
