---
---

<script is:inline>
  (() => {
    if (window.__rqMotionIsland) return;
    window.__rqMotionIsland = true;

    const root = document.documentElement;

    const setupJourney = () => {
      const roots = Array.from(document.querySelectorAll('[data-rq-journey]'));
      const reducedMotionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');

      roots.forEach((journey) => {
        const tabs = Array.from(journey.querySelectorAll('[data-rq-journey-node]'));
        const panels = Array.from(journey.querySelectorAll('[data-rq-journey-panel]'));
        if (!tabs.length || !panels.length) return;

        const getTabIndex = (tab) => Number(tab.getAttribute('data-rq-target-index') || '0');
        const getPanelIndex = (panel) => Number(panel.getAttribute('data-rq-step-index') || '0');
        const initialTab = tabs.find((tab) => (
          tab.classList.contains('is-active') || tab.getAttribute('aria-selected') === 'true'
        ));
        const initialIndex = initialTab ? getTabIndex(initialTab) : 0;
        let activeIndex = initialIndex;
        let focusIndex = initialIndex;
        const journeyBody = journey.querySelector('[data-rq-journey-body]');
        const panelStack = journey.querySelector('[data-rq-journey-panels]');
        const preview = journey.querySelector('[data-rq-journey-preview]');
        const previewTriggers = Array.from(journey.querySelectorAll('[data-rq-journey-preview-trigger]'));
        const previewModes = Array.from(journey.querySelectorAll('[data-rq-journey-preview-mode]'));
        const previewProblemTitle = journey.querySelector('[data-rq-journey-preview-problem-title]');
        const previewProblemText = journey.querySelector('[data-rq-journey-preview-problem-text]');
        const previewProblemStep = journey.querySelector('[data-rq-journey-preview-problem-step]');
        let activePreviewMode = '';

        const getPreviewTriggerMode = (trigger) => trigger.getAttribute('data-rq-journey-preview-trigger') || '';
        const getElementHeight = (element) => element?.getBoundingClientRect().height || 0;

        const setJourneyState = (state) => {
          journey.setAttribute('data-rq-journey-state', state);
        };

        const reserveBodyHeight = (...heights) => {
          if (!journeyBody) return;
          const currentHeight = Number.parseFloat(journeyBody.style.getPropertyValue('--rq-journey-body-min-height')) || 0;
          const nextHeight = Math.max(currentHeight, ...heights);
          if (nextHeight <= 0) return;
          journeyBody.style.setProperty('--rq-journey-body-min-height', `${Math.ceil(nextHeight)}px`);
        };

        const hidePanels = () => {
          if (!panelStack) return;
          panelStack.hidden = true;
          panelStack.setAttribute('aria-hidden', 'true');
          panelStack.toggleAttribute('inert', true);
        };

        const showPanels = () => {
          setJourneyState('panels');
          if (!panelStack) return;
          panelStack.hidden = false;
          panelStack.setAttribute('aria-hidden', 'false');
          panelStack.toggleAttribute('inert', false);
        };

        const focusPreview = (mode) => {
          window.requestAnimationFrame(() => {
            if (!preview || preview.hidden || activePreviewMode !== mode) return;
            const activeMode = previewModes.find((previewMode) => (
              previewMode.getAttribute('data-rq-journey-preview-mode') === mode
            ));
            const focusTarget = activeMode?.querySelector('[data-rq-journey-preview-frame].is-active [data-rq-journey-preview-card]')
              || activeMode?.querySelector('[data-rq-preview-interactive]')
              || preview;
            if (typeof focusTarget?.focus === 'function') {
              focusTarget.focus({ preventScroll: true });
            }
          });
        };

        const getActiveProblemPreview = (detail = {}) => {
          if (detail.title || detail.problem || detail.step) {
            return detail;
          }

          const activeProblemPanel = document.querySelector('[data-rq-problem-panel].is-active');
          const findings = Array.from(activeProblemPanel?.querySelectorAll('.rq-problem-diagnostic__findings dd') || []);

          return {
            title: activeProblemPanel?.getAttribute('data-rq-problem-mini-title') || activeProblemPanel?.querySelector('h3')?.textContent?.trim() || '',
            problem: activeProblemPanel?.getAttribute('data-rq-problem-mini-problem') || findings[0]?.textContent?.trim() || '',
            step: activeProblemPanel?.getAttribute('data-rq-problem-mini-step') || findings[3]?.textContent?.trim() || '',
          };
        };

        const updateStartPreview = (detail = {}) => {
          const previewData = getActiveProblemPreview(detail);
          if (previewData.title && previewProblemTitle) previewProblemTitle.textContent = previewData.title;
          if (previewData.problem && previewProblemText) previewProblemText.textContent = previewData.problem;
          if (previewData.step && previewProblemStep) previewProblemStep.textContent = previewData.step;
        };

        const syncPreviewTriggers = () => {
          previewTriggers.forEach((trigger) => {
            trigger.setAttribute('aria-expanded', String(getPreviewTriggerMode(trigger) === activePreviewMode));
          });
        };

        const closePreview = (options = {}) => {
          const previousTrigger = previewTriggers.find((trigger) => getPreviewTriggerMode(trigger) === activePreviewMode);
          const previewHeight = getElementHeight(preview);
          activePreviewMode = '';
          showPanels();
          reserveBodyHeight(previewHeight, getElementHeight(panelStack));
          if (preview) {
            preview.hidden = true;
            preview.setAttribute('aria-hidden', 'true');
            preview.toggleAttribute('inert', true);
          }
          previewModes.forEach((mode) => { mode.hidden = true; });
          syncPreviewTriggers();
          if (options.restoreFocus) previousTrigger?.focus();
        };

        const openPreview = (mode) => {
          if (!preview || !mode) return;
          if (mode === 'start') updateStartPreview();

          const panelsHeight = getElementHeight(panelStack);
          activePreviewMode = mode;
          preview.hidden = false;
          preview.setAttribute('aria-hidden', 'false');
          preview.toggleAttribute('inert', false);
          previewModes.forEach((previewMode) => {
            previewMode.hidden = previewMode.getAttribute('data-rq-journey-preview-mode') !== mode;
          });
          reserveBodyHeight(panelsHeight, getElementHeight(preview));
          hidePanels();
          setJourneyState(`preview-${mode}`);
          syncPreviewTriggers();
          focusPreview(mode);
        };

        const togglePreview = (mode) => {
          if (activePreviewMode === mode) {
            closePreview();
            return;
          }

          openPreview(mode);
        };

        const focusScrollTarget = (target) => {
          if (typeof target.focus !== 'function') return;
          const hadTabIndex = target.hasAttribute('tabindex');
          if (!hadTabIndex) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
          if (!hadTabIndex) {
            target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
          }
        };

        const syncTabs = () => {
          tabs.forEach((tab) => {
            const tabIndex = getTabIndex(tab);
            const isActive = tabIndex === activeIndex;

            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            tab.tabIndex = tabIndex === focusIndex ? 0 : -1;
          });
        };

        const syncPanels = () => {
          panels.forEach((panel) => {
            const panelIndex = getPanelIndex(panel);
            const isActive = panelIndex === activeIndex;

            panel.classList.toggle('is-active', isActive);
            panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
            panel.toggleAttribute('inert', !isActive);
          });
        };

        const setActive = (index) => {
          if (!tabs.some((tab) => getTabIndex(tab) === index)) return;
          if (!panels.some((panel) => getPanelIndex(panel) === index)) return;

          activeIndex = index;
          focusIndex = index;
          closePreview();
          syncTabs();
          syncPanels();
        };

        const scrollTabIntoView = (tab) => {
          window.requestAnimationFrame(() => {
            tab.scrollIntoView({
              behavior: reducedMotionQuery?.matches ? 'auto' : 'smooth',
              block: 'nearest',
              inline: 'center',
            });
          });
        };

        const moveTabFocus = (index) => {
          if (!tabs.length) return;
          const nextIndex = (index + tabs.length) % tabs.length;
          setActive(nextIndex);

          const nextTab = tabs.find((tab) => getTabIndex(tab) === nextIndex);
          nextTab?.focus();
          if (nextTab) scrollTabIntoView(nextTab);
        };

        journey.classList.add('is-enhanced');
        setActive(initialIndex);

        tabs.forEach((tab) => {
          const tabIndex = getTabIndex(tab);

          tab.addEventListener('click', () => {
            setActive(tabIndex);
            scrollTabIntoView(tab);
          });

          tab.addEventListener('focus', () => {
            setActive(tabIndex);
          });

          tab.addEventListener('keydown', (event) => {
            const keyActions = {
              ArrowLeft: () => moveTabFocus(focusIndex - 1),
              ArrowRight: () => moveTabFocus(focusIndex + 1),
              Home: () => moveTabFocus(0),
              End: () => moveTabFocus(tabs.length - 1),
              Enter: () => setActive(focusIndex),
              ' ': () => setActive(focusIndex),
            };

            const action = keyActions[event.key];
            if (!action) return;
            event.preventDefault();
            action();
          });
        });

        journey.addEventListener('click', (event) => {
          const trigger = event.target instanceof Element ? event.target.closest('[data-rq-journey-preview-trigger]') : null;
          if (!trigger || !journey.contains(trigger)) return;
          event.preventDefault();
          togglePreview(getPreviewTriggerMode(trigger));
        });

        journey.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !activePreviewMode) return;
          event.preventDefault();
          closePreview({ restoreFocus: true });
        });

        journey.addEventListener('click', (event) => {
          const eventTarget = event.target instanceof Element ? event.target : null;
          const link = eventTarget?.closest('[data-rq-journey-scroll]');
          if (!link || !journey.contains(link)) return;

          const hash = link.getAttribute('href') || '';
          if (!hash.startsWith('#')) return;

          const target = document.querySelector(hash);
          if (!target) return;

          event.preventDefault();
          closePreview();
          target.scrollIntoView({
            behavior: reducedMotionQuery?.matches ? 'auto' : 'smooth',
            block: 'start',
            inline: 'nearest',
          });
          window.requestAnimationFrame(() => focusScrollTarget(target));
        });

        const handleProblemChange = (event) => {
          if (activePreviewMode !== 'start') return;
          updateStartPreview(event.detail || {});
        };

        window.addEventListener('rq:problem-change', handleProblemChange);
        window.addEventListener('pagehide', () => {
          window.removeEventListener('rq:problem-change', handleProblemChange);
        }, { once: true });
      });
    };

    setupJourney();

    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    root.dataset.rqMotion = 'on';

    const revealItems = Array.from(document.querySelectorAll('[data-rq-reveal]'));

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-in'));
    }

    const supportsFinePointer = window.matchMedia?.('(pointer: fine)').matches;

    if (supportsFinePointer) {
      document.querySelectorAll('[data-rq-magnetic]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          const moveX = Math.max(-6, Math.min(6, x * 0.08));
          const moveY = Math.max(-6, Math.min(6, y * 0.08));
          item.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
        });

        item.addEventListener('pointerleave', () => {
          item.style.transform = '';
        });
      });
    }

    const marqueeRoots = Array.from(document.querySelectorAll('[data-rq-marquee]'));

    const createInViewGate = (target, { rootMargin = '120px 0px', threshold = 0, onEnter = () => {}, onExit = () => {} } = {}) => {
      let observer = null;
      let isIntersecting = false;
      let isActive = false;
      let destroyed = false;

      const enter = () => {
        if (destroyed || isActive) return;
        isActive = true;
        onEnter();
      };

      const exit = () => {
        if (destroyed || !isActive) return;
        isActive = false;
        onExit();
      };

      const sync = () => {
        if (document.hidden || !isIntersecting) {
          exit();
          return;
        }

        enter();
      };

      const handleVisibilityChange = () => {
        if (document.hidden) {
          exit();
          return;
        }

        if (isIntersecting) enter();
      };

      const cleanup = () => {
        observer?.disconnect();
        observer = null;
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        window.removeEventListener('pagehide', handlePageHide);
      };

      const handlePageHide = () => {
        onExit();
        isActive = false;
        destroyed = true;
        cleanup();
      };

      document.addEventListener('visibilitychange', handleVisibilityChange);
      window.addEventListener('pagehide', handlePageHide, { once: true });

      if (!('IntersectionObserver' in window)) {
        isIntersecting = true;
        if (!document.hidden) enter();

        return {
          destroy() {
            destroyed = true;
            cleanup();
          },
        };
      }

      observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        isIntersecting = Boolean(entry && entry.isIntersecting);
        sync();
      }, { rootMargin, threshold });

      observer.observe(target);

      return {
        destroy() {
          destroyed = true;
          cleanup();
        },
      };
    };

    marqueeRoots.forEach((marquee) => {
      const track = marquee.querySelector('[data-rq-marquee-track]');
      const group = marquee.querySelector('[data-rq-marquee-group]');
      if (!track || !group) return;

      const viewport = marquee.querySelector('.rq-marquee__viewport') || marquee;
      const SPEED_PX_PER_SECOND = 14;
      let x = 0;
      let frame = 0;
      let measureFrame = 0;
      let lastTime = 0;
      let groupWidth = 0;
      let isVisible = false;
      let isPaused = false;
      let isPointerPaused = false;
      let isFocusPaused = false;
      let resizeObserver = null;
      let marqueeGate = null;
      let usesWindowResize = false;

      const syncPaused = () => {
        isPaused = isPointerPaused || isFocusPaused;
      };

      const applyTransform = () => {
        track.style.transform = `translate3d(${-x}px, 0, 0)`;
      };

      const cloneGroup = () => {
        const clone = group.cloneNode(true);
        clone.removeAttribute('data-rq-marquee-group');
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('data-rq-marquee-clone', 'true');
        track.appendChild(clone);
      };

      const measure = () => {
        track.querySelectorAll('[data-rq-marquee-clone]').forEach((clone) => clone.remove());

        groupWidth = group.getBoundingClientRect().width;
        const viewportWidth = viewport.getBoundingClientRect().width;
        if (groupWidth <= 0 || viewportWidth <= 0) return;

        let cloneCount = 0;
        while (track.scrollWidth < viewportWidth + groupWidth && cloneCount < 16) {
          cloneGroup();
          cloneCount += 1;
        }

        x %= groupWidth;
        applyTransform();
      };

      const cancelMeasure = () => {
        if (measureFrame) cancelAnimationFrame(measureFrame);
        measureFrame = 0;
      };

      const scheduleMeasure = () => {
        if (!isVisible || document.hidden) return;
        cancelMeasure();
        measureFrame = requestAnimationFrame(() => {
          measureFrame = 0;
          if (!isVisible || document.hidden) return;
          measure();
        });
      };

      const tick = (now) => {
        if (!lastTime) lastTime = now;
        const dt = Math.min((now - lastTime) / 1000, 0.08);
        lastTime = now;

        if (!isPaused && groupWidth > 0) {
          x = (x + SPEED_PX_PER_SECOND * dt) % groupWidth;
          applyTransform();
        }

        frame = isVisible ? requestAnimationFrame(tick) : 0;
      };

      const start = () => {
        if (frame) return;
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        if (!frame) return;
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
      };

      const connectMeasurement = () => {
        if (resizeObserver || usesWindowResize) return;

        if ('ResizeObserver' in window) {
          resizeObserver = new ResizeObserver(scheduleMeasure);
          resizeObserver.observe(viewport);
          resizeObserver.observe(group);
        } else {
          usesWindowResize = true;
          window.addEventListener('resize', scheduleMeasure, { passive: true });
        }
      };

      const disconnectMeasurement = () => {
        cancelMeasure();
        resizeObserver?.disconnect();
        resizeObserver = null;
        if (usesWindowResize) {
          window.removeEventListener('resize', scheduleMeasure);
          usesWindowResize = false;
        }
      };

      const setMarqueeVisible = (nextVisible) => {
        if (isVisible === nextVisible) return;
        isVisible = nextVisible;

        if (isVisible) {
          connectMeasurement();
          scheduleMeasure();
          start();
          return;
        }

        stop();
        disconnectMeasurement();
      };

      marquee.addEventListener('pointerenter', () => {
        isPointerPaused = true;
        syncPaused();
      });

      marquee.addEventListener('pointerleave', () => {
        isPointerPaused = false;
        syncPaused();
      });

      marquee.addEventListener('focusin', () => {
        isFocusPaused = true;
        syncPaused();
      });

      marquee.addEventListener('focusout', () => {
        window.setTimeout(() => {
          if (!marquee.contains(document.activeElement)) {
            isFocusPaused = false;
            syncPaused();
          }
        }, 0);
      });

      marqueeGate = createInViewGate(marquee, {
        rootMargin: '120px 0px',
        threshold: 0,
        onEnter: () => setMarqueeVisible(true),
        onExit: () => setMarqueeVisible(false),
      });

      window.addEventListener('pagehide', () => {
        setMarqueeVisible(false);
        marqueeGate?.destroy();
        marqueeGate = null;
      }, { once: true });
    });

    const countItems = Array.from(document.querySelectorAll('[data-rq-count]'));

    const animateCount = (item) => {
      if (item.dataset.rqCountDone === 'true') return;
      item.dataset.rqCountDone = 'true';

      const targetRaw = item.getAttribute('data-rq-count') || '0';
      const target = Number(targetRaw.replace(',', '.'));
      if (!Number.isFinite(target)) return;

      const originalText = item.textContent || '';
      const suffix = originalText.replace(/^\s*[+-]?[\d\s.,]+/, '');
      const decimals = targetRaw.includes('.') || targetRaw.includes(',') ? targetRaw.split(/[.,]/)[1]?.length || 0 : 0;
      const duration = 900;
      const start = performance.now();

      const tick = (now) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        item.textContent = `${value.toFixed(decimals)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          item.textContent = `${target.toFixed(decimals)}${suffix}`;
        }
      };

      requestAnimationFrame(tick);
    };

    if (countItems.length) {
      if ('IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              animateCount(entry.target);
              countObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.3, rootMargin: '0px 0px -8% 0px' }
        );

        countItems.forEach((item) => countObserver.observe(item));
      } else {
        countItems.forEach(animateCount);
      }
    }
  })();
</script>
