---
interface Props {
  label?: string;
}

const { label = 'RadeQ.cz' } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoMask = `${basePath}/brand/radeq-logo-b-mask.png`;
---

<span
  class="radeq-brand-logo"
  role="img"
  aria-label={label}
  style={`--brand-logo-mask: url("${logoMask}")`}
></span>
