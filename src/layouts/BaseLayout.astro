---
import type { Locale } from '../data/locales';
import MeasurementTracker from '../components/MeasurementTracker';
import MotionOrchestrator from '../components/MotionOrchestrator';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  alternatePath?: string;
  alternateLang?: Locale;
  allowStoredStyle?: boolean;
}

const { title, description, lang, alternatePath, alternateLang, allowStoredStyle = false } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternatePath ? new URL(`${basePath}${alternatePath}`, siteUrl).toString() : undefined;
const lightFavicon = `${basePath}/brand/radeq-favicon-b-light.png`;
const darkFavicon = `${basePath}/brand/radeq-favicon-b-dark.png`;
---

<!doctype html>
<html lang={lang} data-style="variant-a" data-theme="light" data-style-source={allowStoredStyle ? 'stored' : 'fixed'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePath && alternateLang && alternateUrl ? <link rel="alternate" hreflang={alternateLang} href={alternateUrl} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={lightFavicon} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={darkFavicon} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={lightFavicon} data-theme-favicon-active data-light-href={lightFavicon} data-dark-href={darkFavicon} />
    <title>{title}</title>
    <script is:inline define:vars={{ lightFavicon, darkFavicon }}>
      (() => {
        const root = document.documentElement;
        const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
        const setActiveFavicon = (theme) => {
          const active = document.querySelector('link[data-theme-favicon-active]');
          active?.setAttribute('href', theme === 'dark' ? darkFavicon : lightFavicon);
        };

        try {
          const stored = localStorage.getItem('radeq-theme-mode');
          root.dataset.theme = stored === 'dark' || stored === 'light' ? stored : (systemDark ? 'dark' : 'light');
        } catch {
          root.dataset.theme = systemDark ? 'dark' : 'light';
        }
        setActiveFavicon(root.dataset.theme);

        const styleSource = root.dataset.styleSource;
        if (styleSource === 'stored') {
          try {
            const storedStyle = localStorage.getItem('radeq-style-variant');
            const allowedStyles = ['variant-a', 'variant-b', 'variant-c', 'variant-d'];
            root.dataset.style = allowedStyles.includes(storedStyle) ? storedStyle : 'variant-a';
          } catch {
            root.dataset.style = 'variant-a';
          }
        } else {
          root.dataset.style = 'variant-a';
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <MeasurementTracker client:load />
    <MotionOrchestrator client:load />
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
