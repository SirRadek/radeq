---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['demos'];
}

const { content } = Astro.props;
---

<section class="demo-section" id="demos" aria-labelledby="demo-title">
  <div class="section-heading">
    {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
    <h2 id="demo-title">{content.title}</h2>
    <p>{content.lead}</p>
  </div>
  <div class="demo-grid">
    {
      content.items.map((demo, index) => (
        <article class="demo-card" data-cat-platform={`demo-card-${index + 1}`}>
          {demo.metric && <div class="card-kicker">{demo.metric}</div>}
          <h3>{demo.name}</h3>
          <p>{demo.summary}</p>
          <ol>
            {demo.events.map((event) => (
              <li>{event}</li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</section>
