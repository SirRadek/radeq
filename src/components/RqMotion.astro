<script is:inline>
  (() => {
    if (window.__rqMotionIsland) return;
    window.__rqMotionIsland = true;

    const root = document.documentElement;

    const setupJourney = () => {
      const roots = Array.from(document.querySelectorAll('[data-rq-journey]'));
      const reducedMotionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');

      roots.forEach((journey) => {
        const steps = Array.from(journey.querySelectorAll('[data-rq-journey-step]'));
        const nodes = Array.from(journey.querySelectorAll('[data-rq-journey-node]'));
        if (!steps.length) return;

        const mobileQuery = window.matchMedia?.('(max-width: 760px)');
        const hoverQuery = window.matchMedia?.('(hover: hover) and (pointer: fine)');
        const initialIndex = Math.max(
          0,
          steps.findIndex((step) => step.open || step.classList.contains('is-active'))
        );
        let activeIndex = initialIndex;
        let lockedIndex = initialIndex;
        let focusIndex = initialIndex;
        let isSyncing = false;
        let syncTimer = 0;

        const isMobile = () => Boolean(mobileQuery?.matches);
        const canHover = () => Boolean(hoverQuery?.matches);
        const getNodeIndex = (node) => Number(node.getAttribute('data-rq-target-index') || '0');

        const syncNodes = () => {
          nodes.forEach((node) => {
            const nodeIndex = getNodeIndex(node);
            const isActive = nodeIndex === activeIndex;

            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-expanded', isActive ? 'true' : 'false');
            node.tabIndex = nodeIndex === focusIndex ? 0 : -1;

            if (isActive) {
              node.setAttribute('aria-current', 'step');
            } else {
              node.removeAttribute('aria-current');
            }
          });
        };

        const scrollPanelIntoView = (index) => {
          const panel = steps[index]?.querySelector('[data-rq-journey-panel]');
          if (!panel) return;

          window.requestAnimationFrame(() => {
            panel.scrollIntoView({
              behavior: reducedMotionQuery?.matches ? 'auto' : 'smooth',
              block: 'nearest',
              inline: 'nearest',
            });
          });
        };

        const setActive = (index, options = {}) => {
          if (!steps[index]) return;
          if (syncTimer) window.clearTimeout(syncTimer);

          activeIndex = index;
          if (options.lock) lockedIndex = index;
          if (!options.preserveFocus) focusIndex = index;
          isSyncing = true;

          steps.forEach((step, stepIndex) => {
            const isActive = stepIndex === index;
            const summary = step.querySelector('[data-rq-journey-summary]');

            step.classList.toggle('is-active', isActive);
            step.open = isActive;

            if (!summary) return;
            summary.setAttribute('aria-expanded', isActive ? 'true' : 'false');
            if (isActive) {
              summary.setAttribute('aria-current', 'step');
            } else {
              summary.removeAttribute('aria-current');
            }
          });

          syncNodes();

          syncTimer = window.setTimeout(() => {
            isSyncing = false;
            syncTimer = 0;
          }, 0);

          if (options.scroll) scrollPanelIntoView(index);
        };

        const moveNodeFocus = (index) => {
          if (!nodes.length) return;
          focusIndex = (index + nodes.length) % nodes.length;
          syncNodes();
          nodes[focusIndex]?.focus();
        };

        journey.classList.add('is-enhanced');
        setActive(initialIndex, { lock: true });

        steps.forEach((step, index) => {
          const summary = step.querySelector('[data-rq-journey-summary]');
          if (!summary) return;

          summary.addEventListener('click', (event) => {
            event.preventDefault();
            setActive(index, { lock: true });
          });

          step.addEventListener('toggle', () => {
            if (isSyncing) return;
            if (step.open) {
              setActive(index, { lock: true });
            } else if (activeIndex === index) {
              step.open = true;
            }
          });

          summary.addEventListener('pointerenter', () => {
            if (!isMobile() && canHover()) setActive(index);
          });

          summary.addEventListener('focusin', () => {
            setActive(index);
          });
        });

        nodes.forEach((node) => {
          const nodeIndex = getNodeIndex(node);

          node.addEventListener('click', () => {
            setActive(nodeIndex, { lock: true, scroll: true });
          });

          node.addEventListener('focus', () => {
            focusIndex = nodeIndex;
            syncNodes();
          });

          node.addEventListener('keydown', (event) => {
            const keyActions = {
              ArrowLeft: () => moveNodeFocus(focusIndex - 1),
              ArrowUp: () => moveNodeFocus(focusIndex - 1),
              ArrowRight: () => moveNodeFocus(focusIndex + 1),
              ArrowDown: () => moveNodeFocus(focusIndex + 1),
              Home: () => moveNodeFocus(0),
              End: () => moveNodeFocus(nodes.length - 1),
              Enter: () => setActive(focusIndex, { lock: true, scroll: true }),
              ' ': () => setActive(focusIndex, { lock: true, scroll: true }),
            };

            const action = keyActions[event.key];
            if (!action) return;
            event.preventDefault();
            action();
          });
        });

        journey.addEventListener('pointerleave', () => {
          if (!isMobile() && canHover()) setActive(lockedIndex);
        });

        journey.addEventListener('focusout', () => {
          window.setTimeout(() => {
            if (!journey.contains(document.activeElement)) setActive(lockedIndex);
          }, 0);
        });

        mobileQuery?.addEventListener?.('change', () => {
          setActive(lockedIndex, { lock: true });
        });
      });
    };

    setupJourney();

    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    root.dataset.rqMotion = 'on';

    const revealItems = Array.from(document.querySelectorAll('[data-rq-reveal]'));

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-in'));
    }

    const supportsFinePointer = window.matchMedia?.('(pointer: fine)').matches;

    if (supportsFinePointer) {
      document.querySelectorAll('[data-rq-magnetic]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          const moveX = Math.max(-6, Math.min(6, x * 0.08));
          const moveY = Math.max(-6, Math.min(6, y * 0.08));
          item.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
        });

        item.addEventListener('pointerleave', () => {
          item.style.transform = '';
        });
      });
    }

    const marqueeRoots = Array.from(document.querySelectorAll('[data-rq-marquee]'));

    marqueeRoots.forEach((marquee) => {
      const track = marquee.querySelector('[data-rq-marquee-track]');
      const group = marquee.querySelector('[data-rq-marquee-group]');
      if (!track || !group) return;

      let x = 0;
      let frame = 0;
      let isVisible = false;
      let currentSpeed = 0.42;
      let targetSpeed = 0.42;

      const getGroupWidth = () => group.getBoundingClientRect().width;

      const tick = () => {
        const width = getGroupWidth();

        if (width > 0) {
          currentSpeed += (targetSpeed - currentSpeed) * 0.08;
          x = (x + currentSpeed) % width;
          track.style.transform = `translate3d(${-x}px, 0, 0)`;
        }

        frame = isVisible ? requestAnimationFrame(tick) : 0;
      };

      const start = () => {
        if (frame) return;
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        if (!frame) return;
        cancelAnimationFrame(frame);
        frame = 0;
      };

      marquee.addEventListener('mouseenter', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('mouseleave', () => {
        targetSpeed = 0.42;
      });

      marquee.addEventListener('focusin', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('focusout', () => {
        targetSpeed = 0.42;
      });

      window.addEventListener('resize', () => {
        const width = getGroupWidth();
        if (width > 0) {
          x %= width;
        }
      });

      if ('IntersectionObserver' in window) {
        const marqueeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible) {
                start();
              } else {
                stop();
              }
            });
          },
          { threshold: 0, rootMargin: '120px 0px' }
        );

        marqueeObserver.observe(marquee);
      } else {
        isVisible = true;
        start();
      }
    });

    const countItems = Array.from(document.querySelectorAll('[data-rq-count]'));

    const animateCount = (item) => {
      if (item.dataset.rqCountDone === 'true') return;
      item.dataset.rqCountDone = 'true';

      const targetRaw = item.getAttribute('data-rq-count') || '0';
      const target = Number(targetRaw.replace(',', '.'));
      if (!Number.isFinite(target)) return;

      const originalText = item.textContent || '';
      const suffix = originalText.replace(/^\s*[+-]?[\d\s.,]+/, '');
      const decimals = targetRaw.includes('.') || targetRaw.includes(',') ? targetRaw.split(/[.,]/)[1]?.length || 0 : 0;
      const duration = 900;
      const start = performance.now();

      const tick = (now) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        item.textContent = `${value.toFixed(decimals)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          item.textContent = `${target.toFixed(decimals)}${suffix}`;
        }
      };

      requestAnimationFrame(tick);
    };

    if (countItems.length) {
      if ('IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              animateCount(entry.target);
              countObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.3, rootMargin: '0px 0px -8% 0px' }
        );

        countItems.forEach((item) => countObserver.observe(item));
      } else {
        countItems.forEach(animateCount);
      }
    }
  })();
</script>
