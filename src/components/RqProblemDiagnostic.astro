---
import { homeContent, type HomeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
  content?: HomeContent['problems'];
  lang?: Locale;
}

const { content = homeContent.cs.problems, lang = 'cs' } = Astro.props;
const items = content.items;
const stars = Array.from({ length: 5 });
---

<section class="rq-section rq-problem-diagnostic" id="co-resim" aria-labelledby="rq-problem-diagnostic-title" data-rq-problem-diagnostic data-rq-active-index="0" data-rq-locale={lang}>
  <span class="rq-problem-diagnostic__alias" id="diagnostika" aria-hidden="true"></span>
  <div class="rq-problem-diagnostic__inner">
    <header class="rq-problem-diagnostic__head" data-rq-reveal>
      <div class="rq-problem-diagnostic__copy">
        <p class="rq-eyebrow">{content.eyebrow}</p>
        <h2 class="rq-h2 rq-h2--feature rq-problem-diagnostic__title" id="rq-problem-diagnostic-title">{content.title}</h2>
        <p class="rq-problem-diagnostic__lead">{content.lead}</p>
      </div>
    </header>

    <div class="rq-problem-diagnostic__shell" data-rq-reveal>
      <div class="rq-problem-diagnostic__meta-row">
        <p class="rq-problem-diagnostic__severity-legend" id="rq-problem-severity-legend">
          <strong>{content.severityLegend.strong}</strong> {content.severityLegend.text}
        </p>
      </div>

      <div class="rq-problem-diagnostic__board">
        <div class="rq-problem-diagnostic__stage" aria-label={content.controlsAriaLabel}>
          <button class="rq-problem-diagnostic__nav rq-problem-diagnostic__nav--prev" type="button" aria-label={content.previousLabel} data-rq-problem-prev disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M15 5 8 12l7 7"></path>
            </svg>
          </button>

          <div class="rq-problem-diagnostic__carousel-scene" data-rq-problem-carousel aria-describedby="rq-problem-severity-legend">
        <ul class="rq-problem-diagnostic__filmstrip" role="tablist" aria-label={content.carouselAriaLabel}>
          {items.map((item, index) => (
            <li class:list={['rq-problem-diagnostic__frame', item.role === 'lead' && 'rq-problem-diagnostic__frame--lead']} role="presentation">
              <button
                class:list={[
                  'rq-problem-diagnostic__card',
                  item.role === 'lead' && 'rq-problem-diagnostic__card--lead',
                ]}
                id={`rq-problem-card-${item.id}`}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`rq-problem-panel-${item.id}`}
                tabindex={index === 0 ? '0' : '-1'}
                data-rq-problem-card
                data-rq-problem-genre={item.genreKey}
                style={`--rq-problem-genre-color: ${item.genreColor};`}
              >
                <span class="rq-problem-diagnostic__card-inner">
                  <span class="rq-problem-diagnostic__poster-meta">
                    <span class="rq-problem-diagnostic__genre">{item.genre}</span>
                  </span>
                  <span class="rq-problem-diagnostic__poster-title">{item.symptom}</span>
                  <span class="rq-problem-diagnostic__severity">
                    <span class="rq-sr-only">{content.severitySrPrefix} {item.severity} {content.severitySrSuffix}</span>
                    <span class="rq-problem-diagnostic__stars" aria-hidden="true">
                      {stars.map((_, starIndex) => (
                        <span class:list={['rq-problem-diagnostic__star', starIndex < item.severity && 'is-active']}>★</span>
                      ))}
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
          </div>

          <button class="rq-problem-diagnostic__nav rq-problem-diagnostic__nav--next" type="button" aria-label={content.nextLabel} data-rq-problem-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>

      <p class="rq-problem-diagnostic__tagline" id="rq-problem-carousel-tagline">{content.tagline}</p>

      <div class="rq-problem-diagnostic__output" aria-live="off" data-rq-problem-output>
        {items.map((item, index) => (
          <article
            class:list={[
              'rq-problem-diagnostic__panel',
              index === 0 && 'is-active',
            ]}
            id={`rq-problem-panel-${item.id}`}
            role="tabpanel"
            tabindex={index === 0 ? '0' : '-1'}
            aria-labelledby={`rq-problem-card-${item.id}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index !== 0 ? true : undefined}
            data-rq-problem-panel
            data-rq-problem-mini-title={item.symptom}
            data-rq-problem-mini-problem={item.problem}
            data-rq-problem-mini-step={item.step}
          >
            <div class="rq-problem-diagnostic__panel-top">
              <span class="rq-problem-diagnostic__solution-label">{content.solutionLabel}</span>
            </div>
            <h3>{item.symptom}</h3>
            <dl class="rq-problem-diagnostic__findings">
              <div>
                <dt>{content.findingLabels.problem}</dt>
                <dd>{item.problem}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.cause}</dt>
                <dd>{item.cause}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.verify}</dt>
                <dd>{item.verify}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.step}</dt>
                <dd>{item.step}</dd>
              </div>
            </dl>
            <div class="rq-problem-diagnostic__actions">
              <a class="rq-btn rq-btn--primary" href="#kontakt">{content.ctaLabel}</a>
              <a
                class="rq-problem-diagnostic__service"
                href={`#service-${item.primaryServiceId}`}
                data-rq-primary-service-target={item.primaryServiceId}
                data-rq-related-service-target={item.relatedServiceIds[0]}
              >
                {content.servicePrefix} <strong>{item.service}</strong>
              </a>
            </div>
          </article>
        ))}
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap');

  .rq-problem-diagnostic {
    --rq-diagnostic-velvet: #3A0F16;
    --rq-diagnostic-burgundy: #5E1926;
    --rq-diagnostic-chamber: #220F13;
    --rq-diagnostic-cherry-glass: #2D0D13;
    --rq-diagnostic-accent: #E5C453;
    --rq-diagnostic-accent-ink: #2A1705;
    --rq-diagnostic-accent-soft: rgba(229, 196, 83, 0.18);
    --rq-cinema-display: 'Oswald', 'Barlow Condensed', system-ui, sans-serif;
    position: relative;
    isolation: isolate;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow-x: clip;
    background:
      radial-gradient(120% 96% at 50% 48%, transparent 54%, rgba(10, 2, 5, 0.56) 100%),
      radial-gradient(90% 70% at 50% 12%, rgba(94, 25, 38, 0.42), transparent 66%),
      linear-gradient(180deg, rgba(58, 15, 22, 0.85), rgba(26, 6, 10, 0.95)),
      linear-gradient(135deg, var(--rq-diagnostic-velvet) 0%, var(--rq-diagnostic-burgundy) 46%, var(--rq-diagnostic-chamber) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 42px 84px rgba(34, 15, 19, 0.28),
      inset 0 -80px 120px rgba(10, 2, 5, 0.42);
    color: var(--rq-on-dark);
  }

  @supports not (overflow: clip) {
    .rq-problem-diagnostic {
      overflow-x: hidden;
    }
  }

  .rq-problem-diagnostic::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.9'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    opacity: 0.015;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .rq-problem-diagnostic__alias {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .rq-problem-diagnostic__inner {
    position: relative;
    z-index: 1;
    width: var(--rq-page-w-wide);
    max-width: var(--rq-page-w-wide);
    margin-inline: auto;
  }

  .rq-problem-diagnostic__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 4vw, 3.2rem);
  }

  .rq-problem-diagnostic .rq-eyebrow,
  .rq-problem-diagnostic__lead,
  .rq-problem-diagnostic__severity-legend,
  .rq-problem-diagnostic__tagline {
    color: var(--rq-on-dark-2);
  }

  .rq-problem-diagnostic__title {
    max-width: 18ch;
    color: var(--rq-on-dark);
  }

  .rq-problem-diagnostic__title::after {
    background: color-mix(in srgb, var(--rq-diagnostic-accent) 72%, transparent);
    opacity: 0.72;
  }

  .rq-problem-diagnostic__lead {
    max-width: 58ch;
    margin-top: 1rem;
    line-height: 1.65;
  }

  .rq-problem-diagnostic__solution-label,
  .rq-problem-diagnostic__severity-legend strong {
    font-family: var(--rq-mono), ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rq-problem-diagnostic__shell {
    --rq-card-w: clamp(12.5rem, 20vw, 17rem);
    --rq-card-w-lead: clamp(13rem, 21vw, 17rem);
    --rq-card-h: clamp(12.75rem, 17vw, 15.5rem);
    --rq-card-h-lead: clamp(13rem, 18vw, 16rem);
    --rq-jaw-min-block-size: clamp(26rem, 32vw, 32rem);
    --rq-problem-ease-out-back: cubic-bezier(0.18, 1.22, 0.28, 1);
    position: relative;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.6rem);
    min-width: 0;
  }

  .rq-problem-diagnostic__meta-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .rq-problem-diagnostic__severity-legend {
    max-width: 62ch;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .rq-problem-diagnostic__severity-legend strong {
    color: var(--rq-diagnostic-accent);
  }

  .rq-problem-diagnostic__board {
    position: relative;
    display: grid;
    gap: clamp(0.7rem, 1.4vw, 1rem);
    min-width: 0;
    border: 1px solid rgba(247, 244, 238, 0.16);
    border-radius: 8px;
    padding: clamp(0.85rem, 2vw, 1.35rem);
    overflow: clip;
    isolation: isolate;
    background:
      linear-gradient(180deg, rgba(247, 244, 238, 0.075), transparent 42%),
      linear-gradient(135deg, rgba(94, 25, 38, 0.68), rgba(58, 15, 22, 0.76) 48%, rgba(34, 15, 19, 0.88));
    box-shadow:
      0 36px 90px rgba(34, 15, 19, 0.48),
      0 14px 46px rgba(94, 25, 38, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      inset 0 0 0 1px color-mix(in srgb, var(--rq-diagnostic-accent) 4%, transparent);
  }

  @supports not (overflow: clip) {
    .rq-problem-diagnostic__board {
      overflow: hidden;
    }
  }

  .rq-problem-diagnostic__board::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--rq-diagnostic-accent) 5%, transparent), transparent 1px),
      linear-gradient(180deg, rgba(247, 244, 238, 0.05), transparent 1px);
    background-size: 4.5rem 4.5rem;
    opacity: 0.22;
    pointer-events: none;
  }

  .rq-problem-diagnostic__stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.9rem minmax(0, 1fr) 2.9rem;
    align-items: center;
    gap: clamp(0.45rem, 1.1vw, 0.75rem);
    min-width: 0;
  }

  .rq-problem-diagnostic__nav {
    display: inline-grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 34%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--rq-diagnostic-accent);
    cursor: pointer;
    box-shadow: none;
    transition: border-color 180ms var(--rq-ease), background-color 180ms var(--rq-ease), color 180ms var(--rq-ease), opacity 180ms var(--rq-ease), transform 180ms var(--rq-ease), box-shadow 180ms var(--rq-ease);
  }

  .rq-problem-diagnostic__nav svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
    filter: drop-shadow(0 1px 2px rgba(34, 15, 19, 0.72));
  }

  .rq-problem-diagnostic__nav:hover,
  .rq-problem-diagnostic__nav:focus-visible {
    border-color: color-mix(in srgb, var(--rq-diagnostic-accent) 78%, transparent);
    outline: 0;
    background-color: rgba(247, 244, 238, 0.07);
    color: var(--rq-diagnostic-accent);
    transform: translateY(-1px);
    box-shadow: 0 0 24px color-mix(in srgb, var(--rq-diagnostic-accent) 16%, transparent);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }

  .rq-problem-diagnostic__nav:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--rq-diagnostic-accent) 82%, transparent);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px rgba(13, 11, 12, 0.42), 0 0 24px var(--rq-diagnostic-accent-soft);
  }

  .rq-problem-diagnostic__nav:disabled {
    cursor: default;
    opacity: 0.42;
    border-color: color-mix(in srgb, var(--rq-diagnostic-accent) 24%, transparent);
    background: transparent;
    box-shadow: none;
    transform: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .rq-problem-diagnostic__carousel-scene {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: 0.9rem 0.75rem;
    perspective: 1160px;
    perspective-origin: center;
    scroll-padding-inline: max(1rem, calc((100% - var(--rq-card-w)) / 2));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rq-problem-diagnostic__carousel-scene::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rq-problem-diagnostic__filmstrip {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 1.3vw, 0.95rem);
    min-width: max-content;
    margin: 0;
    padding: 0 max(1rem, calc((100% - var(--rq-card-w)) / 2));
    list-style: none;
    transform-style: preserve-3d;
  }

  .rq-problem-diagnostic__frame {
    flex: 0 0 var(--rq-card-w);
    min-width: 0;
    scroll-snap-align: center;
  }

  .rq-problem-diagnostic__frame--lead {
    flex-basis: var(--rq-card-w-lead);
  }

  .rq-problem-diagnostic__card {
    --rq-card-rotate: 0deg;
    --rq-card-lift: 0.45rem;
    --rq-card-depth: -96px;
    --rq-card-scale: 0.84;
    --rq-card-opacity: 0.2;
    --rq-card-saturate: 0.58;
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    isolation: isolate;
    opacity: var(--rq-card-opacity);
    filter: saturate(var(--rq-card-saturate));
    transform: translate3d(0, var(--rq-card-lift), var(--rq-card-depth)) rotateY(var(--rq-card-rotate)) scale(var(--rq-card-scale));
    transform-style: preserve-3d;
    scroll-snap-align: center;
    transition: opacity 240ms var(--rq-ease), filter 240ms var(--rq-ease), transform 480ms var(--rq-problem-ease-out-back);
  }

  .rq-problem-diagnostic__card[data-rq-problem-distance='hidden'] {
    pointer-events: none;
  }

  .rq-problem-diagnostic__card::before,
  .rq-problem-diagnostic__card::after {
    content: "";
    position: absolute;
    inset: 10% 4% -6%;
    border-radius: 14px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--rq-ease);
  }

  .rq-problem-diagnostic__card::before {
    z-index: 0;
    background: radial-gradient(circle at 50% 48%, var(--rq-diagnostic-accent-soft), color-mix(in srgb, var(--rq-diagnostic-accent) 8%, transparent) 42%, transparent 72%);
    filter: blur(32px);
    transform: translateY(0.8rem);
  }

  .rq-problem-diagnostic__card::after {
    z-index: 2;
    border: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 18%, transparent);
  }

  .rq-problem-diagnostic__card-inner {
    position: relative;
    z-index: 1;
    display: grid;
    min-block-size: var(--rq-card-h);
    grid-template-rows: auto minmax(4.8rem, 1fr) auto;
    gap: 0.75rem;
    border: 1px solid rgba(247, 244, 238, 0.18);
    border-radius: 8px;
    padding: clamp(0.85rem, 1.45vw, 1.08rem);
    overflow: hidden;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(94, 25, 38, 0.24) 40%, rgba(26, 6, 10, 0.85));
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    backface-visibility: hidden;
    box-shadow:
      0 34px 72px rgba(34, 15, 19, 0.42),
      0 12px 26px rgba(58, 15, 22, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateZ(0);
    transform-style: preserve-3d;
    transition: border-color 220ms var(--rq-ease), opacity 220ms var(--rq-ease), transform 260ms var(--rq-ease);
  }

  .rq-problem-diagnostic__card-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--rq-diagnostic-accent) 12%, transparent), transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.09), transparent 34%);
    opacity: 0.38;
    pointer-events: none;
  }

  .rq-problem-diagnostic__card[data-rq-problem-distance='near']:not([aria-selected='true']) .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card[data-rq-problem-distance='far']:not([aria-selected='true']) .rq-problem-diagnostic__card-inner {
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(94, 25, 38, 0.28) 38%, rgba(45, 13, 19, 0.84)),
      var(--rq-diagnostic-cherry-glass);
    border-color: rgba(247, 244, 238, 0.15);
  }

  .rq-problem-diagnostic__card--lead .rq-problem-diagnostic__card-inner {
    min-block-size: var(--rq-card-h-lead);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] {
    --rq-card-lift: -0.25rem;
    --rq-card-depth: 42px;
    --rq-card-rotate: 0deg;
    --rq-card-scale: 1;
    --rq-card-opacity: 1;
    --rq-card-saturate: 1.08;
    z-index: 3;
  }

  .rq-problem-diagnostic__card:hover:not([aria-selected='true'])::before,
  .rq-problem-diagnostic__card:focus-visible:not([aria-selected='true'])::before {
    opacity: 0.42;
  }

  .rq-problem-diagnostic__card:hover::after,
  .rq-problem-diagnostic__card:focus-visible::after {
    opacity: 0.78;
  }

  .rq-problem-diagnostic__card[aria-selected='true']::before,
  .rq-problem-diagnostic__card[aria-selected='true']::after {
    opacity: 1;
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__card-inner {
    border-color: color-mix(in srgb, var(--rq-diagnostic-accent) 38%, transparent);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(122, 31, 43, 0.32) 40%, rgba(34, 15, 19, 0.9));
    box-shadow:
      0 44px 100px rgba(34, 15, 19, 0.54),
      0 22px 68px rgba(122, 31, 43, 0.26),
      0 0 0 1px color-mix(in srgb, var(--rq-diagnostic-accent) 18%, transparent),
      0 0 42px color-mix(in srgb, var(--rq-diagnostic-accent) 14%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    transform: translateZ(22px);
  }

  .rq-problem-diagnostic__card:hover,
  .rq-problem-diagnostic__card:focus-visible {
    --rq-card-lift: -0.3rem;
    --rq-card-depth: 28px;
    --rq-card-rotate: 0deg;
    --rq-card-scale: 1;
    --rq-card-opacity: 0.96;
    --rq-card-saturate: 1;
    z-index: 4;
    outline: 0;
  }

  .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    border-color: color-mix(in srgb, var(--rq-diagnostic-accent) 78%, transparent);
    transform: translateZ(18px);
  }

  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    box-shadow:
      0 44px 100px rgba(34, 15, 19, 0.54),
      0 22px 68px rgba(122, 31, 43, 0.26),
      0 0 0 3px color-mix(in srgb, var(--rq-diagnostic-accent) 34%, transparent),
      0 0 42px color-mix(in srgb, var(--rq-diagnostic-accent) 14%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__poster-title {
    color: var(--rq-diagnostic-accent);
    text-shadow: 0 0 16px color-mix(in srgb, var(--rq-diagnostic-accent) 26%, transparent);
  }

  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:hover) .rq-problem-diagnostic__card:not(:hover):not([aria-selected='true']),
  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:focus-visible) .rq-problem-diagnostic__card:not(:focus-visible):not([aria-selected='true']) {
    opacity: 0.38;
  }

  .rq-problem-diagnostic.is-scrolling .rq-problem-diagnostic__card-inner {
    will-change: transform;
  }

  .rq-problem-diagnostic.is-scrolling .rq-problem-diagnostic__card {
    will-change: transform, opacity;
  }

