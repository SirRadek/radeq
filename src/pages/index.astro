---
import CommandHeader from '../components/CommandHeader.astro';
import ContactTerminal from '../components/ContactTerminal';
import CatGuide from '../components/CatGuide.astro';
import DemoWorlds from '../components/DemoWorlds.astro';
import HandoffStandard from '../components/HandoffStandard.astro';
import HeroSection from '../components/HeroSection.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import StudioProof from '../components/StudioProof.astro';
import { siteContent } from '../data/siteContent';
import BaseLayout from '../layouts/BaseLayout.astro';

const content = siteContent.cs;
---

<BaseLayout
  title={content.layout.title}
  description={content.layout.description}
  lang={content.layout.lang}
  alternatePath={content.layout.alternatePath}
  alternateLang="en"
>
  <CommandHeader
    content={content.header}
    alternatePath={content.layout.alternatePath}
    alternateLabel={content.layout.alternateLabel}
    locale={content.layout.lang}
  />
  <main>
    <div class="proposal-stage" id="services">
      <HeroSection content={content.hero} />
      <ServiceCatalog locale={content.layout.lang} content={content.systems} />
      <CatGuide locale={content.layout.lang} hero={content.hero} systems={content.systems} />
      <StudioProof locale={content.layout.lang} systems={content.systems} />
      <DemoWorlds locale={content.layout.lang} systems={content.systems} />
    </div>
    <HandoffStandard content={content.handoff} />
    <ContactTerminal locale={content.layout.lang} content={content.terminal} client:load />
  </main>
</BaseLayout>
