    background-repeat: no-repeat;
    background-size: 100% 100%;
    mix-blend-mode: screen;
    opacity: var(--rq-poster-dot-opacity);
    pointer-events: none;
  }

  .rq-problem-diagnostic__card-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background:
      repeating-linear-gradient(0deg, transparent 0 0.42rem, rgba(247, 244, 238, var(--rq-poster-perf-opacity)) 0.42rem 0.68rem, transparent 0.68rem 1.08rem),
      repeating-linear-gradient(0deg, transparent 0 0.42rem, rgba(247, 244, 238, var(--rq-poster-perf-opacity)) 0.42rem 0.68rem, transparent 0.68rem 1.08rem),
      linear-gradient(180deg, rgba(13, 4, 8, 0.12), rgba(13, 4, 8, 0.58));
    background-position:
      0.42rem var(--rq-poster-perf-offset),
      calc(100% - 0.76rem) calc(0px - var(--rq-poster-perf-offset)),
      0 0;
    background-repeat: repeat-y, repeat-y, no-repeat;
    background-size: 0.34rem 1.08rem, 0.34rem 1.08rem, 100% 100%;
    box-shadow:
      inset 0.75rem 0 0 rgba(10, 2, 5, 0.14),
      inset -0.75rem 0 0 rgba(10, 2, 5, 0.14);
    opacity: 0.78;
    pointer-events: none;
  }

  .rq-problem-diagnostic__card[data-rq-problem-distance='near']:not([data-rq-problem-active='true']) .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card[data-rq-problem-distance='far']:not([data-rq-problem-active='true']) .rq-problem-diagnostic__card-inner {
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(94, 25, 38, 0.28) 38%, rgba(45, 13, 19, 0.84)),
      var(--rq-diagnostic-cherry-glass);
  }

  .rq-problem-diagnostic__card--lead .rq-problem-diagnostic__card-inner {
    min-block-size: var(--rq-card-h-lead);
  }

  .rq-problem-diagnostic__card[aria-selected='true'],
  .rq-problem-diagnostic__card[data-rq-problem-active='true'] {
    --rq-card-lift: -0.25rem;
    --rq-card-depth: 42px;
    --rq-card-rotate: 0deg;
    --rq-card-scale: 1;
    --rq-card-opacity: 1;
    --rq-card-saturate: 1.08;
    --rq-poster-dot-opacity: 0.44;
    z-index: 3;
  }

  .rq-problem-diagnostic__card:hover:not([data-rq-problem-active='true'])::before,
  .rq-problem-diagnostic__card:focus-visible:not([data-rq-problem-active='true'])::before {
    opacity: 0.42;
  }

  .rq-problem-diagnostic__card:hover::after,
  .rq-problem-diagnostic__card:focus-visible::after {
    opacity: 0.78;
  }

  .rq-problem-diagnostic__card[aria-selected='true']::before,
  .rq-problem-diagnostic__card[aria-selected='true']::after,
  .rq-problem-diagnostic__card[data-rq-problem-active='true']::before,
  .rq-problem-diagnostic__card[data-rq-problem-active='true']::after {
    opacity: 1;
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card[data-rq-problem-active='true'] .rq-problem-diagnostic__card-inner {
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(122, 31, 43, 0.32) 40%, rgba(34, 15, 19, 0.9));
    box-shadow:
      0 44px 100px rgba(34, 15, 19, 0.54),
      0 22px 68px rgba(122, 31, 43, 0.26),
      0 0 42px color-mix(in srgb, var(--rq-diagnostic-accent) 14%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    transform: translateZ(22px);
  }

  .rq-problem-diagnostic__card:hover,
  .rq-problem-diagnostic__card:focus-visible {
    --rq-card-lift: -0.3rem;
    --rq-card-depth: 28px;
    --rq-card-rotate: 0deg;
    --rq-card-scale: 1;
    --rq-card-opacity: 0.96;
    --rq-card-saturate: 1;
    z-index: 4;
    outline: 0;
  }

  .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    transform: translateZ(18px);
  }

  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    box-shadow:
      0 44px 100px rgba(34, 15, 19, 0.54),
      0 22px 68px rgba(122, 31, 43, 0.26),
      0 0 0 3px color-mix(in srgb, var(--rq-diagnostic-accent) 34%, transparent),
      0 0 42px color-mix(in srgb, var(--rq-diagnostic-accent) 14%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__poster-title,
  .rq-problem-diagnostic__card[data-rq-problem-active='true'] .rq-problem-diagnostic__poster-title {
    color: var(--rq-diagnostic-accent);
    text-shadow: 0 0 16px color-mix(in srgb, var(--rq-diagnostic-accent) 26%, transparent);
  }

  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:hover) .rq-problem-diagnostic__card:not(:hover):not([data-rq-problem-active='true']),
  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:focus-visible) .rq-problem-diagnostic__card:not(:focus-visible):not([data-rq-problem-active='true']) {
