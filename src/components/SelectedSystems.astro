---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['systems'];
}

const { content } = Astro.props;
---

<section class="systems-section" aria-labelledby="systems-title">
  <div class="section-heading">
    {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
    <h2 id="systems-title">{content.title}</h2>
  </div>
  <div class="systems-grid">
    {
      content.items.map((item, index) => (
        <article data-cat-platform={`system-card-${index + 1}`}>
          <p>{item.fit}</p>
          <h3>{item.title}</h3>
          <span>{item.text}</span>
        </article>
      ))
    }
  </div>
</section>
