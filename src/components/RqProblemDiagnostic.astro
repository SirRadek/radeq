  }

  .rq-problem-diagnostic__finding--plot {
    border-color: color-mix(in srgb, var(--rq-diagnostic-accent) 48%, rgba(100, 73, 33, 0.24));
    background:
      linear-gradient(180deg, rgba(255, 249, 233, 0.96), rgba(247, 236, 211, 0.9));
    box-shadow:
      0 10px 26px rgba(100, 73, 33, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
  }

  .rq-problem-diagnostic__findings dt {
    color: #3a281b;
    font-weight: 800;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .rq-problem-diagnostic__findings dd {
    margin: 0;
    color: #4b3c2d;
    line-height: 1.55;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .rq-problem-diagnostic__finding--plot dt {
    color: #24160d;
  }

  .rq-problem-diagnostic__finding--plot dd {
    color: #302115;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    font-weight: 720;
    line-height: 1.52;
  }

  .rq-problem-diagnostic__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1rem;
    min-width: 0;
    margin-top: auto;
    padding-top: clamp(0.8rem, 1.6vw, 1.1rem);
    border-top: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 38%, rgba(40, 27, 18, 0.2));
  }

  .rq-problem-diagnostic__actions .rq-btn--primary {
    border-color: var(--rq-diagnostic-accent);
    background: var(--rq-diagnostic-accent);
    color: var(--rq-diagnostic-accent-ink);
  }

  .rq-problem-diagnostic__service {
    color: #4a3927;
    font-weight: 740;
    line-height: 1.45;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--rq-diagnostic-accent) 54%, transparent);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .rq-problem-diagnostic__service strong {
    color: #24160d;
    transition: color 180ms var(--rq-ease);
  }

  .rq-problem-diagnostic__service:hover {
    color: #24160d;
    text-decoration-color: var(--rq-diagnostic-accent);
  }

  .rq-problem-diagnostic__service:hover strong {
