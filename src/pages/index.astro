---
import BaseLayout from '../layouts/BaseLayout.astro';
import RqHeader from '../components/RqHeader.astro';
import RqFooter from '../components/RqFooter.astro';
import RqGuide from '../components/RqGuide.astro';
import RqJourney from '../components/RqJourney.astro';
import RqMotion from '../components/RqMotion.astro';
import RqDiagnostic from '../components/RqDiagnostic.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '#co-resim', label: 'Co řeším' },
  { href: '#sluzby', label: 'Služby' },
  { href: '#jak-pracuji', label: 'Postup' },
  { href: '#ceny', label: 'Ceny' },
  { href: '/ukazky/', label: 'Ukázky' },
  { href: '#kontakt', label: 'Kontakt' },
];

const symptoms = [
  'pomalý web',
  'poptávky se ztrácí v mailu',
  'ruční přepisování do Excelu',
  'nejasné CTA',
  'web nevodí zákazníky',
  'žádné měření',
  'chaos v nástrojích',
];
---

<BaseLayout title="RadeQ.cz - Racionální digitalizace" description="Weby, data a automatizace pro živnostníky, malé firmy a spolky.">
  <RqHeader content={{ navItems: nav }} alternateLabel="EN" alternatePath="/en/" />

  <main>
    <section class="rq-section rq-hero" id="top" style="--rq-reveal-index: 0" data-rq-hero-signature>
      <div class="rq-hero__content">
      <div class="rq-hero__copy">
        <p class="rq-eyebrow" data-rq-reveal style="--rq-i:0">Racionální digitalizace</p>
        <h1 class="rq-display" data-rq-reveal style="--rq-i:1">Weby, data a automatizace,<br class="rq-br-desktop" /> které vám uvolní ruce.</h1>
        <p class="rq-lead" data-rq-reveal style="--rq-i:2">Jeden technik s okem analytika a precizností testera. Navrhnu, postavím, otestuji a předám tak, že v tom nezůstanete sami.</p>
        <p class="rq-hero__journey-note" data-rq-reveal style="--rq-i:3">Postup od problému k ověřenému výsledku.</p>
      </div>

      <div class="rq-proof-rail" data-rq-reveal style="--rq-i:4" aria-label="Důkazy a orientační ceny">
        <div class="rq-proof-rail__item">
          <p class="rq-proof-rail__label">Web od 9 900 Kč</p>
          <p class="rq-proof-rail__text">rychlý web, co vodí poptávky</p>
        </div>
        <div class="rq-proof-rail__item">
          <p class="rq-proof-rail__label">Audit od 4 900 Kč</p>
          <p class="rq-proof-rail__text">zmapuju, co brzdí, odečtu z realizace</p>
        </div>
        <div class="rq-proof-rail__item">
          <p class="rq-proof-rail__label">Postavím · změřím · předám</p>
          <p class="rq-proof-rail__text">bez závislosti na dodavateli</p>
        </div>
      </div>

      <div class="rq-hero__actions" data-rq-reveal style="--rq-i:5">
        <a class="rq-btn rq-btn--primary" href="#kontakt" data-rq-magnetic>Napsat poptávku</a>
        <a class="rq-btn rq-btn--ghost" href="#ukazky-teaser">Ukázky práce</a>
        <p class="rq-hero__micro">Nezávazně. Ozvu se do 1 pracovního dne.</p>
      </div>
      </div>

      <div class="rq-hero__visual" data-rq-hero-visual aria-hidden="true">
        <svg class="rq-hero-signature" viewBox="0 0 600 380" aria-hidden="true" focusable="false" data-rq-hero-svg>
          <defs>
            <path id="rq-hero-path" pathLength="1000" d="M46 316 C72 310 90 286 116 276 C146 264 160 244 190 232 C222 218 238 196 272 182 C306 168 324 148 360 134 C398 118 418 102 456 92 C494 82 518 64 548 56" />
          </defs>
          <use class="rq-hero-signature__trace" href="#rq-hero-path"></use>
          <g class="rq-hero-signature__points" data-rq-signature-points>
            <g class="rq-hero-signature__stage rq-hero-signature__stage--start" data-rq-snap-at="0.00" style="--rq-chaos-x: 18px; --rq-chaos-y: -44px;">
              <circle class="rq-hero-signature__point" cx="46" cy="316" r="4.8"></circle>
              <text class="rq-hero-signature__stage-label" x="54" y="296">Váš problém</text>
            </g>
            <g class="rq-hero-signature__stage" data-rq-snap-at="0.14" style="--rq-chaos-x: -38px; --rq-chaos-y: 30px;">
              <circle class="rq-hero-signature__point" cx="116" cy="276" r="4.2"></circle>
              <text class="rq-hero-signature__stage-label" x="116" y="256" text-anchor="middle">Rozbor</text>
            </g>
            <g class="rq-hero-signature__stage" data-rq-snap-at="0.30" style="--rq-chaos-x: 28px; --rq-chaos-y: -30px;">
              <circle class="rq-hero-signature__point" cx="190" cy="232" r="4.4"></circle>
              <text class="rq-hero-signature__stage-label" x="198" y="212">Návrh</text>
            </g>
            <g class="rq-hero-signature__stage" data-rq-snap-at="0.46" style="--rq-chaos-x: -34px; --rq-chaos-y: 36px;">
              <circle class="rq-hero-signature__point" cx="272" cy="182" r="4.1"></circle>
              <text class="rq-hero-signature__stage-label" x="272" y="162" text-anchor="middle">Stavba</text>
            </g>
            <g class="rq-hero-signature__stage" data-rq-snap-at="0.64" style="--rq-chaos-x: 36px; --rq-chaos-y: -22px;">
              <circle class="rq-hero-signature__point" cx="360" cy="134" r="4.5"></circle>
              <text class="rq-hero-signature__stage-label" x="368" y="116">Test</text>
            </g>
            <g class="rq-hero-signature__stage" data-rq-snap-at="0.83" style="--rq-chaos-x: -24px; --rq-chaos-y: 30px;">
              <circle class="rq-hero-signature__point" cx="456" cy="92" r="4.3"></circle>
              <text class="rq-hero-signature__stage-label" x="456" y="72" text-anchor="middle">Předání</text>
            </g>
          </g>
          <g class="rq-hero-signature__token" transform="translate(548 56)" data-rq-signature-token>
            <rect class="rq-hero-signature__token-bg" x="8" y="10" width="64" height="24" rx="4"></rect>
            <text class="rq-hero-signature__token-text" x="40" y="26" text-anchor="middle">Řešení</text>
          </g>
          <g class="rq-hero-signature__endpoint" data-rq-signature-end>
            <line class="rq-hero-signature__cross" x1="548" y1="38" x2="548" y2="74"></line>
            <line class="rq-hero-signature__cross" x1="530" y1="56" x2="566" y2="56"></line>
            <circle class="rq-hero-signature__end-dot" cx="548" cy="56" r="6.5"></circle>
            <text class="rq-hero-signature__label" x="566" y="28" text-anchor="end"><tspan class="rq-hero-signature__label-main">Výsledek · </tspan><tspan class="rq-hero-signature__label-verified">ověřeno</tspan></text>
          </g>
        </svg>
      </div>
    </section>


<section class="rq-marquee rq-bleed" aria-label="Typické symptomy před úpravou webu a procesů" data-rq-marquee>
  <div class="rq-marquee__viewport">
    <div class="rq-marquee__track" data-rq-marquee-track>
      {[0, 1].map((groupIndex) => (
        <span class="rq-marquee__group" data-rq-marquee-group={groupIndex === 0 ? 'true' : undefined} aria-hidden={groupIndex === 1 ? 'true' : undefined}>
          {symptoms.map((symptom) => (
            <>
              <span class="rq-marquee__item">{symptom}</span>
              <span class="rq-marquee__sep" aria-hidden="true">•</span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>
</section>

<section id="co-resim" class="rq-statement rq-problem-wall" aria-labelledby="rq-problem-wall-title">
  <div class="rq-statement__inner rq-problem-wall__inner">
    <div class="rq-problem-wall__head" data-rq-reveal>
      <p class="rq-eyebrow">Co řeším</p>
      <h2 id="rq-problem-wall-title" class="rq-display rq-problem-wall__title">Tohle vás nejspíš brzdí.</h2>
    </div>

    <div class="rq-problem-wall__grid" data-rq-reveal aria-label="Typické problémy, které řeším">
      <article class="rq-problem-wall__tile rq-problem-wall__tile--lead rq-hoverable" style="--rq-i: 0;">
        <span class="rq-flag">nalezen problém</span>
        <p>Web jen existuje, ale nevydělává.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>

      <article class="rq-problem-wall__tile rq-problem-wall__tile--mail rq-hoverable" style="--rq-i: 1;">
        <span class="rq-flag">nalezen problém</span>
        <p>Poptávky se ztrácí v e-mailech a ručně je přepisuju.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>

      <article class="rq-problem-wall__tile rq-problem-wall__tile--offer rq-hoverable" style="--rq-i: 2;">
        <span class="rq-flag">nalezen problém</span>
        <p>Nabídka není jasná a zákazník neví, kam pokračovat.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>

      <article class="rq-problem-wall__tile rq-problem-wall__tile--data rq-hoverable" style="--rq-i: 3;">
        <span class="rq-flag">nalezen problém</span>
        <p>Data přepisuju mezi tabulkami pořád dokola.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>

      <article class="rq-problem-wall__tile rq-problem-wall__tile--overview rq-hoverable" style="--rq-i: 4;">
        <span class="rq-flag">nalezen problém</span>
        <p>Potřebuju jednoduchou evidenci nebo přehled, který se nerozpadne po týdnu.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>

      <article class="rq-problem-wall__tile rq-problem-wall__tile--start rq-hoverable" style="--rq-i: 5;">
        <span class="rq-flag">nalezen problém</span>
        <p>Chci využít AI prakticky a bezpečně, ale nevím, kde začít.</p>
        <a class="rq-problem-wall__link" href="#sluzby">Co s tím</a>
      </article>
    </div>
  </div>
</section>

<RqDiagnostic />

<section id="sluzby" class="rq-section rq-bleed rq-services-bento" aria-labelledby="rq-sluzby-title">
  <div class="rq-bleed__inner">
    <p class="rq-eyebrow">Služby</p>
    <h2 id="rq-sluzby-title" class="rq-h2">Co vám zjednoduším</h2>
    <div class="rq-services-bento__grid" data-rq-reveal aria-label="Služby a orientační ceny">
      <article class="rq-offer rq-service-tile rq-service-tile--featured rq-hoverable" style="--rq-i: 0;">
        <p class="rq-offer__price">od 9 900 Kč</p>
        <h3>Web a redesign</h3>
        <p class="rq-offer__result">Výsledek: web, který návštěvníkovi rychle vysvětlí nabídku a přivádí poptávky.</p>
        <ul class="rq-offer__outputs">
          <li>rychlý jednostránkový web (Astro) + poptávkový formulář</li>
          <li>základní SEO pro Google i Seznam + měření</li>
          <li>předání tak, že drobnosti zvládnete měnit sami</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--shop rq-hoverable" style="--rq-i: 1;">
        <p class="rq-offer__price">od 19 900 Kč</p>
        <h3>E-shop</h3>
        <p class="rq-offer__result">Výsledek: malý vlastněný obchod bez zbytečností, který sami utáhnete.</p>
        <ul class="rq-offer__outputs">
          <li>katalog, košík, varianty</li>
          <li>doprava a platba dle platformy</li>
          <li>předání + krátké zaškolení</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--automation rq-hoverable" style="--rq-i: 2;">
        <p class="rq-offer__price">od 12 000 Kč</p>
        <h3>Automatizace procesů</h3>
        <p class="rq-offer__result">Výsledek: konec ručního přepisování — co děláte opakovaně, běží samo.</p>
        <ul class="rq-offer__outputs">
          <li>analýza jednoho procesu od začátku do konce</li>
          <li>jeden funkční automatický tok</li>
          <li>dokumentace + předání</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--data rq-hoverable" style="--rq-i: 3;">
        <p class="rq-offer__price">od 15 000 Kč</p>
        <h3>Data a AI pomocníci</h3>
        <p class="rq-offer__result">Výsledek: přehled ve vlastních datech a AI nasazená prakticky a bezpečně.</p>
        <ul class="rq-offer__outputs">
          <li>sběr a vyčištění dat</li>
          <li>jednoduchý přehled / report</li>
          <li>AI pomocník nad schválenými podklady</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--audit rq-hoverable" style="--rq-i: 4;">
        <span class="rq-flag">Nízkorizikový start</span>
        <p class="rq-offer__price">4 900 Kč</p>
        <h3>Audit webu nebo procesu</h3>
        <p class="rq-offer__result">Výsledek: víte, co nejvíc brzdí a co řešit první — cenu odečtu z realizace.</p>
        <ul class="rq-offer__outputs">
          <li>technický stav, rychlost, SEO základ, formuláře</li>
          <li>seznam problémů podle priority</li>
          <li>doporučení, co hned a co počká</li>
        </ul>
      </article>
    </div>
    <div class="rq-services-bento__cta">
      <a class="rq-btn rq-btn--primary" href="#kontakt">Domluvit nezávazný rozbor</a>
    </div>
  </div>
</section>

<section id="jak-pracuji" class="rq-section rq-process">
  <RqJourney />
  <article class="rq-guarantee">
    <p class="rq-eyebrow">Servisní protokol &amp; Testerova záruka</p>
    <h3>Každá zakázka má jasný výstup a ověřený výkon.</h3>
    <p>U každé zakázky dostanete servisní protokol — co bylo, co se změnilo, proč a co dál (i co nemá smysl). Před předáním web otestuji: formuláře, mobil, rychlost, základní SEO a měření. Cílím na rychlé načítání podle metrik Googlu (Lighthouse 90+ u statických prezentačních webů); konkrétní technický cíl zapíšu do protokolu předem — když ho při předání nesplním, vrátím 15 % z ceny nebo to bez příplatku doladím.</p>
  </article>
</section>


<section class="rq-section rq-pricing" id="ceny" aria-labelledby="ceny-title">
  <p class="rq-eyebrow" data-rq-reveal>Ceny</p>
  <h2 class="rq-h2" id="ceny-title">Orientační ceny bez překvapení.</h2>
  <p class="rq-lead">Péče po spuštění pro menší weby, e-shopy a automatizace. Vybereme jen rozsah, který dává smysl.</p>

  <div class="rq-pricing-grid" data-rq-reveal aria-label="Tarify péče po spuštění">
    <article class="rq-card rq-price-card">
      <h3 class="rq-price-card__title">Klid</h3>
      <p class="rq-price-card__price">2 500 Kč<span>/měs.</span></p>
      <p class="rq-price-card__text">provoz, zálohy, drobné úpravy (1 h), máte komu zavolat</p>
      <a class="rq-btn rq-btn--ghost" href="#kontakt">Chci Klid</a>
    </article>

    <article class="rq-card rq-price-card rq-price-card--featured">
      <span class="rq-price-card__badge">Doporučeno</span>
      <h3 class="rq-price-card__title">Růst</h3>
      <p class="rq-price-card__price">6 000 Kč<span>/měs.</span></p>
      <p class="rq-price-card__text">vše z Klidu + SEO/výkon hlídání, měsíční report, 3 h vývoje</p>
      <a class="rq-btn rq-btn--primary" href="#kontakt">Chci Růst</a>
    </article>

    <article class="rq-card rq-price-card">
      <h3 class="rq-price-card__title">Partner</h3>
      <p class="rq-price-card__price">15 000 Kč<span>/měs.</span></p>
      <p class="rq-price-card__text">vše z Růstu + průběžná automatizace/AI, 10 h, prioritní support</p>
      <a class="rq-btn rq-btn--ghost" href="#kontakt">Chci Partner</a>
    </article>
  </div>

  <p class="rq-pricing-note">Nechcete paušál? Bloky hodin 5/15/40 h (od 1 100 Kč/h). Audit lze odečíst z realizace.</p>
</section>

<section class="rq-bleed rq-ukazky-teaser" id="ukazky-teaser" aria-labelledby="ukazky-teaser-title">
  <div class="rq-section rq-ukazky-teaser__inner">
    <p class="rq-eyebrow">Ukázky</p>
    <h2 class="rq-h2" id="ukazky-teaser-title">Co umím postavit</h2>
    <div class="rq-ukazky-bento" data-rq-reveal>
      <a class="rq-card rq-ukazky-bento-card rq-ukazky-bento-card--featured" href={base + "/ukazky/instalater/"}>
        <span class="rq-ukazky-bento-card__badge">VZOROVÝ PROJEKT</span>
        <span class="rq-ukazky-bento-card__kicker">Řemeslo a lokální služby</span>
        <strong class="rq-ukazky-bento-card__title">Web pro instalatéra</strong>
        <span class="rq-ukazky-bento-card__text">Přehled služeb, důvěryhodné reference a rychlý kontakt pro zákazníky, kteří potřebují pomoct hned.</span>
        <span class="rq-ukazky-bento-card__link">Zobrazit ukázku</span>
      </a>
      <a class="rq-card rq-ukazky-bento-card rq-ukazky-bento-card--booking" href={base + "/ukazky/sluzba/"}>
        <span class="rq-ukazky-bento-card__badge">VZOROVÝ PROJEKT</span>
        <span class="rq-ukazky-bento-card__kicker">Služby s termíny</span>
        <strong class="rq-ukazky-bento-card__title">Web s rezervací</strong>
        <span class="rq-ukazky-bento-card__text">Jednoduchá prezentace služby s jasnou cestou k objednání.</span>
        <span class="rq-ukazky-bento-card__link">Zobrazit ukázku</span>
      </a>
      <a class="rq-card rq-ukazky-bento-card rq-ukazky-bento-card--shop" href={base + "/ukazky/eshop/"}>
        <span class="rq-ukazky-bento-card__badge">VZOROVÝ PROJEKT</span>
        <span class="rq-ukazky-bento-card__kicker">Prodej a katalog</span>
        <strong class="rq-ukazky-bento-card__title">Malý e-shop</strong>
        <span class="rq-ukazky-bento-card__text">Produktová nabídka, košík a nákupní tok pro menší sortiment.</span>
        <span class="rq-ukazky-bento-card__link">Zobrazit ukázku</span>
      </a>
    </div>
  </div>
</section>

<section class="rq-section rq-contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="rq-contact__copy">
    <p class="rq-eyebrow" data-rq-reveal>Kontakt</p>
    <h2 class="rq-h2" id="kontakt-title">Napište, co vás pálí</h2>
    <p class="rq-lead">Stačí stručně popsat, co chcete zjednodušit — ozvu se a doptám se. Odpovídám do 1 pracovního dne.</p>
  </div>

  <form class="rq-contact-form" method="post" action={base + "/api/leads"} id="rq-lead-form">
    <div class="rq-form-field">
      <label for="rq-lead-name">Jméno</label>
      <input id="rq-lead-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="rq-form-field">
      <label for="rq-lead-email">E-mail</label>
      <input id="rq-lead-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="rq-form-field">
      <label for="rq-lead-current">Co dnes používáte?</label>
      <select id="rq-lead-current" name="project_type">
        <option value="Web">Web</option>
        <option value="E-mail">E-mail</option>
        <option value="Tabulky">Tabulky</option>
        <option value="Formulář">Formulář</option>
        <option value="Jiné">Jiné</option>
      </select>
    </div>

    <div class="rq-form-field">
      <label for="rq-lead-need">Co potřebujete zjednodušit?</label>
      <textarea id="rq-lead-need" name="message" rows="6" required></textarea>
    </div>

    <div class="rq-hp" aria-hidden="true"><label>Toto pole nevyplňujte<input type="text" name="honeypot" tabindex="-1" autocomplete="off" /></label></div>
    <button class="rq-btn rq-btn--primary" type="submit">Odeslat poptávku</button>
    <p class="rq-form-status" id="rq-lead-status" role="status" aria-live="polite"></p>
  </form>

  <p class="rq-contact-note">Nebo rovnou zavolejte: <a href="tel:+420000000000">+420 [DOPLNIT TELEFON]</a> · napište na <a href="mailto:info@radeq.cz">info@radeq.cz</a></p>

  <script is:inline define:vars={{ leadsUrl: base + "/api/leads" }}>
    (() => {
      const form = document.getElementById("rq-lead-form");
      const statusEl = document.getElementById("rq-lead-status");
      if (!form) return;
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        if (fd.get("honeypot")) return;
        const payload = {
          name: fd.get("name") || "", email: fd.get("email") || "",
          project_type: fd.get("project_type") || "", message: fd.get("message") || "",
          company: "", audience: "", deadline: "", current_url: "", budget_range: "",
          honeypot: "", source_path: location.pathname + location.search,
          referrer: document.referrer || "", locale: "cs"
        };
        statusEl.textContent = "Odesílám…";
        try {
          const r = await fetch(leadsUrl, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
          const ct = r.headers.get("content-type") || "";
          if (!ct.includes("application/json")) throw new Error("nojson");
          const res = await r.json();
          if (!r.ok || !res.ok) throw new Error((res.details && res.details.join(" ")) || res.error || "fail");
          form.reset();
          statusEl.textContent = "Děkuji, poptávka odeslána. Ozvu se co nejdřív.";
        } catch (err) {
          statusEl.innerHTML = 'Odeslání teď neproběhlo. Napište prosím na <a href="mailto:info@radeq.cz">info@radeq.cz</a>.';
        }
      });
    })();
  </script>
</section>

