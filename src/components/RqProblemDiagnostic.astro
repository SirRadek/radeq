  .rq-problem-diagnostic__card-inner {
    position: relative;
    z-index: 1;
    display: grid;
    min-block-size: var(--rq-card-h);
    grid-template-rows: auto minmax(4.8rem, 1fr) auto;
    gap: 0.75rem;
    border-radius: 8px;
    padding: clamp(0.85rem, 1.45vw, 1.08rem);
    overflow: hidden;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(94, 25, 38, 0.24) 40%, rgba(26, 6, 10, 0.85));
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    backface-visibility: hidden;
    box-shadow:
      0 34px 72px rgba(34, 15, 19, 0.42),
      0 12px 26px rgba(58, 15, 22, 0.28),
