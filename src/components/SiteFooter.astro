---
import type { Locale } from '../data/locales';
import { withBaseHref } from '../lib/links';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = lang === 'cs'
  ? {
      contact: 'Kontakt',
      brandTitle: 'RadeQ',
      brandText: 'Praktické weby, automatizace a provozní zjednodušení.',
      billing: 'Fakturační údaje',
      owner: 'Radek Široký',
      ico: 'IČO: 08748811',
      address: ['Nezamyslova 274/10', 'Nusle, 128 00 Praha 2', 'Česká republika'],
      legal: 'Dokumenty',
      copyright: '© 2026 RadeQ / Radek Široký',
      mail: 'info@radeq.cz',
      links: [
        { href: '/podminky/', label: 'Podmínky' },
        { href: '/gdpr/', label: 'GDPR' },
        { href: '/cookies/', label: 'Cookies' },
        { href: '/soukromi/', label: 'Soukromí' },
      ],
    }
  : {
      contact: 'Contact',
      brandTitle: 'RadeQ',
      brandText: 'Practical websites, automation, and operational cleanup.',
      billing: 'Billing details',
      owner: 'Radek Široký',
      ico: 'Company ID: 08748811',
      address: ['Nezamyslova 274/10', 'Nusle, 128 00 Prague 2', 'Czech Republic'],
      legal: 'Documents',
      copyright: '© 2026 RadeQ / Radek Široký',
      mail: 'info@radeq.cz',
      links: [
        { href: '/podminky/', label: 'Terms' },
        { href: '/gdpr/', label: 'GDPR' },
        { href: '/cookies/', label: 'Cookies' },
        { href: '/soukromi/', label: 'Privacy' },
      ],
    };
---

<footer class="site-footer" aria-label={copy.legal}>
  <div class="site-footer__brand-block">
    <strong class="site-footer__brand">{copy.brandTitle}</strong>
    <p>{copy.brandText}</p>
    <small>{copy.copyright}</small>
  </div>
  <div class="site-footer__contact">
    <p class="section-code">{copy.contact}</p>
    <a class="site-footer__mail" href={`mailto:${copy.mail}`}>{copy.mail}</a>
  </div>
  <div class="site-footer__billing">
    <p class="section-code">{copy.billing}</p>
    <strong>{copy.owner}</strong>
    <span>{copy.ico}</span>
    <address>
      {copy.address.map((line) => <span>{line}</span>)}
    </address>
  </div>
  <nav aria-label={copy.legal}>
    {copy.links.map((link) => <a href={withBaseHref(link.href)}>{link.label}</a>)}
  </nav>
</footer>
