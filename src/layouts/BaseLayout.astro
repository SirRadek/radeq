---
import type { Locale } from '../data/locales';
import MeasurementTracker from '../components/MeasurementTracker';
import MotionOrchestrator from '../components/MotionOrchestrator';
import '../styles/global.css';
import '../styles/redesign.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  alternatePath?: string;
  alternateLang?: Locale;
  allowStoredStyle?: boolean;
}

const { title, description, lang, alternatePath, alternateLang, allowStoredStyle = false } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternatePath ? new URL(`${basePath}${alternatePath}`, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang={lang} data-style="variant-a" data-theme="light" data-style-source={allowStoredStyle ? 'stored' : 'fixed'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePath && alternateLang && alternateUrl ? <link rel="alternate" hreflang={alternateLang} href={alternateUrl} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('radeq-theme-mode');
          document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }

        const styleSource = document.documentElement.dataset.styleSource;
        if (styleSource === 'stored') {
          try {
            const storedStyle = localStorage.getItem('radeq-style-variant');
            const allowedStyles = ['variant-a', 'variant-b', 'variant-c', 'variant-d'];
            document.documentElement.dataset.style = allowedStyles.includes(storedStyle) ? storedStyle : 'variant-a';
          } catch {
            document.documentElement.dataset.style = 'variant-a';
          }
        } else {
          document.documentElement.dataset.style = 'variant-a';
        }
      })();
    </script>
  </head>
  <body>
    <MeasurementTracker client:load />
    <MotionOrchestrator client:load />
    <slot />
  </body>
</html>
