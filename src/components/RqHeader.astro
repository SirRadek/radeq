---
const { content = {}, alternateLabel, alternatePath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (h) => {
  if (!h || !h.startsWith("/")) return h;
  if (base && (h === base || h.startsWith(base + "/"))) return h;
  return base + h;
};
const logoMask = `${base}/brand/radeq-logo-b-mask.png`;
const navItems = content.navItems ?? content.items ?? [];
const navAriaLabel = content.navAriaLabel ?? "Hlavní navigace";
const brandAriaLabel = content.brandAriaLabel ?? "RadeQ.cz";
const homeHref = content.homeHref ?? "/";
const ctaHref = content.ctaHref ?? "/#kontakt";
---

<header class="rq-site-header">
  <div class="rq-site-header__inner">
    <a
      class="rq-site-header__logo rq-logo"
      href={resolve(homeHref)}
      style={`--rq-logo-mask:url("${logoMask}")`}
      aria-label={brandAriaLabel}
    >
      <span role="img" aria-label={brandAriaLabel}></span>
    </a>

    <nav class="rq-site-nav" aria-label={navAriaLabel}>
      {navItems.map((item) => (
        <a class="rq-site-nav__link" href={resolve(item.href)}>{item.label}</a>
      ))}
    </nav>

    <div class="rq-site-header__actions">
      {alternateLabel && alternatePath && (
        <a class="rq-site-header__alt" href={resolve(alternatePath)}>{alternateLabel}</a>
      )}
      {content.cta && <a class="rq-btn rq-btn--primary" href={resolve(ctaHref)}>{content.cta}</a>}
    </div>
  </div>
</header>
