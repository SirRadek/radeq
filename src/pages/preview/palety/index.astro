---
import AboutSection from '../../../components/AboutSection.astro';
import CommandHeader from '../../../components/CommandHeader.astro';
import ContactTerminal from '../../../components/ContactTerminal';
import HeroSection from '../../../components/HeroSection.astro';
import PalettePreviewControls from '../../../components/PalettePreviewControls.astro';
import PricingSection from '../../../components/PricingSection.astro';
import ServiceCatalog from '../../../components/ServiceCatalog.astro';
import { siteContent } from '../../../data/siteContent';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const content = siteContent.cs;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const lightFavicon = `${basePath}/brand/radeq-favicon-b-light.svg`;
const darkFavicon = `${basePath}/brand/radeq-favicon-b-dark.svg`;
---

<BaseLayout
  title="RadeQ.cz - preview barevných palet"
  description="Interní preview homepage RadeQ.cz s aplikovanými paletami pro logo variantu B."
  lang={content.layout.lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={lightFavicon} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={darkFavicon} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={lightFavicon} data-preview-favicon-active data-light-href={lightFavicon} data-dark-href={darkFavicon} />
    <script is:inline define:vars={{ lightFavicon, darkFavicon }}>
      (() => {
        const root = document.documentElement;
        const palettes = ['walnut', 'forest', 'royal', 'espresso'];
        const modes = ['auto', 'light', 'dark'];
        const systemDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
        const read = (key, fallback, allowed) => {
          try {
            const value = localStorage.getItem(key);
            return allowed.includes(value) ? value : fallback;
          } catch {
            return fallback;
          }
        };
        const palette = read('radeq-palette-preview-palette', 'walnut', palettes);
        const mode = read('radeq-palette-preview-theme', 'auto', modes);
        const effectiveTheme = mode === 'auto' ? (systemDark ? 'dark' : 'light') : mode;
        root.dataset.palettePreview = 'true';
        root.dataset.palette = palette;
        root.dataset.previewThemePreference = mode;
        root.dataset.theme = effectiveTheme;
        const activeFavicon = document.querySelector('link[data-preview-favicon-active]');
        activeFavicon?.setAttribute('href', mode === 'dark' || (mode === 'auto' && systemDark) ? darkFavicon : lightFavicon);
      })();
    </script>
  </Fragment>

  <CommandHeader
    content={content.header}
    locale={content.layout.lang}
    showStyleToggle={false}
    showThemeToggle={false}
    brandVariant="logo-b"
  />
  <PalettePreviewControls />
  <main>
    <div class="proposal-stage palette-preview-home">
      <HeroSection content={content.hero} />
    </div>
    <AboutSection content={content.about} />
    <ServiceCatalog locale={content.layout.lang} content={content.systems} />
    <PricingSection content={content.pricing} />
    <ContactTerminal locale={content.layout.lang} content={content.terminal} client:load />
    <a class="back-to-top" href="#top" aria-label="Zpět nahoru"><span aria-hidden="true">↑</span></a>
  </main>
</BaseLayout>
