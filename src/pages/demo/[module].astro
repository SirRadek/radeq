---
import '../../styles/minimal-simulator.css';
import StyleMatrixSimulator from '../../components/StyleMatrixSimulator';
import { siteContent } from '../../data/siteContent';
import { getModuleOptions, type ModuleId } from '../../data/styleMatrix';
import RqLayout from '../../layouts/RqLayout.astro';
import RqHeader from '../../components/RqHeader.astro';
import RqFooter from '../../components/RqFooter.astro';
import RqContactForm from '../../components/RqContactForm.astro';
import { homeContent } from '../../data/home';


export function getStaticPaths() {
  return getModuleOptions('cs').map((option) => ({
    params: { module: option.id },
    props: { moduleId: option.id },
  }));
}

const { moduleId } = Astro.props as { moduleId: ModuleId };
const content = siteContent.cs;
const moduleOption = getModuleOptions(content.layout.lang).find((option) => option.id === moduleId);
const isShopShowcase = moduleId === 'service-landing' || moduleId === 'eshop-offers';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const servicesHref = `${basePath}/#sluzby`;
const pageTitle = isShopShowcase
  ? 'E-shop ukázka | Radeq.cz'
  : moduleOption
  ? `${moduleOption.label} demo | Radeq.cz`
  : `Demo ukázka | Radeq.cz`;
const pageDescription = isShopShowcase
  ? 'Interaktivní ukázka e-shopu s produkty, filtrováním, porovnáním a nezávazným demo košíkem ve stylech A, B, C a D.'
  : (moduleOption?.benefit ?? content.layout.description);
---

<RqLayout
  title={pageTitle}
  description={pageDescription}
  lang={content.layout.lang}
  alternatePath={`/en/demo/${moduleId}/`}
  alternateLang="en"
>
  <RqHeader alternateLabel="EN" alternatePath={`/en/demo/${moduleId}/`} />
  <main>
    <section class="demo-route-hero" id="top" aria-labelledby="demo-route-title">
      <div>
        <p class="section-code">Demo</p>
        <h1 id="demo-route-title">{isShopShowcase ? 'E-shop ukázka' : moduleOption ? moduleOption.label : 'Ukázka webu'}</h1>
      </div>
      <div>
        <p>
          {
            isShopShowcase
              ? 'Jedna e-shopová ukázka, čtyři vizuální styly. Produkty, filtrování, porovnání i demo košík zůstávají stejné.'
              : moduleOption
                ? moduleOption.benefit
                : content.matrix.lead
          }
        </p>
        <a class="button-secondary" href={servicesHref}>Zpět na služby</a>
      </div>
    </section>
    <div class="rq-simulator"><StyleMatrixSimulator
      locale={content.layout.lang}
      content={content.matrix}
      initialModuleId={moduleId}
      shopOnly={isShopShowcase}
      client:load
    /></div>
    <section id="terminal"><span id="kontakt"></span><h2>Probrat projekt</h2><RqContactForm content={homeContent.cs.contact} lang={content.layout.lang} /></section>
  </main>
  <RqFooter content={homeContent.cs.footer} homeHref="/" />
</RqLayout>
