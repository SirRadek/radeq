---
import type { Locale } from '../data/locales';
import MeasurementTracker from '../components/MeasurementTracker';
import '../styles/rq.css';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  alternatePath?: string;
  alternateLang?: Locale;
  allowStoredStyle?: boolean;
}

const { title, description, lang = 'cs', canonicalPath, alternatePath, alternateLang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ? `${basePath}${canonicalPath}` : Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternatePath ? new URL(`${basePath}${alternatePath}`, siteUrl).toString() : undefined;
const ogImageUrl = new URL(`${basePath}/og-default.jpg`, siteUrl).toString();
const defaultUrl = lang === 'cs' ? canonicalUrl : alternateUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href={basePath + '/favicon.png'} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href={basePath + '/favicon-dark.png'} />
    <link rel="apple-touch-icon" href={basePath + '/apple-touch-icon.png'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePath && alternateLang && alternateUrl ? (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
        <link rel="alternate" hreflang="x-default" href={defaultUrl} />
      </>
    ) : null}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RadeQ.cz" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <MeasurementTracker client:load />
    <slot />
    <script is:inline>
      (() => {
        const readyKey = 'rqFooterFogReady';
        const root = document.documentElement;
        const body = document.body;

        if (!body || root.dataset[readyKey] === 'true') return;
        root.dataset[readyKey] = 'true';

        const footer = document.querySelector('.rq-site-footer');
        const setFooterVisible = (isVisible) => {
          body.classList.toggle('is-footer-visible', isVisible);
        };

        if (!footer || !('IntersectionObserver' in window)) {
          setFooterVisible(false);
          root.dataset[readyKey] = 'false';
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          const isVisible = entries.some((entry) => entry.isIntersecting);
          setFooterVisible(isVisible);
        }, {
          rootMargin: '0px 0px 48px 0px',
          threshold: 0,
        });

        observer.observe(footer);

        window.addEventListener('pagehide', () => {
          observer.disconnect();
          setFooterVisible(false);
          root.dataset[readyKey] = 'false';
        }, { once: true });
      })();
    </script>
  </body>
</html>
