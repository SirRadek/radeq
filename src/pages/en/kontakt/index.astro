---
import RqLayout from '../../../layouts/RqLayout.astro';
import RqHeader from '../../../components/RqHeader.astro';
import RqFooter from '../../../components/RqFooter.astro';
import RqContactForm from '../../../components/RqContactForm.astro';
import { homeContent } from '../../../data/home';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: base + '/en/#co-resim', label: 'What I solve' },
  { href: base + '/en/#sluzby', label: 'Services' },
  { href: base + '/en/#jak-pracuji', label: 'How I work' },
  { href: base + '/en/#ceny', label: 'Pricing' },
  { href: base + '/ukazky/', label: 'Examples' },
  { href: base + '/zapisky/', label: 'Notes' },
  { href: base + '/en/#kontakt', label: 'Contact' },
];
---

<RqLayout
  title="Contact | RadeQ.cz"
  description="Send a few sentences about your website or problem. I'll reply within 1 working day. Email and phone."
  lang="en"
>
  <RqHeader content={{ navItems: nav }} alternateLabel="CS" alternatePath="/kontakt/" />

  <main class="rq-contact-page">
    <section class="rq-section rq-contact-hero" id="top">
      <p class="rq-eyebrow">Contact</p>
      <h1 class="rq-display">Get in touch</h1>
      <p class="rq-lead">
        Just a few sentences — the type of website or the problem, the current state, and
        what should improve. I'll reply within 1 working day, no commitment.
      </p>
      <div class="rq-actions">
        <a class="rq-btn rq-btn--primary" href="#poptavka">Send an enquiry</a>
        <a class="rq-btn rq-btn--ghost" href={base + '/ukazky/'}>See examples</a>
      </div>
    </section>

    <section class="rq-section rq-contact-methods" aria-labelledby="rq-contact-methods-title">
      <p class="rq-eyebrow">How to reach me</p>
      <h2 class="rq-h2" id="rq-contact-methods-title">Direct contact</h2>

      <div class="rq-contact-grid">
        <article class="rq-card rq-contact-card">
          <h3>Email</h3>
          <p>
            <a href="mailto:siroky@radeq.cz">siroky@radeq.cz</a>
          </p>
        </article>
        <article class="rq-card rq-contact-card">
          <h3>Phone</h3>
          <p><a href="tel:+420730634439">+420 730 634 439</a></p>
        </article>
        <article class="rq-card rq-contact-card">
          <h3>Where</h3>
          <p>Prague, all of Czechia · Reg. No. 08748811</p>
        </article>
        <article class="rq-card rq-contact-card">
          <h3>Response</h3>
          <p>I'll reply within 1 working day.</p>
        </article>
      </div>
    </section>

    <section class="rq-section" id="poptavka">
      <RqContactForm content={homeContent.en.contact} lang="en" />
    </section>

    <section class="rq-section rq-contact-process" aria-labelledby="rq-contact-process-title">
      <p class="rq-eyebrow">Before you write</p>
      <h2 class="rq-h2" id="rq-contact-process-title">What to send and how it works</h2>

      <div class="rq-contact-grid rq-contact-grid--steps">
        <article class="rq-card rq-info-card">
          <h3>What to send</h3>
          <p>
            Describe whether it's a new website, redesign, website or process audit, or something else. A link
            to your current site helps but isn't required.
          </p>
        </article>
        <article class="rq-card rq-info-card">
          <h3>Where enquiries go</h3>
          <p>
            The form is for work enquiries and arranging next steps. Don't send passwords,
            payment details, or internal documents.
          </p>
        </article>
        <article class="rq-card rq-info-card">
          <h3>Handled by a person</h3>
          <p>
            An enquiry doesn't end with an automated decision. Unclear or sensitive things
            I handle manually, with clear boundaries.
          </p>
        </article>
      </div>
    </section>
  </main>

  <RqFooter navItems={nav} />
</RqLayout>

<style>
  .rq-contact-page :is(h1, h2, h3) {
    letter-spacing: 0;
  }

  .rq-contact-hero {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
    padding-block-start: clamp(5rem, 9vw, 8rem);
  }

  .rq-contact-hero .rq-display {
    max-width: 13ch;
  }

  .rq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .rq-contact-methods,
  .rq-contact-process {
    padding-block-start: clamp(2.5rem, 5vw, 4.5rem);
  }

  .rq-contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.1rem;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
  }

  .rq-contact-grid--steps {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .rq-contact-card,
  .rq-info-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.15rem, 2vw, 1.45rem);
  }

  .rq-contact-card h3,
  .rq-info-card h3 {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.12;
  }

  .rq-contact-card p,
  .rq-info-card p {
    color: var(--rq-ink-2);
    line-height: 1.55;
  }

  .rq-contact-card a {
    display: block;
    color: var(--rq-burgundy);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .rq-contact-card a + a {
    margin-top: 0.35rem;
  }
</style>
