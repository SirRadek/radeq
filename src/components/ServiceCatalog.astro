---
import type { Locale, SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['systems'];
  locale: Locale;
}

const { content, locale } = Astro.props;

const routeCopy = {
  cs: {
    label: 'Doporuceny start',
    title: 'Audit rozhodne, kudy jit prvni',
    text: 'Nejdriv zmapujeme provoz, slabiny a prilezitosti. Pak navrhneme nejkratsi cestu k vysledku bez zbytecnych odbocek.',
    action: 'Domluvit audit'
  },
  en: {
    label: 'Recommended start',
    title: 'An audit shows where to move first',
    text: 'We map operations, weak spots, and opportunities first. Then we define the shortest route to impact without unnecessary detours.',
    action: 'Request audit'
  }
} satisfies Record<Locale, { label: string; title: string; text: string; action: string }>;

const primaryItems = content.items.slice(0, 3);
const secondaryItems = content.items.slice(3);
const auditCopy = routeCopy[locale];
---

<section class="service-catalog ds-bleed" id="services-guided" aria-labelledby="services-guided-title">
  <div class="service-catalog__inner ds-section">
    <div class="service-catalog__header">
      <p class="ds-eyebrow">{content.sectionCode}</p>
      <h2 class="ds-h2" id="services-guided-title">{content.title}</h2>
      <p class="ds-lead">{content.lead}</p>
    </div>

    <div class="service-catalog__layout">
      <aside class="service-guide ds-card" aria-labelledby="service-guide-title">
        <p class="ds-eyebrow">{content.guide.eyebrow}</p>
        <h3 id="service-guide-title">{content.guide.title}</h3>
        <p>{content.guide.text}</p>

        <div class="service-guide__recommendation">
          <p>{auditCopy.label}</p>
          <h4>{auditCopy.title}</h4>
          <span>{auditCopy.text}</span>
          <a href="#terminal">{auditCopy.action}</a>
        </div>

        <ol class="service-guide__steps" aria-label={content.guide.title}>
          {content.guide.steps.map((step) => (
            <li>
              <span>{step.label}</span>
              <strong>{step.value}</strong>
            </li>
          ))}
        </ol>
      </aside>

      <div class="service-path" aria-label={content.title}>
        {primaryItems.map((item, index) => (
          <article class="service-card ds-card">
            <span class="service-card__marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="service-card__problem">{item.problem}</p>
            <h3>{item.system}</h3>
            <p>{item.output}</p>
            <a href="#terminal" aria-label={`${content.requestLabel}: ${item.system}`}>
              <span aria-hidden="true">-&gt;</span> {content.requestLabel}
            </a>
          </article>
        ))}
      </div>
    </div>

    {secondaryItems.length > 0 && (
      <div class="service-addons" aria-labelledby="service-addons-title">
        <div class="service-addons__intro">
          <p class="ds-eyebrow">{content.sectionCode}</p>
          <h3 id="service-addons-title">{content.secondaryTitle}</h3>
          <p>{content.secondaryLead}</p>
        </div>

        <div class="service-addons__grid">
          {secondaryItems.map((item, index) => (
            <article class="service-addon-card ds-card">
              <span>{String(index + 4).padStart(2, '0')}</span>
              <h4>{item.system}</h4>
              <p>{item.output}</p>
              <a href="#terminal" aria-label={`${content.requestLabel}: ${item.system}`}>
                <span aria-hidden="true">-&gt;</span> {content.requestLabel}
              </a>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
