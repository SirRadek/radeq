---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['about'];
}

const { content } = Astro.props;
const isCzech = content.sectionCode === 'O RadeQ';
const showMoreLabel = isCzech ? 'Zobrazit více' : 'Show more';
const showLessLabel = isCzech ? 'Zobrazit méně' : 'Show less';
---

<section class="about-services" id="about" aria-labelledby="about-title" data-section-signature="about-services">
  <div class="about-services__intro">
    <p class="section-code">{content.sectionCode}</p>
    <h2 id="about-title">{content.title}</h2>
    <p>{content.lead}</p>
  </div>
  <div class="about-services__profile">
    <p class="section-code">{content.profileTitle}</p>
    <p>{content.profileText}</p>
    <dl>
      {
        content.principles.map((principle) => (
          <div>
            <dt>{principle.label}</dt>
            <dd>{principle.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="about-services__service-map" aria-label={content.servicesTitle}>
    {
      content.items.map((item, index) => (
        <details class="about-service-card">
          <summary>
            <span>{String(index + 1).padStart(2, '0')} / {item.label}</span>
            <strong>{item.title}</strong>
            <em aria-hidden="true">
              <span class="about-service-card__more-closed">{showMoreLabel}</span>
              <span class="about-service-card__more-open">{showLessLabel}</span>
            </em>
          </summary>
          <p>{item.text}</p>
        </details>
      ))
    }
  </div>
  <p class="about-services__note">{content.note}</p>
</section>
