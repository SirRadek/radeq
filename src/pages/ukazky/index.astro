---
import RqLayout from '../../layouts/RqLayout.astro';
import RqHeader from '../../components/RqHeader.astro';
import RqFooter from '../../components/RqFooter.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: base + '/#co-resim', label: 'Co řeším' },
  { href: base + '/#sluzby', label: 'Služby' },
  { href: base + '/#jak-pracuji', label: 'Jak pracuji' },
  { href: base + '/#ceny', label: 'Ceny' },
  { href: base + '/ukazky/', label: 'Ukázky' },
  { href: base + '/zapisky/', label: 'Zápisky' },
  { href: base + '/#kontakt', label: 'Kontakt' },
];

const ukazky = [
  {
    href: base + '/ukazky/provozni-terminal/',
    badge: 'Demo scénář',
    name: 'Dílenský terminál (výroba/sklad)',
    pro: 'Malovýroba, dílna, řemeslo',
    co: 'Živý mini-admin: evidence hotové práce, odpis materiálu a docházka s online přehledem pro vedení — místo těžkého ERP. Proklikatelné nad demo daty.',
  },
  {
    href: base + '/ukazky/eshop-system/',
    badge: 'Demo scénář',
    name: 'E-shop se správou a exportem',
    pro: 'Malý e-shop, lokální výrobce',
    co: 'Živá ukázka: katalog → objednávka → administrace → export do účetnictví (XML). Bez ručního přepisování; test-mode, nic se neplatí.',
  },
  {
    href: base + '/ukazky/instalater/',
    name: 'Web pro instalatéra',
    pro: 'Řemeslník v terénu',
    co: 'Lokální SEO, výrazné telefonní CTA, orientační ceník a rychlé načítání — web, který přivádí poptávky z mobilu.',
  },
  {
    href: base + '/ukazky/sluzba/',
    name: 'Web s rezervací',
    pro: 'Služba na čas (fyzio, kadeřnictví, poradna)',
    co: 'Budování důvěry, přehled služeb a jednoduché online objednání termínu.',
  },
  {
    href: base + '/ukazky/eshop/',
    name: 'Malý e-shop',
    pro: 'Lokální výrobce nebo prodejce',
    co: 'Čistý katalog s filtrem, varianty, košík — malý vlastněný obchod bez zbytečného balastu.',
  },
  {
    href: base + '/ukazky/chatbot/',
    name: 'Web s průvodcem (autoservis)',
    pro: 'Opakované dotazy a objednávání',
    co: 'Modelový web autoservisu s pravidlovým průvodcem „Co potřebuje vaše auto“ — rychlá orientace a objednání bez čekání na telefon.',
  },
  {
    href: base + '/ukazky/automatizace/',
    badge: 'Statická ukázka',
    name: 'Automatizace poptávek',
    pro: 'Poptávky a ruční přepisování',
    co: 'Archetyp sběru, kontroly a třídění poptávek bez klientských dat a skrytého odesílání.',
  },
];
---

<RqLayout
  title="Ukázkové projekty | RadeQ.cz"
  description="Modelové weby a statické ukázky řešení, které ukazují rozsah a styl práce RadeQ.cz bez klientských dat."
  lang="cs"
>
  <RqHeader content={{ navItems: nav }} alternateLabel="EN" alternatePath="/en/" />

  <main>
    <section class="rq-section" id="top">
      <p class="rq-eyebrow">Ukázky</p>
      <h1 class="rq-display">Ukázkové projekty</h1>
      <p class="rq-lead">
        Modelové weby a statické scénáře, které ukazují rozsah a styl práce — než přibydou veřejné reference.
        Každá ukázka je živá a rozkliknutelná; jde o vzorové projekty nebo archetypy, ne o skutečné provozovatele.
      </p>

      <div class="rq-ukazky-grid">
        {ukazky.map((u) => (
          <article class="rq-card rq-ukazka">
            <span class="rq-ukazka__badge">{u.badge ?? 'Vzorový projekt'}</span>
            <h2 class="rq-ukazka__name">{u.name}</h2>
            <p class="rq-ukazka__pro">Pro koho: {u.pro}</p>
            <p class="rq-ukazka__co">{u.co}</p>
            <a class="rq-btn rq-btn--ghost" href={u.href}>Otevřít ukázku</a>
          </article>
        ))}
      </div>

      <p class="rq-ukazky-note">
        Chcete podobný web? <a href={base + '/#kontakt'}>Napište mi</a> — probereme rozsah a orientační cenu.
      </p>
    </section>
  </main>

  <RqFooter navItems={nav} />
</RqLayout>

<style>
  .rq-ukazky-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.1rem;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
  }
  .rq-ukazka {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
  }
  .rq-ukazka__badge {
    align-self: flex-start;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--rq-burgundy-tint);
    color: var(--rq-burgundy-strong);
    font-family: var(--rq-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .rq-ukazka__name { margin: 0.2rem 0 0; }
  .rq-ukazka__pro { margin: 0; color: var(--rq-ink-2); font-size: 0.86rem; }
  .rq-ukazka__co { margin: 0; color: var(--rq-ink-2); line-height: 1.55; }
  .rq-ukazka .rq-btn { margin-top: auto; align-self: flex-start; }
  .rq-ukazky-note { margin-top: clamp(1.6rem, 3vw, 2.4rem); color: var(--rq-ink-2); }
  .rq-ukazky-note a { color: var(--rq-burgundy); }
</style>
