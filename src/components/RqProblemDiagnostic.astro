</style>

<script>
  import { inViewGate } from '../lib/inViewGate';

  (() => {
    const root = document.querySelector('[data-rq-problem-diagnostic]');
    if (!root || root.dataset.rqProblemDiagnosticReady === 'true') return;

    root.dataset.rqProblemDiagnosticReady = 'true';

    const carousel = root.querySelector('[data-rq-problem-carousel]');
    const output = root.querySelector('[data-rq-problem-output]');
    const cards = Array.from(root.querySelectorAll('[data-rq-problem-card]'));
    const panels = Array.from(root.querySelectorAll('[data-rq-problem-panel]'));
    const prevButton = root.querySelector('[data-rq-problem-prev]');
    const nextButton = root.querySelector('[data-rq-problem-next]');
    const reducedMotionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');

    if (!carousel || !cards.length || !panels.length) return;

    let activeIndex = 0;
    let diagnosticInView = false;
    let userHasInteracted = false;
    let scrollSettleTimer = 0;
    let panelTimer = 0;
    let coverflowFrame = 0;

    const markInteracted = () => {
      userHasInteracted = true;
      output?.setAttribute('aria-live', 'polite');
    };

    const clearScrollTimer = () => {
      if (!scrollSettleTimer) return;
      window.clearTimeout(scrollSettleTimer);
      scrollSettleTimer = 0;
    };

    const clearPanelTimer = () => {
      if (!panelTimer) return;
      window.clearTimeout(panelTimer);
      panelTimer = 0;
    };

    const clearCoverflowFrame = () => {
      if (!coverflowFrame) return;
      window.cancelAnimationFrame(coverflowFrame);
      coverflowFrame = 0;
    };

    const updateNav = () => {
      prevButton?.toggleAttribute('disabled', activeIndex === 0);
      nextButton?.toggleAttribute('disabled', activeIndex === cards.length - 1);
    };

    const animatePanel = () => {
      if (!output || reducedMotionQuery?.matches) return;
      clearPanelTimer();
      output.classList.remove('is-switching');
      output.getBoundingClientRect();
      output.classList.add('is-switching');
      panelTimer = window.setTimeout(() => {
        output.classList.remove('is-switching');
        panelTimer = 0;
      }, 360);
    };

    const scrollCardIntoView = (index) => {
      cards[index]?.scrollIntoView({
        behavior: reducedMotionQuery?.matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    };

    const setCardVar = (card, name, value) => {
      if (!(card instanceof HTMLElement)) return;
      card.style.setProperty(name, value);
    };

    const setCardCoverflow = (card, state) => {
      setCardVar(card, '--rq-card-rotate', `${state.rotate.toFixed(2)}deg`);
      setCardVar(card, '--rq-card-lift', `${state.lift.toFixed(2)}rem`);
      setCardVar(card, '--rq-card-depth', `${state.depth.toFixed(2)}px`);
      setCardVar(card, '--rq-card-scale', state.scale.toFixed(3));
      setCardVar(card, '--rq-card-opacity', state.opacity.toFixed(3));
      setCardVar(card, '--rq-card-saturate', state.saturate.toFixed(3));
    };

    const rotationFromDistance = (distance) => {
      const absDistance = Math.abs(distance);
      if (absDistance < 0.08) return 0;
      const amount = absDistance <= 1
        ? absDistance * 16
        : 16 + Math.min(absDistance - 1, 1.6) * 8;
      return -Math.sign(distance) * amount;
    };

    const updateCoverflow = () => {
      coverflowFrame = 0;
      const carouselRect = carousel.getBoundingClientRect();
      const carouselCenter = carouselRect.left + carouselRect.width / 2;
      const renderRange = carouselRect.width * 0.9;
      const reducedMotion = reducedMotionQuery?.matches === true;

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;

        const rect = card.getBoundingClientRect();
        const cardWidth = Math.max(rect.width, 1);
        const cardCenter = rect.left + rect.width / 2;
        const rawDistance = (cardCenter - carouselCenter) / cardWidth;
        const absRawDistance = Math.abs(rawDistance);

        if (reducedMotion) {
          card.setAttribute('data-rq-problem-distance', index === activeIndex ? 'active' : 'near');
          setCardCoverflow(card, {
            rotate: 0,
            lift: 0,
            depth: 0,
            scale: 1,
            opacity: index === activeIndex ? 1 : 0.72,
            saturate: 1,
          });
          return;
        }

        const isNearViewport = rect.right >= carouselRect.left - renderRange
          && rect.left <= carouselRect.right + renderRange;

        if (!isNearViewport || absRawDistance > 3.2) {
          card.setAttribute('data-rq-problem-distance', 'hidden');
          setCardCoverflow(card, {
            rotate: 0,
            lift: 0.8,
            depth: -132,
            scale: 0.76,
            opacity: 0.06,
            saturate: 0.42,
          });
          return;
        }

        const distance = Math.max(-2.6, Math.min(2.6, rawDistance));
        const absDistance = Math.abs(distance);
        const isActive = index === activeIndex;

        card.setAttribute('data-rq-problem-distance', absDistance > 2 ? 'far' : 'near');
        setCardCoverflow(card, {
          rotate: rotationFromDistance(distance),
          lift: isActive ? -0.25 : Math.min(absDistance * 0.42, 0.95),
          depth: isActive ? 42 : 26 - absDistance * 58,
          scale: isActive ? 1 : Math.max(0.78, 1 - absDistance * 0.085),
          opacity: isActive ? 1 : Math.max(0.18, 1 - absDistance * 0.31),
          saturate: isActive ? 1.08 : Math.max(0.52, 1.02 - absDistance * 0.18),
        });
      });
    };

    const requestCoverflow = () => {
      if (coverflowFrame || document.hidden) return;
      coverflowFrame = window.requestAnimationFrame(updateCoverflow);
    };

    const activate = (nextIndex, options = {}) => {
      const safeIndex = Math.max(0, Math.min(nextIndex, cards.length - 1));
      const previousIndex = activeIndex;
      const shouldAnimate = safeIndex !== activeIndex || options.forceAnimation;

      if (options.interacted) markInteracted();

      activeIndex = safeIndex;
      root.dataset.rqActiveIndex = String(activeIndex);

      cards.forEach((card, index) => {
        const isActive = index === activeIndex;
        card.setAttribute('aria-selected', String(isActive));
        card.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      panels.forEach((panel, index) => {
        const isActive = index === activeIndex;
        panel.classList.toggle('is-active', isActive);
        panel.setAttribute('aria-hidden', String(!isActive));
        panel.setAttribute('tabindex', isActive ? '0' : '-1');
        panel.toggleAttribute('inert', !isActive);
      });

      updateNav();
      requestCoverflow();
      if (safeIndex !== previousIndex) {
        const panel = panels[activeIndex];
        window.dispatchEvent(new CustomEvent('rq:problem-change', {
          detail: {
            title: panel?.getAttribute('data-rq-problem-mini-title') || '',
            problem: panel?.getAttribute('data-rq-problem-mini-problem') || '',
            step: panel?.getAttribute('data-rq-problem-mini-step') || '',
          },
        }));
      }
      if (shouldAnimate) animatePanel();
      if (options.scroll) scrollCardIntoView(activeIndex);
      if (options.focus) cards[activeIndex]?.focus({ preventScroll: true });
    };

    root.addEventListener('click', (event) => {
      const serviceLink = event.target instanceof Element
        ? event.target.closest('[data-rq-primary-service-target]')
        : null;
      if (!serviceLink || !root.contains(serviceLink)) return;

      const primaryServiceId = serviceLink.getAttribute('data-rq-primary-service-target');
      const relatedServiceId = serviceLink.getAttribute('data-rq-related-service-target') || '';
      if (!primaryServiceId) return;

      const focusEvent = new CustomEvent('rq:service-focus', {
        detail: { primaryServiceId, relatedServiceId },
        cancelable: true,
      });

      if (!window.dispatchEvent(focusEvent)) {
        event.preventDefault();
      }
    });

    const closestCardIndex = () => {
      const carouselRect = carousel.getBoundingClientRect();
      const carouselCenter = carouselRect.left + carouselRect.width / 2;
      let closestIndex = activeIndex;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const distance = Math.abs(cardCenter - carouselCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    };

    const settleScroll = () => {
      clearScrollTimer();
      root.classList.remove('is-scrolling');

      if (!diagnosticInView || document.hidden) return;
      activate(closestCardIndex(), { interacted: userHasInteracted });
      requestCoverflow();
    };

    const scheduleScrollSettle = () => {
      if (!diagnosticInView || document.hidden) return;

      root.classList.add('is-scrolling');
      requestCoverflow();
      clearScrollTimer();
      scrollSettleTimer = window.setTimeout(settleScroll, 150);
    };

    const moveBy = (direction, options = {}) => {
      const nextIndex = Math.max(0, Math.min(activeIndex + direction, cards.length - 1));
      activate(nextIndex, {
        interacted: true,
        scroll: true,
        focus: options.focus,
      });
    };

    carousel.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const frame = target?.closest('.rq-problem-diagnostic__frame');
      if (!frame || !carousel.contains(frame)) return;

      const card = frame.querySelector('[data-rq-problem-card]');
      if (!(card instanceof HTMLElement)) return;
      const index = cards.indexOf(card);
      if (index < 0) return;
      if (card.getAttribute('data-rq-problem-distance') === 'hidden') return;

      activate(index, { interacted: true, scroll: true });
    });

    cards.forEach((card, index) => {
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(index, { interacted: true, scroll: true, focus: true });
        }

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          moveBy(1, { focus: true });
        }

        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          moveBy(-1, { focus: true });
        }

        if (event.key === 'Home') {
          event.preventDefault();
          activate(0, { interacted: true, scroll: true, focus: true });
        }

        if (event.key === 'End') {
          event.preventDefault();
          activate(cards.length - 1, { interacted: true, scroll: true, focus: true });
        }
      });
    });

    prevButton?.addEventListener('click', () => moveBy(-1, { focus: true }));
    nextButton?.addEventListener('click', () => moveBy(1, { focus: true }));

    carousel.addEventListener('pointerdown', markInteracted, { passive: true });
    carousel.addEventListener('touchstart', markInteracted, { passive: true });
    carousel.addEventListener('wheel', markInteracted, { passive: true });
    carousel.addEventListener('scroll', scheduleScrollSettle, { passive: true });

    if ('onscrollend' in window) {
      carousel.addEventListener('scrollend', settleScroll, { passive: true });
    }

    const handleResize = () => {
      clearScrollTimer();
      root.classList.remove('is-scrolling');
      requestCoverflow();
      if (diagnosticInView) scrollCardIntoView(activeIndex);
    };

    const handleReducedMotionChange = () => {
      root.classList.remove('is-scrolling');
      requestCoverflow();
      if (diagnosticInView) scrollCardIntoView(activeIndex);
    };

    window.addEventListener('resize', handleResize, { passive: true });
    if (typeof reducedMotionQuery?.addEventListener === 'function') {
      reducedMotionQuery.addEventListener('change', handleReducedMotionChange);
    } else if (typeof reducedMotionQuery?.addListener === 'function') {
      reducedMotionQuery.addListener(handleReducedMotionChange);
    }

    const gate = inViewGate(root, {
      rootMargin: '120px 0px',
      onEnter: () => {
        diagnosticInView = true;
        requestCoverflow();
      },
      onExit: () => {
        diagnosticInView = false;
        clearScrollTimer();
        root.classList.remove('is-scrolling');
      },
    });

    activate(0, { forceAnimation: false });

    window.addEventListener('pagehide', () => {
      clearScrollTimer();
      clearPanelTimer();
      clearCoverflowFrame();
      window.removeEventListener('resize', handleResize);
      if (typeof reducedMotionQuery?.removeEventListener === 'function') {
        reducedMotionQuery.removeEventListener('change', handleReducedMotionChange);
      } else if (typeof reducedMotionQuery?.removeListener === 'function') {
        reducedMotionQuery.removeListener(handleReducedMotionChange);
      }
      gate.destroy();
    }, { once: true });
  })();
</script>
