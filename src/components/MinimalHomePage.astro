---
import MinimalPricing from './MinimalPricing.astro';
import ServiceStories from './ServiceStories.astro';
import MinimalAudience from './MinimalAudience.astro';
import RqContactForm from './RqContactForm.astro';
import { homeContent } from '../data/home';
import type { Locale } from '../data/locales';
const { lang = 'cs' } = Astro.props as {lang?: Locale};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const starts = lang === 'en' ? [
  {id:'web', title:'Make your offer clear.', detail:'A website that starts a conversation.'},
  {id:'terminy', title:'Let customers choose a time.', detail:'Bookings without the back-and-forth.'},
  {id:'data', title:'Keep work connected.', detail:'Records without retyping.'},
] : [
  {id:'web', title:'Ať je jasné, co nabízíte.', detail:'Web, ze kterého vznikne domluva.'},
  {id:'terminy', title:'Ať si zákazník vybere termín.', detail:'Rezervace bez telefonování sem a tam.'},
  {id:'data', title:'Ať na sebe práce navazuje.', detail:'Evidence bez zbytečného přepisování.'},
];
---
      <main>
        <section class="rq-minimal-preview__intro rq-home-intro" aria-labelledby="uvod">
          <div class="rq-home-intro__main">
          <h1 id="uvod">{lang === "en" ? 'Websites and automation that simplify your work.' : 'Weby a automatizace, které usnadňují podnikání.'}</h1>
          {lang === "cs" ? <MinimalAudience /> : <p class="rq-minimal-preview__lead">For sole traders and small businesses.</p>}
          <p class="rq-minimal-preview__intro-detail">{lang === "en" ? 'A clear website, easier bookings or connected records for sole traders, small businesses and associations. Work directly with me, primarily online and by phone.' : 'Srozumitelný web, jednodušší rezervace nebo propojená evidence pro živnostníky, malé firmy a spolky. Spolupracujete přímo se mnou, především online a telefonicky.'}</p>
          <p class="rq-home-price">{lang === 'en' ? 'One-page website' : 'Jednostránkový web'} <strong>{lang === 'en' ? 'from CZK 10,000' : 'od 10 000 Kč'}</strong></p>
          <div class="rq-home-actions"><a class="rq-minimal-preview__cta" href="#kontakt">{lang === "en" ? 'Discuss your project' : 'Probrat projekt'}</a><a href="#ceny">{lang === 'en' ? 'View prices' : 'Prohlédnout ceny'} <span aria-hidden="true">↗</span></a></div>
          <a class="rq-home-audit" href="#audit"><span>{homeContent[lang].pricing.audit.title}</span><span class="rq-starts__audit-price">{homeContent[lang].pricing.audit.price} <span aria-hidden="true">↗</span></span></a>
          <p class="rq-home-response">{lang === 'en' ? 'No obligation. I reply within one working day.' : 'Nezávazně. Ozvu se do 1 pracovního dne.'}</p>
          </div>
          <nav class="rq-starts" aria-label={lang === 'en' ? 'Where can we start?' : 'Kde můžeme začít?'}>
            <p class="rq-starts__label">{lang === 'en' ? 'Where can we start?' : 'Kde můžeme začít?'}</p>
            <div class="rq-starts__audit">
              <p>{lang === 'en' ? 'Not sure yet? Let’s identify what to tackle first.' : 'Nejste si jistí? Ujasníme, co řešit jako první.'}</p>
              <a class="rq-starts__audit-link" href="#audit"><span>{homeContent[lang].pricing.audit.title}</span><span class="rq-starts__audit-price">{homeContent[lang].pricing.audit.price} <span aria-hidden="true">↗</span></span></a>
            </div>
            <ol>{starts.map((item,i)=><li><a href={`#sluzba-${item.id}`}><span class="rq-starts__number" aria-hidden="true">0{i+1}</span><span><strong>{item.title}</strong><small>{item.detail}</small></span><span class="rq-starts__arrow" aria-hidden="true">↘</span></a></li>)}</ol>
          </nav>
        </section>
        <ServiceStories lang={lang} />
        <MinimalPricing lang={lang} />
        <span id="jak-pracuji"></span><span id="process"></span><section id="pristup" aria-labelledby="pristup-nadpis">
          <div class="rq-minimal-preview__section-head"><h2 id="pristup-nadpis">{lang === "en" ? 'Approach' : 'Přístup'}</h2><p>{lang === "en" ? 'Understand first.' : 'Nejdřív porozumět.'}<br />{lang === "en" ? 'Then build.' : 'Potom stavět.'}</p></div>
          <ol class="rq-minimal-preview__steps">
            <li><strong>{lang === "en" ? 'Understand the task' : 'Ujasnit zadání'}</strong><p>{lang === "en" ? 'What makes your work harder? What already works? We define the goal and the limits.' : 'Co vám komplikuje práci? Co už funguje? Pojmenujeme cíl i hranice řešení.'}</p></li>
            <li><strong>{lang === "en" ? 'Plan a small solution' : 'Navrhnout malé řešení'}</strong><p>{lang === "en" ? 'We review scope, priorities and the first useful result. We agree a price based on the task.' : 'Projdeme rozsah, priority a podobu prvního použitelného výsledku. Cenu domluvíme podle zadání.'}</p></li>
            <li><strong>{lang === "en" ? 'Build and verify' : 'Postavit a ověřit'}</strong><p>{lang === "en" ? 'We build a working solution and review how to use it together.' : 'Návrh převedeme do funkční podoby a společně projdeme, jak se používá v praxi.'}</p></li>
            <li><strong>{lang === "en" ? 'Hand over and explain' : 'Předat a vysvětlit'}</strong><p>{lang === "en" ? 'You receive source code, access to your accounts, a short guide and training.' : 'Dostanete zdrojový kód, přístupy, stručný návod a zaškolení.'}</p></li>
          </ol>
          <p class="rq-handoff">{lang === 'en' ? 'Your website and source code are handed over to accounts you own. You receive a record of the work and agreed next steps. Post-launch care is arranged separately.' : 'Web i zdrojový kód předám pod vaše vlastní účty. Dostanete přehled provedené práce a domluvených dalších kroků. Péči po spuštění domluvíme zvlášť.'}</p>
          <div class="rq-disclosures">
            <details id="predani-podrobnosti" class="rq-disclosure">
              <summary><span>{lang === 'en' ? 'What you receive' : 'Co přesně převezmete'}</span><span class="rq-disclosure__mark" aria-hidden="true"></span></summary>
              <div class="rq-disclosure__body">
                <p>{lang === 'en' ? 'We go through the finished solution together, so you know where to find everything and how to use it.' : 'Hotové řešení projdeme společně, abyste věděli, kde co najít a jak s ním pracovat.'}</p>
                <ul>
                  <li>{lang === 'en' ? 'Source code and access under your own accounts.' : 'Zdrojový kód a přístupy pod vašimi účty.'}</li>
                  <li>{lang === 'en' ? 'A short guide and training for everyday use.' : 'Stručný návod a zaškolení pro běžnou práci.'}</li>
                  <li>{lang === 'en' ? 'A record of completed work and agreed next steps.' : 'Přehled hotové práce a domluvených dalších kroků.'}</li>
                </ul>
                <p>{lang === 'en' ? 'You can continue with another developer. Care after launch is a separate service, agreed with you in advance.' : 'Můžete pokračovat i s jiným vývojářem. Péče po spuštění je samostatná služba, kterou domluvíme předem.'}</p>
              </div>
            </details>
            <details id="overeni-podrobnosti" class="rq-disclosure">
              <summary><span>{lang === 'en' ? 'How we check the result' : 'Jak ověříme výsledek'}</span><span class="rq-disclosure__mark" aria-hidden="true"></span></summary>
              <div class="rq-disclosure__body">
                <p>{lang === 'en' ? 'We agree what the solution needs to do before work starts. Before handover, we check the main tasks, common error cases and, for websites, how it works on mobile.' : 'Předem domluvíme, co má řešení splnit. Před předáním projdeme hlavní úkoly, běžné chybové stavy a u webu i použití na mobilu.'}</p>
                <p>{lang === 'en' ? 'The handover record explains what is finished, what we checked and which next steps make sense. Any changes beyond the agreed scope are discussed first.' : 'Do přehledu práce zapíšu, co je hotové, co jsme ověřili a které další kroky dávají smysl. Změny mimo domluvený rozsah si nejdřív odsouhlasíme.'}</p>
              </div>
            </details>
          </div>
        </section>
        <span id="about"></span><section id="autor" aria-labelledby="autor-nadpis" class="rq-minimal-preview__about">
          <h2 id="autor-nadpis">{lang === "en" ? 'Who is behind RadeQ' : 'Kdo za tím stojí'}</h2>
          <div><p class="rq-minimal-preview__author">{homeContent[lang].about.name}</p><p>{lang === "en" ? 'RadeQ is my business brand. You work directly with me on the design, build and handoff.' : 'RadeQ je moje podnikatelská značka. Návrh, realizaci i předání řešíte přímo se mnou.'}</p><p>{lang === "en" ? 'I help turn everyday problems into clear tasks and useful solutions. We choose technology based on the work it should simplify.' : 'Pomáhám převést každodenní problém do srozumitelného zadání a použitelného řešení. Technologie vybíráme podle práce, kterou mají usnadnit.'}</p>
            <p>{lang === 'en' ? 'Professional profiles:' : 'Profesní profily:'} <a href="https://www.linkedin.com/in/sirradek">LinkedIn</a> · <a href="https://github.com/SirRadek">GitHub</a>. {lang === 'en' ? 'Business listings:' : 'Firemní záznamy:'} <a href="https://www.firmy.cz/detail/14036384-radeq-praha-nusle.html">Firmy.cz</a> · <a href="https://www.zivefirmy.cz/radeq_f1952239">Živéfirmy</a>.</p>
            <div class="rq-disclosures">
              <details id="zkusenosti-podrobnosti" class="rq-disclosure">
                <summary><span>{lang === 'en' ? 'Experience behind the work' : 'Zkušenosti za mou prací'}</span><span class="rq-disclosure__mark" aria-hidden="true"></span></summary>
                <div class="rq-disclosure__body">{homeContent[lang].about.paragraphs.slice(1, 3).map(paragraph => <p>{paragraph}</p>)}</div>
              </details>
              <details id="radeq-vlastni-projekt" class="rq-disclosure">
                <summary><span>{lang === 'en' ? 'My own project: RadeQ.cz' : 'Vlastní projekt: RadeQ.cz'}</span><span class="rq-disclosure__mark" aria-hidden="true"></span></summary>
                <div class="rq-disclosure__body">
                  <p><strong>{lang === 'en' ? 'Task. ' : 'Zadání. '}</strong>{lang === 'en' ? 'Present my services clearly and let visitors send an enquiry in Czech or English.' : 'Srozumitelně představit vlastní nabídku a umožnit návštěvníkovi poslat poptávku v češtině i angličtině.'}</p>
                  <p><strong>{lang === 'en' ? 'Decisions. ' : 'Rozhodnutí. '}</strong>{lang === 'en' ? 'Three starting points: a website, bookings or connected records. Indicative prices, labelled model demos and source code kept under version control.' : 'Tři vstupy podle potřeby: web, rezervace a propojená evidence. Orientační ceny, označené modelové ukázky a zdrojový kód s historií změn.'}</p>
                  <p><strong>{lang === 'en' ? 'Checks. ' : 'Ověření. '}</strong>{lang === 'en' ? 'The release checks on 30 October 2026 covered both languages, mobile and desktop layouts, keyboard navigation, links and page metadata. Form behaviour was tested in a controlled environment.' : 'Kontroly vydání 30. října 2026 zahrnovaly oba jazyky, mobil i desktop, ovládání klávesnicí, odkazy a metadata stránek. Chování formuláře bylo ověřeno v řízeném testovacím prostředí.'}</p>
                  <p>{lang === 'en' ? 'This is my own website, not a client engagement. These checks do not establish live email delivery, search rankings or business results.' : 'Jde o můj vlastní web, nikoli klientskou zakázku. Tyto kontroly nedokládají živé doručení e-mailů, pozice ve vyhledávání ani obchodní výsledky.'}</p>
                  <p><a href="https://github.com/SirRadek/radeq/tree/codex/radeq-clean-pages-20261013">{lang === 'en' ? 'Source code' : 'Zdrojový kód'}</a> · <a href="https://github.com/SirRadek/radeq/blob/55c6be375780094ad2457c329e8fd007fd49a364/docs/verification/2026-10-30-audit/README.md">{lang === 'en' ? 'Release check record and limits' : 'Doklad kontrol vydání a jejich limity'}</a> · <a href={base + (lang === 'en' ? '/en/ukazky/' : '/ukazky/')}>{lang === 'en' ? 'Try the model demos' : 'Vyzkoušet modelové ukázky'}</a></p>
                </div>
              </details>
            </div>
          </div>
        </section>
        <span id="terminal"></span><span id="contact"></span><section id="kontakt" aria-labelledby="kontakt-nadpis" class="rq-minimal-preview__contact">
          <h2 id="kontakt-nadpis">{lang === "en" ? 'Let’s discuss your project' : 'Pojďme probrat váš záměr'}</h2>
          <div class="rq-minimal-preview__contact-grid">
            <div><p>{lang === "en" ? 'Tell me what you do, what makes your work harder and what result would help. We can find a sensible place to start.' : 'Stačí napsat, čemu se věnujete, co vám teď komplikuje práci a jaký výsledek by vám pomohl. Podíváme se, kde dává smysl začít.'}</p><p class="rq-home-response">{lang === 'en' ? 'I reply within one working day.' : 'Odpovídám do 1 pracovního dne.'}</p><a class="rq-minimal-preview__email" href="mailto:siroky@radeq.cz">siroky@radeq.cz</a><div class="rq-minimal-preview__contact-links"><a href="tel:+420730634439">+420 730 634 439</a></div></div>
            <div class="rq-minimal-preview__form-surface"><RqContactForm content={homeContent[lang].contact} lang={lang} /></div>
          </div>
        </section>
      </main>
