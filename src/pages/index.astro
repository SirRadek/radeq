---
import RqLayout from '../layouts/RqLayout.astro';
import RqHeader from '../components/RqHeader.astro';
import RqFooter from '../components/RqFooter.astro';
import RqGuide from '../components/RqGuide.astro';
import RqJourney from '../components/RqJourney.astro';
import RqMotion from '../components/RqMotion.astro';
import RqProblemDiagnostic from '../components/RqProblemDiagnostic.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '#co-resim', label: 'Co řeším' },
  { href: '#sluzby', label: 'Služby' },
  { href: '#jak-pracuji', label: 'Postup' },
  { href: '#ceny', label: 'Ceny' },
  { href: '/ukazky/', label: 'Ukázky' },
  { href: '#kontakt', label: 'Kontakt' },
];

const symptoms = [
  'pomalý web',
  'poptávky se ztrácí v mailu',
  'ruční přepisování do Excelu',
  'nejasné CTA',
  'web nevodí zákazníky',
  'žádné měření',
  'chaos v nástrojích',
];
---

<RqLayout title="RadeQ.cz - Racionální digitalizace" description="Weby, data a automatizace pro živnostníky, malé firmy a spolky." lang="cs">
  <RqHeader content={{ navItems: nav }} alternateLabel="EN" alternatePath="/en/" />

  <main>
    <section class="rq-section rq-hero" id="top" style="--rq-reveal-index: 0">
      <div class="rq-hero__content">
        <div class="rq-hero__copy">
          <p class="rq-eyebrow" data-rq-reveal style="--rq-i:0">Racionální digitalizace</p>
          <h1 class="rq-display" data-rq-reveal style="--rq-i:1">Weby, data a automatizace, které vám uvolní ruce.</h1>
          <p class="rq-hero__typewriter" data-rq-reveal style="--rq-i:2">
            <span class="rq-hero__tw-prefix">Pro&nbsp;</span><span
              class="rq-hero__tw-rotator"
              data-rq-typewriter
              data-rq-words="živnostníky|salony|malé firmy|lokální služby"
            ><span class="rq-hero__tw-sizer" aria-hidden="true">lokální služby</span><span class="rq-hero__tw-text" aria-hidden="true">živnostníky</span></span>
            <span class="rq-sr-only" data-rq-typewriter-live aria-live="polite">Pro živnostníky, salony, malé firmy a lokální služby.</span>
          </p>
          <p class="rq-lead" data-rq-reveal style="--rq-i:3">Pomůžu vám zjednodušit web, poptávky, evidenci nebo ruční práci v tabulkách. Navrhnu řešení, postavím ho, ověřím v praxi a předám tak, abyste ho zvládli používat bez závislosti na dodavateli.</p>
          <p class="rq-hero__journey-note" data-rq-reveal style="--rq-i:4">Postup od problému k ověřenému výsledku.</p>
        </div>

        <div class="rq-proof-rail" data-rq-reveal style="--rq-i:5" aria-label="Důkazy a orientační ceny">
          <div class="rq-proof-rail__item">
            <p class="rq-proof-rail__label">Web od 9 900 Kč</p>
            <p class="rq-proof-rail__text">jasná nabídka a měřitelné poptávky</p>
          </div>
          <div class="rq-proof-rail__item">
            <p class="rq-proof-rail__label">Audit od 4 900 Kč</p>
            <p class="rq-proof-rail__text">zjistíte, co brzdí; audit odečtu z realizace</p>
          </div>
          <div class="rq-proof-rail__item">
            <p class="rq-proof-rail__label">Postavím · změřím · předám</p>
            <p class="rq-proof-rail__text">bez závislosti na dodavateli</p>
          </div>
        </div>

        <div class="rq-hero__actions" data-rq-reveal style="--rq-i:6">
          <a class="rq-btn rq-btn--primary" href="#kontakt" data-rq-magnetic>Napsat poptávku</a>
          <a class="rq-btn rq-btn--ghost" href="#ukazky-teaser">Ukázky práce</a>
          <p class="rq-hero__micro">Nezávazně. Ozvu se do 1 pracovního dne.</p>
        </div>
      </div>

    </section>

  <script is:inline>
    (() => {
      const el = document.querySelector('[data-rq-typewriter]');
      if (!el) return;
      const textEl = el.querySelector('.rq-hero__tw-text');
      const liveEl = el.parentElement && el.parentElement.querySelector('[data-rq-typewriter-live]');
      const words = (el.getAttribute('data-rq-words') || '').split('|').map((w) => w.trim()).filter(Boolean);
      if (!textEl || words.length === 0) return;

      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { textEl.textContent = words[0]; return; }

      const TYPE = 70, DEL = 38, HOLD = 1600, GAP = 320;
      const MAX_CYCLES = 3;
      const finalWord = words[words.length - 1];
      const observeTarget = el.closest('.rq-hero__typewriter') || el;
      const prefixEl = el.parentElement && el.parentElement.querySelector('.rq-hero__tw-prefix');
      const livePrefix = prefixEl ? prefixEl.textContent.replace(/\s+/g, ' ') : '';
      let wi = 0, ci = words[0].length, deleting = true;
      let cycles = 0;
      let inView = false;
      let stopped = false;
      let timerId = 0;
      let nextDelay = HOLD;
      let observer = null;

      function clearTimer() {
        if (!timerId) return;
        window.clearTimeout(timerId);
        timerId = 0;
      }

      function disconnectObserver() {
        if (!observer) return;
        observer.disconnect();
        observer = null;
      }

      function cleanup() {
        clearTimer();
        disconnectObserver();
      }

      function schedule(delay) {
        nextDelay = delay;
        clearTimer();
        if (!inView || stopped || document.hidden) return;
        timerId = window.setTimeout(() => {
          timerId = 0;
          tick();
        }, delay);
      }

      function resume() {
        if (timerId || stopped || document.hidden) return;
        schedule(nextDelay);
      }

      function stopOnFinalWord() {
        stopped = true;
        deleting = false;
        wi = words.length - 1;
        ci = finalWord.length;
        textEl.textContent = finalWord;
        textEl.classList.add('is-rq-typewriter-done');
        if (liveEl) liveEl.textContent = `${livePrefix}${finalWord}.`;
        cleanup();
      }

      function maybeStopAfterCycle(word) {
        if (word !== finalWord) return false;
        cycles += 1;
        if (cycles < MAX_CYCLES) return false;
        stopOnFinalWord();
        return true;
      }

      function tick() {
        if (!inView || stopped || document.hidden) return;
        const word = words[wi];
        if (!deleting) {
          ci += 1;
          textEl.textContent = word.slice(0, ci);
          if (ci >= word.length) {
            if (liveEl) liveEl.textContent = word;
            if (maybeStopAfterCycle(word)) return;
            deleting = true;
            schedule(HOLD);
            return;
          }
          schedule(TYPE);
          return;
        }
        ci -= 1;
        textEl.textContent = word.slice(0, Math.max(ci, 0));
        if (ci <= 0) {
          deleting = false;
          wi = (wi + 1) % words.length;
          schedule(GAP);
          return;
        }
        schedule(DEL);
      }

      function setInView(nextInView) {
        if (stopped) return;
        inView = nextInView;
        if (!inView) {
          clearTimer();
          return;
        }
        resume();
      }

      function observeInView() {
        if (stopped) return;
        disconnectObserver();
        if (!('IntersectionObserver' in window)) {
          setInView(true);
          return;
        }
        observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          setInView(Boolean(entry && entry.isIntersecting));
        }, { rootMargin: '120px 0px' });
        observer.observe(observeTarget);
      }

      // Start showing the SSR word, hold, then delete and cycle.
      observeInView();
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          inView = false;
          cleanup();
          return;
        }
        observeInView();
      });
      window.addEventListener('pagehide', () => {
        inView = false;
        cleanup();
      });
    })();
  </script>

<RqProblemDiagnostic />

<section class="rq-marquee rq-bleed" aria-label="Typické symptomy před úpravou webu a procesů" data-rq-marquee>
  <div class="rq-marquee__viewport">
    <div class="rq-marquee__track" data-rq-marquee-track>
      {[0, 1].map((groupIndex) => (
        <span class="rq-marquee__group" data-rq-marquee-group={groupIndex === 0 ? 'true' : undefined} aria-hidden={groupIndex === 1 ? 'true' : undefined}>
          {symptoms.map((symptom) => (
            <>
              <span class="rq-marquee__item">{symptom}</span>
              <span class="rq-marquee__sep" aria-hidden="true">•</span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>
</section>

<section id="sluzby" class="rq-section rq-bleed rq-services-bento" aria-labelledby="rq-sluzby-title">
  <div class="rq-bleed__inner">
    <p class="rq-eyebrow">Služby</p>
    <h2 id="rq-sluzby-title" class="rq-h2">Co vám zjednoduším</h2>
    <div class="rq-services-bento__grid" data-rq-service-rotator data-rq-reveal aria-label="Služby a orientační ceny">
      <article class="rq-offer rq-service-tile rq-hoverable is-featured" data-rq-slot="web" aria-current="true" style="--rq-i: 0;">
        <p class="rq-offer__price">od 9 900 Kč</p>
        <h3>Web a redesign</h3>
        <p class="rq-offer__result">Výsledek: web, který návštěvníkovi rychle vysvětlí nabídku a přivádí poptávky.</p>
        <ul class="rq-offer__outputs">
          <li>rychlý jednostránkový web (Astro) + poptávkový formulář</li>
          <li>základní SEO pro Google i Seznam + měření</li>
          <li>předání tak, že drobnosti zvládnete měnit sami</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--shop rq-hoverable" data-rq-slot="shop" style="--rq-i: 1;">
        <p class="rq-offer__price">od 19 900 Kč</p>
        <h3>E-shop</h3>
        <p class="rq-offer__result">Výsledek: malý vlastněný obchod bez zbytečností, který sami utáhnete.</p>
        <ul class="rq-offer__outputs">
          <li>katalog, košík, varianty</li>
          <li>doprava a platba dle platformy</li>
          <li>předání + krátké zaškolení</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--automation rq-hoverable" data-rq-slot="automation" style="--rq-i: 2;">
        <p class="rq-offer__price">od 12 000 Kč</p>
        <h3>Automatizace procesů</h3>
        <p class="rq-offer__result">Výsledek: konec ručního přepisování — co děláte opakovaně, běží samo.</p>
        <ul class="rq-offer__outputs">
          <li>analýza jednoho procesu od začátku do konce</li>
          <li>jeden funkční automatický tok</li>
          <li>dokumentace + předání</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--data rq-hoverable" data-rq-slot="data" style="--rq-i: 3;">
        <p class="rq-offer__price">od 15 000 Kč</p>
        <h3>Data a AI pomocníci</h3>
        <p class="rq-offer__result">Výsledek: přehled ve vlastních datech a AI nasazená prakticky a bezpečně.</p>
        <ul class="rq-offer__outputs">
          <li>sběr a vyčištění dat</li>
          <li>jednoduchý přehled / report</li>
          <li>AI pomocník nad schválenými podklady</li>
        </ul>
      </article>

      <article class="rq-offer rq-service-tile rq-service-tile--audit rq-hoverable" data-rq-slot="audit" style="--rq-i: 4;">
        <span class="rq-flag">Nízkorizikový start</span>
        <p class="rq-offer__price">4 900 Kč</p>
        <h3>Audit webu nebo procesu</h3>
        <p class="rq-offer__result">Výsledek: víte, co nejvíc brzdí a co řešit první — cenu odečtu z realizace.</p>
        <ul class="rq-offer__outputs">
          <li>technický stav, rychlost, SEO základ, formuláře</li>
          <li>seznam problémů podle priority</li>
          <li>doporučení, co hned a co počká</li>
        </ul>
      </article>
    </div>
    <div class="rq-services-bento__cta">
      <a class="rq-btn rq-btn--primary" href="#kontakt">Domluvit nezávazný rozbor</a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-rq-service-rotator]');
    if (!grid) return;

    const tiles = Array.from(grid.querySelectorAll('.rq-service-tile'));
    if (tiles.length < 2) return;

    const ROTATION_MS = 20000;
    const FLIP_MS = 620;
    const FEATURED_SLOT = 'web';
    const SLOTS = ['web', 'shop', 'automation', 'data', 'audit'];
    const SMALL_SLOTS = SLOTS.filter((slot) => slot !== FEATURED_SLOT);
    const FLIP_EASING = 'cubic-bezier(.25,1,.5,1)';
    const initialFeatured = tiles.find((tile) => tile.classList.contains('is-featured')) || tiles[0];
    const initialSlots = new Map(tiles.map((tile) => [tile, tile.dataset.rqSlot || '']));
    const reduceQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');
    const mobileQuery = window.matchMedia?.('(max-width: 860px)');
    const supportsAnimations = typeof tiles[0].animate === 'function';
    const supportsProgressRing = typeof CSS !== 'undefined' && 'registerProperty' in CSS;
    const slotOrders = permute(SMALL_SLOTS);

    let observer = null;
    let resizeTimer = 0;
    let timerId = 0;
    let timerStartedAt = 0;
    let remainingMs = ROTATION_MS;
    let inView = false;
    let pointerPaused = false;
    let focusPaused = false;
    let isAnimating = false;
    let userLocked = false;
    let enhancementAvailable = false;

    function permute(items) {
      if (items.length <= 1) return [items.slice()];
      return items.flatMap((item, index) => {
        const rest = items.slice(0, index).concat(items.slice(index + 1));
        return permute(rest).map((order) => [item].concat(order));
      });
    }

    function canEnhance() {
      return supportsAnimations && !reduceQuery?.matches && !mobileQuery?.matches;
    }

    function currentFeatured() {
      return tiles.find((tile) => tile.classList.contains('is-featured')) || initialFeatured;
    }

    function setFeatured(tile) {
      tiles.forEach((candidate) => {
        const active = candidate === tile;
        candidate.classList.toggle('is-featured', active);
        if (active) {
          candidate.setAttribute('aria-current', 'true');
        } else {
          candidate.removeAttribute('aria-current');
        }
      });
    }

    function resetToInitialState() {
      tiles.forEach((tile) => {
        const slot = initialSlots.get(tile);
        if (slot) tile.dataset.rqSlot = slot;
      });
      setFeatured(initialFeatured);
    }

    function setInteractive(enabled) {
      tiles.forEach((tile) => {
        if (!enabled) {
          tile.removeAttribute('role');
          tile.removeAttribute('tabindex');
          return;
        }
        tile.setAttribute('role', 'button');
        tile.setAttribute('tabindex', '0');
      });
    }

    function clearTimer() {
      if (!timerId) return;
      window.clearTimeout(timerId);
      timerId = 0;
    }

    function pauseTimer() {
      if (!timerId) return;
      remainingMs = Math.max(0, remainingMs - (performance.now() - timerStartedAt));
      clearTimer();
    }

    function scheduleTimer() {
      if (timerId || !enhancementAvailable || userLocked || isAnimating || !inView || pointerPaused || focusPaused || document.hidden) return;
      timerStartedAt = performance.now();
      timerId = window.setTimeout(() => {
        timerId = 0;
        remainingMs = ROTATION_MS;
        autoAdvance();
      }, remainingMs);
    }

    function syncPauseState() {
      const paused = !enhancementAvailable || userLocked || isAnimating || !inView || pointerPaused || focusPaused || document.hidden;
      grid.classList.toggle('is-paused', paused);
      if (paused) {
        pauseTimer();
      } else {
        scheduleTimer();
      }
    }

    function disconnectObserver() {
      if (!observer) return;
      observer.disconnect();
      observer = null;
    }

    function observeGrid() {
      disconnectObserver();
      if (!('IntersectionObserver' in window)) {
        inView = false;
        syncPauseState();
        return;
      }
      observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        inView = Boolean(entry && entry.isIntersecting);
        syncPauseState();
      }, { threshold: 0.15 });
      observer.observe(grid);
    }

    function getNextTile() {
      const active = currentFeatured();
      const start = tiles.indexOf(active);
      for (let offset = 1; offset < tiles.length; offset += 1) {
        const candidate = tiles[(start + offset) % tiles.length];
        if (candidate && candidate !== active) return candidate;
      }
      return null;
    }

    function applySwap(target) {
      const active = currentFeatured();
      if (!target || target === active) return false;

      const releasedSlot = target.dataset.rqSlot || initialSlots.get(target);
      active.dataset.rqSlot = releasedSlot;
      target.dataset.rqSlot = FEATURED_SLOT;
      setFeatured(target);
      return true;
    }

    function reserveGridHeight() {
      if (!enhancementAvailable) {
        grid.style.minHeight = '';
        return;
      }

      const width = grid.getBoundingClientRect().width;
      if (!width) return;

      grid.style.minHeight = '0px';

      const clone = grid.cloneNode(true);
      const cloneTiles = Array.from(clone.querySelectorAll('.rq-service-tile'));
      clone.removeAttribute('data-rq-reveal');
      clone.classList.remove('is-rotation-ready', 'is-paused', 'is-flipping', 'is-user-locked');
      clone.style.position = 'absolute';
      clone.style.left = '-10000px';
      clone.style.top = '0';
      clone.style.width = `${width}px`;
      clone.style.minHeight = '0';
      clone.style.visibility = 'hidden';
      clone.style.pointerEvents = 'none';

      document.body.appendChild(clone);
      let maxHeight = grid.getBoundingClientRect().height;

      cloneTiles.forEach((tile) => {
        tile.removeAttribute('role');
        tile.removeAttribute('tabindex');
      });

      cloneTiles.forEach((_, featuredIndex) => {
        const smallIndices = cloneTiles
          .map((tile, index) => index)
          .filter((index) => index !== featuredIndex);

        slotOrders.forEach((order) => {
          cloneTiles.forEach((tile, index) => {
            const active = index === featuredIndex;
            tile.classList.toggle('is-featured', active);
            tile.dataset.rqSlot = active ? FEATURED_SLOT : order[smallIndices.indexOf(index)];
          });
          maxHeight = Math.max(maxHeight, clone.getBoundingClientRect().height);
        });
      });

      clone.remove();
      grid.style.minHeight = `${Math.ceil(maxHeight)}px`;
    }

    function promoteTile(target) {
      const active = currentFeatured();
      if (!enhancementAvailable || !target || target === active || isAnimating) return;

      isAnimating = true;
      grid.classList.add('is-flipping');
      syncPauseState();

      const firstRects = new Map(tiles.map((tile) => [tile, tile.getBoundingClientRect()]));
      applySwap(target);
      const lastRects = new Map(tiles.map((tile) => [tile, tile.getBoundingClientRect()]));

      const animations = tiles.map((tile) => {
        const first = firstRects.get(tile);
        const last = lastRects.get(tile);
        if (!first || !last) return null;

        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const sx = first.width / Math.max(last.width, 1);
        const sy = first.height / Math.max(last.height, 1);
        const moved = Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5 || Math.abs(sx - 1) > 0.01 || Math.abs(sy - 1) > 0.01;
        if (!moved) return null;

        tile.style.transformOrigin = 'top left';
        tile.classList.add('is-flip-animating');
        return tile.animate([
          { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
          { transform: 'translate(0, 0) scale(1, 1)' },
        ], {
          duration: FLIP_MS,
          easing: FLIP_EASING,
          fill: 'both',
        });
      }).filter(Boolean);

      const finish = () => {
        tiles.forEach((tile) => {
          tile.style.transformOrigin = '';
          tile.classList.remove('is-flip-animating');
        });
        grid.classList.remove('is-flipping');
        isAnimating = false;
        remainingMs = ROTATION_MS;
        syncPauseState();
      };

      if (!animations.length) {
        finish();
        return;
      }

      Promise.allSettled(animations.map((animation) => animation.finished)).then(finish);
    }

    function autoAdvance() {
      if (!enhancementAvailable || userLocked || isAnimating || !inView || pointerPaused || focusPaused || document.hidden) {
        syncPauseState();
        return;
      }
      promoteTile(getNextTile());
    }

    function lockToTile(tile) {
      if (!enhancementAvailable || !tile || tile === currentFeatured()) return;
      userLocked = true;
      clearTimer();
      disconnectObserver();
      grid.classList.add('is-user-locked', 'is-paused');
      promoteTile(tile);
    }

    function configure() {
      enhancementAvailable = canEnhance();
      clearTimer();
      disconnectObserver();
      inView = false;
      pointerPaused = false;
      focusPaused = grid.contains(document.activeElement);
      remainingMs = ROTATION_MS;

      grid.classList.toggle('has-rq-progress-ring', supportsProgressRing && enhancementAvailable);
      grid.classList.toggle('is-user-locked', userLocked && enhancementAvailable);
      grid.classList.remove('is-flipping');

      if (!enhancementAvailable) {
        grid.classList.remove('is-rotation-ready', 'is-paused', 'has-rq-progress-ring', 'is-user-locked');
        setInteractive(false);
        resetToInitialState();
        grid.style.minHeight = '';
        return;
      }

      setInteractive(true);
      reserveGridHeight();
      grid.classList.add('is-rotation-ready', 'is-paused');

      if (userLocked) return;
      observeGrid();
    }

    function closestTile(event) {
      const eventTarget = event.target instanceof Element ? event.target : null;
      if (!eventTarget) return null;
      const tile = eventTarget.closest('.rq-service-tile');
      return tile && grid.contains(tile) ? tile : null;
    }

    function watchQuery(query) {
      if (!query) return;
      if (typeof query.addEventListener === 'function') {
        query.addEventListener('change', configure);
        return;
      }
      if (typeof query.addListener === 'function') {
        query.addListener(configure);
      }
    }

    grid.addEventListener('pointerenter', () => {
      if (!enhancementAvailable || userLocked) return;
      pointerPaused = true;
      syncPauseState();
    });

    grid.addEventListener('pointerleave', () => {
      if (!enhancementAvailable || userLocked) return;
      pointerPaused = false;
      syncPauseState();
    });

    grid.addEventListener('focusin', () => {
      if (!enhancementAvailable || userLocked) return;
      focusPaused = true;
      syncPauseState();
    });

    grid.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        if (!enhancementAvailable || userLocked) return;
        focusPaused = grid.contains(document.activeElement);
        syncPauseState();
      });
    });

    grid.addEventListener('click', (event) => {
      const target = closestTile(event);
      if (!target) return;
      lockToTile(target);
    });

    grid.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const target = closestTile(event);
      if (!target) return;
      event.preventDefault();
      lockToTile(target);
    });

    document.addEventListener('visibilitychange', () => {
      if (!enhancementAvailable || userLocked) return;
      syncPauseState();
    });

    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(configure, 160);
    });

    window.addEventListener('pagehide', () => {
      clearTimer();
      disconnectObserver();
    });

    watchQuery(reduceQuery);
    watchQuery(mobileQuery);

    configure();
  })();
</script>

