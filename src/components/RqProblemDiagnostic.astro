    transform: translateZ(0);
    transform-style: preserve-3d;
    transition: opacity 220ms var(--rq-ease), transform 260ms var(--rq-ease), box-shadow 220ms var(--rq-ease);
  }

  .rq-problem-diagnostic__card-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background:
      var(--rq-poster-dot-field),
      radial-gradient(70% 60% at 22% 18%, color-mix(in srgb, var(--rq-problem-genre-color) 22%, transparent), transparent 70%),
      radial-gradient(72% 58% at 78% 82%, color-mix(in srgb, var(--rq-diagnostic-accent) 13%, transparent), transparent 74%);
