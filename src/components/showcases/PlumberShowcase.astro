---
import {demoText} from '../themed-demos/demo-i18n.mjs';
const {lang = 'cs'} = Astro.props as {lang?: 'cs' | 'en'};
const t = (value: string) => demoText(lang, value);

import DemoThemeDocument from '../themed-demos/DemoThemeDocument.astro';
import {createInitialState,getProblemSummary,getContactSummary} from '../themed-demos/plumber-state.mjs';
const initial=createInitialState();
const help=getProblemSummary(initial);
---
<DemoThemeDocument lang={lang} title={t("Instalatér — modelová ukázka RadeQ")} description={t("Model instalatérské služby: vyberte problém, připravte popis a prohlédněte si kontakt. Nic se neodesílá.")} theme="plumber">
 <main data-plumber data-lang={lang}>
  <div class="composition">
   <section class="problem" aria-labelledby="problem-title">
    <p class="eyebrow">{t("Voda · odpady · montáž")}</p>
    <h1 id="problem-title">{t("Co doma")}<br/> {t("zlobí?")}</h1>
    <fieldset>
     <legend class="visually-hidden">{t("Typ problému (nepovinné)")}</legend>
     { [['water',t("Voda teče")],['connect',t("Něco zapojit")],['other',t("Jiné")]].map(([value,label])=><label><input type="radio" name="problem" value={value}/><span>{label}</span></label>) }
    </fieldset>
    <label class="description" for="description">{t("Popište závadu (nepovinné)")}</label>
    <textarea id="description" rows="3" maxlength="500" placeholder={t("Třeba: pod dřezem kape voda.")} aria-describedby="description-note"></textarea>
    <p class="note" id="description-note">{t("Stačí závada, bez osobních údajů. Text zůstává jen v této ukázce.")}</p>
   </section>
   <div class="contact-services">
    <section class="contact" aria-labelledby="contact-title">
     <div class="help" aria-live="polite" aria-atomic="true">
      <p class="eyebrow">{t("S čím pomůžeme")}</p>
      <h2 id="contact-title" data-help-title>{t(help.title)}</h2>
      <p data-help-detail>{t(help.detail)}</p>
     </div>
     <button type="button" data-js-action data-contact aria-expanded="false" aria-controls="contact-explanation" hidden>{t("Kontakt v ukázce")} <span aria-hidden="true">↗</span></button>
     <div id="contact-explanation" data-contact-explanation>
      <p class="eyebrow">{t("Připraveno k domluvě")}</p>
      <p class="contact-summary" data-contact-summary>{t(getContactSummary(initial))}</p>
      <p>{t("Na skutečném webu by následoval telefon nebo poptávka s tímto popisem. Tady pouze prohlížíte model kontaktu: nikomu se nevolá a nic se neodesílá.")}</p>
     </div>
     <noscript><p>{t("Výběr a shrnutí vyžadují JavaScript. Přehled služeb a vysvětlení kontaktu jsou dostupné i bez něj.")}</p></noscript>
     <button class="reset" type="button" data-js-action data-reset hidden>{t("Vrátit ukázku")}</button>
     <p class="status" data-status role="status" aria-live="polite"></p>
    </section>
    <section class="services" aria-labelledby="services-title">
     <h2 id="services-title">{t("Od kapky po výměnu")}</h2>
     <ul>
      <li><strong>{t("Voda a odpady")}</strong><span>{t("Netěsné spoje, baterie, odpady a WC.")}</span></li>
      <li><strong>{t("Montáž a výměna")}</strong><span>{t("Armatury, sanita a připojení bojleru.")}</span></li>
      <li><strong>{t("Drobné opravy")}</strong><span>{t("Ventily a menší úpravy rozvodů.")}</span></li>
     </ul>
     <dl class="area-hours">
      <div><dt>{t("Modelová oblast")}</dt><dd>{t("Kolín a okolní obce")}</dd></div>
      <div><dt>{t("Provozní doba")}</dt><dd>{t("Termín i víkend podle domluvy")}</dd></div>
     </dl>
     <p class="note">{t("Fiktivní služba pro ukázku webu, bez skutečné dostupnosti.")}</p>
    </section>
   </div>
   <svg class="pipe" aria-hidden="true" viewBox="0 0 1000 300" fill="none"><path d="M20 20h40q25 0 25 25v160q0 25 25 25h570q25 0 25-25V90q0-25 25-25h150q25 0 25-25V10"/><circle cx="20" cy="20" r="8"/><circle cx="430" cy="230" r="8"/><circle cx="905" cy="10" r="8"/></svg>
  </div>
 </main>
 <script>
  import {mount} from '../themed-demos/plumber-client.js';
  const root=document.querySelector<HTMLElement>('[data-plumber]');if(root)mount(root);
 </script>
</DemoThemeDocument>
<style>
 main{padding-top:4.5rem;padding-bottom:15rem}
 .composition{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);column-gap:7rem;position:relative}
 .problem{grid-column:1;grid-row:1}.contact-services{grid-column:2;grid-row:1;display:flex;flex-direction:column;gap:2.5rem;align-self:start;min-width:0}
 section{position:relative;z-index:1;min-width:0}.eyebrow{font-size:.875rem;color:#235ac6;margin-bottom:1rem}
 h1{margin-bottom:2rem}.contact h2{font-size:clamp(1.65rem,2.8vw,2.3rem);margin-bottom:1rem}.contact p{font-size:1rem;line-height:1.6;margin-bottom:1.25rem}
 fieldset{border:0;padding:0;margin:2rem 0;display:flex;gap:.75rem 1.2rem;flex-wrap:wrap}fieldset label{display:flex;align-items:center;gap:.5rem;cursor:pointer;font-weight:600;min-height:44px}
 input[type=radio]{accent-color:#235ac6;width:1.1rem;min-height:1.1rem;flex-shrink:0}input:checked+span{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:.4em;color:#235ac6}
 .description{display:block;margin-bottom:.75rem}textarea{display:block;width:100%;min-width:0;padding:1.1rem;border:1px solid #235ac6;border-radius:1rem;color:#142b45;background:#e9f0fc;resize:vertical}textarea::placeholder{color:#405f82;opacity:1}
 .note{font-size:.875rem;line-height:1.6;margin-top:.75rem;color:#405f82}
 .contact button[data-contact]{display:flex;justify-content:space-between;align-items:center;gap:1rem;width:100%;border-radius:999px;background:#235ac6;color:#fff;padding:1.05rem 1.5rem;font-weight:600;text-align:left}
 [data-contact-explanation]{border-left:2px solid #235ac6;margin-top:1.5rem;padding-left:1.25rem;overflow-wrap:anywhere}.contact-summary{font-weight:600;white-space:pre-wrap}.contact .eyebrow{font-size:.875rem;margin-bottom:.75rem}
 .reset{background:transparent;color:#235ac6;text-decoration:underline;text-underline-offset:.3em;padding:.5rem 0;margin-top:.75rem}.contact .status{margin:0;min-height:1.6em;font-size:.875rem}
 .services h2{font-size:1.3rem;margin-bottom:.5rem}ul{padding:0;margin:0;list-style:none}li{padding:.8rem 0;border-bottom:1px solid #afc4e9;font-size:1rem}li strong,li span{display:block}li span{color:#405f82;margin-top:.15rem;font-size:.875rem}
 .area-hours{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.5rem 0 0;font-size:.875rem}.area-hours dt{color:#405f82}.area-hours dd{margin:.3rem 0 0}
 .pipe{position:absolute;left:38%;top:100%;margin-top:1rem;width:62%;height:14rem;z-index:0;pointer-events:none;stroke:#235ac6;stroke-width:3;overflow:visible}.pipe circle{fill:#235ac6;stroke:#f8fafb;stroke-width:4}
 .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
 @media(max-width:1100px){main{padding-bottom:0}.composition{column-gap:3rem}.pipe{display:none}}
 @media(max-width:700px){main{padding-top:3rem}.composition{display:flex;flex-direction:column;gap:2rem}.contact-services{gap:2rem;align-self:stretch}h1 br{display:none}.area-hours{grid-template-columns:1fr}}
</style>
