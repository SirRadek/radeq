---
import { homeContent, type HomeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
  content?: HomeContent['problems'];
  lang?: Locale;
}

const { content = homeContent.cs.problems, lang = 'cs' } = Astro.props;
const items = content.items;
const roleLabels = content.roleLabels;
const problemIndicatorLabel = lang === 'en' ? 'Problem' : 'Problém';
const timelineAriaLabel = lang === 'en' ? 'Problem timeline' : 'Časová osa problémů';
const stars = Array.from({ length: 5 });
---

<section class="rq-section rq-problem-diagnostic" id="co-resim" aria-labelledby="rq-problem-diagnostic-title" data-rq-problem-diagnostic data-rq-active-index="0">
  <span class="rq-problem-diagnostic__alias" id="diagnostika" aria-hidden="true"></span>
  <div class="rq-problem-diagnostic__inner">
    <header class="rq-problem-diagnostic__head" data-rq-reveal>
      <div class="rq-problem-diagnostic__copy">
        <p class="rq-eyebrow">{content.eyebrow}</p>
        <h2 class="rq-h2 rq-h2--feature rq-problem-diagnostic__title" id="rq-problem-diagnostic-title">{content.title}</h2>
        <p class="rq-problem-diagnostic__lead">{content.lead}</p>
      </div>
      <p class="rq-problem-diagnostic__badge">{content.badgeText}</p>
    </header>

    <div class="rq-problem-diagnostic__shell" data-rq-reveal>
      <div class="rq-problem-diagnostic__meta-row">
        <p class="rq-problem-diagnostic__severity-legend" id="rq-problem-severity-legend">
          <strong>{content.severityLegend.strong}</strong> {content.severityLegend.text}
        </p>
      </div>

      <div class="rq-problem-diagnostic__board">
        <div class="rq-problem-diagnostic__stage" aria-label={content.controlsAriaLabel}>
          <button class="rq-problem-diagnostic__nav rq-problem-diagnostic__nav--prev" type="button" tabindex="-1" aria-label={content.previousLabel} data-rq-problem-prev disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M15 5 8 12l7 7"></path>
            </svg>
          </button>

          <div class="rq-problem-diagnostic__carousel-scene" data-rq-problem-carousel aria-describedby="rq-problem-severity-legend">
        <ul class="rq-problem-diagnostic__filmstrip" role="tablist" aria-label={content.carouselAriaLabel}>
          {items.map((item, index) => (
            <li class:list={['rq-problem-diagnostic__frame', item.role === 'lead' && 'rq-problem-diagnostic__frame--lead']} role="presentation">
              <button
                class:list={[
                  'rq-problem-diagnostic__card',
                  item.role === 'lead' && 'rq-problem-diagnostic__card--lead',
                ]}
                id={`rq-problem-card-${item.id}`}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`rq-problem-panel-${item.id}`}
                tabindex={index === 0 ? '0' : '-1'}
                data-rq-problem-card
              >
                <span class="rq-problem-diagnostic__card-inner">
                  <span class="rq-problem-diagnostic__poster-meta">
                    <span class="rq-problem-diagnostic__number">{String(index + 1).padStart(2, '0')}</span>
                    <span class="rq-problem-diagnostic__role">{roleLabels[item.role]}</span>
                  </span>
                  <span class="rq-problem-diagnostic__poster-title">{item.symptom}</span>
                  <span class="rq-problem-diagnostic__hook">{item.hook}</span>
                  <span class="rq-problem-diagnostic__severity">
                    <span class="rq-sr-only">{content.severitySrPrefix} {item.severity} {content.severitySrSuffix}</span>
                    <span class="rq-problem-diagnostic__stars" aria-hidden="true">
                      {stars.map((_, starIndex) => (
                        <span class:list={['rq-problem-diagnostic__star', starIndex < item.severity && 'is-active']}>★</span>
                      ))}
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
          </div>

          <button class="rq-problem-diagnostic__nav rq-problem-diagnostic__nav--next" type="button" tabindex="-1" aria-label={content.nextLabel} data-rq-problem-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <div
          class="rq-problem-diagnostic__timeline"
          role="group"
          aria-label={timelineAriaLabel}
          data-rq-problem-timeline
          style={`--rq-active-index: 0; --rq-count: ${items.length};`}
        >
          <span class="rq-problem-diagnostic__timeline-rail" aria-hidden="true"></span>
          {items.map((item, index) => (
            <button
              class="rq-problem-diagnostic__indicator"
              type="button"
              aria-label={`${problemIndicatorLabel} ${index + 1}`}
              aria-controls={`rq-problem-panel-${item.id}`}
              aria-current={index === 0 ? 'true' : 'false'}
              data-rq-problem-indicator
            >
              {String(index + 1).padStart(2, '0')}
            </button>
          ))}
        </div>

      <p class="rq-problem-diagnostic__tagline" id="rq-problem-carousel-tagline">{content.tagline}</p>

      <div class="rq-problem-diagnostic__output" aria-live="off" data-rq-problem-output>
        {items.map((item, index) => (
          <article
            class:list={[
              'rq-problem-diagnostic__panel',
              index === 0 && 'is-active',
            ]}
            id={`rq-problem-panel-${item.id}`}
            role="tabpanel"
            tabindex={index === 0 ? '0' : '-1'}
            aria-labelledby={`rq-problem-card-${item.id}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index !== 0 ? true : undefined}
            data-rq-problem-panel
            data-rq-problem-mini-title={item.symptom}
            data-rq-problem-mini-problem={item.problem}
            data-rq-problem-mini-step={item.step}
          >
            <div class="rq-problem-diagnostic__panel-top">
              <span class="rq-problem-diagnostic__solution-label">{content.solutionLabel}</span>
              <span class="rq-problem-diagnostic__count">{String(index + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</span>
            </div>
            <h3>{item.symptom}</h3>
            <dl class="rq-problem-diagnostic__findings">
              <div>
                <dt>{content.findingLabels.problem}</dt>
                <dd>{item.problem}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.cause}</dt>
                <dd>{item.cause}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.verify}</dt>
                <dd>{item.verify}</dd>
              </div>
              <div>
                <dt>{content.findingLabels.step}</dt>
                <dd>{item.step}</dd>
              </div>
            </dl>
            <div class="rq-problem-diagnostic__actions">
              <a class="rq-btn rq-btn--primary" href="#kontakt">{content.ctaLabel}</a>
              <a
                class="rq-problem-diagnostic__service"
                href={`#service-${item.primaryServiceId}`}
                data-rq-primary-service-target={item.primaryServiceId}
                data-rq-related-service-target={item.relatedServiceIds[0]}
              >
                {content.servicePrefix} <strong>{item.service}</strong>
              </a>
            </div>
          </article>
        ))}
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rq-problem-diagnostic {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow-x: clip;
    background:
      linear-gradient(180deg, rgba(13, 11, 12, 0.78), rgba(34, 15, 19, 0.9)),
      linear-gradient(135deg, #0D0B0C 0%, #160d0f 48%, #220F13 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), inset 0 34px 74px rgba(0, 0, 0, 0.34);
    color: var(--rq-on-dark);
  }

  @supports not (overflow: clip) {
    .rq-problem-diagnostic {
      overflow-x: hidden;
    }
  }

  .rq-problem-diagnostic__alias {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .rq-problem-diagnostic__inner {
    width: var(--rq-page-w-wide);
    max-width: var(--rq-page-w-wide);
    margin-inline: auto;
  }

  .rq-problem-diagnostic__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 4vw, 3.2rem);
  }

  .rq-problem-diagnostic .rq-eyebrow,
  .rq-problem-diagnostic__lead,
  .rq-problem-diagnostic__severity-legend,
  .rq-problem-diagnostic__tagline {
    color: color-mix(in srgb, var(--rq-on-dark-2) 92%, transparent);
  }

  .rq-problem-diagnostic__title {
    max-width: 18ch;
    color: var(--rq-on-dark);
  }

  .rq-problem-diagnostic__title::after {
    background: color-mix(in srgb, var(--rq-lime) 72%, transparent);
    opacity: 0.72;
  }

  .rq-problem-diagnostic__lead {
    max-width: 58ch;
    margin-top: 1rem;
    line-height: 1.65;
  }

  .rq-problem-diagnostic__badge,
  .rq-problem-diagnostic__solution-label,
  .rq-problem-diagnostic__count,
  .rq-problem-diagnostic__number,
  .rq-problem-diagnostic__role,
  .rq-problem-diagnostic__severity-legend strong {
    font-family: var(--rq-mono), ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rq-problem-diagnostic__badge {
    border: 1px solid rgba(199, 224, 74, 0.34);
    border-radius: var(--rq-r-pill);
    padding: 0.7rem 0.82rem;
    color: var(--rq-lime);
    background: rgba(199, 224, 74, 0.08);
  }

  .rq-problem-diagnostic__shell {
    --rq-card-w: clamp(16.75rem, 28vw, 24rem);
    --rq-card-w-lead: clamp(18.1rem, 30.24vw, 25.9rem);
    --rq-card-h: clamp(20.5rem, 30vw, 24rem);
    --rq-card-h-lead: clamp(22.1rem, 32.4vw, 25.9rem);
    --rq-jaw-min-block-size: clamp(35rem, 42vw, 42rem);
    --rq-problem-ease-out-back: cubic-bezier(0.18, 1.22, 0.28, 1);
    position: relative;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.6rem);
    min-width: 0;
  }

  .rq-problem-diagnostic__meta-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .rq-problem-diagnostic__severity-legend {
    max-width: 62ch;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .rq-problem-diagnostic__severity-legend strong {
    color: var(--rq-lime);
  }

  .rq-problem-diagnostic__board {
    position: relative;
    display: grid;
    gap: clamp(0.85rem, 1.8vw, 1.25rem);
    min-width: 0;
    border: 1px solid rgba(247, 244, 238, 0.14);
    border-radius: 8px;
    padding: clamp(0.85rem, 2vw, 1.35rem);
    overflow: clip;
    isolation: isolate;
    background:
      linear-gradient(180deg, rgba(247, 244, 238, 0.075), transparent 42%),
      linear-gradient(135deg, rgba(94, 25, 38, 0.34), rgba(22, 18, 20, 0.78) 48%, rgba(13, 11, 12, 0.88)),
      rgba(22, 18, 20, 0.92);
    box-shadow:
      0 36px 90px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 0 0 1px rgba(199, 224, 74, 0.045);
  }

  @supports not (overflow: clip) {
    .rq-problem-diagnostic__board {
      overflow: hidden;
    }
  }

  .rq-problem-diagnostic__board::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(199, 224, 74, 0.09), transparent 1px),
      linear-gradient(180deg, rgba(247, 244, 238, 0.055), transparent 1px);
    background-size: 4.5rem 4.5rem;
    opacity: 0.26;
    pointer-events: none;
  }

  .rq-problem-diagnostic__stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.9rem minmax(0, 1fr) 2.9rem;
    align-items: center;
    gap: clamp(0.45rem, 1.1vw, 0.75rem);
    min-width: 0;
  }

  .rq-problem-diagnostic__nav {
    display: inline-grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid rgba(199, 224, 74, 0.34);
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 0%, rgba(199, 224, 74, 0.16), transparent 58%),
      rgba(94, 25, 38, 0.72);
    color: var(--rq-lime);
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgba(13, 11, 12, 0.48),
      0 0 28px rgba(199, 224, 74, 0.1);
    transition: border-color 180ms var(--rq-ease), background-color 180ms var(--rq-ease), color 180ms var(--rq-ease), opacity 180ms var(--rq-ease), transform 180ms var(--rq-ease), box-shadow 180ms var(--rq-ease);
  }

  .rq-problem-diagnostic__nav svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
  }

  .rq-problem-diagnostic__nav:hover,
  .rq-problem-diagnostic__nav:focus-visible {
    border-color: rgba(199, 224, 74, 0.78);
    outline: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(199, 224, 74, 0.28), transparent 62%),
      rgba(94, 25, 38, 0.86);
    color: var(--rq-lime);
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(13, 11, 12, 0.48),
      0 0 34px rgba(199, 224, 74, 0.2);
  }

  .rq-problem-diagnostic__nav:focus-visible {
    box-shadow: 0 0 0 3px rgba(199, 224, 74, 0.24);
  }

  .rq-problem-diagnostic__nav:disabled {
    cursor: default;
    opacity: 0.42;
    transform: none;
  }

  .rq-problem-diagnostic__carousel-scene {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: 1.65rem 1.45rem;
    perspective: 1160px;
    perspective-origin: center;
    scroll-padding-inline: max(1rem, calc((100% - var(--rq-card-w)) / 2));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rq-problem-diagnostic__carousel-scene::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rq-problem-diagnostic__filmstrip {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.35rem);
    min-width: max-content;
    margin: 0;
    padding: 0 max(1rem, calc((100% - var(--rq-card-w)) / 2));
    list-style: none;
    transform-style: preserve-3d;
  }

  .rq-problem-diagnostic__frame {
    flex: 0 0 var(--rq-card-w);
    min-width: 0;
    scroll-snap-align: center;
  }

  .rq-problem-diagnostic__frame--lead {
    flex-basis: var(--rq-card-w-lead);
  }

  .rq-problem-diagnostic__card {
    --rq-card-rotate: 0deg;
    --rq-card-lift: 0.75rem;
    --rq-card-depth: -64px;
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.45;
    filter: saturate(0.72);
    transform: translate3d(0, var(--rq-card-lift), var(--rq-card-depth)) rotateY(var(--rq-card-rotate));
    transform-style: preserve-3d;
    scroll-snap-align: center;
    transition: opacity 240ms var(--rq-ease), filter 240ms var(--rq-ease), transform 480ms var(--rq-problem-ease-out-back);
  }

  .rq-problem-diagnostic__card[data-rq-problem-side='before'] {
    --rq-card-rotate: 14deg;
  }

  .rq-problem-diagnostic__card[data-rq-problem-side='after'] {
    --rq-card-rotate: -14deg;
  }

  .rq-problem-diagnostic__card[data-rq-problem-distance='far'] {
    opacity: 0.36;
  }

  .rq-problem-diagnostic__card::before,
  .rq-problem-diagnostic__card::after {
    content: "";
    position: absolute;
    inset: 10% 4% -6%;
    border-radius: 14px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--rq-ease);
  }

  .rq-problem-diagnostic__card::before {
    background: rgba(199, 224, 74, 0.18);
    filter: blur(28px);
    transform: translateY(0.8rem);
  }

  .rq-problem-diagnostic__card::after {
    border: 1px solid rgba(199, 224, 74, 0.24);
  }

  .rq-problem-diagnostic__card-inner {
    position: relative;
    display: grid;
    min-block-size: var(--rq-card-h);
    grid-template-rows: auto minmax(6.5rem, auto) 1fr auto;
    gap: 1rem;
    border: 1px solid rgba(247, 244, 238, 0.13);
    border-radius: 8px;
    padding: clamp(1.05rem, 2.2vw, 1.45rem);
    overflow: hidden;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.018) 42%, rgba(94, 25, 38, 0.18)),
      rgba(22, 18, 20, 0.75);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    backface-visibility: hidden;
    box-shadow:
      0 34px 72px rgba(0, 0, 0, 0.46),
      0 12px 26px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateZ(0);
    transform-style: preserve-3d;
    transition: border-color 220ms var(--rq-ease), opacity 220ms var(--rq-ease), transform 260ms var(--rq-ease);
  }

  .rq-problem-diagnostic__card-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(199, 224, 74, 0.22), transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 34%);
    opacity: 0.45;
    pointer-events: none;
  }

  .rq-problem-diagnostic__card--lead .rq-problem-diagnostic__card-inner {
    min-block-size: var(--rq-card-h-lead);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] {
    --rq-card-lift: -0.35rem;
    --rq-card-depth: 42px;
    --rq-card-rotate: 0deg;
    z-index: 3;
    opacity: 1;
    filter: saturate(1.08);
  }

  .rq-problem-diagnostic__card[aria-selected='true']::before,
  .rq-problem-diagnostic__card[aria-selected='true']::after,
  .rq-problem-diagnostic__card:hover::before,
  .rq-problem-diagnostic__card:focus-visible::before {
    opacity: 1;
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__card-inner {
    border-color: rgba(199, 224, 74, 0.72);
    box-shadow:
      0 42px 94px rgba(0, 0, 0, 0.56),
      0 0 0 1px rgba(199, 224, 74, 0.22),
      0 0 54px rgba(199, 224, 74, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transform: translateZ(22px);
  }

  .rq-problem-diagnostic__card:hover,
  .rq-problem-diagnostic__card:focus-visible {
    --rq-card-lift: -0.3rem;
    --rq-card-depth: 28px;
    --rq-card-rotate: 0deg;
    z-index: 4;
    outline: 0;
    opacity: 0.96;
    filter: saturate(1);
  }

  .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    border-color: rgba(199, 224, 74, 0.78);
    transform: translateZ(18px);
  }

  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    box-shadow:
      0 42px 94px rgba(0, 0, 0, 0.56),
      0 0 0 3px rgba(199, 224, 74, 0.34),
      0 0 54px rgba(199, 224, 74, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__number,
  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__role,
  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__poster-title {
    color: var(--rq-lime);
    text-shadow: 0 0 18px rgba(199, 224, 74, 0.24);
  }

  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:hover) .rq-problem-diagnostic__card:not(:hover):not([aria-selected='true']),
  .rq-problem-diagnostic__filmstrip:has(.rq-problem-diagnostic__card:focus-visible) .rq-problem-diagnostic__card:not(:focus-visible):not([aria-selected='true']) {
    opacity: 0.38;
  }

  .rq-problem-diagnostic.is-scrolling .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
  .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
    will-change: transform;
  }

  .rq-problem-diagnostic__timeline {
    --rq-step: calc(100% / var(--rq-count));
    --rq-laser-w: clamp(2.1rem, 6.5vw, 4.5rem);
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--rq-count), minmax(2.45rem, 1fr));
    align-items: end;
    gap: clamp(0.25rem, 0.8vw, 0.55rem);
    min-width: 0;
    padding: 1.25rem 0.15rem 0.15rem;
    isolation: isolate;
  }

  .rq-problem-diagnostic__timeline::after {
    content: "";
    position: absolute;
    inset-block-start: 0.78rem;
    inset-inline-start: calc((var(--rq-step) * var(--rq-active-index)) + ((var(--rq-step) - var(--rq-laser-w)) / 2));
    z-index: 1;
    width: min(var(--rq-laser-w), calc(var(--rq-step) - 0.35rem));
    height: 2px;
    border-radius: 999px;
    background: var(--rq-lime);
    box-shadow:
      0 0 10px rgba(199, 224, 74, 0.95),
      0 0 28px rgba(199, 224, 74, 0.36);
    transition: inset-inline-start 420ms var(--rq-problem-ease-out-back), opacity 220ms var(--rq-ease);
  }

  .rq-problem-diagnostic__timeline-rail {
    position: absolute;
    inset: 0.78rem 0.35rem auto;
    height: 2px;
    border-radius: 999px;
    background:
      linear-gradient(90deg, rgba(94, 25, 38, 0.32), rgba(94, 25, 38, 0.9), rgba(94, 25, 38, 0.32));
    box-shadow: 0 0 18px rgba(94, 25, 38, 0.5);
  }

