---
import DemoThemeDocument from '../themed-demos/DemoThemeDocument.astro';
import {days,services,initialState,availableSlots} from '../themed-demos/booking-state.mjs';
const initial=initialState();
const initialService=services[initial.service];
const allTimes=[...new Set(Object.values(days).flatMap(day=>[...day.slots]))];
---
<DemoThemeDocument title="Fyzioterapie — modelová rezervace RadeQ" description="Tři fiktivní služby a pevný scénář výběru dne a času. Rezervace se neodesílá." theme="physio">
 <main data-booking>
  <p class="eyebrow">Fyzioterapie · prostor pro pohyb</p>
  <h1>Kdy se vám to hodí?</h1>
  <p class="lead">Vyberte péči a čas, který vám sedí.</p>
  <p class="scenario">Fiktivní ordinace, služby i ceny. Pevný modelový kalendář v říjnu 2026 — nejde o aktuální dostupnost.</p>
  <fieldset class="services">
   <legend><span class="step">01</span> Čím začneme?</legend>
   <div class="service-grid">
    {Object.entries(services).map(([value,service])=><label class="service"><input type="radio" name="service" value={value} checked={value===initial.service} disabled/><span class="service-name">{service.label}</span><span class="service-description">{service.description}</span><span class="service-details">{service.duration} minut <span aria-hidden="true">·</span> {service.price} Kč</span><small class="selected">Vybráno</small></label>)}
   </div>
  </fieldset>
  <div class="columns">
   <fieldset class="days"><legend><span class="step">02</span> Den návštěvy</legend>{Object.entries(days).map(([value,day])=><label><input type="radio" name="day" value={value} checked={value===initial.day} disabled/><span>{day.short}</span><small class="selected">Vybráno</small></label>)}</fieldset>
   <fieldset class="times"><legend><span class="step">03</span> Čas <span class="date-heading" data-time-heading>{days[initial.day].label}</span></legend>{allTimes.map(time=><label data-slot hidden={!availableSlots(initial).includes(time)}><input type="radio" name="time" value={time} checked={time===initial.time} disabled/><span>{time}</span><small class="selected">Vybráno</small></label>)}<p data-empty hidden>Pro tuto službu nejsou v modelovém dni žádné termíny. Zvolte jiný den.</p></fieldset>
   <section class="summary" aria-labelledby="summary-title"><h2 id="summary-title">Váš výběr</h2><p class="summary-service" data-summary-service>{initialService.label}</p><p data-summary-details>{initialService.duration} minut · {initialService.price} Kč</p><p data-summary-day>{days[initial.day].label}</p><p class="chosen-time" data-summary-time>{initial.time}</p><button type="button" data-confirm data-js-action hidden>Potvrdit modelový výběr</button><p class="local-note">Bez osobních údajů. Potvrzení zůstane jen na této stránce, nic se neodesílá.</p><p data-status role="status" aria-live="polite" aria-atomic="true">Vybráno. Zatím nepotvrzeno.</p><button class="reset" type="button" data-reset data-js-action hidden>Vrátit výchozí výběr</button></section>
  </div>
  <noscript><p>Interaktivní výběr vyžaduje JavaScript. Zobrazen je pevný modelový příklad: úvodní setkání, pátek 9. října v 11:30, 60 minut za 800 Kč. Rezervace se neodesílá.</p></noscript>
 </main>
 <script>import {mount} from '../themed-demos/booking-client.js';const root=document.querySelector<HTMLElement>('[data-booking]');if(root)mount(root);</script>
</DemoThemeDocument>
<style>
main{padding-top:3rem}h1{font-family:'Fraunces',serif;font-size:clamp(3rem,6.4vw,6.25rem);margin:1.5rem 0 .75rem;letter-spacing:-.055em}.lead{font-size:1.65rem;margin-bottom:.6rem}.scenario,.eyebrow{font-size:1rem}.scenario{max-width:52rem}.services{margin-top:2.75rem}fieldset{border:0;padding:0;margin:0;min-width:0}legend{font-size:1.15rem;font-weight:600;margin-bottom:1.4rem;width:100%}.step{font-size:.9rem;color:#76576f;margin-right:.35rem}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}label{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;position:relative;cursor:pointer;min-height:44px;padding:1rem .25rem}input{appearance:none;position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}label:has(input:focus-visible){outline:3px solid #2f493d;outline-offset:5px}.service{border:1px solid #8a9c8c;border-radius:1rem;padding:1.25rem;display:grid;align-content:start;gap:.65rem}.service:has(input:checked){background:#e8dfE7;border-color:#76576f}.service-name{font-family:'Fraunces',serif;font-size:1.65rem;font-weight:600;line-height:1.2}.service-description{font-size:1rem;color:#2f493d}.service-details{font-size:1.05rem;font-weight:600}.service .selected{margin:0}.columns{display:grid;grid-template-columns:1fr 1.15fr 1fr;margin-top:3rem;gap:3rem}.days label>span,.times label>span{font-family:'Fraunces',serif;font-size:clamp(1.5rem,2.8vw,2.7rem);font-weight:600}.days label{border-bottom:1px solid #8a9c8c}.times,.summary{border-left:1px solid #8a9c8c;padding-left:2.5rem}.date-heading{display:block;font-size:1rem;font-weight:400;margin-top:.5rem}.times label{border-radius:999px;padding:.65rem 1rem;border:2px solid transparent}.times input:checked+span{font-size:clamp(2.6rem,4.5vw,4.8rem)}label:has(input:checked){color:#76576f}.times label:has(input:checked){border-color:#76576f}.days label:has(input:checked){border-left:3px solid #76576f;padding-left:.75rem}.selected{display:none;font-size:.9rem}input:checked~.selected{display:inline}.summary h2{font-family:'Fraunces',serif;font-size:2.3rem}.summary p{margin-bottom:1rem}.summary-service{font-weight:600}.chosen-time{font-family:'Fraunces',serif;color:#76576f;font-size:clamp(3rem,5.5vw,5.5rem);line-height:1.1;font-weight:600;overflow-wrap:anywhere}.summary button[data-confirm]{border-radius:999px;background:#76576f;color:white;padding:1rem;width:100%}.summary button:disabled{opacity:.65;cursor:default}.local-note,[data-status]{font-size:1rem;margin-top:1.5rem}.reset{background:transparent;color:#76576f;text-decoration:underline;padding:.5rem 0}noscript p{margin-top:2rem;font-size:1rem}@media(max-width:1000px){.columns{gap:1.25rem}.times,.summary{padding-left:1.25rem}}@media(max-width:760px){.service-grid,.columns{grid-template-columns:1fr}.columns{gap:2.5rem}.times,.summary{padding:2rem 0 0;border-left:0;border-top:1px solid #8a9c8c}.times label>span{font-size:2rem}.times input:checked+span{font-size:3rem}.service{padding:1rem}}@media(forced-colors:active){input{appearance:auto;position:static;opacity:1;width:1.1rem;height:1.1rem;min-height:0}label:has(input:checked){outline:2px solid Highlight}.times label{border-color:ButtonText}.service:has(input:checked){background:Canvas}.service-description{color:CanvasText}}
</style>
