---
import CommandHeader from './CommandHeader.astro';
import ContactTerminal from './ContactTerminal';
import { routePages, type RoutePageKey } from '../data/routePages';
import { siteContent } from '../data/siteContent';
import { withBaseHref } from '../lib/links';
import BaseLayout from '../layouts/BaseLayout.astro';

type RoutePage = (typeof routePages)[RoutePageKey] & {
  primaryHref?: string;
};

interface Props {
  page: RoutePage;
  includeContact?: boolean;
}

const { page, includeContact = false } = Astro.props;
const content = siteContent.cs;
const primaryHref = page.primaryHref ?? '#terminal';
const secondaryHref = withBaseHref(page.secondaryHref);
---

<BaseLayout title={page.title} description={page.description} lang={content.layout.lang}>
  <CommandHeader
    content={content.header}
    locale={content.layout.lang}
    homePath="/"
    showStyleToggle={false}
  />
  <main class="route-page">
    <section class="route-page__hero" id="top" aria-labelledby="route-title">
      <p class="section-code">{page.eyebrow}</p>
      <h1 id="route-title">{page.h1}</h1>
      <p>{page.lead}</p>
      <ul class="route-page__points">
        {page.points.map((point) => <li>{point}</li>)}
      </ul>
      <div class="route-page__actions">
        <a class="button-primary" href={primaryHref} data-track={primaryHref === '#terminal' ? 'cta_primary_click' : undefined}>{page.primaryCta}</a>
        <a class="button-secondary" href={secondaryHref}>{page.secondaryCta}</a>
      </div>
    </section>
    <section class="route-page__details" aria-label={`${page.h1} - detaily`}>
      {page.sections.map((section) => (
        <article>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
        </article>
      ))}
    </section>
    {includeContact ? <ContactTerminal locale={content.layout.lang} content={content.terminal} client:load /> : null}
  </main>
</BaseLayout>
