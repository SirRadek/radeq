---
import type { Locale } from '../data/locales';
import '../styles/service-stories.css';
const { lang = 'cs' } = Astro.props as { lang?: Locale };
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const choose = (cs: string, english: string) => en ? english : cs;
const stories = [
  {id:'web', slug:'instalater', image:'flow-plumber-wide.png',
   title:choose('Web a viditelnost','Website and visibility'),
   description:choose('Web, ze kterého je jasné, co nabízíte, pro koho to je a jak se ozvat. Přehledná struktura, čitelný obsah a použití na mobilu — od prezentace služby po malý e-shop.','A website that makes it clear what you offer, who it is for and how to get in touch. Clear content that works well on mobile, from a service page to a small shop.'),
   aside:choose('Jasná nabídka. Snadná domluva.','Clear offer. Easy contact.'),
   note:choose('Od problému k poptávce.','From problem to enquiry.'),
   steps:en?['Describe the problem','Explore the options','Send an enquiry','Enquiry received']:['Popsat problém','Zjistit možnosti','Poslat poptávku','Poptávka dorazila'],
   handoff:choose('Poptávka vám dorazí do e-mailu. Další domluva je na vás.','The enquiry arrives in your inbox. You take the conversation from there.'),
   name:choose('Web pro instalatéra','Plumber website'),cta:choose('Prohlédnout web instalatéra','Explore the plumber website'),
   action:choose('Poslat poptávku','Send an enquiry'),result:choose('Poptávka dorazila','Enquiry received'),symbol:'↗'},
  {id:'terminy',slug:'sluzba',image:'booking-wide.png',
   title:choose('Rezervace termínů','Appointment booking'),
   description:choose('Přehled služeb a cesta k objednání termínu. Společně projdeme, co zákazník potřebuje vědět a co potřebujete mít pod kontrolou vy.','Clear services and appointment booking. We review what customers need to know and what you need to manage.'),
   aside:choose('Jeden volný termín. Méně telefonování.','Easier booking. Fewer calls.'),
   note:choose('Místo telefonování jeden termín.','An appointment without a phone call.'),
   steps:en?['Choose a service','Find a time','Book','Booking confirmed']:['Vybrat službu','Najít termín','Rezervovat','Rezervace potvrzena'],
   handoff:choose('O rezervaci víte i e-mailem. Další péče je na vás.','You also receive the booking by email. You take care of the next step.'),
   name:choose('Fyzioterapie s rezervací','Physiotherapy with booking'),cta:choose('Vyzkoušet rezervaci','Try the booking'),
   action:'',result:choose('Termín vybrán','Appointment selected'),symbol:'✓'},
  {id:'data',slug:'provozni-terminal',image:'flow-workshop-wide.png',
   title:choose('Propojená evidence','Connected records'),
   description:choose('Evidence, předávání informací a exporty bez zbytečného přepisování. Začneme jedním procesem a hledáme, kde propojení dat usnadní každodenní práci.','Records, information handoff and exports without unnecessary retyping. We start with one process and connect data where it helps everyday work.'),
   aside:choose('Hotová práce je zapsaná.','Completed work is recorded.'),
   note:choose('Hotová práce nezůstane jen v hlavě.','Completed work does not get forgotten.'),
   steps:en?['Log work','Add material','See the overview','Work logged']:['Zapsat práci','Přidat materiál','Mít přehled','Práce zapsaná'],
   handoff:choose('Práce i materiál jsou zapsané. Další krok je na vás.','Work and materials are recorded. The next step is yours.'),
   name:choose('Dílenský terminál','Workshop terminal'),cta:choose('Otevřít modelovou dílnu','Explore the model workshop'),
   action:choose('Zapsat práci','Log work'),result:choose('Práce zapsaná','Work logged'),symbol:'✓'},
  {id:'eshop',slug:'eshop',image:'flow-shop.png',
   title:choose('Malý e-shop','Small online shop'),
   description:choose('Od výběru kávy přes košík až k předání objednávky do pražírny. Ukázka propojuje pohled zákazníka s jednoduchou evidencí objednávek.','From choosing coffee and filling a basket to handing the order to the roastery. This example connects the customer view with simple order management.'),
   aside:choose('Od košíku k připravené objednávce.','From basket to an order ready for collection.'),
   steps:en?['Choose coffee','Fill the basket','Create a demo order','Prepare for collection']:['Vybrat kávu','Naplnit košík','Vytvořit modelovou objednávku','Připravit k předání'],
   handoff:choose('V ukázce si vyzkoušíte i zpracování objednávky. Bez platby a skutečného nákupu.','Try processing the order at the roastery too. No payment or real purchase.'),
   name:choose('Pražírna a malý e-shop','Roastery and small shop'),cta:choose('Vyzkoušet modelový e-shop','Explore the model coffee shop')},
];
const href = (slug: string) => `${base}/${en ? 'en/' : ''}ukazky/${slug}/`;
const englishImages: Record<string, string> = {web:'flow-plumber-wide-en.png',terminy:'booking-wide-en.png',data:'flow-workshop-wide-en.png',eshop:'flow-shop-en.png'};
---
<span id="co-resim"></span><span id="services"></span><span id="situace"></span><span id="how"></span><span id="co-delam"></span>
<section id="sluzby" class="rq-service-stories" aria-labelledby="sluzby-nadpis">
 <div class="rq-minimal-preview__section-head"><h2 id="sluzby-nadpis">{choose('Služby','Services')}</h2><p>{choose('Čtyři ukázky. Rozbalte si tu, která je vám blízká.','Four examples. Open the one closest to your needs.')}</p></div>
 <div class="rq-showcases">
 {stories.map((story,i)=><details id={`sluzba-${story.id}`} class="rq-showcase">
  <summary>
   <span class="rq-showcase__cover"><img src={`${base}/images/services/${en?englishImages[story.id]:story.image}`} alt="" width="1120" height="700" loading="lazy" /></span>
   <span class="rq-showcase__copy"><small>{`0${i+1}`} · {story.title}</small><h3>{story.name}</h3><span>{story.aside}</span><span class="rq-showcase__toggle"><span class="when-closed">{choose('Více o ukázce','About this example')}</span><span class="when-open">{choose('Sbalit podrobnosti','Hide details')}</span></span></span>
  </summary>
  <div class="rq-showcase__body flow-wrap" data-demo={story.id}>
   <p>{story.description}</p>
   <ol class="flow" aria-label={`${story.name}: ${choose('modelová cesta zákazníka','illustrative customer journey')}`}>
    {story.steps.map((step,j)=><li><span class="flow-node" aria-hidden="true">{`0${j+1}`}</span><span>{step}</span></li>)}
   </ol>
   <p class="flow-handoff">{story.handoff}</p>
   <a class="flow-example" href={href(story.slug)}>{story.cta} ↗</a>
   <small class="flow-model-note">{choose('Modelový průběh · nic se neodesílá.','Illustrative journey · nothing is sent.')}</small>
  </div>
 </details>)}
 </div>
</section>
<script>
 const revealService=()=>{
  const target=document.getElementById(window.location.hash.slice(1));
  if(target instanceof HTMLDetailsElement && target.classList.contains('rq-showcase')){
   target.open=true;
   target.scrollIntoView({block:'start'});
  }
 };
 window.addEventListener('hashchange',revealService);
 revealService();
</script>
