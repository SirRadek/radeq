---
import type { Locale } from '../data/locales';
import MotionOrchestrator from '../components/MotionOrchestrator';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  alternatePath: string;
  alternateLang: Locale;
}

const { title, description, lang, alternatePath, alternateLang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const alternateHref = `${basePath}${alternatePath}`;
---

<!doctype html>
<html lang={lang} data-style="variant-a" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" hreflang={alternateLang} href={alternateHref} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('radeq-theme-mode');
          document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }

        try {
          const storedStyle = localStorage.getItem('radeq-style-variant');
          const allowedStyles = ['variant-a', 'variant-b', 'variant-c', 'variant-d'];
          document.documentElement.dataset.style = allowedStyles.includes(storedStyle) ? storedStyle : 'variant-a';
        } catch {
          document.documentElement.dataset.style = 'variant-a';
        }
      })();
    </script>
  </head>
  <body>
    <MotionOrchestrator client:load />
    <slot />
  </body>
</html>
