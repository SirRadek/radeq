---
import type { Locale, SiteContent } from '../data/siteContent';

interface Props {
  locale: Locale;
  systems: SiteContent['systems'];
}

const { locale } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const demoRoot = locale === 'en' ? '/en/demo' : '/demo';
const shopDemoHref = `${basePath}${demoRoot}/service-landing/`;

const copy = {
  cs: {
    eyebrow: 'D / Demo Worlds',
    title: 'Vyberte cestu podle toho, kde se váš web nebo práce zasekly.',
    lead:
      'Návštěvník nezačíná technologií, ale situací. Každý svět vysvětluje výsledek a vede buď do krátkého briefu, nebo do e-shop ukázky.',
    primary: 'Otevřít e-shop demo',
    worldsTitle: 'Čtyři cesty podle situace zákazníka',
    nextTitle: 'Jak se návštěva skládá do poptávky',
    next: [
      'Vybere situaci, kterou poznává.',
      'Uvidí konkrétní výstup a doporučený další krok.',
      'Otevře e-shop demo nebo pošle stručný brief.',
    ],
    worlds: [
      {
        label: 'Web / landing',
        problem: 'Nabídka je nejasná nebo web nepůsobí důvěryhodně.',
        promise: 'Navrhneme první obrazovku, CTA cestu a sekce pro rozhodnutí.',
        action: 'contact',
        actionLabel: 'Probrat nový web',
      },
      {
        label: 'Obsah / SEO',
        problem: 'Obsah existuje, ale lidé ani vyhledávače se v něm neorientují.',
        promise: 'Srovnáme strukturu článků, odkazů, metadat a témat.',
        action: 'contact',
        actionLabel: 'Probrat obsah a SEO',
      },
      {
        label: 'Data / formuláře',
        problem: 'Poptávky a ruční práce mizí v e-mailu, tabulkách nebo chatu.',
        promise: 'Navrhneme sběr, třídění a přehled, který tým skutečně používá.',
        action: 'contact',
        actionLabel: 'Probrat formuláře',
      },
      {
        label: 'E-shop / nabídka',
        problem: 'Potřebujete ukázat produkty, balíčky nebo služby bez zbytečného výběrového chaosu.',
        promise: 'Prohlédněte si e-shopovou nabídku, porovnání variant a jasný nákupní krok.',
        action: 'demo',
        actionLabel: 'Otevřít e-shop demo',
      },
    ],
  },
  en: {
    eyebrow: 'D / Demo Worlds',
    title: 'Choose a path by where your website or work gets stuck.',
    lead:
      'Visitors do not start with technology; they start with a situation. Each world explains the outcome and leads either to a short brief or the shop demo.',
    primary: 'Open shop demo',
    worldsTitle: 'Four paths by customer situation',
    nextTitle: 'How a visit turns into a request',
    next: [
      'They choose a situation they recognize.',
      'They see a concrete output and recommended next step.',
      'They open the shop demo or send a short brief.',
    ],
    worlds: [
      {
        label: 'Web / landing',
        problem: 'The offer is unclear or the site does not feel trustworthy.',
        promise: 'We shape the first viewport, CTA route, and decision sections.',
        action: 'contact',
        actionLabel: 'Discuss a new website',
      },
      {
        label: 'Content / SEO',
        problem: 'The content exists, but people and search engines cannot navigate it.',
        promise: 'We organize articles, links, metadata, and topic structure.',
        action: 'contact',
        actionLabel: 'Discuss content and SEO',
      },
      {
        label: 'Data / forms',
        problem: 'Requests and manual work disappear in email, sheets, or chat.',
        promise: 'We design collection, sorting, and an overview the team can use.',
        action: 'contact',
        actionLabel: 'Discuss forms',
      },
      {
        label: 'Shop / offer',
        problem: 'You need to show products, packages, or services without needless choice overload.',
        promise: 'Inspect a shop offer, variant comparison, and a clear buying step.',
        action: 'demo',
        actionLabel: 'Open shop demo',
      },
    ],
  },
}[locale];

const finderCopy = {
  cs: {
    title: 'Rychlý výběr bez technických slov',
    lead: 'Na mobilu i desktopu má člověk poznat svou situaci během pár sekund a zvolit jasný další krok.',
    steps: ['Poznám problém', 'Uvidím výstup', 'Otevřu demo nebo brief'],
    tags: ['Nejrychlejší start', 'Orientace', 'Pořádek v poptávkách', 'Rozhodování'],
  },
  en: {
    title: 'Fast choice without technical words',
    lead: 'On mobile and desktop, visitors should recognize their situation in seconds and choose a clear next step.',
    steps: ['Recognize the problem', 'See the output', 'Open demo or brief'],
    tags: ['Fastest start', 'Orientation', 'Request order', 'Decision flow'],
  },
}[locale];
---

<div class="demo-worlds variant-composition" role="region" data-variant-root="demo-worlds" aria-labelledby="demo-worlds-title">
  <div class="demo-worlds__hero" data-section-signature="demo-worlds-hero">
    <p class="section-code">{copy.eyebrow}</p>
    <h1 id="demo-worlds-title">{copy.title}</h1>
    <p>{copy.lead}</p>
    <a class="button-primary" href={shopDemoHref}>{copy.primary}</a>
  </div>

  <div class="demo-worlds__finder" data-section-signature="demo-world-finder">
    <div>
      <p class="section-code">{copy.eyebrow}</p>
      <h2>{finderCopy.title}</h2>
      <p>{finderCopy.lead}</p>
    </div>
    <ol>
      {finderCopy.steps.map((item) => <li>{item}</li>)}
    </ol>
  </div>

  <div class="demo-world-map" aria-labelledby="demo-worlds-list-title" data-section-signature="demo-world-map">
    <h2 id="demo-worlds-list-title">{copy.worldsTitle}</h2>
    {
      copy.worlds.map((world, index) => (
        <article class={`demo-world demo-world--${index + 1}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <small>{finderCopy.tags[index]}</small>
          <h3>{world.label}</h3>
          <p>{world.problem}</p>
          <strong>{world.promise}</strong>
          <a href={world.action === 'demo' ? shopDemoHref : '#terminal'}>{world.actionLabel}</a>
        </article>
      ))
    }
  </div>

  <div class="demo-worlds__next" data-section-signature="demo-world-sequence">
    <h2>{copy.nextTitle}</h2>
    <ol>
      {copy.next.map((item) => <li>{item}</li>)}
    </ol>
  </div>
</div>
