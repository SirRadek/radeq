---
import type { Locale, SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['systems'];
  locale: Locale;
}

const { content, locale } = Astro.props;

const routeCopy = {
  cs: {
    label: 'Doporučený start',
    title: 'Pokud si nejste jistí, začněte auditem.',
    text: 'Krátký placený audit ukáže, jestli řešit web, formulář, data, automatizaci nebo jen menší opravu. Nevzniká tak slepý odhad.',
    action: 'Začít auditem',
  },
  en: {
    label: 'Recommended start',
    title: 'If you are unsure, start with an audit.',
    text: 'A short paid audit shows whether to address the website, forms, data, automation, or a smaller repair first.',
    action: 'Start with audit',
  },
}[locale];

const showMoreLabel = locale === 'cs' ? 'Zobrazit více' : 'Show more';
const showLessLabel = locale === 'cs' ? 'Zobrazit méně' : 'Show less';
const situationLabel = locale === 'cs' ? 'Typická situace' : 'Typical situation';
const outcomeLabel = locale === 'cs' ? 'Výsledek' : 'Outcome';
---

<section class="service-catalog" id="services" aria-labelledby="services-title" data-direction="guided-offer-map">
  <div class="section-heading section-heading--services">
    {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
    <h2 id="services-title">{content.title}</h2>
    <p>{content.lead}</p>
  </div>
  <div class="offer-map" aria-label={content.mapAria} data-cat-platform="service-grid">
    <aside class="offer-map-guide">
      <p class="section-code">{content.guide.eyebrow}</p>
      <h3>{content.guide.title}</h3>
      <p>{content.guide.text}</p>
      <div class="offer-map-guide__recommendation">
        <span>{routeCopy.label}</span>
        <strong>{routeCopy.title}</strong>
        <p>{routeCopy.text}</p>
        <a href="#terminal">{routeCopy.action}</a>
      </div>
      <ol>
        {
          content.guide.steps.map((step) => (
            <li>
              <span>{step.label}</span>
              <strong>{step.value}</strong>
            </li>
          ))
        }
      </ol>
    </aside>
    <div class="service-path" data-service-focus-list>
      {
        content.items.map((item, index) => (
          <details class="service-card" data-service-card data-cat-platform={`service-card-${index + 1}`}>
            <summary class="service-card__summary">
              <span class="service-card__marker">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </span>
              <span class="service-card__body">
                <span class="service-card__label">{item.system}</span>
                <span class="service-card__short">{item.output}</span>
                <span class="service-card__more" aria-hidden="true">
                  <span class="service-card__more-closed">{showMoreLabel}</span>
                  <span class="service-card__more-open">{showLessLabel}</span>
                </span>
              </span>
            </summary>
            <div class="service-card__details">
              <p><strong>{situationLabel}:</strong> {item.problem}</p>
              <p><strong>{outcomeLabel}:</strong> {item.output}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll('[data-service-card]'));
    if (!cards.length) return;

    const mobileQuery = window.matchMedia('(max-width: 560px)');
    const scheduleFrame =
      window.requestAnimationFrame?.bind(window) ?? ((callback) => window.setTimeout(callback, 16));
    let ticking = false;

    const clearForwardState = () => {
      cards.forEach((card) => card.classList.remove('is-forward'));
    };

    const updateForwardCard = () => {
      ticking = false;

      if (!mobileQuery.matches) {
        clearForwardState();
        return;
      }

      const viewportCenter = window.innerHeight / 2;
      let bestCard = null;
      let bestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const isVisible = rect.bottom > 0 && rect.top < window.innerHeight;

        if (!isVisible) return;

        const distance = Math.abs(rect.top + rect.height / 2 - viewportCenter);

        if (distance < bestDistance) {
          bestDistance = distance;
          bestCard = card;
        }
      });

      clearForwardState();

      if (bestCard) {
        bestCard.classList.add('is-forward');
      }
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      scheduleFrame(updateForwardCard);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    mobileQuery.addEventListener?.('change', requestUpdate);
    requestUpdate();
  })();
</script>
