---
import RqLayout from '../../layouts/RqLayout.astro';
import RqHeader from '../../components/RqHeader.astro';
import RqFooter from '../../components/RqFooter.astro';
import { homeContent } from '../../data/home';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: base + '/#co-resim', label: 'Co řeším' },
  { href: base + '/#sluzby', label: 'Služby' },
  { href: base + '/#jak-pracuji', label: 'Jak pracuji' },
  { href: base + '/#ceny', label: 'Ceny' },
  { href: base + '/ukazky/', label: 'Ukázky' },
  { href: base + '/#kontakt', label: 'Kontakt' },
];

const services = homeContent.cs.services.items;
const extraServices = [
  {
    price: 'od 25 000 Kč',
    title: 'Firemní web (1–5 stran)',
    result: 'Vícestránkový web s jasnou nabídkou, strukturou a kontaktem.',
    outputs: ['1–5 podstránek', 'textová struktura', 'SEO základ a formulář'],
  },
  {
    price: 'od 9 900 Kč',
    title: 'Redesign staršího webu',
    result: 'Přestavba webu, který potřebuje lepší obsah, mobil, rychlost a důvěryhodnost.',
    outputs: ['audit současného webu', 'nová struktura a texty', 'kontrola před spuštěním'],
  },
];
const guarantee = homeContent.cs.guarantee;
const steps = [
  {
    number: '1.',
    title: 'Problém',
    text: 'krátce popíšete, co řešíte; navrhnu nejmenší rozumný krok.',
  },
  {
    number: '2.',
    title: 'Ověření',
    text: 'postavím a otestuju (formuláře, mobil, rychlost, SEO základ).',
  },
  {
    number: '3.',
    title: 'Předání',
    text: 'dostanete hotové a otestované, drobnosti zvládnete sami.',
  },
];
---

<RqLayout
  title="Služby | RadeQ.cz"
  description="Weby, e-shopy, automatizace a data pro živnostníky a malé firmy — rozsah i cena dopředu."
  lang="cs"
>
  <RqHeader content={{ navItems: nav }} alternateLabel="EN" alternatePath="/en/sluzby/" />

  <main class="rq-services-page">
    <section class="rq-section rq-services-hero" id="top">
      <p class="rq-eyebrow">Služby</p>
      <h1 class="rq-display">Co pro vás udělám</h1>
      <p class="rq-lead">
        Weby, e-shopy, automatizace a data pro živnostníky a malé firmy. Vyberte,
        co řešíte — rozsah i cenu řeknu dopředu.
      </p>
      <div class="rq-actions">
        <a class="rq-btn rq-btn--primary" href={base + '/#kontakt'}>Napsat poptávku</a>
        <a class="rq-btn rq-btn--ghost" href={base + '/ukazky/'}>Ukázky práce</a>
      </div>
    </section>

    <section class="rq-section rq-services-list" id="sluzby" aria-labelledby="rq-services-title">
      <p class="rq-eyebrow">Vyberte, co řešíte</p>
      <h2 class="rq-h2" id="rq-services-title">Služby podle toho, co potřebujete</h2>
      <p class="rq-services-note">
        Weby: jednostránkový od 9 900 Kč · firemní web (1–5 stran) od 25 000 Kč ·
        redesign staršího webu od 9 900 Kč.
      </p>

      <div class="rq-services-grid">
        {[...services, ...extraServices].map((service) => (
          <article class="rq-card rq-service-card">
            <p class="rq-service-card__price">{service.price}</p>
            <h3>{service.title}</h3>
            <p class="rq-service-card__result">{service.result}</p>
            <ul class="rq-service-card__outputs">
              {service.outputs.map((output) => <li>{output}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="rq-section rq-process" id="postup" aria-labelledby="rq-process-title">
      <p class="rq-eyebrow">Jak to probíhá</p>
      <h2 class="rq-h2" id="rq-process-title">Od problému k předanému výsledku.</h2>
      <ol class="rq-process-grid" aria-label="Postup spolupráce">
        {steps.map((step) => (
          <li class="rq-card rq-step">
            <h3><span>{step.number}</span> {step.title}</h3>
            <p>— {step.text}</p>
          </li>
        ))}
      </ol>
      <a class="rq-process-link" href={base + '/#jak-pracuji'}>Podrobný postup</a>
    </section>

    <section class="rq-section rq-services-guarantee" aria-labelledby="rq-services-guarantee-title">
      <article class="rq-guarantee">
        <p class="rq-eyebrow">{guarantee.eyebrow}</p>
        <h2 class="rq-h2" id="rq-services-guarantee-title">{guarantee.title}</h2>
        <p>{guarantee.text}</p>
      </article>
    </section>

    <section class="rq-section rq-services-cta" aria-label="Poptávka">
      <div class="rq-services-cta__panel">
        <p>Nevíte, co potřebujete? Napište pár vět a doporučím první krok.</p>
        <a class="rq-btn rq-services-cta__button" href={base + '/#kontakt'}>Napsat poptávku</a>
      </div>
    </section>
  </main>

  <RqFooter navItems={nav} />
</RqLayout>

<style>
  .rq-services-page :is(h1, h2, h3) {
    letter-spacing: 0;
  }

  .rq-services-hero {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
    padding-block-start: clamp(5rem, 9vw, 8rem);
  }

  .rq-services-hero .rq-display {
    max-width: 13ch;
  }

  .rq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .rq-services-list,
  .rq-process,
  .rq-services-guarantee {
    padding-block-start: clamp(2.5rem, 5vw, 4.5rem);
  }

  .rq-services-guarantee .rq-h2 {
    max-width: 48rem;
    color: var(--rq-surface);
  }

  .rq-services-note {
    max-width: 72ch;
    margin-top: clamp(1rem, 2vw, 1.3rem);
    border-left: 3px solid var(--rq-burgundy);
    border-radius: 0 var(--rq-r) var(--rq-r) 0;
    padding: 0.85rem 1rem;
    color: var(--rq-ink-2);
    background: var(--rq-burgundy-tint);
    line-height: 1.55;
  }

  .rq-services-grid,
  .rq-process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.1rem;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
  }

  .rq-service-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
  }

  .rq-service-card__price {
    align-self: flex-start;
    border-radius: var(--rq-r-pill);
    padding: 0.28rem 0.62rem;
    color: var(--rq-burgundy-strong);
    background: var(--rq-burgundy-tint);
    font-family: var(--rq-mono), ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rq-service-card h3,
  .rq-step h3 {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.12;
  }

  .rq-service-card__result,
  .rq-service-card__outputs,
  .rq-step p {
    color: var(--rq-ink-2);
  }

  .rq-service-card__result {
    line-height: 1.55;
  }

  .rq-service-card__outputs {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
    line-height: 1.5;
  }

  .rq-step {
    padding: clamp(1.15rem, 2vw, 1.45rem);
  }

  .rq-step h3 {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .rq-step h3 span {
    color: var(--rq-burgundy);
    font-family: var(--rq-mono), ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78em;
  }

  .rq-step p {
    margin-top: 0.65rem;
    line-height: 1.55;
  }

  .rq-process-link {
    display: inline-flex;
    margin-top: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--rq-burgundy);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .rq-services-cta {
    padding-block-start: clamp(1.5rem, 3vw, 3rem);
  }

  .rq-services-cta__panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: var(--rq-r);
    padding: clamp(1.35rem, 3vw, 2.2rem);
    color: #fff;
    background: var(--rq-burgundy);
  }

  .rq-services-cta__panel p {
    max-width: 58ch;
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .rq-services-cta__button {
    flex: 0 0 auto;
    border: 1px solid #fff;
    color: var(--rq-burgundy-strong);
    background: #fff;
  }

  .rq-services-cta__button:hover {
    color: #fff;
    background: transparent;
  }

  @media (max-width: 720px) {
    .rq-services-cta__panel {
      align-items: flex-start;
      flex-direction: column;
    }

    .rq-services-cta__button {
      width: 100%;
    }
  }
</style>
