---
interface Props { service: 'web' | 'terminy' | 'data' | 'eshop'; lang?: 'cs' | 'en' }
const { service, lang = 'cs' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<p class="service-return" data-service-return data-home={base + '/'} data-service={service}>
  <a href={`${base}/${lang === 'en' ? 'en/' : ''}#sluzba-${service}`}>{lang === 'en' ? '← Back to this service on RadeQ' : '← Zpět ke službě na RadeQ'}</a>
</p>
<script>
  // Only the known locale is accepted; no arbitrary return URL is read.
  if (new URLSearchParams(window.location.search).get('from') === 'en') {
    const routes = ['instalater', 'sluzba', 'provozni-terminal', 'eshop'];
    const current = window.location.pathname.split('/').filter(Boolean);
    const slug = current.at(-1);
    if (document.documentElement.lang !== 'en' && slug && routes.includes(slug)) {
      // Fixed known counterpart only; no user-supplied destination is accepted.
      const marker = window.location.pathname.lastIndexOf('/ukazky/');
      if (marker >= 0) window.location.replace(`${window.location.pathname.slice(0, marker)}/en/ukazky/${slug}/${window.location.hash}`);
    }
    document.querySelectorAll<HTMLElement>('[data-service-return]').forEach(root => {
      const link = root.querySelector('a');
      if (link) {
        link.href = `${root.dataset.home}en/#sluzba-${root.dataset.service}`;
        link.textContent = '← Back to this service on RadeQ';
        link.lang = 'en';
      }
    });
  }
</script>
<style>.service-return{margin:1.5rem 0;font-size:1rem}.service-return a{display:inline-flex;align-items:center;min-height:44px}</style>
