<script is:inline>
  (() => {
    if (window.__rqMotionIsland) return;
    window.__rqMotionIsland = true;

    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const root = document.documentElement;
    root.dataset.rqMotion = 'on';

    const revealItems = Array.from(document.querySelectorAll('[data-rq-reveal]'));

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-in'));
    }

    const heroSignals = Array.from(document.querySelectorAll('[data-rq-hero-signal]'));
    const supportsViewTimeline = typeof CSS !== 'undefined' && (
      CSS.supports?.('animation-timeline: view()') ||
      CSS.supports?.('animation-timeline', 'view()')
    );

    heroSignals.forEach((signal) => {
      const hero = signal.closest('.rq-hero') || signal;
      const markIn = () => signal.classList.add('is-in');

      if (supportsViewTimeline) {
        if ('IntersectionObserver' in window) {
          const enterObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                markIn();
                enterObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
          );

          enterObserver.observe(hero);
        } else {
          markIn();
        }

        return;
      }

      let isVisible = false;
      let frame = 0;

      const clamp = (value) => Math.max(0, Math.min(1, value));

      const updateHeroSignal = () => {
        frame = 0;

        if (!isVisible) return;

        const rect = hero.getBoundingClientRect();
        const progress = clamp(-rect.top / Math.max(1, rect.height * 0.85));
        const signalLift = Math.sin(progress * Math.PI);

        signal.style.setProperty('--rq-hero-scrub-x', `${(-18 * progress).toFixed(2)}px`);
        signal.style.setProperty('--rq-hero-scrub-y', `${(-24 * progress).toFixed(2)}px`);
        signal.style.setProperty('--rq-hero-dot-x', `${(-8 + 24 * progress).toFixed(2)}px`);
        signal.style.setProperty('--rq-hero-dot-y', `${(8 - 20 * progress).toFixed(2)}px`);
        signal.style.setProperty('--rq-hero-dot-scale', (0.94 + 0.14 * signalLift).toFixed(3));
        signal.style.setProperty('--rq-hero-dot-opacity', (0.58 + 0.34 * signalLift).toFixed(3));
      };

      const requestHeroSignalUpdate = () => {
        if (!isVisible || frame) return;
        frame = requestAnimationFrame(updateHeroSignal);
      };

      const setVisible = (visible) => {
        isVisible = visible;

        if (visible) {
          markIn();
          requestHeroSignalUpdate();
        } else if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      };

      window.addEventListener('scroll', requestHeroSignalUpdate, { passive: true });
      window.addEventListener('resize', requestHeroSignalUpdate);

      if ('IntersectionObserver' in window) {
        const signalObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => setVisible(entry.isIntersecting));
          },
          { threshold: 0, rootMargin: '120px 0px' }
        );

        signalObserver.observe(hero);
      } else {
        setVisible(true);
      }
    });

    const supportsFinePointer = window.matchMedia?.('(pointer: fine)').matches;

    if (supportsFinePointer) {
      document.querySelectorAll('[data-rq-magnetic]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          const moveX = Math.max(-6, Math.min(6, x * 0.08));
          const moveY = Math.max(-6, Math.min(6, y * 0.08));
          item.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
        });

        item.addEventListener('pointerleave', () => {
          item.style.transform = '';
        });
      });
    }

    const marqueeRoots = Array.from(document.querySelectorAll('[data-rq-marquee]'));

    marqueeRoots.forEach((marquee) => {
      const track = marquee.querySelector('[data-rq-marquee-track]');
      const group = marquee.querySelector('[data-rq-marquee-group]');
      if (!track || !group) return;

      let x = 0;
      let frame = 0;
      let isVisible = false;
      let currentSpeed = 0.42;
      let targetSpeed = 0.42;

      const getGroupWidth = () => group.getBoundingClientRect().width;

      const tick = () => {
        const width = getGroupWidth();

        if (width > 0) {
          currentSpeed += (targetSpeed - currentSpeed) * 0.08;
          x = (x + currentSpeed) % width;
          track.style.transform = `translate3d(${-x}px, 0, 0)`;
        }

        frame = isVisible ? requestAnimationFrame(tick) : 0;
      };

      const start = () => {
        if (frame) return;
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        if (!frame) return;
        cancelAnimationFrame(frame);
        frame = 0;
      };

      marquee.addEventListener('mouseenter', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('mouseleave', () => {
        targetSpeed = 0.42;
      });

      marquee.addEventListener('focusin', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('focusout', () => {
        targetSpeed = 0.42;
      });

      window.addEventListener('resize', () => {
        const width = getGroupWidth();
        if (width > 0) {
          x %= width;
        }
      });

      if ('IntersectionObserver' in window) {
        const marqueeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible) {
                start();
              } else {
                stop();
              }
            });
          },
          { threshold: 0, rootMargin: '120px 0px' }
        );

        marqueeObserver.observe(marquee);
      } else {
        isVisible = true;
        start();
      }
    });

    const countItems = Array.from(document.querySelectorAll('[data-rq-count]'));

    const animateCount = (item) => {
      if (item.dataset.rqCountDone === 'true') return;
      item.dataset.rqCountDone = 'true';

      const targetRaw = item.getAttribute('data-rq-count') || '0';
      const target = Number(targetRaw.replace(',', '.'));
      if (!Number.isFinite(target)) return;

      const originalText = item.textContent || '';
      const suffix = originalText.replace(/^\s*[+-]?[\d\s.,]+/, '');
      const decimals = targetRaw.includes('.') || targetRaw.includes(',') ? targetRaw.split(/[.,]/)[1]?.length || 0 : 0;
      const duration = 900;
      const start = performance.now();

      const tick = (now) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        item.textContent = `${value.toFixed(decimals)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          item.textContent = `${target.toFixed(decimals)}${suffix}`;
        }
      };

      requestAnimationFrame(tick);
    };

    if (countItems.length) {
      if ('IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              animateCount(entry.target);
              countObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.3, rootMargin: '0px 0px -8% 0px' }
        );

        countItems.forEach((item) => countObserver.observe(item));
      } else {
        countItems.forEach(animateCount);
      }
    }
  })();
</script>
