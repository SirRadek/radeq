  @media (min-width: 1024px) {
    .rq-problem-diagnostic__inner {
      width: var(--rq-page-w);
      max-width: var(--rq-page-w);
    }

    .rq-problem-diagnostic__head {
      margin-bottom: clamp(1.4rem, 2.6vw, 2.2rem);
    }

    /* B: skrýt mřížkový box — sekce má vlastní pozadí, karusel splyne */
    .rq-problem-diagnostic__board::before {
      display: none;
    }

    /* A: vertikální stack — filmstrip nahoře, panel pod ním, tagline dole */
    .rq-problem-diagnostic__board {
      grid-template-columns: 1fr;
      grid-template-areas:
        "stage"
        "output"
        "tagline";
      row-gap: clamp(0.5rem, 1.2vw, 1rem);
      --rq-card-h: clamp(7.5rem, 10vw, 8.5rem);
      --rq-card-h-lead: clamp(8rem, 10.5vw, 9rem);
      --rq-jaw-min-block-size: clamp(22rem, 26vw, 26rem);
    }

    .rq-problem-diagnostic__stage {
      grid-area: stage;
    }

    .rq-problem-diagnostic__output {
      grid-area: output;
      position: relative;
      width: 100%;
      max-width: 1080px;
      margin-inline: auto;
      margin-top: 1.4rem;
    }

    /* connector: zobáček od panelu k aktivní kartě (panel má overflow:hidden → na __output) */
    .rq-problem-diagnostic__output::before {
      content: "";
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      border-width: 0 12px 12px 12px;
      border-style: solid;
      border-color: transparent transparent #f3ead8 transparent;
    }

    .rq-problem-diagnostic__tagline {
      grid-area: tagline;
      text-align: center;
      max-width: 48ch;
      margin-inline: auto;
      margin-top: 1.2rem;
    }

    .rq-problem-diagnostic__script-sheet {
      gap: clamp(0.7rem, 1.3vw, 1rem);
      padding: clamp(0.95rem, 1.7vw, 1.4rem);
      min-block-size: 0;
    }

    .rq-problem-diagnostic__findings {
      gap: clamp(0.6rem, 1vw, 0.85rem);
    }

    .rq-problem-diagnostic__panel-top {
      padding-bottom: clamp(0.65rem, 1.2vw, 0.95rem);
    }
  }

  .rq-problem-diagnostic__back {
    display: none;
  }

  @media (max-width: 1023px) {
    .rq-problem-diagnostic__back {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      gap: 0.3rem;
      margin-top: 0.2rem;
      font-family: var(--rq-mono), ui-monospace, monospace;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--rq-diagnostic-accent);
      text-decoration: none;
    }

    .rq-problem-diagnostic__back:hover {
      text-decoration: underline;
    }
  }

  @media (max-width: 860px) {
    .rq-problem-diagnostic__head {
      display: grid;
      margin-bottom: 1.75rem;
    }

    .rq-problem-diagnostic__shell {
      --rq-card-w: min(58vw, 15rem);
      --rq-card-w-lead: min(60vw, 16rem);
      --rq-card-h: clamp(8.5rem, 28vw, 11rem);
      --rq-card-h-lead: clamp(9rem, 29vw, 11.5rem);
      --rq-jaw-min-block-size: clamp(18rem, 40vw, 26rem);
    }

    .rq-problem-diagnostic__meta-row {
      align-items: flex-start;
    }

    .rq-problem-diagnostic__carousel-scene {
      padding-block: 0.65rem 1rem;
      perspective: 820px;
      scroll-padding-inline: max(1rem, calc((100% - var(--rq-card-w)) / 2));
    }

    .rq-problem-diagnostic__filmstrip {
      gap: 0.85rem;
      padding-inline: max(1rem, calc((100% - var(--rq-card-w)) / 2));
      transform-style: flat;
    }

    .rq-problem-diagnostic__frame--lead {
      flex-basis: var(--rq-card-w-lead);
    }

    .rq-problem-diagnostic__card {
      --rq-card-lift: 0.35rem;
      --rq-card-depth: -34px;
    }

    .rq-problem-diagnostic__card[aria-selected='true'],
    .rq-problem-diagnostic__card[data-rq-problem-active='true'] {
      --rq-card-lift: 0;
      --rq-card-depth: 18px;
    }

    .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner {
      transform: none;
    }

    .rq-problem-diagnostic__card--lead .rq-problem-diagnostic__card-inner {
      min-block-size: var(--rq-card-h);
    }
  }

  @media (max-width: 640px) {
    .rq-problem-diagnostic__shell {
      --rq-card-w: min(54vw, 14rem);
      --rq-card-w-lead: min(58vw, 15rem);
      --rq-jaw-min-block-size: clamp(16rem, 38vw, 22rem);
    }

    /* kill 100vw stage bleed (30px přetok) — content-w=100% sníží board-pad-inline,
       takže stage drží full-width filmstrip, ale nepřetéká přes viewport */
    .rq-problem-diagnostic__board {
      --rq-diagnostic-board-content-w: 100%;
    }

    /* panel roste dle obsahu, ne pevný 62rem floor (žrout délky) */
    .rq-problem-diagnostic__script-sheet {
      min-block-size: 0;
    }

    .rq-problem-diagnostic__meta-row {
      display: grid;
      gap: 0.9rem;
    }

    .rq-problem-diagnostic__nav {
      width: 2.75rem;
      height: 2.75rem;
    }

    .rq-problem-diagnostic__findings {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .rq-problem-diagnostic__poster-title {
      font-size: 1.05rem;
      line-height: 0.98;
    }

    .rq-problem-diagnostic__panel-top,
    .rq-problem-diagnostic__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .rq-problem-diagnostic__panel h3 {
      font-size: clamp(1.38rem, 8vw, 1.9rem);
    }

    .rq-problem-diagnostic__actions .rq-btn {
      width: 100%;
    }
  }

  @media (max-width: 360px) {
    .rq-problem-diagnostic__shell {
      --rq-card-w: min(48vw, 12rem);
      --rq-card-w-lead: min(50vw, 12.5rem);
      --rq-card-h: 12.75rem;
      --rq-card-h-lead: 13rem;
    }

    .rq-problem-diagnostic__panel-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .rq-problem-diagnostic__severity-legend strong {
      white-space: normal;
      line-height: 1.25;
    }

    .rq-problem-diagnostic__poster-title {
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rq-problem-diagnostic,
    .rq-problem-diagnostic__card,
    .rq-problem-diagnostic__card::before,
    .rq-problem-diagnostic__card::after,
    .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__panel,
    .rq-problem-diagnostic__output.is-switching .rq-problem-diagnostic__panel.is-active {
      animation: none;
      transition: none;
    }

    .rq-problem-diagnostic__carousel-scene {
      perspective: none;
    }

    .rq-problem-diagnostic__filmstrip {
      transform-style: flat;
    }

    .rq-problem-diagnostic__card,
    .rq-problem-diagnostic__card[aria-selected='true'],
    .rq-problem-diagnostic__card[data-rq-problem-active='true'],
    .rq-problem-diagnostic__card:hover,
    .rq-problem-diagnostic__card:focus-visible,
    .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card[data-rq-problem-active='true'] .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card:hover .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__card:focus-visible .rq-problem-diagnostic__card-inner,
    .rq-problem-diagnostic__panel {
      transform: none;
    }

    .rq-problem-diagnostic__card {
      filter: none;
      opacity: 0.72;
    }

    .rq-problem-diagnostic__card[aria-selected='true'],
    .rq-problem-diagnostic__card[data-rq-problem-active='true'] {
      opacity: 1;
    }
  }
</style>

<script>
  import { inViewGate } from '../lib/inViewGate';

  (() => {
    const root = document.querySelector('[data-rq-problem-diagnostic]');
    if (!root || root.dataset.rqProblemDiagnosticReady === 'true') return;

    root.dataset.rqProblemDiagnosticReady = 'true';

    const carousel = root.querySelector('[data-rq-problem-carousel]');
    const output = root.querySelector('[data-rq-problem-output]');
    const allCards = Array.from(root.querySelectorAll('[data-rq-problem-card]'));
    const cards = allCards.filter((card) => !card.hasAttribute('data-rq-problem-clone'));
    const panels = Array.from(root.querySelectorAll('[data-rq-problem-panel]'));
    const prevButton = root.querySelector('[data-rq-problem-prev]');
    const nextButton = root.querySelector('[data-rq-problem-next]');
    const reducedMotionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');

    if (!carousel || !cards.length || !panels.length) return;

    let activeIndex = 0;
    let diagnosticInView = false;
    let userHasInteracted = false;
    let scrollSettleTimer = 0;
    let panelTimer = 0;
    let coverflowFrame = 0;
    let isLoopJumping = false;

    const markInteracted = () => {
      userHasInteracted = true;
      output?.setAttribute('aria-live', 'polite');
    };

    const clearScrollTimer = () => {
      if (!scrollSettleTimer) return;
      window.clearTimeout(scrollSettleTimer);
      scrollSettleTimer = 0;
    };

    const clearPanelTimer = () => {
      if (!panelTimer) return;
      window.clearTimeout(panelTimer);
      panelTimer = 0;
    };

    const clearCoverflowFrame = () => {
      if (!coverflowFrame) return;
      window.cancelAnimationFrame(coverflowFrame);
      coverflowFrame = 0;
    };

    const prefersReducedMotion = () => reducedMotionQuery?.matches === true;

    const normalizeIndex = (index) => {
      const count = cards.length;
      return ((index % count) + count) % count;
    };

    const isCloneCard = (card) => card instanceof HTMLElement && card.hasAttribute('data-rq-problem-clone');

    const readRealIndex = (card) => {
      const index = Number(card?.getAttribute('data-rq-problem-real-index'));
      return Number.isInteger(index) && index >= 0 && index < cards.length ? index : 0;
    };

    const findLoopClone = (realIndex, side) => allCards.find((card) => (
      isCloneCard(card)
        && card.getAttribute('data-rq-problem-clone-side') === side
        && readRealIndex(card) === realIndex
    ));

    const updateNav = () => {
      prevButton?.removeAttribute('disabled');
      nextButton?.removeAttribute('disabled');
    };

    const animatePanel = () => {
      if (!output || reducedMotionQuery?.matches) return;
      clearPanelTimer();
      output.classList.remove('is-switching');
      output.getBoundingClientRect();
      output.classList.add('is-switching');
      panelTimer = window.setTimeout(() => {
        output.classList.remove('is-switching');
        panelTimer = 0;
      }, 360);
    };

    const scrollCardIntoView = (index, options = {}) => {
      const card = options.card instanceof HTMLElement ? options.card : cards[index];
      if (!(card instanceof HTMLElement)) return;

      const carouselRect = carousel.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const left = carousel.scrollLeft
        + cardRect.left
        - carouselRect.left
        - (carouselRect.width - cardRect.width) / 2;

      carousel.scrollTo({
        left,
        behavior: options.instant || prefersReducedMotion() ? 'auto' : 'smooth',
      });
    };

    const setCardVar = (card, name, value) => {
      if (!(card instanceof HTMLElement)) return;
      card.style.setProperty(name, value);
    };

    const setCardCoverflow = (card, state) => {
      setCardVar(card, '--rq-card-rotate', `${state.rotate.toFixed(2)}deg`);
      setCardVar(card, '--rq-card-lift', `${state.lift.toFixed(2)}rem`);
      setCardVar(card, '--rq-card-depth', `${state.depth.toFixed(2)}px`);
      setCardVar(card, '--rq-card-scale', state.scale.toFixed(3));
      setCardVar(card, '--rq-card-opacity', state.opacity.toFixed(3));
      setCardVar(card, '--rq-card-saturate', state.saturate.toFixed(3));
    };

    const rotationFromDistance = (distance) => {
      const absDistance = Math.abs(distance);
      if (absDistance < 0.08) return 0;
      const amount = absDistance <= 1
        ? absDistance * 16
        : 16 + Math.min(absDistance - 1, 1.6) * 8;
      return -Math.sign(distance) * amount;
    };

    const updateCoverflow = () => {
      coverflowFrame = 0;
      const carouselRect = carousel.getBoundingClientRect();
      const carouselCenter = carouselRect.left + carouselRect.width / 2;
      const renderRange = carouselRect.width * 0.9;
      const reducedMotion = prefersReducedMotion();

      allCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const realIndex = readRealIndex(card);
        const isActive = realIndex === activeIndex;
        const rect = card.getBoundingClientRect();
        const cardWidth = Math.max(rect.width, 1);
        const cardCenter = rect.left + rect.width / 2;
        const rawDistance = (cardCenter - carouselCenter) / cardWidth;
        const absRawDistance = Math.abs(rawDistance);

        if (reducedMotion) {
          card.setAttribute('data-rq-problem-distance', isActive ? 'active' : 'near');
          setCardCoverflow(card, {
            rotate: 0,
            lift: 0,
            depth: 0,
            scale: 1,
            opacity: isActive ? 1 : 0.72,
            saturate: 1,
          });
          return;
        }

        const isNearViewport = rect.right >= carouselRect.left - renderRange
          && rect.left <= carouselRect.right + renderRange;

        if (!isNearViewport || absRawDistance > 3.2) {
          card.setAttribute('data-rq-problem-distance', 'hidden');
          setCardCoverflow(card, {
            rotate: 0,
            lift: 0.8,
            depth: -132,
            scale: 0.76,
            opacity: 0.06,
            saturate: 0.42,
          });
          return;
        }

        const distance = Math.max(-2.6, Math.min(2.6, rawDistance));
        const absDistance = Math.abs(distance);

        card.setAttribute('data-rq-problem-distance', isActive ? 'active' : absDistance > 2 ? 'far' : 'near');
        setCardCoverflow(card, {
          rotate: rotationFromDistance(distance),
          lift: isActive ? -0.25 : Math.min(absDistance * 0.42, 0.95),
          depth: isActive ? 42 : 26 - absDistance * 58,
          scale: isActive ? 1 : Math.max(0.78, 1 - absDistance * 0.085),
          opacity: isActive ? 1 : Math.max(0.18, 1 - absDistance * 0.31),
          saturate: isActive ? 1.08 : Math.max(0.52, 1.02 - absDistance * 0.18),
        });
      });
    };

    const requestCoverflow = () => {
      if (coverflowFrame || document.hidden) return;
      coverflowFrame = window.requestAnimationFrame(updateCoverflow);
    };

    const activate = (nextIndex, options = {}) => {
      const safeIndex = normalizeIndex(nextIndex);
      const previousIndex = activeIndex;
      const shouldAnimate = safeIndex !== activeIndex || options.forceAnimation;

      if (options.interacted) markInteracted();

      activeIndex = safeIndex;
      root.dataset.rqActiveIndex = String(activeIndex);

      allCards.forEach((card) => {
        const isActive = readRealIndex(card) === activeIndex;
        card.setAttribute('data-rq-problem-active', String(isActive));

        if (!isCloneCard(card)) return;
        card.setAttribute('aria-hidden', 'true');
        card.setAttribute('role', 'presentation');
        card.setAttribute('tabindex', '-1');
        card.toggleAttribute('inert', true);
      });

      cards.forEach((card, index) => {
        const isActive = index === activeIndex;
        card.setAttribute('aria-selected', String(isActive));
        card.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      panels.forEach((panel, index) => {
        const isActive = index === activeIndex;
        panel.classList.toggle('is-active', isActive);
        panel.setAttribute('aria-hidden', String(!isActive));
        panel.setAttribute('tabindex', isActive ? '0' : '-1');
        panel.toggleAttribute('inert', !isActive);
      });

      updateNav();
      requestCoverflow();
      if (safeIndex !== previousIndex) {
        const panel = panels[activeIndex];
        window.dispatchEvent(new CustomEvent('rq:problem-change', {
          detail: {
            title: panel?.getAttribute('data-rq-problem-mini-title') || '',
            problem: panel?.getAttribute('data-rq-problem-mini-problem') || '',
            step: panel?.getAttribute('data-rq-problem-mini-step') || '',
          },
        }));
      }
      if (shouldAnimate) animatePanel();
      if (options.scroll) scrollCardIntoView(activeIndex, {
        card: options.scrollTarget,
        instant: options.instant,
      });
      if (options.interacted && safeIndex !== previousIndex && typeof window !== 'undefined' && window.matchMedia('(max-width: 1023px)').matches) {
        const activePanel = panels[activeIndex];
        if (activePanel) {
          window.requestAnimationFrame(() => {
            activePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
        }
      }
      if (options.focus) cards[activeIndex]?.focus({ preventScroll: true });
    };

    root.addEventListener('click', (event) => {
      const serviceLink = event.target instanceof Element
        ? event.target.closest('[data-rq-primary-service-target]')
        : null;
      if (!serviceLink || !root.contains(serviceLink)) return;

      const primaryServiceId = serviceLink.getAttribute('data-rq-primary-service-target');
      const relatedServiceId = serviceLink.getAttribute('data-rq-related-service-target') || '';
      if (!primaryServiceId) return;

      const focusEvent = new CustomEvent('rq:service-focus', {
        detail: { primaryServiceId, relatedServiceId },
        cancelable: true,
      });

      if (!window.dispatchEvent(focusEvent)) {
        event.preventDefault();
      }
    });

    const closestCardInfo = () => {
      const carouselRect = carousel.getBoundingClientRect();
      const carouselCenter = carouselRect.left + carouselRect.width / 2;
      let closest = {
        card: cards[activeIndex],
        isClone: false,
        realIndex: activeIndex,
      };
      let closestDistance = Number.POSITIVE_INFINITY;

      allCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const distance = Math.abs(cardCenter - carouselCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closest = {
            card,
            isClone: isCloneCard(card),
            realIndex: readRealIndex(card),
          };
        }
      });

      return closest;
    };

    const silentJumpToRealCard = (realIndex) => {
      const card = cards[realIndex];
      if (!(card instanceof HTMLElement)) return;

      isLoopJumping = true;
      clearScrollTimer();
      root.classList.remove('is-scrolling');
      scrollCardIntoView(realIndex, { card, instant: true });

      window.requestAnimationFrame(() => {
        isLoopJumping = false;
        requestCoverflow();
      });
    };

    const settleScroll = () => {
      clearScrollTimer();
      root.classList.remove('is-scrolling');

      if (isLoopJumping) return;
      if (!diagnosticInView || document.hidden) return;
      const closest = closestCardInfo();
      activate(closest.realIndex, { interacted: userHasInteracted });
      if (closest.isClone) {
        silentJumpToRealCard(closest.realIndex);
        return;
      }
      requestCoverflow();
    };

    const scheduleScrollSettle = () => {
      if (isLoopJumping) return;
      if (!diagnosticInView || document.hidden) return;

      root.classList.add('is-scrolling');
      requestCoverflow();
      clearScrollTimer();
      scrollSettleTimer = window.setTimeout(settleScroll, 150);
    };

    const moveBy = (direction, options = {}) => {
      const rawIndex = activeIndex + direction;
      const nextIndex = normalizeIndex(rawIndex);
      const loopSide = rawIndex < 0 ? 'before' : rawIndex >= cards.length ? 'after' : '';
      const scrollTarget = loopSide ? findLoopClone(nextIndex, loopSide) || cards[nextIndex] : cards[nextIndex];

      activate(nextIndex, {
        interacted: true,
        scroll: true,
        focus: options.focus,
        scrollTarget,
      });
    };

    carousel.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const frame = target?.closest('.rq-problem-diagnostic__frame');
      if (!frame || !carousel.contains(frame)) return;

      const card = frame.querySelector('[data-rq-problem-card]');
      if (!(card instanceof HTMLElement)) return;
      const index = readRealIndex(card);
      if (card.getAttribute('data-rq-problem-distance') === 'hidden') return;

      activate(index, {
        interacted: true,
        scroll: true,
        scrollTarget: card,
      });
    });

    cards.forEach((card, index) => {
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(index, { interacted: true, scroll: true, focus: true });
        }

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          moveBy(1, { focus: true });
        }

        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          moveBy(-1, { focus: true });
        }

        if (event.key === 'Home') {
          event.preventDefault();
          activate(0, { interacted: true, scroll: true, focus: true });
        }

        if (event.key === 'End') {
          event.preventDefault();
          activate(cards.length - 1, { interacted: true, scroll: true, focus: true });
        }
      });
    });

    prevButton?.addEventListener('click', () => moveBy(-1, { focus: true }));
    nextButton?.addEventListener('click', () => moveBy(1, { focus: true }));

    carousel.addEventListener('pointerdown', markInteracted, { passive: true });
    carousel.addEventListener('touchstart', markInteracted, { passive: true });
    carousel.addEventListener('wheel', markInteracted, { passive: true });
    carousel.addEventListener('scroll', scheduleScrollSettle, { passive: true });

    if ('onscrollend' in window) {
      carousel.addEventListener('scrollend', settleScroll, { passive: true });
    }

    const handleResize = () => {
      clearScrollTimer();
      root.classList.remove('is-scrolling');
      requestCoverflow();
      if (diagnosticInView) scrollCardIntoView(activeIndex, { instant: true });
    };

    const handleReducedMotionChange = () => {
      root.classList.remove('is-scrolling');
      requestCoverflow();
      if (diagnosticInView) scrollCardIntoView(activeIndex, { instant: true });
    };

    window.addEventListener('resize', handleResize, { passive: true });
    if (typeof reducedMotionQuery?.addEventListener === 'function') {
      reducedMotionQuery.addEventListener('change', handleReducedMotionChange);
    } else if (typeof reducedMotionQuery?.addListener === 'function') {
      reducedMotionQuery.addListener(handleReducedMotionChange);
    }

    const gate = inViewGate(root, {
      rootMargin: '120px 0px',
      onEnter: () => {
        diagnosticInView = true;
        requestCoverflow();
      },
      onExit: () => {
        diagnosticInView = false;
        clearScrollTimer();
        root.classList.remove('is-scrolling');
      },
    });

    activate(0, { forceAnimation: false, scroll: true, instant: true });

    window.requestAnimationFrame(() => {
      scrollCardIntoView(activeIndex, { instant: true });
      requestCoverflow();
    });

    window.addEventListener('pagehide', () => {
      clearScrollTimer();
      clearPanelTimer();
      clearCoverflowFrame();
      window.removeEventListener('resize', handleResize);
      if (typeof reducedMotionQuery?.removeEventListener === 'function') {
        reducedMotionQuery.removeEventListener('change', handleReducedMotionChange);
      } else if (typeof reducedMotionQuery?.removeListener === 'function') {
        reducedMotionQuery.removeListener(handleReducedMotionChange);
      }
      gate.destroy();
    }, { once: true });
  })();
</script>
