---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['pricing'];
}

const { content } = Astro.props;
---

<section class="pricing-section" aria-labelledby="pricing-title" data-section-signature="pricing">
  <div class="pricing-process" id="process" aria-labelledby="process-title">
    <div>
      <p class="section-code">{content.process.eyebrow}</p>
      <h3 id="process-title">{content.process.title}</h3>
      <p>{content.process.text}</p>
    </div>
    <ol>
      {
        content.process.steps.map((step) => (
          <li>
            <span>{step.label}</span>
            <strong>{step.value}</strong>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="section-heading pricing-section__heading" id="pricing">
    <div>
      {content.sectionCode && <p class="section-code">{content.sectionCode}</p>}
      <h2 id="pricing-title">{content.title}</h2>
    </div>
    <p>{content.lead}</p>
  </div>
  <div class="pricing-grid">
    {
      content.items.map((item) => (
        <article class:list={['pricing-card', item.featured && 'pricing-card--featured']} tabindex="0">
          <div>
            <span class="pricing-card__price">{item.price}</span>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </div>
          <ul>
            {item.includes.map((include) => <li>{include}</li>)}
          </ul>
          <p class="pricing-card__output">{item.output}</p>
        </article>
      ))
    }
  </div>
  {content.note && <p class="pricing-section__note">{content.note}</p>}
</section>
