---
interface NavLink {
  href: string;
  label: string;
}

interface FooterContent {
  tagline?: string;
  navTitle?: string;
  navAriaLabel?: string;
  connectionTitle?: string;
  connectionLinks?: readonly NavLink[];
  legal?: string;
  contactEmail?: string;
  contactPhone?: string;
}

interface Props {
  navItems?: readonly NavLink[];
  content?: FooterContent;
  homeHref?: string;
}

const { navItems = [], content = {}, homeHref = Astro.url.pathname.includes("/en/") ? "/en/" : "/" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (h: string) => {
  if (!h || !h.startsWith("/")) return h;
  if (base && (h === base || h.startsWith(base + "/"))) return h;
  return base + h;
};
const logoMask = `${base}/brand/radeq-logo-b-mask.png`;
const tagline = content.tagline ?? "Racionální digitalizace pro živnostníky, malé firmy a spolky. Weby, data a automatizace bez zbytečné složitosti.";
const navTitle = content.navTitle ?? "Navigace";
const navAriaLabel = content.navAriaLabel ?? "Navigace v patičce";
const connectionTitle = content.connectionTitle ?? "Spojení";
const connectionLinks = content.connectionLinks ?? [
  { href: "/#kontakt", label: "Napsat poptávku" },
  { href: "/#ceny", label: "Ceny" },
];
const legal = content.legal ?? "© 2026 Radek Široký — RadeQ.cz · IČO 08748811 · Praha · celá ČR";
const legalItems = legal.split(/\s*(?:\u00b7|\u2014)\s*/).filter(Boolean);
const contactEmail = content.contactEmail ?? "siroky@radeq.cz";
const contactPhone = content.contactPhone ?? "+420 730 634 439";
const isEnglishFooter = homeHref.startsWith("/en") || navItems.some((item) => item.href.includes("/en/"));
const auditLink = isEnglishFooter
  ? { href: "/en/audit/", label: "Website audit" }
  : { href: "/audit/", label: "Audit webu" };
const footerNavItems = navItems.some((item) => item.href === auditLink.href) ? navItems : [...navItems, auditLink];
---

<footer class="rq-minimal-footer"><a class="rq-minimal-preview__logo" href={resolve(homeHref)} aria-label="RadeQ — home" style={`--logo-mask:url("${logoMask}")`}><span aria-hidden="true"></span></a><p>{legal}</p><nav aria-label={navAriaLabel}><a href={resolve(isEnglishFooter?'/en/ukazky/':'/ukazky/')}>{isEnglishFooter?'Examples':'Ukázky'}</a><a href={resolve(isEnglishFooter?'/en/soukromi/':'/soukromi/')}>{isEnglishFooter?'Privacy':'Soukromí'}</a><a href={resolve(auditLink.href)}>{auditLink.label}</a><a href={resolve('/zapisky/')}>{isEnglishFooter?'Notes':'Zápisky'}</a></nav></footer>
