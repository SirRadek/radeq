---
import { turnstileSiteKey } from '../data/site-config';
import PreviewEmailContact from './PreviewEmailContact.astro';
import { isPreviewChannel } from '../lib/preview-channel.mjs';
import type { HomeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
  content: HomeContent['contact'];
  lang: Locale;
}

const { content, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (href: string) => {
  if (!href || !href.startsWith('/')) return href;
  if (base && (href === base || href.startsWith(`${base}/`))) return href;
  return `${base}${href}`;
};
const verifyLabel = lang === 'en' ? 'Verify you are not a robot' : 'Ověření, že nejste robot';
const doneTitle = lang === 'en' ? 'Enquiry received ✓' : 'Poptávka přijata ✓';
const turnstileNote = lang === 'en'
  ? 'The form is protected by Cloudflare Turnstile — usually silent, no clicking needed.'
  : 'Formulář chrání Cloudflare Turnstile — většinou bez klikání, jen tiše na pozadí.';
---

{isPreviewChannel ? <PreviewEmailContact lang={lang} /> : <Fragment>
<form class="rq-contact-form" method="post" action={resolve('/api/leads')} id="rq-lead-form">
  <div class="rq-form-field">
    <label for="rq-lead-name">{content.fields.name}</label>
    <input maxlength="90" id="rq-lead-name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="rq-form-field">
    <label for="rq-lead-email">{content.fields.email}</label>
    <input maxlength="160" id="rq-lead-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="rq-form-field">
    <label for="rq-lead-current">{content.fields.projectType}</label>
    <select id="rq-lead-current" name="project_type">
      {content.projectOptions.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </div>

  <div class="rq-form-field">
    <label for="rq-lead-need">{content.fields.message}</label>
    <textarea maxlength="1200" id="rq-lead-need" name="message" rows="6" required></textarea>
  </div>

  <details class="rq-form-optional">
    <summary>{content.optionalSummary}</summary>
    <div class="rq-form-optional__grid">
      <div class="rq-form-field">
        <label for="rq-lead-budget">{content.fields.budget}</label>
        <select id="rq-lead-budget" name="budget_range">
          {content.budgetOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>
      <div class="rq-form-field">
        <label for="rq-lead-deadline">{content.fields.deadline}</label>
        <input maxlength="80" id="rq-lead-deadline" name="deadline" type="text" autocomplete="off" placeholder={content.fields.deadlinePlaceholder} />
      </div>
    </div>
  </details>

  <div class="rq-hp" aria-hidden="true">
    <label>{content.fields.honeypot}<input type="text" name="honeypot" tabindex="-1" autocomplete="off" /></label>
  </div>
  {turnstileSiteKey ? (
    <div class="rq-form-field rq-turnstile-group">
      <div class="rq-turnstile" id="rq-lead-turnstile" role="group" aria-label={verifyLabel}></div>
      <p class="rq-turnstile-note">{turnstileNote}</p>
    </div>
  ) : null}
  <p class="rq-form-legal">{lang === 'en' ? 'A non-binding enquiry, not an order. If you leave the category blank, it is sent as “General enquiry”.' : 'Nezávazná poptávka, nikoli objednávka. Bez výběru kategorie ji odešleme jako „Obecná poptávka“.'} <a href={resolve(lang === 'en' ? '/en/soukromi/' : '/soukromi/')}>{lang === 'en' ? 'Privacy' : 'Soukromí'}</a> · <a href={resolve(lang === 'en' ? '/en/spoluprace/' : '/spoluprace/')}>{lang === 'en' ? 'How we work together' : 'Podmínky spolupráce'}</a></p>
  <noscript><p>{lang === 'en' ? 'Please enable JavaScript to use the protected form, or email' : 'Pro chráněný formulář zapněte JavaScript, nebo napište na'} <a href="mailto:siroky@radeq.cz">siroky@radeq.cz</a>.</p></noscript>
  <button class="rq-btn rq-btn--primary" type="submit">{content.submitLabel}</button>
  <p class="rq-form-status" id="rq-lead-status" role="status" aria-live="polite"></p>
</form>

<div class="rq-contact-done" id="rq-lead-done" role="status" tabindex="-1" hidden>
  <p class="rq-contact-done__title">{doneTitle}</p>
  <p class="rq-contact-done__text">{content.status.success}</p>
</div>

<script>
  import { buildLeadPayload, createSubmissionController } from '../lib/contact-client.mjs';
  window.dispatchEvent(new CustomEvent('radeq:contact-ready', {detail:{buildLeadPayload,createSubmissionController}}));
</script>
<script is:inline define:vars={{
  leadsUrl: resolve('/api/leads'),
  leadLocale: lang,
  statusSending: content.status.sending,
  statusSuccess: content.status.success,
  statusFailureHtml: content.status.failureHtml,
  verifyPrompt: content.status.verifyPrompt,
  doneLeadHtml: content.doneLeadHtml,
  turnstileSiteKey,
}}>
  window.addEventListener("radeq:contact-ready", ({detail: {buildLeadPayload,createSubmissionController}}) => {
    const form = document.getElementById("rq-lead-form");
    const statusEl = document.getElementById("rq-lead-status");
    if (!form) return;
    const params = new URLSearchParams(location.search);
    const currentUrlHint = (params.get("current_url") || "").slice(0, 240);
    const projectTypeHint = params.get("project_type") || "";
    const projectSelect = form.elements.namedItem("project_type");

    if (projectTypeHint && projectSelect instanceof HTMLSelectElement) {
      const normalizedProjectTypeHint = projectTypeHint.trim().toLocaleLowerCase();
      const matchingOption = Array.from(projectSelect.options).find((option) => {
        if (option.value === projectTypeHint) return true;
        return normalizedProjectTypeHint === "audit" && option.value.toLocaleLowerCase().includes("audit");
      });
      if (matchingOption) projectSelect.value = matchingOption.value;
    }

    const turnstileEnabled = Boolean(turnstileSiteKey);
    const turnstileContainer = document.getElementById("rq-lead-turnstile");
    let turnstileToken = "";
    let turnstileWidgetId = null;
    let turnstileUnavailable = false;

    function loadTurnstile() {
      return new Promise((resolve, reject) => {
        if (window.turnstile) return resolve();
        const src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        const existing = document.querySelector('script[src="' + src + '"]');
        if (existing) {
          existing.addEventListener("load", () => resolve(), { once: true });
          existing.addEventListener("error", () => reject(new Error("turnstile")), { once: true });
          return;
        }
        const s = document.createElement("script");
        s.src = src;
        s.async = true;
        s.defer = true;
        s.addEventListener("load", () => resolve(), { once: true });
        s.addEventListener("error", () => reject(new Error("turnstile")), { once: true });
        document.head.appendChild(s);
      });
    }

    if (turnstileEnabled && turnstileContainer) {
      loadTurnstile()
        .then(() => {
          if (!window.turnstile) {
            turnstileUnavailable = true;
            return;
          }
          turnstileWidgetId = window.turnstile.render(turnstileContainer, {
            sitekey: turnstileSiteKey,
            appearance: "interaction-only",
            callback: (t) => {
              turnstileToken = t;
              turnstileUnavailable = false;
            },
            "expired-callback": () => {
              turnstileToken = "";
            },
            "error-callback": () => {
              turnstileToken = "";
              turnstileUnavailable = true;
            },
          });
        })
        .catch(() => {
          turnstileUnavailable = true;
        });
    }

    function readToken() {
      if (turnstileToken) return turnstileToken;
      const input = turnstileContainer && turnstileContainer.querySelector('input[name="cf-turnstile-response"]');
      return input && input.value ? input.value : "";
    }

    const button = form.querySelector('button[type="submit"]');
    const submitter = createSubmissionController({fetch: window.fetch.bind(window), onSuccess: () => window.dispatchEvent(new Event('radeq:lead-received'))});
    let submitting = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitting || !form.reportValidity()) return;
      const fd = new FormData(form);
      if (fd.get("honeypot")) return;

      let submittedToken = "";
      if (turnstileEnabled) {
        submittedToken = readToken();
        if (!submittedToken) {
          if (turnstileUnavailable) {
            statusEl.innerHTML = statusFailureHtml;
          } else {
            statusEl.textContent = verifyPrompt;
          }
          return;
        }
      }

      const payload = buildLeadPayload(fd,{locale:leadLocale,path:location.pathname,referrer:document.referrer,currentUrl:currentUrlHint});
      if (turnstileEnabled) payload.turnstileToken = submittedToken;

      statusEl.textContent = statusSending;
      submitting = true;
      button.disabled = true;
      form.setAttribute('aria-busy','true');
      try {
        const outcome = await submitter.submit(leadsUrl, payload);
        if (outcome !== 'received') throw new Error('receipt');
        form.reset();
        const done = document.getElementById("rq-lead-done");
        if (done) {
          form.hidden = true;
          done.hidden = false;
          done.focus();
          const leadEl = document.getElementById("rq-contact-lead");
          if (leadEl && doneLeadHtml) leadEl.innerHTML = doneLeadHtml;
          const noteEmail = document.getElementById("rq-contact-note-email");
          if (noteEmail) noteEmail.hidden = true;
          const notePhone = document.getElementById("rq-contact-note-phone");
          if (notePhone) notePhone.hidden = true;
        } else {
          statusEl.textContent = statusSuccess;
        }
      } catch (err) {
        statusEl.innerHTML = statusFailureHtml;
      } finally {
        submitting = false;
        button.disabled = false;
        form.removeAttribute('aria-busy');
        if (turnstileEnabled && turnstileWidgetId && window.turnstile) {
          turnstileToken = "";
          window.turnstile.reset(turnstileWidgetId);
        }
      }
    });
  }, {once:true});
</script>

</Fragment>}
