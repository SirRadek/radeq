---
import { homeContent, type HomeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
  content?: HomeContent['journey'];
  lang?: Locale;
}

const { content = homeContent.cs.journey, lang = 'cs' } = Astro.props;
const localeContent = homeContent[lang];
const phases = content.phases;
const trustPoints = content.trustPoints;
const startPreviewItems = localeContent.problems.items.slice(0, 4);
const endPreviewItems = localeContent.showcase.items.slice(0, 3);
const previewLabels = lang === 'en'
  ? {
      startCarousel: 'Problem previews',
      endCarousel: 'Example previews',
      previous: 'Previous preview item',
      next: 'Next preview item',
      indicator: 'Show preview item',
    }
  : {
      startCarousel: 'N\u00e1hledy probl\u00e9m\u016f',
      endCarousel: 'N\u00e1hledy uk\u00e1zek',
      previous: 'P\u0159edchoz\u00ed polo\u017eka n\u00e1hledu',
      next: 'Dal\u0161\u00ed polo\u017eka n\u00e1hledu',
      indicator: 'Zobrazit polo\u017eku n\u00e1hledu',
    };
---

<div class="rq-journey" data-rq-journey>
  <div class="rq-journey__header" data-rq-reveal>
    <p class="rq-eyebrow">{content.eyebrow}</p>
    <h2 class="rq-h2">{content.title}</h2>
  </div>

  <div class="rq-journey__timeline rq-journey-line" data-rq-reveal>
    <div class="rq-journey-line__copy">
      <p>{content.timelineText}</p>
      <small>{content.timelineNote}</small>
    </div>

    <div class="rq-journey-line__track">
      <div class="rq-journey-line__flow">
        <div class="rq-journey-line__rail" aria-hidden="true"></div>
        <button
          class="rq-journey-line__cap rq-journey-line__cap--start"
          type="button"
          aria-expanded="false"
          aria-controls="rq-journey-preview"
          data-rq-journey-preview-trigger="start"
        >
          <span>{content.startCap}</span>
          <span class="rq-journey-line__cap-dot"></span>
        </button>

        <div
          class="rq-journey-line__tabs"
          role="tablist"
          aria-label={content.tablistAriaLabel}
          aria-orientation="horizontal"
        >
          {phases.map((phase, index) => (
            <button
              class:list={['rq-journey-node', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              id={`rq-journey-tab-${phase.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`rq-journey-panel-${phase.id}`}
              aria-label={phase.title}
              data-rq-journey-node
              data-rq-target-index={index}
              tabindex={index === 0 ? '0' : '-1'}
            >
              <span class="rq-journey-node__label">
                <span class="rq-journey-node__number">{phase.number}</span>
                <span class="rq-journey-node__title">{phase.title}</span>
              </span>
              <span class="rq-journey-node__dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <button
          class="rq-journey-line__cap rq-journey-line__cap--end"
          type="button"
          aria-expanded="false"
          aria-controls="rq-journey-preview"
          data-rq-journey-preview-trigger="end"
        >
          <span>{content.endCap}</span>
          <span class="rq-journey-line__cap-dot"></span>
        </button>
      </div>
    </div>
  </div>

  <div class="rq-journey__body" data-rq-journey-body>
    <aside class="rq-journey-preview" id="rq-journey-preview" hidden inert tabindex="-1" data-rq-journey-preview>
      <div class="rq-journey-preview__mode" data-rq-journey-preview-mode="start">
        <div class="rq-journey-preview__shell" data-rq-journey-preview-carousel data-rq-preview-carousel-mode="start">
          <button class="rq-journey-preview__nav rq-journey-preview__nav--prev" type="button" aria-label={previewLabels.previous} data-rq-journey-preview-prev disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M15 5 8 12l7 7"></path>
            </svg>
          </button>

          <div class="rq-journey-preview__carousel-scene" aria-label={previewLabels.startCarousel}>
            <ul class="rq-journey-preview__filmstrip">
              {startPreviewItems.map((item, index) => (
                <li
                  class:list={['rq-journey-preview__frame', index === 0 && 'is-active']}
                  data-rq-journey-preview-frame
                  data-rq-preview-index={index}
                  data-rq-preview-side={index === 0 ? 'active' : 'after'}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <article class="rq-problem-diagnostic__panel--mini rq-journey-preview__card" tabindex={index === 0 ? '0' : '-1'} data-rq-journey-preview-card>
                    <p class="rq-journey-preview__eyebrow">{content.preview.start.eyebrow}</p>
                    <h3>{item.symptom}</h3>
                    <dl class="rq-journey-preview__facts">
                      <div>
                        <dt>{content.preview.start.problemLabel}</dt>
                        <dd>{item.problem}</dd>
                      </div>
                      <div>
                        <dt>{content.preview.start.stepLabel}</dt>
                        <dd>{item.step}</dd>
                      </div>
                    </dl>
                    <a class="rq-btn rq-btn--primary" href="#co-resim" data-rq-journey-scroll data-rq-preview-interactive>{content.preview.start.ctaLabel}</a>
                  </article>
                </li>
              ))}
            </ul>
          </div>

          <button class="rq-journey-preview__nav rq-journey-preview__nav--next" type="button" aria-label={previewLabels.next} data-rq-journey-preview-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </button>

          <div class="rq-journey-preview__indicators" role="group" aria-label={previewLabels.startCarousel}>
            {startPreviewItems.map((_, index) => (
              <button
                class="rq-journey-preview__indicator"
                type="button"
                aria-label={`${previewLabels.indicator} ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
                data-rq-journey-preview-indicator
              >
                {String(index + 1).padStart(2, '0')}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="rq-journey-preview__mode" data-rq-journey-preview-mode="end" hidden>
        <div class="rq-journey-preview__shell" data-rq-journey-preview-carousel data-rq-preview-carousel-mode="end">
          <button class="rq-journey-preview__nav rq-journey-preview__nav--prev" type="button" aria-label={previewLabels.previous} data-rq-journey-preview-prev disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M15 5 8 12l7 7"></path>
            </svg>
          </button>

          <div class="rq-journey-preview__carousel-scene" aria-label={previewLabels.endCarousel}>
            <ul class="rq-journey-preview__filmstrip">
              {endPreviewItems.map((item, index) => (
                <li
                  class:list={['rq-journey-preview__frame', index === 0 && 'is-active']}
                  data-rq-journey-preview-frame
                  data-rq-preview-index={index}
                  data-rq-preview-side={index === 0 ? 'active' : 'after'}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <article class="rq-journey-preview__example rq-journey-preview__card" tabindex={index === 0 ? '0' : '-1'} data-rq-journey-preview-card>
                    <span class="rq-ukazky-bento-card__badge">{item.badge}</span>
                    <span class="rq-ukazky-bento-card__kicker">{item.kicker}</span>
                    <strong class="rq-ukazky-bento-card__title">{item.title}</strong>
                    <span class="rq-ukazky-bento-card__text">{item.text}</span>
                    <a class="rq-btn rq-btn--ghost" href={item.href} data-rq-preview-interactive>{item.linkLabel}</a>
                  </article>
                </li>
              ))}
            </ul>
          </div>

          <button class="rq-journey-preview__nav rq-journey-preview__nav--next" type="button" aria-label={previewLabels.next} data-rq-journey-preview-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </button>

          <div class="rq-journey-preview__indicators" role="group" aria-label={previewLabels.endCarousel}>
            {endPreviewItems.map((_, index) => (
              <button
                class="rq-journey-preview__indicator"
                type="button"
                aria-label={`${previewLabels.indicator} ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
                data-rq-journey-preview-indicator
              >
                {String(index + 1).padStart(2, '0')}
              </button>
            ))}
          </div>
        </div>
      </div>
    </aside>

    <div class="rq-journey__panels" id="rq-journey-panels" data-rq-journey-panels>
    {phases.map((phase, index) => (
      <section
        id={`rq-journey-panel-${phase.id}`}
        class:list={['rq-journey-step__panel', { 'is-active': index === 0 }]}
        role="tabpanel"
        aria-labelledby={`rq-journey-tab-${phase.id}`}
        aria-hidden={index === 0 ? 'false' : 'true'}
        inert={index !== 0}
        data-rq-journey-panel
        data-rq-step-index={index}
      >
        <div class="rq-journey-panel__topline">
          <span>{phase.number}</span>
          <h3>{phase.title}</h3>
        </div>

        <dl class="rq-journey-panel__grid">
          <div>
            <dt>{content.panelLabels.solve}</dt>
            <dd>{phase.solve}</dd>
          </div>
          <div>
            <dt>{content.panelLabels.duration}</dt>
            <dd>{phase.duration}.</dd>
          </div>
          <div>
            <dt>{content.panelLabels.process}</dt>
            <dd>{phase.process}</dd>
          </div>
          <div>
            <dt>{content.panelLabels.benefit}</dt>
            <dd>{phase.benefit}</dd>
          </div>
        </dl>

        <ul class="rq-journey-tags" aria-label={`${content.panelLabels.tagListAriaPrefix} ${phase.title}`}>
          {phase.tags.map((tag) => (
            <li>
              <span>{tag.label}</span>
              {tag.strong ? <strong>{tag.value}</strong> : tag.value}
            </li>
          ))}
        </ul>
      </section>
    ))}
    </div>
  </div>

  <ul class="rq-journey-trust" aria-label={content.trustAriaLabel} data-rq-reveal>
    {trustPoints.map((point) => <li>{point}</li>)}
  </ul>
</div>
