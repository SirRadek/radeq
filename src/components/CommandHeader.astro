---
import type { SiteContent } from '../data/siteContent';
import type { Locale } from '../data/locales';
import { getEpochOptions } from '../data/styleMatrix';
import RadeqBrandLogo from './RadeqBrandLogo.astro';
import StyleVariantToggle from './StyleVariantToggle';
import ThemeModeToggle from './ThemeModeToggle';

interface Props {
  content: SiteContent['header'];
  alternatePath?: string;
  alternateLabel?: string;
  locale: Locale;
  homePath?: string;
  showStyleToggle?: boolean;
  showThemeToggle?: boolean;
  brandVariant?: 'default' | 'logo-b';
}

const {
  content,
  alternatePath,
  alternateLabel,
  locale,
  homePath,
  showStyleToggle = false,
  showThemeToggle = true,
  brandVariant = 'logo-b',
} = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const alternateHref = alternatePath ? `${basePath}${alternatePath}` : undefined;
const styleOptions = getEpochOptions(locale);
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const resolveHref = (href: string) => {
  if (homePath && href.startsWith('#')) {
    return `${basePath}${homePath}${href}`;
  }

  return href.startsWith('/') ? `${basePath}${href}` : href;
};
const isHomepage = currentPath === `${basePath || ''}/` || currentPath === '/';
const getSectionTarget = (href: string) => {
  if (homePath || !href.startsWith('#')) return undefined;
  return href.slice(1);
};
const isCurrentPath = (href: string) => {
  if (!href.startsWith('/')) return false;
  const normalizedHref = href.endsWith('/') ? href : `${href}/`;
  return currentPath === `${basePath}${normalizedHref}` || currentPath === normalizedHref;
};
---

<header class="command-header" aria-label={content.ariaLabel}>
  <a class:list={['brand-mark', brandVariant === 'logo-b' && 'brand-mark--logo-b']} href="#top" aria-label={content.brandAria}>
    {
      brandVariant === 'logo-b'
        ? <RadeqBrandLogo />
        : (
          <>
            <span class="brand-pulse" aria-hidden="true"></span>
            <span>Radeq.cz</span>
          </>
        )
    }
  </a>
  <nav class="command-nav" aria-label={content.navAria}>
    {
      content.navItems.map((item) => {
        const sectionTarget = getSectionTarget(item.href);
        const active = sectionTarget === 'top' && isHomepage ? 'location' : isCurrentPath(item.href) ? 'page' : undefined;

        return (
          <a
            href={resolveHref(item.href)}
            aria-current={active}
            data-section-target={sectionTarget}
            data-nav-href={item.href}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
  <div class="header-actions">
    {showStyleToggle && <StyleVariantToggle label={content.styleLabel} options={styleOptions} client:load />}
    {
      showThemeToggle && (
        <ThemeModeToggle
          label={content.themeLabel}
          lightLabel={content.lightTheme}
          darkLabel={content.darkTheme}
          client:load
        />
      )
    }
    {alternateHref && alternateLabel ? <a class="language-link" href={alternateHref}>{alternateLabel}</a> : null}
  </div>
</header>

<script>
  (() => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.command-nav a[data-section-target]'));
    if (links.length === 0) return;

    const sections = links
      .map((link) => {
        const target = link.dataset.sectionTarget;
        return target ? { link, section: document.getElementById(target) } : undefined;
      })
      .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(item?.section));

    if (sections.length === 0) return;

    const setActive = (activeLink: HTMLAnchorElement) => {
      for (const { link } of sections) {
        if (link === activeLink) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    const update = () => {
      const anchor = window.innerHeight * 0.28;
      let active = sections[0];

      for (const item of sections) {
        const rect = item.section.getBoundingClientRect();
        if (rect.top <= anchor && rect.bottom >= anchor) {
          active = item;
          break;
        }

        if (rect.top <= anchor) {
          active = item;
        }
      }

      setActive(active.link);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  })();
</script>
