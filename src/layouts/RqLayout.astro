---
import type { Locale } from '../data/locales';
import MeasurementTracker from '../components/MeasurementTracker';
import rqCssHref from '../styles/rq.css?url';

// Above-the-fold critical CSS (verbatim copy of rq.css:1-134 — tokens, reset,
// base typography, .rq-section/.rq-bleed). Inlined so first paint never waits
// on the full stylesheet; the deferred load below re-applies it identically.
const criticalCss = `:root {
  font-size: clamp(1rem, min(calc(1rem + (100vw - 1920px) / 120), calc(1rem + (100vh - 1080px) / 67.5)), 2rem);
  --rq-bg: #F7F4EE;
  --rq-bg-sunken: #EFEAE0;
  --rq-surface: #FFFFFF;
  --rq-ink: #1C1A17;
  --rq-ink-2: #4F4942;
  --rq-line: #E6E0D4;
  --rq-burgundy: #7A1F2B;
  --rq-burgundy-strong: #5E1622;
  --rq-burgundy-tint: #F3E7E9;
  --rq-carbon: #1A1611;
  --rq-carbon-2: #242018;
  --rq-on-dark: #F1EDE4;
  --rq-on-dark-2: #C9BFB1;
  --rq-maxw: 80rem;
  --rq-maxw-wide: 90rem;
  --rq-gutter: clamp(1rem, 3vw, 4rem);
  --rq-page-w: min(calc(100% - 2 * var(--rq-gutter)), clamp(var(--rq-maxw), 72vw, 86.4rem));
  --rq-page-w-wide: min(calc(100% - 2 * var(--rq-gutter)), var(--rq-maxw-wide));
  --rq-pad: clamp(1.5rem, 4.5vh, 4.25rem);
  --rq-r: 14px;
  --rq-r-pill: 999px;
  --rq-ease: cubic-bezier(.16, 1, .3, 1);
  --rq-display: "Plus Jakarta Sans";
  --rq-body: "Inter";
  --rq-mono: "JetBrains Mono";
  --rq-header-height: 4.6rem;
}
* { box-sizing: border-box; }
html {
  background: var(--rq-carbon);
  scroll-padding-top: calc(var(--rq-header-height) + 0.5rem);
}
body {
  background: var(--rq-bg) !important;
  overflow-x: clip;
}
body::before, body::after {
  content: "";
  position: fixed;
  left: 0;
  z-index: 15;
  width: 100%;
  height: clamp(2rem, 4vw, 2.625rem);
  pointer-events: none;
}
body::before {
  top: var(--rq-header-height, 4.6rem);
  background: linear-gradient(180deg, var(--rq-bg) 0%, rgba(247, 244, 238, 0) 100%);
}
body::after {
  bottom: 0;
  background: linear-gradient(0deg, var(--rq-bg) 0%, rgba(247, 244, 238, 0) 100%);
  transition: opacity 520ms var(--rq-ease);
}
@media (max-width: 860px) {
  body::after { display: none; }
}
body {
  margin: 0;
  color: var(--rq-ink);
  font-family: var(--rq-body), system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 1rem;
  line-height: 1.6;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}
img, svg { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
main { isolation: isolate; }
h1, h2, h3 {
  margin: 0;
  color: var(--rq-ink);
  font-family: var(--rq-display), var(--rq-body), system-ui, sans-serif;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.02;
}
p { margin: 0; }
.rq-section {
  width: var(--rq-page-w);
  margin-inline: auto;
  padding-block: var(--rq-pad);
}
.rq-bleed {
  width: 100vw;
  margin-inline: calc(50% - 50vw);
}`;

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  alternatePath?: string;
  alternateLang?: Locale;
  allowStoredStyle?: boolean;
}

const { title, description, lang = 'cs', canonicalPath, alternatePath, alternateLang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ? `${basePath}${canonicalPath}` : Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternatePath ? new URL(`${basePath}${alternatePath}`, siteUrl).toString() : undefined;
const ogImageUrl = new URL(`${basePath}/og-default.jpg`, siteUrl).toString();
const defaultUrl = lang === 'cs' ? canonicalUrl : alternateUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <style is:global set:html={criticalCss}></style>
    <link rel="preload" href={rqCssHref} as="style" />
    {/* Desktop (>=861px): render-blocking so multi-column layout is stable at first paint (kills the
        desktop CLS); desktop LCP has ample headroom. On mobile the media query does not match, so this
        link is non-render-blocking. */}
    <link rel="stylesheet" href={rqCssHref} media="screen and (min-width: 861px)" />
    {/* Mobile (and desktop, redundantly after load): async apply so small screens never block first
        paint on the full sheet. Mobile is single-column so late-applied CSS causes no meaningful shift. */}
    <link rel="stylesheet" href={rqCssHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={rqCssHref} /></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet"></noscript>
    <link rel="icon" type="image/png" href={basePath + '/favicon.png'} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href={basePath + '/favicon-dark.png'} />
    <link rel="apple-touch-icon" href={basePath + '/apple-touch-icon.png'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePath && alternateLang && alternateUrl ? (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
        <link rel="alternate" hreflang="x-default" href={defaultUrl} />
      </>
    ) : null}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RadeQ.cz" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <MeasurementTracker client:idle />
    <slot />
    <script is:inline>
      (() => {
        const readyKey = 'rqFooterFogReady';
        const root = document.documentElement;
        const body = document.body;

        if (!body || root.dataset[readyKey] === 'true') return;
        root.dataset[readyKey] = 'true';

        const footer = document.querySelector('.rq-site-footer');
        const setFooterVisible = (isVisible) => {
          body.classList.toggle('is-footer-visible', isVisible);
        };

        if (!footer || !('IntersectionObserver' in window)) {
          setFooterVisible(false);
          root.dataset[readyKey] = 'false';
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          const isVisible = entries.some((entry) => entry.isIntersecting);
          setFooterVisible(isVisible);
        }, {
          rootMargin: '0px 0px 48px 0px',
          threshold: 0,
        });

        observer.observe(footer);

        window.addEventListener('pagehide', () => {
          observer.disconnect();
          setFooterVisible(false);
          root.dataset[readyKey] = 'false';
        }, { once: true });
      })();
    </script>
  </body>
</html>
