---
import {legalContent} from '../data/legal';
import {legalParagraphs} from '../lib/legal-paragraphs.mjs';
import RqLayout from '../layouts/RqLayout.astro';
import RqHeader from './RqHeader.astro';
import RqFooter from './RqFooter.astro';
interface Props {lang:'cs'|'en';kind:'privacy'|'cooperation'}
const {lang,kind}=Astro.props;
const c=legalContent[lang][kind];const en=lang==='en';
const slug=kind==='privacy'?'soukromi':'spoluprace';
const updated=kind==='privacy'?(en?'Updated 30 October 2026':'Aktualizováno 30. října 2026'):(en?'Updated 28 October 2026':'Aktualizováno 28. října 2026');
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<RqLayout title={c.title+' | RadeQ.cz'} description={c.intro} lang={lang} canonicalPath={'/'+(en?'en/':'')+slug+'/'} alternateLang={en?'cs':'en'} alternatePath={'/'+(en?'':'en/')+slug+'/'} trackEvents={false}>
 <RqHeader alternateLabel={en?'CS':'EN'} alternatePath={'/'+(en?'':'en/')+slug+'/'} />
 <main class="rq-legal"><p class="rq-eyebrow">RadeQ · {updated}</p><h1>{c.title}</h1><p class="rq-lead">{c.intro}</p>
 <nav class="rq-legal-index" aria-label={en?'On this page':'Na této stránce'}><p>{en?'On this page':'Na této stránce'}</p><ol>{c.sections.map(([title],i)=><li><a href={`#legal-${i+1}`}>{title}</a></li>)}</ol></nav>
 {c.sections.map(([title,body],i)=><section id={`legal-${i+1}`}><h2>{title}</h2>{legalParagraphs(body).map(paragraph=><p set:html={paragraph}/>)}</section>)}
 <nav aria-label={en?'Related information':'Související informace'}><a href={base+(en?'/en/':'/')+'#kontakt'}>{en?'Contact':'Kontakt'}</a> · <a href={base+(en?'/en/':'/')+(kind==='privacy'?'spoluprace/':'soukromi/')}>{kind==='privacy'?(en?'Working together':'Podmínky spolupráce'):(en?'Privacy and cookies':'Soukromí a cookies')}</a></nav>
 </main><RqFooter />
</RqLayout>
<style>
 .rq-legal{max-width:64ch;margin:0 auto;padding:2.5rem 0 3rem}
 .rq-legal h1{font-family:Chillax,sans-serif;font-size:clamp(2rem,4vw,2.75rem);line-height:1.15;font-weight:600;margin:1rem 0}
 .rq-legal section{margin:2rem 0;padding:0;scroll-margin-top:1.5rem}
 .rq-legal h2{font-size:1.25rem;line-height:1.35;font-weight:600;margin:0 0 .75rem}
 .rq-legal p{font-size:1rem;line-height:1.7;max-width:none;margin:0 0 1rem}
 .rq-legal .rq-eyebrow{font-size:.75rem}
 .rq-legal .rq-lead{font-size:1.0625rem}
 .rq-legal :global(a){color:#7a1f2b;text-underline-offset:3px;overflow-wrap:anywhere}
 .rq-legal-index{display:block;margin:1.5rem 0 2rem;padding:1rem 0;border-block:1px solid #d7cec1;font-size:.875rem}
 .rq-legal-index p{font-size:.875rem;font-weight:600;margin-bottom:.5rem}
 .rq-legal-index ol{padding-left:1.25rem;display:grid;gap:.45rem;margin:0}
 .rq-legal-index a{display:inline-block;padding-block:.2rem;line-height:1.5}
</style>
