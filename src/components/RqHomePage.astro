  <script is:inline define:vars={{ serviceLiveFallback: content.services.liveFallback, serviceLivePrefix: content.services.livePrefix }}>
    (() => {
      const grid = document.querySelector('[data-rq-service-rotator]');
      if (!grid) return;

      const tiles = Array.from(grid.querySelectorAll('.rq-service-tile'));
      if (tiles.length < 2) return;
      const liveEl = grid.parentElement?.querySelector('[data-rq-service-live]');

      const ROTATION_MS = 20000;
      const PROGRESS_INTRO_MS = 520;
      const IN_MS = 820;
      const OUT_MS = 460;
      const REST_MS = 620;
      const QUICK_IN_MS = 620;
      const QUICK_OUT_MS = 360;
      const QUICK_REST_MS = 500;
      const FEATURED_SLOT = 'web';
      const RELATED_SLOT = 'shop';
      const SLOTS = ['web', 'shop', 'automation', 'data', 'audit'];
      const SMALL_SLOTS = SLOTS.filter((slot) => slot !== FEATURED_SLOT);
      const IN_EASING = 'cubic-bezier(.16,1,.3,1)';
      const OUT_EASING = 'cubic-bezier(.4,0,.2,1)';
      const REST_EASING = 'cubic-bezier(.25,1,.5,1)';
      const initialFeatured = tiles.find((tile) => tile.classList.contains('is-featured')) || tiles[0];
      const initialSlots = new Map(tiles.map((tile) => [tile, tile.dataset.rqSlot || '']));
      const reduceQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');
      const mobileQuery = window.matchMedia?.('(max-width: 860px)');
      const supportsAnimations = typeof tiles[0].animate === 'function';
      const supportsCss = typeof CSS !== 'undefined';
      const supportsMaskRing = supportsCss
        && typeof CSS.supports === 'function'
        && (
          CSS.supports('-webkit-mask-composite', 'xor')
          || CSS.supports('mask-composite', 'exclude')
          || CSS.supports('(-webkit-mask-composite: xor)')
          || CSS.supports('(mask-composite: exclude)')
        );
      const supportsProgressRing = supportsCss && 'registerProperty' in CSS && supportsMaskRing;
      const slotOrders = permute(SMALL_SLOTS);

      grid.style.setProperty('--rq-service-rotation-ms', `${ROTATION_MS}ms`);
      grid.style.setProperty('--rq-service-progress-intro-ms', `${PROGRESS_INTRO_MS}ms`);

      let observer = null;
      let resizeTimer = 0;
      let timerId = 0;
      let timerStartedAt = 0;
      let remainingMs = ROTATION_MS;
      let inView = false;
      let pointerPaused = false;
      let focusPaused = false;
      let isAnimating = false;
      let userLocked = false;
      let enhancementAvailable = false;
      let pendingConfigure = true;
      let highlightTimer = 0;
      let liveTimer = 0;
      let retryFocusTimer = 0;

      function permute(items) {
        if (items.length <= 1) return [items.slice()];
        return items.flatMap((item, index) => {
          const rest = items.slice(0, index).concat(items.slice(index + 1));
          return permute(rest).map((order) => [item].concat(order));
        });
      }

      function canEnhance() {
        return supportsAnimations && !reduceQuery?.matches && !mobileQuery?.matches;
      }

      function currentFeatured() {
        return tiles.find((tile) => tile.classList.contains('is-featured')) || initialFeatured;
      }

      function restartProgressAnimation(tile) {
        if (!enhancementAvailable || !supportsProgressRing || !tile) return;
        tile.classList.add('is-progress-restarting');
        void tile.offsetWidth;
        tile.classList.remove('is-progress-restarting');
      }

      function setFeatured(tile) {
        const previousFeatured = currentFeatured();
        tiles.forEach((candidate) => {
          const active = candidate === tile;
          candidate.classList.toggle('is-featured', active);
          if (active) {
            candidate.setAttribute('aria-current', 'true');
          } else {
            candidate.removeAttribute('aria-current');
          }
        });
        if (tile && tile !== previousFeatured) restartProgressAnimation(tile);
      }

      function resetToInitialState() {
        tiles.forEach((tile) => {
          const slot = initialSlots.get(tile);
          if (slot) tile.dataset.rqSlot = slot;
        });
        setFeatured(initialFeatured);
      }

      function setInteractive(enabled) {
        tiles.forEach((tile) => {
          if (!enabled) {
            tile.removeAttribute('role');
            tile.removeAttribute('tabindex');
            return;
          }
          tile.setAttribute('role', 'button');
          tile.setAttribute('tabindex', '0');
        });
      }

      function clearTimer() {
        if (!timerId) return;
        window.clearTimeout(timerId);
        timerId = 0;
      }

      function pauseTimer() {
        if (!timerId) return;
        remainingMs = Math.max(0, remainingMs - (performance.now() - timerStartedAt));
        clearTimer();
      }

      function updateInViewFromRect() {
        if (document.hidden) {
          inView = false;
          return inView;
        }

        const rect = grid.getBoundingClientRect();
        const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 0;
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        inView = rect.width > 0
          && rect.height > 0
          && rect.bottom > 0
          && rect.right > 0
          && rect.top < viewportHeight
          && rect.left < viewportWidth;
        return inView;
      }

      function isRotationPaused() {
        return userLocked || isAnimating || pointerPaused || focusPaused;
      }

      function canRotate() {
        return enhancementAvailable && !document.hidden && inView && !isRotationPaused();
      }

      function scheduleTimer() {
        if (timerId || !canRotate()) return;
        timerStartedAt = performance.now();
        timerId = window.setTimeout(() => {
          timerId = 0;
          remainingMs = ROTATION_MS;
          autoAdvance();
        }, remainingMs);
      }

      function syncPauseState() {
        const paused = !canRotate();
        grid.classList.toggle('is-paused', enhancementAvailable && paused);
        if (paused) {
          pauseTimer();
        } else {
          scheduleTimer();
        }
      }

      function disconnectObserver() {
        if (!observer) return;
        observer.disconnect();
        observer = null;
      }

      function observeGrid() {
        disconnectObserver();
        if (!('IntersectionObserver' in window)) {
          updateInViewFromRect();
          syncPauseState();
          return;
        }
        observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          inView = Boolean(entry && entry.isIntersecting);
          syncPauseState();
        }, { threshold: 0 });
        observer.observe(grid);
        updateInViewFromRect();
        syncPauseState();
      }

      function stopRotation() {
        pendingConfigure = true;
        window.clearTimeout(resizeTimer);
        resizeTimer = 0;
        inView = false;
        clearTimer();
        disconnectObserver();
        syncPauseState();
      }

      function requestConfigure() {
        pendingConfigure = true;
        configure();
      }

      function getNextTile() {
        const active = currentFeatured();
        const start = tiles.indexOf(active);
        for (let offset = 1; offset < tiles.length; offset += 1) {
          const candidate = tiles[(start + offset) % tiles.length];
          if (candidate && candidate !== active) return candidate;
        }
        return null;
      }

      function applySwap(target) {
        const active = currentFeatured();
        if (!target || target === active) return false;

        const releasedSlot = target.dataset.rqSlot || initialSlots.get(target);
        active.dataset.rqSlot = releasedSlot;
        target.dataset.rqSlot = FEATURED_SLOT;
        setFeatured(target);
        return true;
      }

      function reserveGridHeight(options = {}) {
        const force = Boolean(options.force);

        if (document.hidden && !force) {
          pendingConfigure = true;
          return;
        }

        if (!enhancementAvailable && !force) {
          grid.style.minHeight = '';
          return;
        }

        const width = grid.getBoundingClientRect().width;
        if (!width) return;

        grid.style.minHeight = '0px';

        const clone = grid.cloneNode(true);
        const cloneTiles = Array.from(clone.querySelectorAll('.rq-service-tile'));
        clone.removeAttribute('data-rq-reveal');
        clone.classList.remove('is-rotation-ready', 'is-paused', 'is-flipping', 'is-user-locked');
        clone.style.position = 'absolute';
        clone.style.left = '-10000px';
        clone.style.top = '0';
        clone.style.width = `${width}px`;
        clone.style.minHeight = '0';
        clone.style.visibility = 'hidden';
        clone.style.pointerEvents = 'none';

        document.body.appendChild(clone);
        let maxHeight = grid.getBoundingClientRect().height;

        cloneTiles.forEach((tile) => {
          tile.removeAttribute('role');
          tile.removeAttribute('tabindex');
        });

        cloneTiles.forEach((_, featuredIndex) => {
          const smallIndices = cloneTiles
            .map((tile, index) => index)
            .filter((index) => index !== featuredIndex);

          slotOrders.forEach((order) => {
            cloneTiles.forEach((tile, index) => {
              const active = index === featuredIndex;
              tile.classList.toggle('is-featured', active);
              tile.dataset.rqSlot = active ? FEATURED_SLOT : order[smallIndices.indexOf(index)];
            });
            maxHeight = Math.max(maxHeight, clone.getBoundingClientRect().height);
          });
        });

        clone.remove();
        grid.style.minHeight = `${Math.ceil(maxHeight)}px`;
      }

      function applyFocusLayout(primaryTile, relatedTile) {
        if (!primaryTile) return false;

        const nextSlots = new Map();
        const usedSlots = new Set();

        const assignSlot = (tile, slot) => {
          if (!tile || !slot || nextSlots.has(tile) || usedSlots.has(slot)) return false;
          nextSlots.set(tile, slot);
          usedSlots.add(slot);
          return true;
        };

        assignSlot(primaryTile, FEATURED_SLOT);
        if (relatedTile && relatedTile !== primaryTile) assignSlot(relatedTile, RELATED_SLOT);

        const remainingSlots = SLOTS.filter((slot) => !usedSlots.has(slot));
        const unassignedTiles = new Set(tiles.filter((tile) => !nextSlots.has(tile)));

        const assignPreferredSlots = (getSlot) => {
          tiles.forEach((tile) => {
            if (!unassignedTiles.has(tile)) return;
            const slot = getSlot(tile);
            const slotIndex = remainingSlots.indexOf(slot);
            if (slotIndex < 0) return;
            nextSlots.set(tile, slot);
            remainingSlots.splice(slotIndex, 1);
            unassignedTiles.delete(tile);
          });
        };

        assignPreferredSlots((tile) => tile.dataset.rqSlot || '');
        assignPreferredSlots((tile) => initialSlots.get(tile) || '');

        unassignedTiles.forEach((tile) => {
          const slot = remainingSlots.shift();
          if (slot) nextSlots.set(tile, slot);
        });

        let changed = currentFeatured() !== primaryTile;
        tiles.forEach((tile) => {
          const nextSlot = nextSlots.get(tile);
          if (!nextSlot) return;
          if (tile.dataset.rqSlot !== nextSlot) changed = true;
          tile.dataset.rqSlot = nextSlot;
        });
        setFeatured(primaryTile);

        return changed;
      }

      function animateTileLayout(updateLayout, options = {}) {
        if (!enhancementAvailable || isAnimating) return false;

        const quick = Boolean(options.quick);
        const primaryTile = options.primaryTile || null;
        const relatedTile = options.relatedTile || null;
        const outgoingTile = options.outgoingTile || null;

        isAnimating = true;
        grid.classList.add('is-flipping');
        syncPauseState();

        const firstRects = new Map(tiles.map((tile) => [tile, tile.getBoundingClientRect()]));
        const changed = updateLayout();
        const lastRects = new Map(tiles.map((tile) => [tile, tile.getBoundingClientRect()]));

        tiles.forEach((tile) => {
          tile.style.zIndex = tile === primaryTile ? '4' : tile === relatedTile ? '3' : tile === outgoingTile ? '1' : '2';
        });

        const finish = () => {
          tiles.forEach((tile) => {
            tile.style.transformOrigin = '';
            tile.style.zIndex = '';
            tile.classList.remove('is-flip-animating');
          });
          grid.classList.remove('is-flipping');
          isAnimating = false;
          remainingMs = ROTATION_MS;
          syncPauseState();
        };

        if (!changed) {
          finish();
          return false;
        }

        const animations = tiles.map((tile) => {
          const first = firstRects.get(tile);
          const last = lastRects.get(tile);
          if (!first || !last) return null;

          const dx = first.left - last.left;
          const dy = first.top - last.top;
          const sx = first.width / Math.max(last.width, 1);
          const sy = first.height / Math.max(last.height, 1);
          const moved = Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5 || Math.abs(sx - 1) > 0.01 || Math.abs(sy - 1) > 0.01;
          if (!moved) return null;

          const incoming = tile === primaryTile;
          const outgoing = tile === outgoingTile && tile !== primaryTile;
          const duration = incoming
            ? (quick ? QUICK_IN_MS : IN_MS)
            : outgoing
              ? (quick ? QUICK_OUT_MS : OUT_MS)
              : (quick ? QUICK_REST_MS : REST_MS);
          const easing = incoming ? IN_EASING : outgoing ? OUT_EASING : REST_EASING;
          const delay = outgoing && !quick ? 60 : 0;
          const keyframes = outgoing
            ? [
                { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, opacity: 0.9 },
                { transform: 'translate(0, 0) scale(1, 1)', opacity: 1 },
              ]
            : [
                { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
                { transform: 'translate(0, 0) scale(1, 1)' },
              ];

          tile.style.transformOrigin = 'top left';
          tile.classList.add('is-flip-animating');
          return tile.animate(keyframes, {
            duration,
            easing,
            delay,
            fill: 'both',
          });
        }).filter(Boolean);

        if (!animations.length) {
          finish();
          return changed;
        }

        Promise.allSettled(animations.map((animation) => animation.finished)).then(finish);
        return changed;
      }

      function promoteTile(target, options = {}) {
        const active = currentFeatured();
        if (!enhancementAvailable || !target || target === active || isAnimating) return false;
        return animateTileLayout(() => applySwap(target), {
          quick: Boolean(options.quick),
          primaryTile: target,
          outgoingTile: active,
        });
      }

      function promoteFocusedServices(primaryTile, relatedTile, options = {}) {
        const active = currentFeatured();
        if (!enhancementAvailable || !primaryTile || isAnimating) return false;
        return animateTileLayout(() => applyFocusLayout(primaryTile, relatedTile), {
          quick: Boolean(options.quick),
          primaryTile,
          relatedTile,
          outgoingTile: active,
        });
      }

      function autoAdvance() {
        if (!canRotate()) {
          syncPauseState();
          return;
        }
        promoteTile(getNextTile());
      }

      function lockToTile(tile) {
        if (!enhancementAvailable || !tile || tile === currentFeatured()) return;
        userLocked = true;
        clearTimer();
        disconnectObserver();
        grid.classList.add('is-user-locked', 'is-paused');
        promoteTile(tile, { quick: true });
      }

      function serviceTileById(serviceId) {
        return tiles.find((tile) => tile.dataset.rqServiceId === serviceId) || null;
      }

      function clearCrossHighlight() {
        if (highlightTimer) {
          window.clearTimeout(highlightTimer);
          highlightTimer = 0;
        }
        if (liveTimer) {
          window.clearTimeout(liveTimer);
          liveTimer = 0;
        }
        tiles.forEach((tile) => tile.classList.remove('is-cross-highlight', 'is-related-highlight'));
      }

      function getTileTitle(tile) {
        return tile?.querySelector('h3')?.textContent?.trim() || '';
      }

      function markCrossHighlight(tile, relatedTile = null) {
        clearCrossHighlight();
        tile.classList.add('is-cross-highlight');
        if (relatedTile && relatedTile !== tile) relatedTile.classList.add('is-related-highlight');

        const title = getTileTitle(tile) || serviceLiveFallback;
        const relatedTitle = relatedTile && relatedTile !== tile ? getTileTitle(relatedTile) : '';
        const liveTitle = relatedTitle ? `${title} + ${relatedTitle}` : title;
        if (liveEl) {
          liveEl.textContent = '';
          liveTimer = window.setTimeout(() => {
            liveEl.textContent = `${serviceLivePrefix} ${liveTitle}`;
            liveTimer = 0;
          }, 0);
        }

        highlightTimer = window.setTimeout(() => {
          tile.classList.remove('is-cross-highlight');
          relatedTile?.classList.remove('is-related-highlight');
          highlightTimer = 0;
        }, 3000);
      }

      function scrollTileToCenter(tile) {
        window.requestAnimationFrame(() => {
          tile.scrollIntoView({
            behavior: reduceQuery?.matches ? 'auto' : 'smooth',
            block: 'center',
            inline: 'nearest',
          });
        });
      }

      function lockRotationForFocus() {
        userLocked = true;
        clearTimer();
        disconnectObserver();
        grid.classList.add('is-user-locked', 'is-paused');
      }

      function focusService(primaryServiceId, relatedServiceId = '') {
        const target = serviceTileById(primaryServiceId);
        if (!target) return false;
        const relatedTarget = serviceTileById(relatedServiceId);
        const validRelatedTarget = relatedTarget && relatedTarget !== target ? relatedTarget : null;

        lockRotationForFocus();

        if (canEnhance()) {
          enhancementAvailable = true;
          grid.classList.toggle('has-rq-progress-ring', supportsProgressRing);
          grid.classList.add('is-rotation-ready', 'is-paused');
          setInteractive(true);
          reserveGridHeight({ force: true });

          if (isAnimating) {
            if (retryFocusTimer) window.clearTimeout(retryFocusTimer);
            retryFocusTimer = window.setTimeout(() => {
              retryFocusTimer = 0;
              focusService(primaryServiceId, relatedServiceId);
            }, QUICK_IN_MS + 80);
          } else if (!promoteFocusedServices(target, validRelatedTarget, { quick: true })) {
            syncPauseState();
          } else {
            syncPauseState();
          }
        } else {
          enhancementAvailable = false;
          grid.classList.remove('is-rotation-ready', 'has-rq-progress-ring', 'is-flipping');
          setInteractive(false);
          reserveGridHeight({ force: true });
          applyFocusLayout(target, validRelatedTarget);
        }

        markCrossHighlight(target, validRelatedTarget);
        scrollTileToCenter(target);
        return true;
      }

      function handleServiceFocus(event) {
        const primaryServiceId = event.detail?.primaryServiceId;
        const relatedServiceId = event.detail?.relatedServiceId;
        if (typeof primaryServiceId !== 'string' || !primaryServiceId) return;
        if (!focusService(primaryServiceId, typeof relatedServiceId === 'string' ? relatedServiceId : '')) return;
        event.preventDefault?.();
      }

      function configure() {
        if (document.hidden) {
          pendingConfigure = true;
          pauseTimer();
          return;
        }

        pendingConfigure = false;
        enhancementAvailable = canEnhance();
        clearTimer();
        disconnectObserver();
        inView = false;
        pointerPaused = grid.matches(':hover');
        focusPaused = grid.contains(document.activeElement);
        remainingMs = ROTATION_MS;

        grid.classList.toggle('has-rq-progress-ring', supportsProgressRing && enhancementAvailable);
        grid.classList.toggle('is-user-locked', userLocked && enhancementAvailable);
        grid.classList.remove('is-flipping');

        if (!enhancementAvailable) {
          grid.classList.remove('is-rotation-ready', 'is-paused', 'has-rq-progress-ring');
          grid.classList.toggle('is-user-locked', userLocked);
          setInteractive(false);
          if (!userLocked) resetToInitialState();
          if (userLocked) {
            reserveGridHeight({ force: true });
          } else {
            grid.style.minHeight = '';
          }
          return;
        }

        setInteractive(true);
        reserveGridHeight();
        grid.classList.add('is-rotation-ready', 'is-paused');
        if (!userLocked) restartProgressAnimation(currentFeatured());

        if (userLocked) {
          syncPauseState();
          return;
        }
        observeGrid();
      }

      function closestTile(event) {
        const eventTarget = event.target instanceof Element ? event.target : null;
        if (!eventTarget) return null;
        const tile = eventTarget.closest('.rq-service-tile');
        return tile && grid.contains(tile) ? tile : null;
      }

      function watchQuery(query) {
        if (!query) return;
        if (typeof query.addEventListener === 'function') {
          query.addEventListener('change', requestConfigure);
          return;
        }
        if (typeof query.addListener === 'function') {
          query.addListener(requestConfigure);
        }
      }

      grid.addEventListener('pointerenter', () => {
        if (!enhancementAvailable || userLocked) return;
        pointerPaused = true;
        syncPauseState();
      });

      grid.addEventListener('pointerleave', () => {
        if (!enhancementAvailable || userLocked) return;
        pointerPaused = false;
        syncPauseState();
      });

      grid.addEventListener('focusin', () => {
        if (!enhancementAvailable || userLocked) return;
        focusPaused = true;
        syncPauseState();
      });

      grid.addEventListener('focusout', () => {
        window.requestAnimationFrame(() => {
          if (!enhancementAvailable || userLocked) return;
          focusPaused = grid.contains(document.activeElement);
          syncPauseState();
        });
      });

      grid.addEventListener('click', (event) => {
        const target = closestTile(event);
        if (!target) return;
        lockToTile(target);
      });

      grid.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = closestTile(event);
        if (!target) return;
        event.preventDefault();
        lockToTile(target);
      });

      window.addEventListener('rq:service-focus', handleServiceFocus);

      function handleVisibilityChange() {
        if (document.hidden) {
          pauseTimer();
          syncPauseState();
          return;
        }

        if (pendingConfigure) {
          configure();
          return;
        }

        updateInViewFromRect();
        syncPauseState();
      }

      document.addEventListener('visibilitychange', handleVisibilityChange);

      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = 0;
        resizeTimer = window.setTimeout(() => {
          resizeTimer = 0;
          configure();
        }, 160);
      });

      window.addEventListener('pagehide', () => {
        clearCrossHighlight();
        if (retryFocusTimer) {
          window.clearTimeout(retryFocusTimer);
          retryFocusTimer = 0;
        }
        window.removeEventListener('rq:service-focus', handleServiceFocus);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        stopRotation();
      });

      watchQuery(reduceQuery);
      watchQuery(mobileQuery);

      configure();
    })();
  </script>

