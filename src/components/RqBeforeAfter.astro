---
const pairs = [
  {
    before: 'Poptávky se ztrácí v e-mailech.',
    after: 'Jeden formulář, všechno na jednom místě.',
  },
  {
    before: 'Data přepisujete mezi tabulkami.',
    after: 'Přenos běží sám, bez ručního opisování.',
  },
  {
    before: 'Web jen existuje, ale nevydělává.',
    after: 'Jasná cesta od návštěvy k poptávce.',
  },
];
---

<article class="rq-before-after" data-rq-before-after data-rq-ba-state="before" aria-labelledby="rq-before-after-title">
  <div class="rq-before-after__head">
    <h2 class="rq-before-after__title" id="rq-before-after-title">Předtím &amp; Potom</h2>
    <div class="rq-before-after__toggle" role="group" aria-label="Přepnout stav panelu">
      <button class="rq-before-after__button is-active" type="button" aria-pressed="true" data-rq-ba-button data-rq-ba-mode="before">Předtím</button>
      <button class="rq-before-after__button" type="button" aria-pressed="false" data-rq-ba-button data-rq-ba-mode="after">Potom</button>
    </div>
  </div>

  <ol class="rq-before-after__list" aria-live="polite">
    {pairs.map((pair, index) => (
      <li class="rq-before-after__item">
        <span class="rq-before-after__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="rq-before-after__copy">
          <span class="rq-before-after__text rq-before-after__text--before" data-rq-ba-text="before" aria-hidden="false">{pair.before}</span>
          <span class="rq-before-after__text rq-before-after__text--after" data-rq-ba-text="after" aria-hidden="true">{pair.after}</span>
        </span>
      </li>
    ))}
  </ol>
</article>

<script is:inline>
  (() => {
    const roots = Array.from(document.querySelectorAll('[data-rq-before-after]'));

    roots.forEach((root) => {
      const buttons = Array.from(root.querySelectorAll('[data-rq-ba-button]'));
      const texts = Array.from(root.querySelectorAll('[data-rq-ba-text]'));
      if (!buttons.length || !texts.length) return;

      const setMode = (mode, focusActive = false) => {
        root.setAttribute('data-rq-ba-state', mode);

        buttons.forEach((button) => {
          const isActive = button.getAttribute('data-rq-ba-mode') === mode;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive && focusActive) button.focus();
        });

        texts.forEach((text) => {
          const isActive = text.getAttribute('data-rq-ba-text') === mode;
          text.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
      };

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => {
          setMode(button.getAttribute('data-rq-ba-mode') || 'before');
        });

        button.addEventListener('keydown', (event) => {
          const key = event.key;
          let nextIndex = index;

          if (key === 'ArrowRight' || key === 'ArrowDown') nextIndex = (index + 1) % buttons.length;
          else if (key === 'ArrowLeft' || key === 'ArrowUp') nextIndex = (index - 1 + buttons.length) % buttons.length;
          else if (key === 'Home') nextIndex = 0;
          else if (key === 'End') nextIndex = buttons.length - 1;
          else if (key === 'Enter' || key === ' ') {
            event.preventDefault();
            setMode(button.getAttribute('data-rq-ba-mode') || 'before');
            return;
          } else {
            return;
          }

          event.preventDefault();
          setMode(buttons[nextIndex].getAttribute('data-rq-ba-mode') || 'before', true);
        });
      });

      setMode(root.getAttribute('data-rq-ba-state') || 'before');
    });
  })();
</script>
