---
import type { SiteContent } from '../data/siteContent';

interface Props {
  content: SiteContent['audience'];
}

const { content } = Astro.props;
---
<section class="audience-band ds-section" aria-labelledby="audience-title">
  <div class="audience-heading">
    {content.sectionCode && <p class="ds-eyebrow">{content.sectionCode}</p>}
    <h2 id="audience-title" class="ds-h2">{content.title}</h2>
  </div>

  <div class="audience-grid">
    {content.items.map((track) => (
      <article class="audience-card ds-card">
        <h3>{track.title}</h3>
        <p>{track.signal}</p>
      </article>
    ))}
  </div>
</section>
