---
const palettes = [
  { id: 'walnut', label: 'A', name: 'Practical walnut', note: 'doporučeno', swatches: ['#F7F1E8', '#241914', '#A85F2A', '#2F6F68'] },
  { id: 'forest', label: 'B', name: 'Copper + forest', note: 'teplejší', swatches: ['#FAF6EF', '#211713', '#A85F2A', '#315C45'] },
  { id: 'royal', label: 'C', name: 'Walnut + royal blue', note: 'tech', swatches: ['#F8F1E8', '#211713', '#A65F2A', '#1D4E89'] },
  { id: 'espresso', label: 'D', name: 'Espresso black', note: 'premium', swatches: ['#F5F0E9', '#16110E', '#9E5525', '#3A2B23'] },
];

const modes = [
  { id: 'auto', label: 'Auto', note: 'system' },
  { id: 'light', label: 'Světlý', note: 'light' },
  { id: 'dark', label: 'Tmavý', note: 'dark' },
];
---

<aside class="palette-preview-panel" aria-label="Přepínač barevných variant preview">
  <div class="palette-preview-panel__group" role="group" aria-label="Barevná paleta">
    <span>Paleta</span>
    <div class="palette-preview-panel__options">
      {
        palettes.map((palette) => (
          <button type="button" data-palette-preview-option={palette.id} aria-pressed={palette.id === 'walnut' ? 'true' : 'false'}>
            <strong>{palette.label}</strong>
            <span>{palette.name}</span>
            <em>{palette.note}</em>
            <i aria-hidden="true">
              {palette.swatches.map((swatch) => <b style={`--swatch: ${swatch}`}></b>)}
            </i>
          </button>
        ))
      }
    </div>
  </div>
  <div class="palette-preview-panel__group palette-preview-panel__group--mode" role="group" aria-label="Režim barev">
    <span>Režim</span>
    <div class="palette-preview-panel__modes">
      {
        modes.map((mode) => (
          <button type="button" data-palette-preview-mode={mode.id} aria-pressed={mode.id === 'auto' ? 'true' : 'false'}>
            <strong>{mode.label}</strong>
            <small>{mode.note}</small>
          </button>
        ))
      }
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const paletteButtons = Array.from(document.querySelectorAll('[data-palette-preview-option]'));
    const modeButtons = Array.from(document.querySelectorAll('[data-palette-preview-mode]'));
    const paletteKey = 'radeq-palette-preview-palette';
    const modeKey = 'radeq-palette-preview-theme';
    const palettes = ['walnut', 'forest', 'royal', 'espresso'];
    const modes = ['auto', 'light', 'dark'];
    const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const read = (key, fallback, allowed) => {
      try {
        const value = localStorage.getItem(key);
        return allowed.includes(value) ? value : fallback;
      } catch {
        return fallback;
      }
    };

    const write = (key, value) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        // Local storage is optional for this preview.
      }
    };

    const setPressed = (buttons, attr, value) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset[attr] === value ? 'true' : 'false');
      });
    };

    const updateFavicon = (mode) => {
      const active = document.querySelector('link[data-preview-favicon-active]');
      if (!active) return;

      if (mode === 'auto') {
        active.setAttribute('href', systemQuery.matches ? active.dataset.darkHref : active.dataset.lightHref);
        return;
      }

      active.setAttribute('href', mode === 'dark' ? active.dataset.darkHref : active.dataset.lightHref);
    };

    const apply = () => {
      const palette = read(paletteKey, 'walnut', palettes);
      const mode = read(modeKey, 'auto', modes);

      root.dataset.palettePreview = 'true';
      root.dataset.palette = palette;
      root.dataset.previewThemePreference = mode;
      root.dataset.theme = mode;
      setPressed(paletteButtons, 'palettePreviewOption', palette);
      setPressed(modeButtons, 'palettePreviewMode', mode);
      updateFavicon(mode);
    };

    paletteButtons.forEach((button) => {
      button.addEventListener('click', () => {
        write(paletteKey, button.dataset.palettePreviewOption);
        apply();
      });
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        write(modeKey, button.dataset.palettePreviewMode);
        apply();
      });
    });

    systemQuery.addEventListener?.('change', apply);
    apply();
  })();
</script>
