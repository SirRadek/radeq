---
import AudienceBand from '../../components/AudienceBand.astro';
import CommandHeader from '../../components/CommandHeader.astro';
import ContactTerminal from '../../components/ContactTerminal';
import DemoGallery from '../../components/DemoGallery';
import HandoffStandard from '../../components/HandoffStandard.astro';
import HeroSection from '../../components/HeroSection.astro';
import SelectedSystems from '../../components/SelectedSystems.astro';
import StyleMatrixSimulator from '../../components/StyleMatrixSimulator';
import { siteContent } from '../../data/siteContent';
import BaseLayout from '../../layouts/BaseLayout.astro';

const content = siteContent.en;
---

<BaseLayout
  title={content.layout.title}
  description={content.layout.description}
  lang={content.layout.lang}
  alternatePath={content.layout.alternatePath}
  alternateLang="cs"
>
  <CommandHeader
    content={content.header}
    alternatePath={content.layout.alternatePath}
    alternateLabel={content.layout.alternateLabel}
  />
  <main>
    <HeroSection content={content.hero} />
    <StyleMatrixSimulator locale={content.layout.lang} content={content.matrix} client:load />
    <AudienceBand content={content.audience} />
    <DemoGallery content={content.demos} client:visible={{ rootMargin: '200px' }} />
    <HandoffStandard content={content.handoff} />
    <SelectedSystems content={content.systems} />
    <ContactTerminal locale={content.layout.lang} content={content.terminal} client:load />
  </main>
</BaseLayout>
