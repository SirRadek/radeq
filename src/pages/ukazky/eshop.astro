---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const products = [
  { name: 'Mlýnské espresso', profile: 'Čokoláda, lískový oříšek, plné tělo.', category: 'espresso', badge: 'espresso', prices: { '250 g': 219, '500 g': 399, '1 kg': 749 } },
  { name: 'Ranní směs', profile: 'Karamel, sušené ovoce, jemná sladkost.', category: 'espresso', badge: 'espresso', prices: { '250 g': 239, '500 g': 429, '1 kg': 799 } },
  { name: 'Etiopie Sidamo', profile: 'Meruňka, černý čaj, květinová vůně.', category: 'filtr', badge: 'filtr', prices: { '250 g': 269, '500 g': 499 } },
  { name: 'Kolumbie Huila', profile: 'Třtinový cukr, jablko, čistý dozvuk.', category: 'filtr', badge: 'filtr', prices: { '250 g': 249, '500 g': 459, '1 kg': 859 } },
  { name: 'Brazílie bez kofeinu', profile: 'Kakao, mandle, nízká acidita.', category: 'bezkofeinova', badge: 'bez kofeinu', prices: { '250 g': 259, '500 g': 479 } },
  { name: 'Mletá káva do moka konvičky', profile: 'Oříšková, výrazná, připravená na doma.', category: 'espresso', badge: 'mletá', prices: { '250 g': 229, '500 g': 419 } },
  { name: 'Vánoční dárkové balení', profile: 'Dvě výběrové kávy v krabičce z papíru.', category: 'filtr', badge: 'dárek', prices: { '250 g': 499, '500 g': 849 } },
  { name: 'Degustační sada U Mlýna', profile: 'Tři menší balení pro první ochutnání.', category: 'filtr', badge: 'sada', prices: { '250 g': 379 } }
];
---

<BaseLayout title="Pražírna U Mlýna | Vzorový e-shop" description="Vzorová ukázka malého českého e-shopu pro lokální pražírnu kávy: rychlý katalog, varianty gramáže a jednoduchý košík bez backendu.">
  <main class="shop-page">
    <div class="demo-banner" role="region" aria-label="Vzorová ukázka">
      <p>Vzorová ukázka studia RadeQ — takhle může vypadat váš e-shop.</p>
      <a href={base + '/'}>← Zpět na RadeQ.cz</a>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Pražírna U Mlýna</p>
        <h1 id="hero-title">Čerstvě pražená káva z malé pražírny.</h1>
        <p class="hero-text">Pražíme po menších dávkách, balíme ručně a odesíláme kávu, která má jasný původ i datum pražení.</p>
        <a class="primary-link" href="#katalog">Prohlédnout kávu</a>
      </div>
      <div class="hero-photo" aria-label="Ilustrační blok balení kávy"><span class="bag bag-one"></span><span class="bag bag-two"></span><span class="steam"></span></div>
    </section>

    <section class="trust" aria-label="Dostupnost a doprava">
      <p><strong>Skladem:</strong> většinu káv odesíláme do 24 hodin.</p>
      <p><strong>Doprava:</strong> Zásilkovna, kurýr nebo osobní odběr v pražírně.</p>
      <button class="cart-open" type="button" aria-controls="cart-drawer" aria-expanded="false">Košík <span data-cart-count>0</span></button>
    </section>

    <section class="catalog" id="katalog" aria-labelledby="catalog-title">
      <div class="catalog-head">
        <div><p class="eyebrow">Katalog</p><h2 id="catalog-title">Káva pro doma i do kanceláře</h2></div>
        <div class="filters" aria-label="Filtrovat produkty">
          <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">vše</button>
          <button class="filter" type="button" data-filter="espresso" aria-pressed="false">espresso</button>
          <button class="filter" type="button" data-filter="filtr" aria-pressed="false">filtr</button>
          <button class="filter" type="button" data-filter="bezkofeinova" aria-pressed="false">bezkofeinová</button>
        </div>
      </div>

      <div class="product-grid">
        {products.map((product, index) => {
          const weights = Object.keys(product.prices);
          const firstWeight = weights[0];
          const imageClass = `photo-tone tone-${(index % 4) + 1}`;
          return (
            <article class="product-card" data-category={product.category} data-name={product.name} data-prices={JSON.stringify(product.prices)}>
              <div class={imageClass} aria-hidden="true"><span>{product.badge}</span></div>
              <div class="product-body">
                <p class="stock">skladem</p>
                <h3>{product.name}</h3>
                <p>{product.profile}</p>
                <label><span>Gramáž</span><select class="weight-select" aria-label={`Gramáž produktu ${product.name}`}>{weights.map((weight) => <option value={weight}>{weight}</option>)}</select></label>
                <div class="buy-row"><strong class="price" data-price>{product.prices[firstWeight].toLocaleString('cs-CZ')} Kč</strong><button type="button" class="add-cart">Do košíku</button></div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="simple-note" aria-labelledby="simple-title">
      <h2 id="simple-title">Lehký e-shop bez zbytečností</h2>
      <p>Ukázka záměrně neobsahuje účty, přihlášení, reálné platby, slevové kódy ani recenze s hvězdičkami. Pro malou pražírnu často stačí jasný katalog, dostupnost, doprava a jednoduchá cesta k objednávce.</p>
    </section>

    <footer class="shop-footer"><div><strong>Pražírna U Mlýna</strong><p>Fiktivní lokální pražírna kávy pro vzorovou ukázku.</p></div><address>Mlýnská 12, 602 00 Brno<br /><a href="mailto:kava@umlyna.example">kava@umlyna.example</a></address></footer>

    <div class="cart-overlay" data-cart-close hidden></div>
    <aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true">
      <div class="cart-head"><h2 id="cart-title">Košík</h2><button type="button" class="icon-close" data-cart-close aria-label="Zavřít košík">×</button></div>
      <div class="cart-items" data-cart-items><p class="empty-cart">Košík je zatím prázdný.</p></div>
      <div class="cart-total"><span>Mezisoučet</span><strong data-cart-total>0 Kč</strong></div>
      <button type="button" class="checkout-button">K pokladně</button>
      <p class="checkout-message" data-checkout-message hidden>Toto je ukázkový e‑shop. V ostré verzi by zde byla platební brána a doprava (Zásilkovna, kurýr, osobní odběr).</p>
    </aside>
  </main>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  .shop-page { min-height: 100vh; overflow-x: clip; background: #f8efe2; color: #2f1b12; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .demo-banner { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem clamp(1rem, 4vw, 3rem); background: #2f1b12; color: #fff7eb; box-shadow: 0 8px 24px rgba(47, 27, 18, .18); }
  .demo-banner p { margin: 0; font-size: .95rem; line-height: 1.4; }
  .demo-banner a { flex: 0 0 auto; color: #f7d9a6; font-weight: 700; text-decoration: none; }
  .hero, .trust, .catalog, .simple-note, .shop-footer { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding: clamp(3rem, 9vw, 6rem) 0 2rem; }
  .eyebrow { margin: 0 0 .75rem; color: #8b4b24; font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  h1 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 7vw, 5.3rem); line-height: .95; letter-spacing: 0; }
  .hero-text { max-width: 620px; margin: 1.25rem 0 1.75rem; color: #604033; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.7; }
  .primary-link, .add-cart, .cart-open, .checkout-button, .filter { min-height: 44px; border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-weight: 800; }
  .primary-link { display: inline-flex; align-items: center; padding: .85rem 1.15rem; background: #6f351b; color: #fff7eb; text-decoration: none; }
  .hero-photo { position: relative; min-height: 380px; border-radius: 2rem; background: radial-gradient(circle at 30% 25%, rgba(255, 244, 220, .9), transparent 26%), linear-gradient(145deg, #d6a15f, #6f351b 62%, #3a2015); box-shadow: 0 22px 70px rgba(71, 39, 22, .26); overflow: hidden; }
  .bag { position: absolute; bottom: 2.2rem; width: 34%; min-width: 120px; aspect-ratio: 3 / 4; border-radius: 1.2rem .8rem 1rem 1rem; background: linear-gradient(180deg, #f3d9ac, #b46b32); box-shadow: 0 18px 40px rgba(47, 27, 18, .3); }
  .bag::before { content: ''; position: absolute; inset: 18% 18% auto; height: 34%; border-radius: 50%; background: #3b2014; }
  .bag-one { left: 16%; transform: rotate(-5deg); }
  .bag-two { right: 16%; width: 29%; background: linear-gradient(180deg, #fff2d4, #8b4b24); transform: rotate(6deg); }
  .steam { position: absolute; top: 3rem; left: 50%; width: 44%; height: 38%; transform: translateX(-50%); border: 2px solid rgba(255, 247, 235, .55); border-inline-color: transparent; border-bottom-color: transparent; border-radius: 50%; }
  .trust { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: center; margin-top: 1rem; padding: 1rem; border: 1px solid #e7ceb1; border-radius: 1rem; background: #fff9ee; }
  .trust p { margin: 0; color: #604033; line-height: 1.5; }
  .cart-open { padding: .75rem 1rem; background: #3a2015; color: #fff7eb; }
  .catalog { padding: clamp(3rem, 8vw, 5rem) 0 2rem; }
  .catalog-head { display: flex; justify-content: space-between; gap: 1.25rem; align-items: end; margin-bottom: 1.5rem; }
  .catalog h2, .simple-note h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.05; }
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: flex-end; }
  .filter { padding: .65rem .9rem; border: 1px solid #d9b991; background: #fff9ee; color: #4a2818; }
  .filter.is-active { background: #6f351b; color: #fff7eb; border-color: #6f351b; }
  .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .product-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid #e3c6a4; border-radius: .8rem; background: #fffaf1; }
  .product-card[hidden] { display: none; }
  .photo-tone { display: grid; min-height: 150px; place-items: end start; padding: 1rem; background: linear-gradient(135deg, #d8a866, #6f351b); }
  .photo-tone span { border-radius: 999px; padding: .35rem .6rem; background: rgba(255, 249, 238, .9); color: #3a2015; font-size: .78rem; font-weight: 900; }
  .tone-2 { background: linear-gradient(135deg, #c77d3e, #422317); }
  .tone-3 { background: linear-gradient(135deg, #e1c293, #7c4625); }
  .tone-4 { background: linear-gradient(135deg, #b98354, #2f1b12); }
  .product-body { display: flex; flex: 1; flex-direction: column; gap: .85rem; padding: 1rem; }
  .stock { margin: 0; color: #247343; font-size: .82rem; font-weight: 900; text-transform: uppercase; }
  .product-body h3 { margin: 0; font-size: 1.15rem; line-height: 1.2; }
  .product-body p:not(.stock) { margin: 0; color: #604033; line-height: 1.5; }
  label { display: grid; gap: .35rem; margin-top: auto; color: #604033; font-size: .9rem; font-weight: 800; }
  select { width: 100%; min-height: 42px; border: 1px solid #d7b58b; border-radius: .65rem; padding: .55rem .65rem; background: #fffef9; color: #2f1b12; font: inherit; }
  .buy-row { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .price { font-size: 1.15rem; white-space: nowrap; }
  .add-cart { flex: 0 0 auto; padding: .65rem .85rem; background: #6f351b; color: #fff7eb; }
  .add-cart.is-added { background: #247343; }
  .simple-note { margin-block: 2rem; padding: clamp(1.25rem, 4vw, 2rem); border-left: 6px solid #b46b32; background: #fff9ee; }
  .simple-note p { max-width: 820px; margin: .75rem 0 0; color: #604033; line-height: 1.7; }
  .shop-footer { display: flex; justify-content: space-between; gap: 1rem; padding: 2rem 0 3rem; color: #604033; }
  .shop-footer p, address { margin: .35rem 0 0; font-style: normal; line-height: 1.6; }
  .shop-footer a { color: #6f351b; font-weight: 800; }
  .cart-overlay { position: fixed; inset: 0; z-index: 30; background: rgba(47, 27, 18, .38); }
  .cart-drawer { position: fixed; inset: 0 0 0 auto; z-index: 40; display: flex; width: min(420px, 100%); max-width: 100vw; flex-direction: column; gap: 1rem; padding: 1.1rem; background: #fffaf1; box-shadow: -18px 0 50px rgba(47, 27, 18, .22); transform: translateX(100%); transition: transform .22s ease; }
  .cart-drawer.is-open { transform: translateX(0); }
  .cart-head, .cart-total, .cart-line { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .cart-head h2 { margin: 0; }
  .icon-close { width: 44px; height: 44px; border: 0; border-radius: 50%; background: #f0dfc6; color: #2f1b12; cursor: pointer; font-size: 1.5rem; }
  .cart-items { display: grid; gap: .75rem; overflow: auto; }
  .empty-cart { color: #604033; }
  .cart-line { align-items: flex-start; border-bottom: 1px solid #e7ceb1; padding-bottom: .75rem; }
  .cart-line p { margin: 0; font-weight: 800; }
  .cart-line small { color: #604033; }
  .cart-total { margin-top: auto; border-top: 1px solid #e7ceb1; padding-top: 1rem; font-size: 1.15rem; }
  .checkout-button { width: 100%; padding: .85rem 1rem; background: #3a2015; color: #fff7eb; }
  .checkout-message { margin: 0; border-radius: .75rem; padding: .9rem; background: #f1dfc4; color: #3a2015; line-height: 1.5; }
  @media (max-width: 900px) { .hero, .trust, .catalog-head, .shop-footer { grid-template-columns: 1fr; flex-direction: column; align-items: stretch; } .hero-photo { min-height: 300px; } .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .filters { justify-content: flex-start; } }
  @media (max-width: 560px) { .demo-banner { align-items: flex-start; flex-direction: column; } .hero, .trust, .catalog, .simple-note, .shop-footer { width: min(100% - 1rem, 1120px); } .product-grid { grid-template-columns: 1fr; } .buy-row { align-items: stretch; flex-direction: column; } .add-cart { width: 100%; } }
</style>

<script>
  const formatCzk = (value) => `${value.toLocaleString('cs-CZ')} Kč`;
  const cart = [];
  const filters = document.querySelectorAll('.filter');
  const products = document.querySelectorAll('.product-card');
  const drawer = document.querySelector('#cart-drawer');
  const overlay = document.querySelector('.cart-overlay');
  const cartOpen = document.querySelector('.cart-open');
  const closeButtons = document.querySelectorAll('[data-cart-close]');
  const cartItems = document.querySelector('[data-cart-items]');
  const cartTotal = document.querySelector('[data-cart-total]');
  const cartCount = document.querySelector('[data-cart-count]');
  const checkoutButton = document.querySelector('.checkout-button');
  const checkoutMessage = document.querySelector('[data-checkout-message]');
  const openCart = () => { drawer?.classList.add('is-open'); drawer?.setAttribute('aria-hidden', 'false'); cartOpen?.setAttribute('aria-expanded', 'true'); if (overlay) overlay.hidden = false; };
  const closeCart = () => { drawer?.classList.remove('is-open'); drawer?.setAttribute('aria-hidden', 'true'); cartOpen?.setAttribute('aria-expanded', 'false'); if (overlay) overlay.hidden = true; };
  const renderCart = () => {
    if (!cartItems || !cartTotal || !cartCount) return;
    cartItems.innerHTML = '';
    if (cart.length === 0) cartItems.innerHTML = '<p class="empty-cart">Košík je zatím prázdný.</p>';
    else cart.forEach((item) => { const row = document.createElement('div'); row.className = 'cart-line'; row.innerHTML = `<div><p>${item.name}</p><small>${item.weight}</small></div><strong>${formatCzk(item.price)}</strong>`; cartItems.append(row); });
    const total = cart.reduce((sum, item) => sum + item.price, 0);
    cartTotal.textContent = formatCzk(total);
    cartCount.textContent = String(cart.length);
  };
  filters.forEach((button) => button.addEventListener('click', () => { const filter = button.dataset.filter; filters.forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', String(item === button)); }); products.forEach((card) => { card.hidden = filter !== 'all' && card.dataset.category !== filter; }); }));
  products.forEach((card) => {
    const select = card.querySelector('.weight-select');
    const price = card.querySelector('[data-price]');
    const add = card.querySelector('.add-cart');
    const prices = JSON.parse(card.dataset.prices || '{}');
    select?.addEventListener('change', () => { const selectedPrice = prices[select.value]; if (price && selectedPrice) price.textContent = formatCzk(selectedPrice); });
    add?.addEventListener('click', () => { const weight = select?.value || Object.keys(prices)[0]; cart.push({ name: card.dataset.name || 'Káva', weight, price: prices[weight] }); renderCart(); openCart(); add.textContent = 'Přidáno ✓'; add.classList.add('is-added'); window.setTimeout(() => { add.textContent = 'Do košíku'; add.classList.remove('is-added'); }, 1100); });
  });
  cartOpen?.addEventListener('click', openCart);
  closeButtons.forEach((button) => button.addEventListener('click', closeCart));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCart(); });
  checkoutButton?.addEventListener('click', () => { if (checkoutMessage) checkoutMessage.hidden = false; });
  renderCart();
</script>
