<script is:inline>
  (() => {
    if (window.__rqMotionIsland) return;
    window.__rqMotionIsland = true;

    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const root = document.documentElement;
    root.dataset.rqMotion = 'on';

    const revealItems = Array.from(document.querySelectorAll('[data-rq-reveal]'));

    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-in'));
    }

    const supportsFinePointer = window.matchMedia?.('(pointer: fine)').matches;

    if (supportsFinePointer) {
      document.querySelectorAll('[data-rq-magnetic]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          const moveX = Math.max(-6, Math.min(6, x * 0.08));
          const moveY = Math.max(-6, Math.min(6, y * 0.08));
          item.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
        });

        item.addEventListener('pointerleave', () => {
          item.style.transform = '';
        });
      });
    }

    const setupHeroSignature = () => {
      const hero = document.querySelector('[data-rq-hero-signature]');
      if (!hero || !('IntersectionObserver' in window)) return;

      const svg = hero.querySelector('[data-rq-hero-svg]');
      const path = svg?.querySelector('#rq-hero-path');
      const pulse = hero.querySelector('[data-rq-signature-pulse]');
      const visual = hero.querySelector('[data-rq-hero-visual]');
      const stages = Array.from(hero.querySelectorAll('[data-rq-snap-at]'));
      const widthQuery = window.matchMedia?.('(min-width: 768px)');

      if (!svg || !path || !pulse || !visual || !widthQuery?.matches || typeof path.getTotalLength !== 'function') return;

      const totalLength = path.getTotalLength();
      const drawDuration = 2000;
      let isVisible = false;
      let hasStarted = false;
      let isDone = false;
      let drawFrame = 0;
      let pulseFrame = 0;
      let drawProgress = 0;
      let lastDrawTime = 0;

      const clamp = (value) => Math.max(0, Math.min(1, value));

      const snapStages = (progress) => {
        stages.forEach((stage) => {
          const at = Number(stage.getAttribute('data-rq-snap-at') || '1');
          if (progress >= at) stage.classList.add('is-snapped');
        });
      };

      const stopDrawFrame = () => {
        if (!drawFrame) return;
        cancelAnimationFrame(drawFrame);
        drawFrame = 0;
        lastDrawTime = 0;
      };

      const updatePulse = () => {
        pulseFrame = 0;
        if (!isVisible || !isDone || !widthQuery.matches) return;

        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
        const pageY = window.scrollY || window.pageYOffset || 0;
        const heroTop = hero.getBoundingClientRect().top + pageY;
        const travel = Math.max(1, hero.offsetHeight - viewportHeight * 0.2);
        const progress = clamp((pageY - heroTop) / travel);
        const point = path.getPointAtLength(totalLength * progress);
        pulse.setAttribute('transform', `translate(${point.x} ${point.y})`);
      };

      const requestPulse = () => {
        if (pulseFrame || !isVisible || !isDone || !widthQuery.matches) return;
        pulseFrame = requestAnimationFrame(updatePulse);
      };

      const finishDraw = () => {
        if (isDone) return;
        isDone = true;
        stopDrawFrame();
        snapStages(1);
        hero.classList.remove('is-signature-drawing');
        hero.classList.add('is-signature-done');
        requestPulse();
      };

      const drawTick = (now) => {
        if (!isVisible || !widthQuery.matches) {
          stopDrawFrame();
          return;
        }

        if (!lastDrawTime) lastDrawTime = now;
        drawProgress = clamp(drawProgress + (now - lastDrawTime) / drawDuration);
        lastDrawTime = now;
        snapStages(drawProgress);

        if (drawProgress >= 1) {
          finishDraw();
          return;
        }

        drawFrame = requestAnimationFrame(drawTick);
      };

      const startDraw = () => {
        if (isDone || drawFrame || !widthQuery.matches) return;

        if (!hasStarted) {
          hasStarted = true;
          root.classList.add('rq-motion-ready');
          hero.classList.add('is-signature-drawing');
        }

        drawFrame = requestAnimationFrame(drawTick);
      };

      const heroObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting;
            hero.classList.toggle('is-signature-visible', isVisible && widthQuery.matches);

            if (isVisible && widthQuery.matches) {
              startDraw();
              requestPulse();
            } else {
              stopDrawFrame();
              if (pulseFrame) {
                cancelAnimationFrame(pulseFrame);
                pulseFrame = 0;
              }
            }
          });
        },
        { threshold: 0, rootMargin: '0px' }
      );

      heroObserver.observe(hero);
      window.addEventListener('scroll', requestPulse, { passive: true });
      window.addEventListener('resize', requestPulse, { passive: true });

      widthQuery.addEventListener?.('change', () => {
        if (!widthQuery.matches) {
          stopDrawFrame();
          hero.classList.remove('is-signature-visible');
          return;
        }

        if (isVisible) {
          hero.classList.add('is-signature-visible');
          startDraw();
          requestPulse();
        }
      });
    };

    setupHeroSignature();

    const marqueeRoots = Array.from(document.querySelectorAll('[data-rq-marquee]'));

    marqueeRoots.forEach((marquee) => {
      const track = marquee.querySelector('[data-rq-marquee-track]');
      const group = marquee.querySelector('[data-rq-marquee-group]');
      if (!track || !group) return;

      let x = 0;
      let frame = 0;
      let isVisible = false;
      let currentSpeed = 0.42;
      let targetSpeed = 0.42;

      const getGroupWidth = () => group.getBoundingClientRect().width;

      const tick = () => {
        const width = getGroupWidth();

        if (width > 0) {
          currentSpeed += (targetSpeed - currentSpeed) * 0.08;
          x = (x + currentSpeed) % width;
          track.style.transform = `translate3d(${-x}px, 0, 0)`;
        }

        frame = isVisible ? requestAnimationFrame(tick) : 0;
      };

      const start = () => {
        if (frame) return;
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        if (!frame) return;
        cancelAnimationFrame(frame);
        frame = 0;
      };

      marquee.addEventListener('mouseenter', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('mouseleave', () => {
        targetSpeed = 0.42;
      });

      marquee.addEventListener('focusin', () => {
        targetSpeed = 0.14;
      });

      marquee.addEventListener('focusout', () => {
        targetSpeed = 0.42;
      });

      window.addEventListener('resize', () => {
        const width = getGroupWidth();
        if (width > 0) {
          x %= width;
        }
      });

      if ('IntersectionObserver' in window) {
        const marqueeObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible) {
                start();
              } else {
                stop();
              }
            });
          },
          { threshold: 0, rootMargin: '120px 0px' }
        );

        marqueeObserver.observe(marquee);
      } else {
        isVisible = true;
        start();
      }
    });

    const countItems = Array.from(document.querySelectorAll('[data-rq-count]'));

    const animateCount = (item) => {
      if (item.dataset.rqCountDone === 'true') return;
      item.dataset.rqCountDone = 'true';

      const targetRaw = item.getAttribute('data-rq-count') || '0';
      const target = Number(targetRaw.replace(',', '.'));
      if (!Number.isFinite(target)) return;

      const originalText = item.textContent || '';
      const suffix = originalText.replace(/^\s*[+-]?[\d\s.,]+/, '');
      const decimals = targetRaw.includes('.') || targetRaw.includes(',') ? targetRaw.split(/[.,]/)[1]?.length || 0 : 0;
      const duration = 900;
      const start = performance.now();

      const tick = (now) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        item.textContent = `${value.toFixed(decimals)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          item.textContent = `${target.toFixed(decimals)}${suffix}`;
        }
      };

      requestAnimationFrame(tick);
    };

    if (countItems.length) {
      if ('IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              animateCount(entry.target);
              countObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.3, rootMargin: '0px 0px -8% 0px' }
        );

        countItems.forEach((item) => countObserver.observe(item));
      } else {
        countItems.forEach(animateCount);
      }
    }
  })();
</script>
