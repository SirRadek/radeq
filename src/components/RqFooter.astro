---
import {isPreviewChannel} from '../lib/preview-channel.mjs';
interface NavLink {
  href: string;
  label: string;
}

interface FooterContent {
  tagline?: string;
  navTitle?: string;
  navAriaLabel?: string;
  connectionTitle?: string;
  connectionLinks?: readonly NavLink[];
  legal?: string;
  contactEmail?: string;
  contactPhone?: string;
}

interface Props {
  navItems?: readonly NavLink[];
  content?: FooterContent;
  homeHref?: string;
}

const { navItems = [], content = {}, homeHref = Astro.url.pathname.includes("/en/") ? "/en/" : "/" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (h: string) => {
  if (!h || !h.startsWith("/")) return h;
  if (base && (h === base || h.startsWith(base + "/"))) return h;
  return base + h;
};
const logoMask = `${base}/brand/radeq-logo-b-mask.png`;
const navAriaLabel = content.navAriaLabel ?? (homeHref.startsWith('/en')?'Footer navigation':'Navigace v patičce');
const legal = content.legal ?? "© 2026 Radek Široký — RadeQ.cz · IČO 08748811 · Praha · celá ČR";
const isEnglishFooter = homeHref.startsWith("/en") || navItems.some((item) => item.href.includes("/en/"));
const auditLink = isEnglishFooter
  ? { href: "/en/audit/", label: "Automated website check" }
  : { href: "/audit/", label: "Automatická kontrola webu" };
---

<footer class="rq-minimal-footer rq-studio-footer">
 <div class="rq-footer-identity"><a class="rq-minimal-preview__logo" href={resolve(homeHref)} aria-label={isEnglishFooter ? 'RadeQ — home' : 'RadeQ — domů'} style={`--logo-mask:url("${logoMask}")`}><span aria-hidden="true"></span></a><p>{legal}</p></div>
 <nav aria-label={navAriaLabel}>
  <div><p class="rq-footer-heading">{isEnglishFooter?'Contact':'Kontakt'}</p><a href="mailto:siroky@radeq.cz">siroky@radeq.cz</a><a href="tel:+420730634439">+420 730 634 439</a></div>
  <div><p class="rq-footer-heading">{isEnglishFooter?'Explore':'Prohlédnout'}</p><a href={resolve(isEnglishFooter?'/en/ukazky/':'/ukazky/')}>{isEnglishFooter?'Examples':'Ukázky'}</a><a href={resolve(auditLink.href)}>{auditLink.label}</a><a href={resolve('/zapisky/')} lang="cs">{isEnglishFooter?'Notes (in Czech)':'Zápisky'}</a></div>
  <div><p class="rq-footer-heading">{isEnglishFooter?'Information':'Informace'}</p><a href={resolve(isEnglishFooter?'/en/soukromi/':'/soukromi/')}>{isEnglishFooter?'Privacy':'Soukromí'}</a><a href={resolve(isEnglishFooter?'/en/spoluprace/':'/spoluprace/')}>{isEnglishFooter?'Working together':'Podmínky spolupráce'}</a>{!isPreviewChannel && !Astro.url.pathname.includes('/minimalni-navrh') && <button type="button" data-consent-open>{isEnglishFooter?'Cookie settings':'Nastavení cookies'}</button>}</div>
 </nav>
</footer>

<style>.rq-minimal-footer button{border:0;padding:0;background:none;color:inherit;font:inherit;text-decoration:underline;cursor:pointer;min-height:44px}</style>
