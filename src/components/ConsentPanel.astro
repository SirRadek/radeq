---
import {measurement} from '../data/measurement';
const {lang='cs'}=Astro.props;
const en=lang==='en';
const active=Boolean(measurement.ga4||measurement.sem);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<dialog id="rq-consent" class="rq-consent" data-active={active} data-ga4={Boolean(measurement.ga4)} data-sem={Boolean(measurement.sem)} data-frame={base+'/measurement/'} aria-labelledby="rq-consent-title">
 <form method="dialog">
 <h2 id="rq-consent-title">{en?'Your privacy choices':'Vaše soukromí'}</h2>
 <p>{active?(en?'With your permission, Google Analytics helps improve this website. Seznam Sklik measures advertising results and supports remarketing. You can refuse both and still use the whole website.':'S vaším souhlasem Google Analytics pomáhá vylepšovat web. Seznam Sklik měří výsledky reklamy a umožňuje remarketing. Obojí můžete odmítnout a dál používat celý web.'):(en?'Optional measurement is currently disabled.':'Volitelné měření je nyní vypnuté.')}</p>
 <label><input type="checkbox" name="analytics" disabled={!measurement.ga4} /> {en?'Analytics · Google Analytics':'Analytika · Google Analytics'}</label>
 <label><input type="checkbox" name="marketing" disabled={!measurement.sem} /> {en?'Advertising · Seznam Sklik':'Reklama · Seznam Sklik'}</label>
 <p><a href={base+(en?'/en/soukromi/':'/soukromi/')}>{en?'Privacy and data retention':'Soukromí a uchování údajů'}</a></p>
 <div class="rq-consent__actions"><button value="reject">{en?'Reject optional':'Odmítnout volitelné'}</button><button value="accept">{en?'Accept all':'Přijmout vše'}</button><button value="save">{en?'Save my choices':'Uložit výběr'}</button></div>
 <p id="rq-consent-status" role="status" hidden>{en?'Your browser could not save this choice. Optional measurement stays off.':'Prohlížeč volbu nedokázal uložit. Volitelné měření zůstává vypnuté.'}</p>
 </form>
</dialog>
<script>
 import {createConsentController} from '../lib/consent-core.mjs';
 import {createMeasurementChannel} from '../lib/measurement-client.mjs';
 const dialog=document.querySelector<HTMLDialogElement>('#rq-consent');
 if(dialog){
  let storage;try{storage=window.localStorage}catch{storage={getItem:()=>null,setItem:()=>{throw Error('storage')}}}
  function clearCookies(purpose:string){
   const names=document.cookie.split(';').map(c=>c.split('=')[0].trim()).filter(n=>purpose==='analytics'?/^_ga(?:_|$)|^_gid$|^_gat/.test(n):/^(sid|udid|szn.*|_szn.*)$/.test(n));
   for(const name of names)for(const domain of ['',location.hostname,'.'+location.hostname])document.cookie=name+'=; Max-Age=0; path=/;'+(domain?' domain='+domain+';':'')+' SameSite=Lax';
  }
  const seenByPurpose={analytics:new Set<string>(),marketing:new Set<string>()};
  const control=createConsentController({storage,start:(purpose:'analytics'|'marketing')=>{
   const enabled=purpose==='analytics'?dialog.dataset.ga4==='true':dialog.dataset.sem==='true';
   if(!enabled)return {stop(){},event(){}};
   // Each SDK gets a disposable document with no form fields or incoming referrer.
   // Removing it destroys SDK timers, listeners and pending loaders, including on revocation.
   const channel=createMeasurementChannel({purpose,frameUrl:dialog.dataset.frame!,seen:seenByPurpose[purpose]});
   return {event:(name:string)=>channel.event(name),stop(){channel.stop();clearCookies(purpose)}};
  }});
  const analytics=dialog.querySelector<HTMLInputElement>('[name="analytics"]')!;
  const marketing=dialog.querySelector<HTMLInputElement>('[name="marketing"]')!;
  const open=()=>{analytics.checked=control.choice.analytics;marketing.checked=control.choice.marketing;if(!dialog.open)dialog.showModal()};
  document.addEventListener('click',e=>{if((e.target as Element).closest('[data-consent-open]'))open()});
  // Escape is rejection, not an implicit grant. No provider is fetched by opening settings.
  dialog.addEventListener('cancel',()=>{control.choose({analytics:false,marketing:false})});
  dialog.querySelector('form')!.addEventListener('submit',e=>{
   e.preventDefault();const action=(e as SubmitEvent).submitter?.getAttribute('value');
   const next={analytics:!analytics.disabled&&(action==='accept'||action==='save'&&analytics.checked),marketing:!marketing.disabled&&(action==='accept'||action==='save'&&marketing.checked)};
   if(control.choose(next)){dialog.close()}else{dialog.querySelector<HTMLElement>('#rq-consent-status')!.hidden=false}
  });
  const saved=control.restore();if(!saved&&dialog.dataset.active==='true')open();
  window.addEventListener('radeq:lead-received',()=>control.event('lead_received'));
  document.addEventListener('click',e=>{
   const link=(e.target as Element)?.closest('a[href]');if(!link)return;
   const url=new URL(link.getAttribute('href')!,location.href);
   if(['tel:','mailto:'].includes(url.protocol)||url.origin===location.origin&&(url.hash==='#kontakt'||/\/(?:en\/)?kontakt\/$/.test(url.pathname)))control.event('contact_intent');
  });
  document.addEventListener('focusin',e=>{
   if((e.target as Element)?.matches('#rq-lead-form input:not([name="honeypot"]):not([type="hidden"]),#rq-lead-form select,#rq-lead-form textarea'))control.event('form_start');
  });
  // Another tab can revoke immediately without resurrecting a stale local choice.
  window.addEventListener('storage',()=>{const next=control.restore();if(!next)control.choose({analytics:false,marketing:false})});
 }
</script>
<style>
.rq-consent{width:min(540px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;border:1px solid #1c1a1730;border-radius:14px;background:#f7f4ee;color:#1c1a17;padding:28px;box-shadow:0 20px 80px #1c1a1730;font-family:'Cabinet Grotesk',sans-serif}
.rq-consent::backdrop{background:#1c1a1760}.rq-consent h2{font-size:1.7rem;margin:0 0 12px}.rq-consent p{line-height:1.55}.rq-consent label{display:flex;gap:10px;align-items:center;margin:14px 0}.rq-consent input{width:20px;height:20px;accent-color:#7a1f2b}.rq-consent a{color:#7a1f2b}.rq-consent__actions{display:flex;flex-wrap:wrap;gap:8px}.rq-consent button{flex:1 1 180px;min-height:44px;padding:10px 14px;border:1px solid #7a1f2b;border-radius:8px;background:transparent;color:#7a1f2b;font:inherit;font-weight:500;cursor:pointer}.rq-consent button:focus-visible{outline:3px solid #7a1f2b;outline-offset:3px}
</style>
