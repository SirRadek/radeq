---
interface Props { service: 'web' | 'terminy' | 'data' }
const { service } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<p class="service-return" data-service-return data-home={base + '/'} data-service={service}>
  <a href={`${base}/#sluzba-${service}`}>← Zpět ke službě na RadeQ</a>
</p>
<script>
  // Only the known locale is accepted; no arbitrary return URL is read.
  if (new URLSearchParams(window.location.search).get('from') === 'en') {
    document.querySelectorAll<HTMLElement>('[data-service-return]').forEach(root => {
      const link = root.querySelector('a');
      if (link) {
        link.href = `${root.dataset.home}en/#sluzba-${root.dataset.service}`;
        link.textContent = '← Back to this service on RadeQ';
        link.lang = 'en';
      }
    });
  }
</script>
<style>.service-return{margin:1.5rem 0;font-size:1rem}.service-return a{display:inline-flex;align-items:center;min-height:44px}</style>
