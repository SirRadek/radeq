---
import RqHomePage from '../../components/RqHomePage.astro';
import { homeContent } from '../../data/home';
import RqLayout from '../../layouts/RqLayout.astro';

const content = homeContent.en;
---

<RqLayout
  title={content.seo.title}
  description={content.seo.description}
  lang="en"
  canonicalPath={content.seo.canonicalPath}
  alternatePath={content.seo.alternatePath}
  alternateLang="cs"
>
  <RqHomePage content={content} lang="en" />
</RqLayout>
