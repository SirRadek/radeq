---
const phases = [
  {
    id: 'rozbor',
    number: '01',
    title: 'Rozbor',
    duration: '1–3 dny',
    solve: 'co nefunguje, kdo to používá, kde se ztrácí čas a důvěra.',
    process: 'krátký hovor, projdu web/proces, doptám se na cíl.',
    benefit: 'jasně pojmenovaný problém a priority bez mlhy.',
    tags: [
      { label: 'Výstup', value: 'rozbor' },
      { label: 'Vaše role', value: 'dáte přístup/podklady.' },
      { label: 'Moje role', value: 'rozeberu a změřím.' },
      { label: 'Trust', value: 'bez závazků — když se nedomluvíme, rozbor vám zůstává.' },
    ],
  },
  {
    id: 'navrh',
    number: '02',
    title: 'Návrh',
    duration: '2–5 dní',
    solve: 'co vznikne, pro koho, v jakém pořadí a co se dělat NEbude.',
    process: 'připravím strukturu + texty, projdeme a schválíte.',
    benefit: 'konkrétní plán, cenu a termín předem — méně překvapení.',
    tags: [
      { label: 'Výstup', value: 'návrh' },
      { label: 'Vaše role', value: 'potvrdíte směr.' },
      { label: 'Moje role', value: 'navrhnu.' },
    ],
  },
  {
    id: 'stavba',
    number: '03',
    title: 'Stavba',
    duration: 'dny (úpravy) až ~2 týdny',
    solve: 'web / e-shop / automatizace, obsah, mobil, základ SEO.',
    process: 'stavím po částech, průběžně ukazuju na preview — žádná černá skříňka.',
    benefit: 'funkční řešení k vyzkoušení, chyby se zachytí včas.',
    tags: [
      { label: 'Výstup', value: 'funkční řešení' },
      { label: 'Vaše role', value: 'připomínkujete.' },
      { label: 'Moje role', value: 'postavím.' },
      { label: 'Trust', value: 'platba po částech — druhá až po schválení prototypu.' },
    ],
  },
  {
    id: 'test',
    number: '04',
    title: 'Test',
    duration: '1-3 dny',
    solve: 'mobil/prohlížeče, rychlost, formuláře, reálné scénáře.',
    process: 'projedu testovací checklist, ověřím výkon a funkčnost.',
    benefit: 'méně chyb po spuštění, ověřený výkon.',
    tags: [
      { label: 'Výstup', value: 'Protokol o testování (Lighthouse).', strong: true },
      { label: 'Vaše role', value: 'potvrdíte hlavní scénáře.' },
      { label: 'Moje role', value: 'testuji.' },
    ],
  },
  {
    id: 'predani',
    number: '05',
    title: 'Předání',
    duration: '~1 den',
    solve: 'spuštění, přístupy, zaškolení, co dál.',
    process: 'nasadím na vaši doménu, předám návod.',
    benefit: 'plná kontrola a víte, na koho se obrátit.',
    tags: [
      { label: 'Výstup', value: 'předávací poznámky + návod' },
      { label: 'Vaše role', value: 'převezmete přístupy.' },
      { label: 'Moje role', value: 'nasadím a předám.' },
      { label: 'Trust', value: 'po předání dle domluvy: 30 dní podpory, nebo návod/video.' },
    ],
    final: true,
  },
];

const trustPoints = [
  'Jeden člověk od rozboru po test — nic se neztratí mezi rolemi.',
  'Každá fáze má hmatatelný výstup.',
  'Test je před předáním, ne až po stížnosti.',
];
---

<div class="rq-journey" data-rq-journey>
  <div class="rq-journey__header" data-rq-reveal>
    <p class="rq-eyebrow">Postup</p>
    <h2 class="rq-h2">Jak to bude probíhat</h2>
  </div>

  <div class="rq-journey__timeline rq-journey-line" data-rq-reveal>
    <div class="rq-journey-line__copy">
      <p>Typicky 2–4 týdny od poptávky ke spuštění.</p>
      <small>Orientačně pro běžný projekt — větší zakázky podle domluvy.</small>
    </div>

    <div class="rq-journey-line__track">
      <div
        class="rq-journey-line__flow"
        role="tablist"
        aria-label="Fáze spolupráce"
        aria-orientation="horizontal"
      >
        <div class="rq-journey-line__rail" aria-hidden="true"></div>
        <span class="rq-journey-line__cap rq-journey-line__cap--start" aria-hidden="true">
          <span>Váš problém</span>
          <span class="rq-journey-line__cap-dot"></span>
        </span>

        {phases.map((phase, index) => (
          <button
            class:list={['rq-journey-node', { 'is-active': index === 0 }]}
            type="button"
            role="tab"
            id={`rq-journey-tab-${phase.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`rq-journey-panel-${phase.id}`}
            aria-label={phase.title}
            data-rq-journey-node
            data-rq-target-index={index}
            tabindex={index === 0 ? '0' : '-1'}
          >
            <span class="rq-journey-node__label">
              <span class="rq-journey-node__number">{phase.number}</span>
              <span class="rq-journey-node__title">{phase.title}</span>
            </span>
            <span class="rq-journey-node__dot" aria-hidden="true"></span>
          </button>
        ))}

        <span class="rq-journey-line__cap rq-journey-line__cap--end" aria-hidden="true">
          <span>Výsledek · ověřeno</span>
          <span class="rq-journey-line__cap-dot"></span>
        </span>
      </div>
    </div>
  </div>

  <div class="rq-journey__panels">
    {phases.map((phase, index) => (
      <section
        id={`rq-journey-panel-${phase.id}`}
        class:list={['rq-journey-step__panel', { 'is-active': index === 0 }]}
        role="tabpanel"
        aria-labelledby={`rq-journey-tab-${phase.id}`}
        aria-hidden={index === 0 ? 'false' : 'true'}
        inert={index !== 0}
        data-rq-journey-panel
        data-rq-step-index={index}
      >
        <div class="rq-journey-panel__topline">
          <span>{phase.number}</span>
          <h3>{phase.title}</h3>
        </div>

        <dl class="rq-journey-panel__grid">
          <div>
            <dt>Co řešíme</dt>
            <dd>{phase.solve}</dd>
          </div>
          <div>
            <dt>Jak dlouho</dt>
            <dd>{phase.duration}.</dd>
          </div>
          <div>
            <dt>Jak probíhá</dt>
            <dd>{phase.process}</dd>
          </div>
          <div>
            <dt>Co z toho máte</dt>
            <dd>{phase.benefit}</dd>
          </div>
        </dl>

        <ul class="rq-journey-tags" aria-label={`Výstupy a role: ${phase.title}`}>
          {phase.tags.map((tag) => (
            <li>
              <span>{tag.label}</span>
              {tag.strong ? <strong>{tag.value}</strong> : tag.value}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <ul class="rq-journey-trust" aria-label="Důležité jistoty procesu" data-rq-reveal>
    {trustPoints.map((point) => <li>{point}</li>)}
  </ul>
</div>
