            ]}
            data-rq-service-id={service.id}
            data-rq-slot={service.slot}
            aria-current={service.featured ? 'true' : undefined}
            style={`--rq-i: ${index};`}
          >
            {service.flag && <span class="rq-flag">{service.flag}</span>}
            <p class="rq-offer__price">{service.price}</p>
            <h3>{service.title}</h3>
            <p class="rq-offer__result">{service.result}</p>
