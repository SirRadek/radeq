  }

  .rq-problem-diagnostic.is-scrolling .rq-problem-diagnostic__card-inner {
    will-change: transform;
  }

  .rq-problem-diagnostic.is-scrolling .rq-problem-diagnostic__card {
    will-change: transform, opacity;
  }

  .rq-problem-diagnostic__poster-title {
    position: relative;
    z-index: 1;
    display: block;
    grid-row: 2;
    color: var(--rq-on-dark);
    font-family: var(--rq-cinema-display);
    font-size: 1.24rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 0.98;
    text-transform: uppercase;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    text-wrap: balance;
  }

  .rq-problem-diagnostic__severity {
    position: relative;
    z-index: 1;
    display: flex;
    grid-row: 3;
    align-items: center;
    min-height: 1.5rem;
  }

  .rq-problem-diagnostic__stars {
    display: inline-flex;
    gap: 0.17rem;
    color: rgba(247, 244, 238, 0.26);
    font-size: 1.06rem;
    line-height: 1;
  }

  .rq-problem-diagnostic__star.is-active {
    color: color-mix(in srgb, var(--rq-diagnostic-accent) 82%, var(--rq-on-dark));
    text-shadow: 0 0 8px rgba(229, 196, 83, 0.4);
  }

  .rq-problem-diagnostic__card[aria-selected='true'] .rq-problem-diagnostic__star.is-active,
  .rq-problem-diagnostic__card[data-rq-problem-active='true'] .rq-problem-diagnostic__star.is-active {
    color: var(--rq-diagnostic-accent);
    text-shadow: 0 0 8px rgba(229, 196, 83, 0.4);
  }

  .rq-problem-diagnostic__tagline {
    max-width: 46rem;
    margin: 0;
    font-family: var(--rq-display), var(--rq-body), system-ui, sans-serif;
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
    font-weight: 780;
    line-height: 1.35;
  }

  .rq-problem-diagnostic__output {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    min-block-size: var(--rq-jaw-min-block-size);
    margin-top: 0;
    perspective: 980px;
    perspective-origin: center top;
  }

  .rq-problem-diagnostic__panel {
    position: relative;
    grid-area: 1 / 1;
    min-width: 0;
    min-block-size: var(--rq-jaw-min-block-size);
    border: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 26%, transparent);
    border-radius: 8px;
    padding: clamp(0.55rem, 1.1vw, 0.95rem);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(95% 145% at 50% 0%, rgba(229, 196, 83, 0.12), transparent 58%),
      linear-gradient(90deg, rgba(10, 2, 5, 0.72), transparent 18%, transparent 82%, rgba(10, 2, 5, 0.72)),
      linear-gradient(145deg, rgba(94, 25, 38, 0.9), rgba(34, 15, 19, 0.96) 56%, rgba(17, 6, 8, 0.98));
    color: var(--rq-on-dark);
    box-shadow:
      0 30px 80px rgba(10, 2, 5, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 0 0 1px color-mix(in srgb, var(--rq-diagnostic-accent) 7%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    backface-visibility: hidden;
    transform: translateY(0.65rem) rotateY(-7deg);
    transform-origin: center top;
    transition: opacity 260ms var(--rq-ease), transform 320ms var(--rq-problem-ease-out-back), visibility 260ms var(--rq-ease);
  }

  .rq-problem-diagnostic__panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--rq-diagnostic-accent) 18%, transparent), transparent 1px),
      linear-gradient(180deg, rgba(247, 244, 238, 0.06), transparent 1px);
    background-size: 5rem 5rem;
    opacity: 0.14;
    pointer-events: none;
  }

  .rq-problem-diagnostic__panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) rotateY(0deg);
  }

  .rq-problem-diagnostic__output.is-switching .rq-problem-diagnostic__panel.is-active {
    animation: rq-problem-panel-in 320ms var(--rq-problem-ease-out-back);
  }

  .rq-problem-diagnostic__panel:focus-visible {
    outline: 3px solid var(--rq-diagnostic-accent);
    outline-offset: 4px;
  }

  .rq-problem-diagnostic__script-sheet {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(1.05rem, 2vw, 1.45rem);
    box-sizing: border-box;
    min-width: 0;
    min-block-size: calc(var(--rq-jaw-min-block-size) - clamp(1.1rem, 2.2vw, 1.9rem));
    border: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 36%, #cbb891);
    border-radius: 8px;
    padding: clamp(1.05rem, 2.4vw, 1.9rem);
    overflow: hidden;
    background:
      radial-gradient(90% 85% at 12% 5%, rgba(255, 255, 255, 0.62), transparent 48%),
      linear-gradient(180deg, rgba(255, 252, 244, 0.96), rgba(239, 225, 198, 0.98)),
      #f3ead8;
    color: #281b12;
    box-shadow:
      0 24px 70px rgba(10, 2, 5, 0.38),
      0 8px 22px rgba(10, 2, 5, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.84),
      inset 0 0 0 1px rgba(255, 255, 255, 0.28);
  }

  .rq-problem-diagnostic__script-sheet::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='paper'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23paper)' opacity='.3'/%3E%3C/svg%3E"),
      linear-gradient(90deg, rgba(229, 196, 83, 0.18), transparent 1px);
    background-size: 160px 160px, 4rem 4rem;
    opacity: 0.09;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .rq-problem-diagnostic__script-sheet > * {
    position: relative;
    z-index: 1;
  }

  .rq-problem-diagnostic__panel-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(0.85rem, 2vw, 1.35rem);
    min-width: 0;
    padding-bottom: clamp(0.85rem, 1.6vw, 1.15rem);
    border-bottom: 1px solid color-mix(in srgb, var(--rq-diagnostic-accent) 40%, rgba(40, 27, 18, 0.22));
  }

  .rq-problem-diagnostic__panel h3 {
    display: grid;
    gap: 0.32rem;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 34ch;
    margin: 0;
    color: #20150f;
    font-family: var(--rq-cinema-display);
    font-size: clamp(1.55rem, 2.7vw, 2.42rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.14;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
    text-wrap: balance;
  }

  .rq-problem-diagnostic__scene-title {
    display: block;
    color: #20150f;
    line-height: 1.14;
    padding-top: 0.06em;
  }

  .rq-problem-diagnostic__findings {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(0.75rem, 1.6vw, 1.05rem);
    min-width: 0;
    margin: 0;
  }

  .rq-problem-diagnostic__finding {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.48rem;
    min-width: 0;
    border: 1px solid rgba(100, 73, 33, 0.22);
    border-radius: 8px;
    padding: clamp(0.9rem, 1.7vw, 1.12rem);
    background: rgba(255, 252, 245, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      inset 0 -1px 0 rgba(100, 73, 33, 0.06);
  }

  .rq-problem-diagnostic__finding::before {
    content: "";
    width: 2.2rem;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--rq-diagnostic-accent) 72%, #8a5c0c);
