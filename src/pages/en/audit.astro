---
import RqAuditPage from '../../components/RqAuditPage.astro';
import { auditContent } from '../../data/audit';
import RqLayout from '../../layouts/RqLayout.astro';

const content = auditContent.en;
---

<RqLayout
  title={content.seo.title}
  description={content.seo.description}
  lang="en"
  canonicalPath={content.seo.canonicalPath}
  alternatePath={content.seo.alternatePath}
  alternateLang="cs"
>
  <RqAuditPage content={content} lang="en" />
</RqLayout>
