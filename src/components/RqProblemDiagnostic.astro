---
import { homeContent, type HomeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
  content?: HomeContent['problems'];
  lang?: Locale;
}

const { content = homeContent.cs.problems, lang = 'cs' } = Astro.props;
const items = content.items;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (href: string) => {
  if (!href || !href.startsWith('/')) return href;
  if (base && (href === base || href.startsWith(`${base}/`))) return href;
  return `${base}${href}`;
};
const auditPreviewHref = resolve(content.auditPreview.href);
const auditPreviewEligibleServices = new Set(['web', 'data']);
const auditPreviewEligibleIndexes = items
  .map((item, index) => (auditPreviewEligibleServices.has(item.primaryServiceId) ? index : null))
  .filter((index): index is number => index !== null);
const auditPreviewEligibleIndexList = auditPreviewEligibleIndexes.join(',');
const auditPreviewInitiallyHidden = !auditPreviewEligibleIndexes.includes(0);

const impactLabel: Record<number, string> = {
  1: 'nízký',
  2: 'nízký',
  3: 'střední',
  4: 'vysoký',
  5: 'kritický',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.symptom,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${it.problem} Příčina: ${it.cause} Co prověřím: ${it.verify} První krok: ${it.step}`,
    },
  })),
};

const totalItems = items.length;
const severityTone = (severity: number) => (severity >= 4 ? 'critical' : 'medium');
---

<section
  class="rq-diagnostic-section"
  id="co-resim"
  aria-labelledby="rq-problem-diagnostic-title"
  data-rq-problem-diagnostic
  data-rq-locale={lang}
>
  <span class="rq-problem-diagnostic__alias" id="diagnostika" aria-hidden="true"></span>

  <header class="section-header" data-rq-reveal>
    <span class="section-eyebrow">{content.eyebrow}</span>
    <h2 class="section-title" id="rq-problem-diagnostic-title">{content.title}</h2>
    <p class="section-lead">{content.lead}</p>
  </header>

  <div class="diag-tabs-container" data-rq-reveal>
    <div class="diag-tabs" role="tablist" aria-label={content.carouselAriaLabel}>
      {items.map((item, i) => (
        <button
          class:list={['diag-tab', { active: i === 0 }]}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`rq-problem-panel-${i}`}
          id={`rq-problem-tab-${i}`}
          data-index={i}
          tabindex={i === 0 ? 0 : -1}
        >
          <span>{item.symptom}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="diag-panel-wrapper" data-rq-reveal>
    {items.map((item, i) => (
      <section
        class:list={['diag-panel', { active: i === 0 }]}
        id={`rq-problem-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`rq-problem-tab-${i}`}
        hidden={i !== 0}
        data-index={i}
        data-rq-primary-service-id={item.primaryServiceId}
      >
        <header class="panel-header">
          <div class="panel-header-left">
            <h3 class="panel-title">{item.symptom}</h3>
            <div class="panel-meta-row">
              <span
                class={`severity-tag ${severityTone(item.severity)}`}
                aria-label={`Dopad na provoz: ${impactLabel[item.severity]}`}
              >
                <span class="severity-dot" aria-hidden="true"></span>
                Dopad na provoz: {impactLabel[item.severity]}
              </span>
            </div>
          </div>

          <div class="panel-controls" role="group" aria-label={content.controlsAriaLabel}>
            <button class="control-btn prev-btn" type="button" aria-label={content.previousLabel}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <span class="counter-display" aria-live="polite">
              <span class="counter-current">{i + 1}</span> z {totalItems}
            </span>
            <button class="control-btn next-btn" type="button" aria-label={content.nextLabel}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </header>

        <div class="panel-grid">
          <div class="grid-card">
            <span class="card-label">{content.findingLabels.problem}</span>
            <p class="card-text">{item.problem}</p>
          </div>
          <div class="grid-card">
            <span class="card-label">{content.findingLabels.cause}</span>
            <p class="card-text">{item.cause}</p>
          </div>
          <div class="grid-card">
            <span class="card-label">{content.findingLabels.verify}</span>
            <p class="card-text">{item.verify}</p>
          </div>
          <div class="grid-card">
            <span class="card-label">{content.findingLabels.step}</span>
            <p class="card-text">{item.step}</p>
          </div>
        </div>

        <footer class="panel-footer">
          <div class="footer-cta">
            <a href="#kontakt" class="rq-btn">
              {content.ctaLabel}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
          <div class="footer-related">
            <span class="related-label">{content.servicePrefix}</span>
            <a
              href={`#service-${item.primaryServiceId}`}
              class="related-badge"
              data-rq-primary-service-target={item.primaryServiceId}
              data-rq-related-service-target={item.relatedServiceIds[0] ?? ''}
            >
              {item.service}
            </a>
          </div>
        </footer>
      </section>
    ))}
  </div>

  <div
    class="rq-diagnostic-preview"
    data-rq-audit-preview
    data-rq-eligible-indexes={auditPreviewEligibleIndexList}
    hidden={auditPreviewInitiallyHidden}
    aria-hidden={auditPreviewInitiallyHidden ? 'true' : 'false'}
    data-rq-reveal
  >
    <p>{content.auditPreview.text}</p>
    <a class="rq-diagnostic-preview__link" href={auditPreviewHref}>
      <span aria-hidden="true">→</span>
      {content.auditPreview.label}
    </a>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  /* Reset & Base Variables */
  .rq-diagnostic-section {
    --rq-bg: #F7F4EE;
    --rq-surface: #FFFFFF;
    --rq-ink: #1C1A17;
    --rq-ink-2: #4F4942;
    --rq-line: #E6E0D4;
    --rq-burgundy: #7A1F2B;
    --rq-burgundy-strong: #5E1622;
    --rq-burgundy-tint: #F3E7E9;
    --rq-lime: #D4FF3D;
    --rq-lime-ink: #2A3508;
    --rq-carbon: #1A1611;
    --rq-carbon-2: #242018;
    --rq-on-dark: #F1EDE4;
    --rq-on-dark-2: #C9BFB1;

    --rq-r: 14px;
    --rq-r-pill: 999px;
    --rq-ease: cubic-bezier(.16, 1, .3, 1);

    --font-display: var(--rq-display, "Plus Jakarta Sans", system-ui, -apple-system, sans-serif);
    --font-body: var(--rq-body, "Inter", system-ui, -apple-system, sans-serif);
    --font-mono: var(--rq-mono, "JetBrains Mono", monospace);
  }

  .rq-diagnostic-section,
  .rq-diagnostic-section * {
    box-sizing: border-box;
  }

  /* Section Wrapper */
  .rq-diagnostic-section {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-block: clamp(1.6rem, 4vh, 3.25rem);
    padding-inline: max(clamp(1rem, 2vw, 1.4rem), calc((100% - var(--rq-page-w)) / 2));
    background:
      radial-gradient(70% 80% at 92% 4%, rgba(212, 255, 61, 0.06), transparent 60%),
      linear-gradient(225deg, var(--rq-burgundy-strong), #231018 72%);
    border-radius: 0;
    color: var(--rq-on-dark);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .rq-diagnostic-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(247, 244, 238, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 244, 238, 0.02) 1px, transparent 1px);
    background-size: 4rem 4rem;
    pointer-events: none;
    opacity: 0.5;
  }

  .rq-problem-diagnostic__alias {
    position: absolute;
    inset: 0 auto auto 0;
    pointer-events: none;
  }

  /* Section Header */
  .section-header {
    position: relative;
    z-index: 2;
    max-width: 42.5rem;
    margin-bottom: clamp(0.7rem, 1.4dvh, 1.25rem);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--rq-lime);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: clamp(0.45rem, 1dvh, 0.75rem);
  }

  .section-eyebrow::before {
    content: "—";
    color: currentColor;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5.2dvh, 2.65rem);
    font-weight: 800;
    line-height: 1.03;
    color: var(--rq-on-dark);
    letter-spacing: -0.02em;
    margin: 0 0 clamp(0.55rem, 1.2dvh, 0.85rem);
  }

  .section-lead {
    color: var(--rq-on-dark-2);
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    line-height: 1.45;
    margin: 0;
  }

  /* Tab Navigation Wrapper */
  .diag-tabs-container {
    position: relative;
    margin-bottom: clamp(0.5rem, 1.2dvh, 0.85rem);
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    z-index: 2;
  }

  /* Blur na přesahu: to, co vyjíždí mimo šířku sekce, se rozmaže a ztratí */
  .diag-tabs-container::before,
  .diag-tabs-container::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: max(2.5rem, calc((100vw - var(--rq-page-w)) / 2 + 1.5rem));
    z-index: 3;
    pointer-events: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .diag-tabs-container::before {
    left: 0;
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 35%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0, #000 35%, transparent 100%);
  }

  .diag-tabs-container::after {
    right: 0;
    -webkit-mask-image: linear-gradient(270deg, #000 0, #000 35%, transparent 100%);
    mask-image: linear-gradient(270deg, #000 0, #000 35%, transparent 100%);
  }

  .diag-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 0.25rem;
    padding-inline: max(1.25rem, calc((100vw - var(--rq-page-w)) / 2));
    position: relative;
    z-index: 2;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 max(2.5rem, calc((100vw - var(--rq-page-w)) / 2)), #000 calc(100% - max(2.5rem, calc((100vw - var(--rq-page-w)) / 2))), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 max(2.5rem, calc((100vw - var(--rq-page-w)) / 2)), #000 calc(100% - max(2.5rem, calc((100vw - var(--rq-page-w)) / 2))), transparent 100%);
  }

  .diag-tabs::-webkit-scrollbar {
    display: none;
  }

  /* Tab Button */
  .diag-tab {
    flex: 0 0 auto;
    scroll-snap-align: center;
    min-height: 44px;
    background: rgba(26, 22, 17, 0.4);
    border: 1px solid rgba(230, 224, 212, 0.12);
    border-radius: var(--rq-r-pill);
    padding: 0.5rem 0.95rem;
    color: var(--rq-on-dark-2);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    transition: all 0.25s var(--rq-ease);
    user-select: none;
    white-space: nowrap;
  }

  .diag-tab:hover {
    border-color: rgba(212, 255, 61, 0.4);
    color: var(--rq-on-dark);
    background: rgba(212, 255, 61, 0.04);
  }

  .diag-tab:focus-visible {
    outline: 2px solid var(--rq-lime);
    outline-offset: 3px;
  }

  .diag-tab.active {
    background: var(--rq-bg);
    color: var(--rq-ink);
    border-color: var(--rq-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  /* Active Panel Container */
  .diag-panel-wrapper {
    position: relative;
    background: var(--rq-bg);
    color: var(--rq-ink);
    border-radius: var(--rq-r);
    border: 1px solid var(--rq-line);
    padding: clamp(0.95rem, 2.1dvh, 1.5rem);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
    z-index: 2;
    transition: all 0.3s var(--rq-ease);
  }

  .rq-diagnostic-preview {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.85rem;
    margin-top: clamp(0.7rem, 1.6dvh, 1.1rem);
    border-top: 1px solid rgba(241, 237, 228, 0.12);
    padding-top: clamp(0.7rem, 1.5dvh, 1rem);
  }

  .rq-diagnostic-preview[hidden] {
    display: none;
  }

  .rq-diagnostic-preview p {
    margin: 0;
    color: var(--rq-on-dark-2);
    font-size: clamp(0.9rem, 1.2vw, 0.98rem);
    line-height: 1.45;
  }

  .rq-diagnostic-preview__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--rq-lime);
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
    text-underline-offset: 0.22em;
  }

  .rq-diagnostic-preview__link:hover,
  .rq-diagnostic-preview__link:focus-visible {
    text-decoration: underline;
  }

  /* Panel Animation */
  .diag-panel {
    display: none;
    opacity: 0;
  }

  .diag-panel.active {
    display: block;
    animation: panelFadeIn 0.45s var(--rq-ease) forwards;
  }

  @keyframes panelFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Panel Header Layout */
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(0.85rem, 2dvh, 1.3rem);
    margin-bottom: clamp(0.75rem, 1.8dvh, 1.4rem);
    border-bottom: 1px solid var(--rq-line);
    padding-bottom: clamp(0.65rem, 1.6dvh, 1.1rem);
  }

  .panel-header-left {
    flex: 1;
    min-width: 0;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 4dvh, 2rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--rq-ink);
    letter-spacing: -0.01em;
    margin: 0 0 clamp(0.45rem, 1.1dvh, 0.75rem);
  }

  .panel-meta-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  /* Severity Tag */
  .severity-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--rq-r-pill);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .severity-tag.critical {
    background: var(--rq-burgundy-tint);
    color: var(--rq-burgundy-strong);
    border: 1px solid rgba(122, 31, 43, 0.16);
  }

  .severity-tag.medium {
    background: #F0F5D4;
    color: var(--rq-lime-ink);
    border: 1px solid rgba(42, 53, 8, 0.16);
  }

  .severity-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .severity-tag.critical .severity-dot {
    background: var(--rq-burgundy);
  }

  .severity-tag.medium .severity-dot {
    background: var(--rq-lime-ink);
  }

  /* Controls (Arrows & Counter) */
  .panel-controls {
    display: inline-flex;
    align-items: center;
    background: var(--rq-surface);
    border: 1px solid var(--rq-line);
    border-radius: var(--rq-r-pill);
    padding: 0.35rem 0.65rem;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(28, 26, 23, 0.03);
  }

  .control-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--rq-ink);
    width: 2.75rem;
    min-width: 44px;
    height: 2.75rem;
    min-height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--rq-ease);
  }

  .control-btn:hover {
    background: var(--rq-bg);
    color: var(--rq-burgundy);
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--rq-burgundy);
  }

  .counter-display {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--rq-ink-2);
    min-width: 4rem;
    text-align: center;
    user-select: none;
  }

  /* 4 Boxes Grid Layout */
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.55rem, 1.3dvh, 0.9rem);
    margin-bottom: clamp(0.65rem, 1.5dvh, 1.1rem);
  }

  .grid-card {
    background: var(--rq-surface);
    border: 1px solid var(--rq-line);
    border-radius: 12px;
    padding: clamp(0.85rem, 1.8dvh, 1.15rem) clamp(0.95rem, 2vw, 1.35rem);
    transition: all 0.3s var(--rq-ease);
    display: flex;
    flex-direction: column;
  }

  .grid-card:hover {
    border-color: rgba(122, 31, 43, 0.22);
    box-shadow: 0 10px 30px rgba(28, 26, 23, 0.04);
    transform: translateY(-2px);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rq-burgundy);
    margin-bottom: clamp(0.35rem, 0.8dvh, 0.55rem);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card-label::before {
    content: "";
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: 50%;
  }

  .card-text {
    font-family: var(--font-body);
    font-size: 0.96rem;
    line-height: 1.45;
    color: var(--rq-ink);
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Panel Footer */
  .panel-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: clamp(0.7rem, 1.4dvh, 1.2rem);
    flex-wrap: wrap;
    border-top: 1px solid var(--rq-line);
    padding-top: clamp(0.65rem, 1.5dvh, 1rem);
    margin-top: 0.25rem;
  }

  /* CTA Button style */
  .footer-cta .rq-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    background: var(--rq-burgundy);
    color: var(--rq-surface);
    border: 1px solid var(--rq-burgundy);
    border-radius: var(--rq-r-pill);
    padding: 0.7rem 1.35rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s var(--rq-ease);
    box-shadow: 0 4px 14px rgba(122, 31, 43, 0.15);
  }

  .footer-cta .rq-btn:hover {
    background: var(--rq-burgundy-strong);
    border-color: var(--rq-burgundy-strong);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(122, 31, 43, 0.25);
  }

  .footer-cta .rq-btn svg {
    transition: transform 0.25s var(--rq-ease);
  }

  .footer-cta .rq-btn:hover svg {
    transform: translateX(4px);
  }

  /* Related Services */
  .footer-related {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .related-label {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--rq-ink-2);
  }

  .related-badge {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: var(--rq-burgundy-tint);
    color: var(--rq-burgundy-strong);
    padding: 0.4rem 0.85rem;
    border-radius: var(--rq-r-pill);
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid rgba(122, 31, 43, 0.08);
    transition: all 0.2s var(--rq-ease);
    text-decoration: none;
  }

  .related-badge:hover {
    background: var(--rq-burgundy);
    color: var(--rq-surface);
    border-color: var(--rq-burgundy);
  }

  /* Responsiveness */
  @media (max-width: 960px) {
    .rq-diagnostic-section {
      padding: clamp(1rem, 2.8dvh, 1.7rem) 1rem;
    }

    .panel-header {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(0.75rem, 2dvh, 1.15rem);
      padding-bottom: clamp(0.65rem, 1.6dvh, 1rem);
      margin-bottom: clamp(0.75rem, 1.8dvh, 1.25rem);
    }

    .panel-controls {
      align-self: flex-start;
    }

    .panel-grid {
      grid-template-columns: 1fr;
      gap: clamp(0.55rem, 1.4dvh, 0.9rem);
      margin-bottom: clamp(0.65rem, 1.6dvh, 1rem);
    }

    .diag-panel-wrapper {
      padding: clamp(0.9rem, 2.2dvh, 1.35rem) 1rem;
    }
  }

  @media (max-width: 640px) {
    .panel-footer {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(0.7rem, 1.8dvh, 1rem);
      padding-top: clamp(0.65rem, 1.8dvh, 1rem);
    }

    .footer-cta .rq-btn {
      width: 100%;
    }

    .footer-related {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diag-tab,
    .diag-tab-num,
    .diag-panel-wrapper,
    .grid-card,
    .control-btn,
    .footer-cta .rq-btn,
    .footer-cta .rq-btn svg,
    .related-badge {
      transition: none;
    }

    .diag-panel.active {
      animation: none;
      opacity: 1;
    }

    .grid-card:hover,
    .footer-cta .rq-btn:hover,
    .footer-cta .rq-btn:hover svg {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll('[data-rq-problem-diagnostic]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.rqDiagnosticTabs === 'true') return;
      root.dataset.rqDiagnosticTabs = 'true';

      const tabs = Array.from(root.querySelectorAll('.diag-tab')).filter((tab) => tab instanceof HTMLButtonElement);
      const panels = Array.from(root.querySelectorAll('.diag-panel')).filter((panel) => panel instanceof HTMLElement);
      const tabsContainer = root.querySelector('.diag-tabs');
      const auditPreview = root.querySelector('[data-rq-audit-preview]');
      const auditPreviewEligibleIndexes = new Set(
        (auditPreview?.getAttribute('data-rq-eligible-indexes') || '')
          .split(',')
          .map((value) => Number.parseInt(value, 10))
          .filter((value) => Number.isFinite(value)),
      );
      const counterDisplays = Array.from(root.querySelectorAll('.counter-current'));
      const total = Math.min(tabs.length, panels.length);

      if (!(tabsContainer instanceof HTMLElement) || total === 0) return;

      let currentIndex = Math.max(0, tabs.findIndex((tab) => tab.classList.contains('active')));
      let setWidth = 0;

      function normalizeIndex(index) {
        return (index + total) % total;
      }

      // Vycentruj NEJBLIŽŠÍ instanci daného indexu (klon i skutečný tab) —
      // takže z 1. na 21. je to jeden krok doleva, žádné přetáčení přes celý pás.
      function centerTab(index, smooth) {
        const instances = Array.from(tabsContainer.querySelectorAll('.diag-tab')).filter(
          (el) => el instanceof HTMLElement && Number.parseInt(el.dataset.index ?? '-1', 10) === index,
        );
        if (instances.length === 0) return;

        const viewportCenter = tabsContainer.scrollLeft + tabsContainer.clientWidth / 2;
        let best = instances[0];
        let bestDistance = Infinity;
        instances.forEach((el) => {
          const distance = Math.abs(el.offsetLeft + el.offsetWidth / 2 - viewportCenter);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = el;
          }
        });

        let target = best.offsetLeft + best.offsetWidth / 2 - tabsContainer.clientWidth / 2;

        // Drž cíl v prostředním pásmu: případný posun o šířku sady je neviditelný
        // (obsah je identický), takže smooth animace nikdy nekříží teleport.
        if (setWidth > 0) {
          if (target < setWidth * 0.25) {
            tabsContainer.scrollLeft += setWidth;
            target += setWidth;
          } else if (target > setWidth * 1.75) {
            tabsContainer.scrollLeft -= setWidth;
            target -= setWidth;
          }
        }

        tabsContainer.scrollTo({ left: target, behavior: smooth ? 'smooth' : 'auto' });
      }

      function updateCounters(index) {
        counterDisplays.forEach((counter) => {
          counter.textContent = String(index + 1);
        });
      }

      function updateAuditPreview(index) {
        if (!(auditPreview instanceof HTMLElement)) return;
        const isEligible = auditPreviewEligibleIndexes.has(index);
        auditPreview.hidden = !isEligible;
        auditPreview.setAttribute('aria-hidden', isEligible ? 'false' : 'true');
      }

      function setActive(nextIndex, options = {}) {
        const index = normalizeIndex(nextIndex);
        currentIndex = index;

        tabs.forEach((tab, i) => {
          const isActive = i === index;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.tabIndex = isActive ? 0 : -1;

          if (isActive) {
            if (options.scroll !== false) {
              centerTab(index, !reduceQuery.matches);
            }

            if (options.focusTab) {
              tab.focus({ preventScroll: true });
            }
          }
        });

        panels.forEach((panel, i) => {
          const isActive = i === index;
          panel.classList.toggle('active', isActive);
          panel.hidden = !isActive;
        });

        updateCounters(index);
        updateAuditPreview(index);

        root.querySelectorAll('.diag-tab--clone').forEach((clone) => {
          if (!(clone instanceof HTMLElement)) return;
          clone.classList.toggle('active', Number.parseInt(clone.dataset.index ?? '-1', 10) === index);
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const nextIndex = Number.parseInt(tab.dataset.index ?? '0', 10);
          setActive(Number.isNaN(nextIndex) ? 0 : nextIndex);
        });
      });

      root.querySelectorAll('.prev-btn').forEach((button) => {
        button.addEventListener('click', () => {
          setActive(currentIndex - 1);
        });
      });

      root.querySelectorAll('.next-btn').forEach((button) => {
        button.addEventListener('click', () => {
          setActive(currentIndex + 1);
        });
      });

      tabsContainer.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          setActive(currentIndex + 1, { focusTab: true });
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          setActive(currentIndex - 1, { focusTab: true });
        } else if (event.key === 'Home') {
          event.preventDefault();
          setActive(0, { focusTab: true });
        } else if (event.key === 'End') {
          event.preventDefault();
          setActive(total - 1, { focusTab: true });
        }
      });

      // Nekonečný pás: naklonuj celý set tabů před i za skutečné taby a drž
      // scroll v prostředním setu (teleport o šířku setu je díky identickému
      // layoutu neviditelný). Klony jsou jen vizuální/klikací — mimo tablist.
      if (total > 1) {
        const makeClones = () =>
          tabs.map((tab) => {
            const clone = tab.cloneNode(true);
            clone.classList.remove('active');
            clone.classList.add('diag-tab--clone');
            clone.setAttribute('role', 'presentation');
            clone.setAttribute('aria-hidden', 'true');
            clone.removeAttribute('id');
            clone.removeAttribute('aria-controls');
            clone.removeAttribute('aria-selected');
            clone.tabIndex = -1;
            clone.addEventListener('click', () => {
              const nextIndex = Number.parseInt(clone.dataset.index ?? '0', 10);
              setActive(Number.isNaN(nextIndex) ? 0 : nextIndex);
            });
            return clone;
          });

        const before = makeClones();
        const after = makeClones();
        before.forEach((clone) => tabsContainer.insertBefore(clone, tabs[0]));
        after.forEach((clone) => tabsContainer.appendChild(clone));

        const recenter = () => {
          setWidth = tabs[0].offsetLeft - before[0].offsetLeft;
          centerTab(currentIndex, false);
        };

        recenter();
        window.addEventListener('resize', recenter);

        tabsContainer.addEventListener(
          'scroll',
          () => {
            if (!setWidth) return;
            if (tabsContainer.scrollLeft < setWidth * 0.25) {
              tabsContainer.scrollLeft += setWidth;
            } else if (tabsContainer.scrollLeft > setWidth * 1.75) {
              tabsContainer.scrollLeft -= setWidth;
            }
          },
          { passive: true },
        );
      }

      setActive(currentIndex, { scroll: false });
    });
  })();
</script>
