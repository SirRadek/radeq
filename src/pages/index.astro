---
import CommandHeader from '../components/CommandHeader.astro';
import ContactTerminal from '../components/ContactTerminal';
import HandoffStandard from '../components/HandoffStandard.astro';
import HeroSection from '../components/HeroSection.astro';
import PricingSection from '../components/PricingSection.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import { siteContent } from '../data/siteContent';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import AudienceBand from '../components/AudienceBand.astro';

const content = siteContent.cs;
---

<BaseLayout
  title={content.layout.title}
  description={content.layout.description}
  lang={content.layout.lang}
  alternatePath={content.layout.alternatePath}
  alternateLang="en"
>
  <CommandHeader
    content={content.header}
    alternatePath={content.layout.alternatePath}
    alternateLabel={content.layout.alternateLabel}
    locale={content.layout.lang}
    showStyleToggle={false}
  />
  <main>
    <div class="proposal-stage" id="services">
      <HeroSection content={content.hero} />
      <AudienceBand content={content.audience} />
      <ServiceCatalog locale={content.layout.lang} content={content.systems} />
    </div>
    <section class="about-services" id="about" aria-labelledby="about-title" data-section-signature="about-services">
  <div class="about-services__inner ds-section">
    <div class="about-services__left">
      <div class="about-services__intro">
        <p class="ds-eyebrow">{content.about.sectionCode}</p>
        <h2 class="ds-h2" id="about-title">{content.about.title}</h2>
        <p class="ds-lead">{content.about.lead}</p>
      </div>

      <div class="about-services__profile" aria-labelledby="about-profile-title">
        <p class="ds-eyebrow">{content.about.profileTitle}</p>
        <p>{content.about.profileText}</p>
        <dl>
          {content.about.principles.map((principle) => (
            <div>
              <dt>{principle.label}</dt>
              <dd>{principle.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="about-services__right" aria-labelledby="about-services-title">
      <p class="ds-eyebrow" id="about-services-title">{content.about.servicesTitle}</p>
      <div class="about-services__grid">
        {content.about.items.map((item) => (
          <article class="about-service-card ds-card">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="about-services__note">{content.about.note}</p>
    </div>
  </div>
</section>
    <HandoffStandard content={content.handoff} />
    <PricingSection content={content.pricing} />
    <ContactTerminal locale={content.layout.lang} content={content.terminal} client:load />
  </main>
  <Footer content={content.header} locale={content.layout.lang} />
</BaseLayout>
