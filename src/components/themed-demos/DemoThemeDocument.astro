---
import ServiceReturn from '../ServiceReturn.astro';
import RqMetadata from '../RqMetadata.astro';
import DemoThemeHeader from './DemoThemeHeader.astro';
interface Props {title:string;description:string;theme:'plumber'|'physio'|'workshop';lang?:'cs'|'en'}
const {title,description,theme,lang='cs'}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang={lang} data-demo-theme={theme}><head><RqMetadata title={title} description={description} lang={lang} icons={[{rel:'icon',type:'image/png',url:`${base}/favicon.png`}]} /><meta name="robots" content="noindex,nofollow" /><style is:inline set:html={`@font-face{font-family:"IBM Plex Sans";src:url("${base}/fonts/themed-demos/ibm-plex-sans/IBMPlexSans-variable.ttf") format("truetype");font-weight:100 700;font-style:normal;font-display:swap}`} />{theme==='physio'&&<style is:inline set:html={`@font-face{font-family:"Fraunces";src:url("${base}/fonts/themed-demos/fraunces/Fraunces[SOFT,WONK,opsz,wght].ttf") format("truetype");font-weight:100 900;font-display:swap}@font-face{font-family:"Source Sans 3";src:url("${base}/fonts/themed-demos/sourcesans3/SourceSans3[wght].ttf") format("truetype");font-weight:200 900;font-display:swap}html[data-demo-theme=physio] body{background:#eef2e9;color:#2f493d;font-family:"Source Sans 3",sans-serif}html[data-demo-theme=physio] a{color:#2f493d}html[data-demo-theme=physio] .logo>span:first-child{background:#76576f}html[data-demo-theme=physio] header,html[data-demo-theme=physio] footer{border-color:#8a9c8c}html[data-demo-theme=physio] header{border-bottom:1px solid #8a9c8c;padding-bottom:1.5rem}`} /> }{theme==='workshop'&&<style is:inline set:html={`@font-face{font-family:"Barlow Condensed";src:url("${base}/fonts/themed-demos/barlowcondensed/BarlowCondensed-SemiBold.ttf") format("truetype");font-weight:600;font-display:swap}@font-face{font-family:"IBM Plex Mono";src:url("${base}/fonts/themed-demos/ibmplexmono/IBMPlexMono-Regular.ttf") format("truetype");font-weight:400;font-display:swap}@font-face{font-family:"IBM Plex Mono";src:url("${base}/fonts/themed-demos/ibmplexmono/IBMPlexMono-Medium.ttf") format("truetype");font-weight:500;font-display:swap}html[data-demo-theme=workshop] body{background:#222826;color:#eee9dd;font-family:"IBM Plex Mono",monospace}html[data-demo-theme=workshop] a{color:#eee9dd}html[data-demo-theme=workshop] .logo>span:first-child{background:#d6ab59}html[data-demo-theme=workshop] footer{border-color:#858b83}html[data-demo-theme=workshop] a:focus-visible,html[data-demo-theme=workshop] button:focus-visible{outline-color:#d6ab59}`} /> }<style is:global>

*{box-sizing:border-box}body{margin:0;background:#f8fafb;color:#142b45;font-family:'IBM Plex Sans',sans-serif;font-size:1.125rem;line-height:1.5}body>div{max-width:90rem;margin:auto;padding:2rem 5.5rem}a{color:#235ac6;text-underline-offset:.3em}button,input,textarea{font:inherit}button{cursor:pointer}button,a,input{min-height:44px}button{border:0}header{display:flex;align-items:center;justify-content:space-between;gap:2rem}nav{display:flex;flex-wrap:wrap;gap:2rem}.logo{position:relative;display:block;width:7rem}.logo>span:first-child{display:block;height:2.5rem;background:#235ac6;mask:var(--logo) center/contain no-repeat}.logo-fallback{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}footer{border-top:1px solid #235ac6;margin-top:3rem;padding-top:1rem;display:flex;justify-content:space-between;gap:1rem;font-size:1rem}h1,h2,p{margin-top:0}h1{font-size:clamp(3rem,7vw,7.5rem);line-height:1.02;font-weight:600;letter-spacing:-.045em;overflow-wrap:anywhere}h2{overflow-wrap:anywhere;font-size:2rem;font-weight:600;line-height:1.2}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #142b45;outline-offset:5px}[hidden]{display:none!important}@media(max-width:900px){body>div{padding:1.5rem 2rem}}@media(max-width:600px){body>div{padding:1.25rem}header{align-items:flex-start;gap:1rem}nav{gap:.5rem;flex-direction:column;font-size:1rem}footer{flex-direction:column}}@media(forced-colors:active){.logo>span:first-child{display:none}.logo-fallback{position:static;clip-path:none;width:auto;height:auto}button,textarea{border:1px solid ButtonText}} 
</style></head><body><div><DemoThemeHeader base={base} theme={theme} lang={lang}/><slot/><ServiceReturn lang={lang} service={theme === 'physio' ? 'terminy' : theme === 'workshop' ? 'data' : 'web'}/><footer><a href={`${base}/${lang === 'en' ? 'en/' : ''}`}>{lang === 'en' ? 'Back to RadeQ' : 'Zpět na RadeQ'}</a><span>{lang === 'en' ? 'Fictional data. Nothing is sent.' : 'Fiktivní údaje. Nic se neodesílá.'}</span></footer></div></body></html>
